<%- include('../layouts/header', { extraCss: '<link rel="stylesheet" href="/css/projects.css">' }) %>

<div class="content-wrapper p-4">
  <input type="hidden" id="csrf-token" value="<%= locals.csrfToken || '' %>" />
  <input type="hidden" id="project-id" value="<%= project.id %>" />

  <!-- Breadcrumbs & Quick Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0 small">
        <li class="breadcrumb-item"><a href="/projects" class="text-decoration-none">Projects</a></li>
        <li class="breadcrumb-item active" aria-current="page"><%= project.code %></li>
      </ol>
    </nav>
    <div class="d-flex gap-2">
      <a href="/projects/<%= project.id %>/edit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-pencil me-1"></i> Edit Project
      </a>
      <a href="/projects" class="btn btn-sm btn-outline-primary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> All Projects
      </a>
    </div>
  </div>

  <!-- Hero Project Header (Aurora Glass Banner) -->
  <div class="card-glass p-4 mb-4 shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1">
          <span class="badge bg-primary fs-6 px-3 py-1 rounded-pill"><%= project.code %></span>
          <% if (project.status === 'ACTIVE') { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">ACTIVE</span>
          <% } else if (project.status === 'ON_HOLD') { %>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">ON HOLD</span>
          <% } else if (project.status === 'COMPLETED') { %>
            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2">COMPLETED</span>
          <% } else { %>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2"><%= project.status %></span>
          <% } %>
          <span class="badge bg-light text-muted border small"><%= project.billingType.replace(/_/g, ' ') %></span>
        </div>
        <h2 class="h4 fw-bold text-dark mb-1"><%= project.name %></h2>
        <div class="d-flex flex-wrap gap-4 text-muted small mt-2">
          <div><i class="bi bi-building me-1 text-primary"></i><strong>Client:</strong> <%= project.client ? project.client.name : 'Internal Operation' %></div>
          <div><i class="bi bi-geo-alt me-1 text-danger"></i><strong>Site:</strong> <%= project.siteLocation || 'Unspecified' %></div>
          <div><i class="bi bi-person-check me-1 text-success"></i><strong>Manager:</strong> <%= project.manager ? project.manager.name : 'Unassigned' %></div>
          <div><i class="bi bi-calendar3 me-1 text-info"></i><strong>Timeline:</strong> <%= new Date(project.startDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %> → <%= project.endDate ? new Date(project.endDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Ongoing' %></div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-register-bill">
          <i class="bi bi-receipt me-1"></i> Register Bill
        </button>
        <button class="btn btn-sm btn-outline-success rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modal-issue-stock">
          <i class="bi bi-box-arrow-up-right me-1"></i> Issue Stock
        </button>
        <button class="btn btn-sm btn-outline-warning rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modal-daily-labour">
          <i class="bi bi-people me-1"></i> Daily Labour
        </button>
        <button class="btn btn-sm btn-outline-info rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modal-upload-attachment">
          <i class="bi bi-paperclip me-1"></i> Attach File
        </button>
      </div>
    </div>
  </div>

  <!-- Top KPI Ribbon -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
      <div class="kpi-card shadow-sm h-100">
        <div class="kpi-accent-bar accent-purple"></div>
        <span class="kpi-label">Contract Order Value</span>
        <div class="kpi-value fs-5">₹<%= summary.financials.contractValue.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="small text-muted">Fixed agreement</div>
      </div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="kpi-card shadow-sm h-100">
        <div class="kpi-accent-bar accent-blue"></div>
        <span class="kpi-label">Customer Invoiced</span>
        <div class="kpi-value fs-5">₹<%= summary.financials.revenue.invoiced.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="small text-muted">Excl. statutory GST</div>
      </div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="kpi-card shadow-sm h-100">
        <div class="kpi-accent-bar accent-red"></div>
        <span class="kpi-label">Actual Posted Cost</span>
        <div class="kpi-value fs-5 text-danger">₹<%= summary.financials.costs.actualTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="small text-muted">Direct subledger spend</div>
      </div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="kpi-card shadow-sm h-100">
        <div class="kpi-accent-bar accent-green"></div>
        <span class="kpi-label">Invoiced Margin</span>
        <div class="kpi-value fs-5 <%= summary.financials.profitability.margin >= 0 ? 'text-success' : 'text-danger' %>">
          ₹<%= summary.financials.profitability.margin.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
        </div>
        <div class="small fw-semibold <%= summary.financials.profitability.marginPercentage >= 0 ? 'text-success' : 'text-danger' %>">
          <%= summary.financials.profitability.marginPercentage %>% margin
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="kpi-card shadow-sm h-100">
        <div class="kpi-accent-bar accent-amber"></div>
        <span class="kpi-label">Cost Budget</span>
        <div class="kpi-value fs-5">₹<%= summary.financials.costBudget.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="small text-muted">Rem: ₹<%= summary.financials.profitability.remainingBudget.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
      </div>
    </div>
    <div class="col-6 col-lg-2">
      <div class="kpi-card shadow-sm h-100">
        <div class="kpi-accent-bar accent-blue"></div>
        <span class="kpi-label">Cash Collected</span>
        <div class="kpi-value fs-5 text-primary">₹<%= summary.financials.revenue.cashCollected.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="small text-danger">Due: ₹<%= summary.financials.revenue.customerOutstanding.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
      </div>
    </div>
  </div>

  <!-- 10-SECTION NAVIGATION TABS -->
  <div class="card-glass shadow-sm mb-4">
    <div class="card-header bg-transparent border-bottom p-0">
      <ul class="nav project-tab-nav m-0 flex-nowrap overflow-x-auto text-nowrap" id="projectTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link active" id="tab-overview-btn" data-bs-toggle="tab" data-bs-target="#tab-overview" type="button" role="tab">
            <i class="bi bi-speedometer2 me-1"></i> Overview & Profitability
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-purchases-btn" data-bs-toggle="tab" data-bs-target="#tab-purchases" type="button" role="tab">
            <i class="bi bi-receipt-cutoff me-1"></i> Purchases & POs (<%= (purchaseOrders || []).length + (supplierBills || []).length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-materials-btn" data-bs-toggle="tab" data-bs-target="#tab-materials" type="button" role="tab">
            <i class="bi bi-box-seam me-1"></i> Materials & Inventory (<%= (stockMovements || []).length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-labour-btn" data-bs-toggle="tab" data-bs-target="#tab-labour" type="button" role="tab">
            <i class="bi bi-people me-1"></i> Labour & Contractors (<%= (timesheets || []).length + (dailyLabour || []).length + (contractorOrders || []).length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-expenses-btn" data-bs-toggle="tab" data-bs-target="#tab-expenses" type="button" role="tab">
            <i class="bi bi-wallet2 me-1"></i> Other Expenses (<%= (expenses || []).length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-sales-btn" data-bs-toggle="tab" data-bs-target="#tab-sales" type="button" role="tab">
            <i class="bi bi-file-earmark-ruled me-1"></i> Sales & Revenue (<%= (quotations || []).length + (invoices || []).length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-tasks-btn" data-bs-toggle="tab" data-bs-target="#tab-tasks" type="button" role="tab">
            <i class="bi bi-check2-square me-1"></i> Tasks & Milestones (<%= (tasks || []).length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-attachments-btn" data-bs-toggle="tab" data-bs-target="#tab-attachments" type="button" role="tab">
            <i class="bi bi-paperclip me-1"></i> Documents & Certificates (<%= (attachments || []).length %>)
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-reports-btn" data-bs-toggle="tab" data-bs-target="#tab-reports" type="button" role="tab">
            <i class="bi bi-clipboard-check me-1"></i> GL Reconciliation
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link project-tab-link" id="tab-activity-btn" data-bs-toggle="tab" data-bs-target="#tab-activity" type="button" role="tab">
            <i class="bi bi-clock-history me-1"></i> Activity Timeline (<%= (timelineEvents || []).length %>)
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content project-tab-content p-4" id="projectTabContent">
      <!-- 1. OVERVIEW & PROFITABILITY TAB -->
      <div class="tab-pane fade show active" id="tab-overview" role="tabpanel">
        <div class="row g-4">
          <div class="col-lg-7">
            <div class="card border rounded-3 p-3 mb-4 shadow-sm bg-white">
              <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart-steps text-primary me-2"></i>Budget vs Actual Expenditure by Category</h6>
              
              <!-- Materials -->
              <% const matActual = summary.financials.costs.materials; const matBudget = summary.financials.budgetBreakdown.materials; %>
              <% const matPct = matBudget > 0 ? Math.min(100, Math.round((matActual / matBudget) * 100)) : (matActual > 0 ? 100 : 0); %>
              <div class="mb-3">
                <div class="d-flex justify-content-between small fw-semibold mb-1">
                  <span>Materials & Inventory</span>
                  <span>₹<%= matActual.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> / ₹<%= matBudget.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> (<%= matPct %>%)</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar <%= matPct > 90 ? 'bg-danger' : 'bg-primary' %>" style="width: <%= matPct %>%;"></div>
                </div>
              </div>

              <!-- Labour -->
              <% const labActual = summary.financials.costs.labour; const labBudget = summary.financials.budgetBreakdown.labour; %>
              <% const labPct = labBudget > 0 ? Math.min(100, Math.round((labActual / labBudget) * 100)) : (labActual > 0 ? 100 : 0); %>
              <div class="mb-3">
                <div class="d-flex justify-content-between small fw-semibold mb-1">
                  <span>Labour Compensation (Internal Staff & Daily Workers)</span>
                  <span>₹<%= labActual.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> / ₹<%= labBudget.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> (<%= labPct %>%)</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar <%= labPct > 90 ? 'bg-danger' : 'bg-warning' %>" style="width: <%= labPct %>%;"></div>
                </div>
              </div>

              <!-- Subcontractors -->
              <% const subActual = summary.financials.costs.subcontractor; const subBudget = summary.financials.budgetBreakdown.subcontractor; %>
              <% const subPct = subBudget > 0 ? Math.min(100, Math.round((subActual / subBudget) * 100)) : (subActual > 0 ? 100 : 0); %>
              <div class="mb-3">
                <div class="d-flex justify-content-between small fw-semibold mb-1">
                  <span>Subcontractors & Job Work</span>
                  <span>₹<%= subActual.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> / ₹<%= subBudget.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> (<%= subPct %>%)</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar <%= subPct > 90 ? 'bg-danger' : 'bg-info' %>" style="width: <%= subPct %>%;"></div>
                </div>
              </div>

              <!-- Expenses & Other -->
              <% const expActual = summary.financials.costs.expense + summary.financials.costs.other + summary.financials.costs.equipment; const expBudget = summary.financials.budgetBreakdown.expenses; %>
              <% const expPct = expBudget > 0 ? Math.min(100, Math.round((expActual / expBudget) * 100)) : (expActual > 0 ? 100 : 0); %>
              <div class="mb-1">
                <div class="d-flex justify-content-between small fw-semibold mb-1">
                  <span>Direct Expenses, Freight & Equipment</span>
                  <span>₹<%= expActual.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> / ₹<%= expBudget.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> (<%= expPct %>%)</span>
                </div>
                <div class="progress" style="height: 8px;">
                  <div class="progress-bar <%= expPct > 90 ? 'bg-danger' : 'bg-secondary' %>" style="width: <%= expPct %>%;"></div>
                </div>
              </div>
            </div>

            <!-- Forecast to Complete Card -->
            <div class="card border rounded-3 p-3 shadow-sm bg-white">
              <h6 class="fw-bold text-dark mb-2"><i class="bi bi-graph-up text-success me-2"></i>Estimate & Cost Forecast to Complete</h6>
              <p class="text-muted small mb-3">Estimates are maintained separately from authoritative general ledger actuals.</p>
              <div class="row g-2 text-center">
                <div class="col-4 border-end">
                  <span class="text-muted small d-block">Open PO Commitments</span>
                  <span class="fw-bold text-dark fs-6">₹<%= summary.financials.costs.openCommitments.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
                </div>
                <div class="col-4 border-end">
                  <span class="text-muted small d-block">Forecast to Complete</span>
                  <span class="fw-bold text-warning fs-6">₹<%= summary.financials.profitability.forecastCostToComplete.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
                </div>
                <div class="col-4">
                  <span class="text-muted small d-block">Estimated Final Cost</span>
                  <span class="fw-bold text-primary fs-6">₹<%= summary.financials.profitability.forecastFinalCost.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-5">
            <div class="card border rounded-3 p-3 shadow-sm bg-white mb-4">
              <h6 class="fw-bold text-dark mb-3"><i class="bi bi-cash-coin text-success me-2"></i>Financial Reconciliation Card</h6>
              <table class="table table-sm table-borderless mb-0">
                <tbody>
                  <tr>
                    <td class="text-muted">Contract Value</td>
                    <td class="text-end fw-bold">₹<%= summary.financials.contractValue.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  </tr>
                  <tr>
                    <td class="text-muted">Customer Invoiced (excl. tax)</td>
                    <td class="text-end fw-semibold text-primary">₹<%= summary.financials.revenue.invoiced.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  </tr>
                  <tr>
                    <td class="text-muted">Cash Collected</td>
                    <td class="text-end text-success">₹<%= summary.financials.revenue.cashCollected.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  </tr>
                  <tr>
                    <td class="text-muted">Customer Receivables Due</td>
                    <td class="text-end text-danger fw-semibold">₹<%= summary.financials.revenue.customerOutstanding.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  </tr>
                  <tr class="border-top">
                    <td class="text-muted">Actual Incurred Cost</td>
                    <td class="text-end text-danger fw-bold">- ₹<%= summary.financials.costs.actualTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  </tr>
                  <tr class="border-top">
                    <td class="fw-bold">Project Margin (P&L)</td>
                    <td class="text-end fw-bold <%= summary.financials.profitability.margin >= 0 ? 'text-success' : 'text-danger' %> fs-6">
                      ₹<%= summary.financials.profitability.margin.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                      <small class="d-block fw-normal text-muted">(<%= summary.financials.profitability.marginPercentage %>%)</small>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="card border rounded-3 p-3 shadow-sm bg-white">
              <h6 class="fw-bold text-dark mb-2"><i class="bi bi-file-text text-secondary me-2"></i>Project Parameters</h6>
              <div class="small text-muted mb-1"><strong>Revenue Policy:</strong> <%= project.revenueRecognitionMethod.replace(/_/g, ' ') %></div>
              <div class="small text-muted mb-1"><strong>Sales Billing Rate:</strong> ₹<%= parseFloat(project.hourlyRate).toFixed(2) %>/hr</div>
              <div class="small text-muted mb-1"><strong>Internal Labour Cost Rate:</strong> ₹<%= parseFloat(project.costRate).toFixed(2) %>/hr</div>
              <div class="small text-muted mt-2"><strong>Scope / Notes:</strong> <%= project.description || 'No detailed scope notes provided.' %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. PURCHASES, ORDERS & GOODS RECEIPTS TAB -->
      <div class="tab-pane fade" id="tab-purchases" role="tabpanel">
        <!-- 2A. Purchase Orders -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Procurement Commitments & Purchase Orders</h6>
            <span class="text-muted small">Legally binding supplier commitments allocated to this project (zero immediate financial liability until billing)</span>
          </div>
          <a href="/purchases/orders/new?projectId=<%= project.id %>" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Purchase Order
          </a>
        </div>

        <div class="table-responsive border rounded-3 bg-white mb-4">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">PO Number</th>
                <th>Supplier / Vendor</th>
                <th>Order Date</th>
                <th>Due Date</th>
                <th>Items</th>
                <th class="text-center">Status</th>
                <th class="pe-3 text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (purchaseOrders && purchaseOrders.length > 0) { %>
                <% purchaseOrders.forEach(po => { %>
                  <tr id="project-po-<%= po.id %>">
                    <td class="ps-3 fw-bold">
                      <a href="/purchases/orders/<%= po.id %>" class="text-decoration-none text-primary font-monospace"><%= po.orderNumber %></a>
                    </td>
                    <td>
                      <div class="fw-semibold text-dark"><%= po.supplierName %></div>
                      <div class="small text-muted"><%= po.supplier && po.supplier.gstin ? po.supplier.gstin : 'Unregistered' %></div>
                    </td>
                    <td class="small text-muted"><%= new Date(po.orderDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td class="small text-muted"><%= po.dueDate ? new Date(po.dueDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %></td>
                    <td><span class="badge bg-light text-dark border"><%= (po.items || []).length %> items</span></td>
                    <td class="text-center">
                      <span class="badge bg-<%= po.status === 'ACTIVE' ? 'success' : (po.status === 'VOID' ? 'danger' : 'secondary') %> rounded-pill px-2">
                        <%= po.status %>
                      </span>
                    </td>
                    <td class="pe-3 text-end">
                      <a href="/purchases/orders/<%= po.id %>" class="btn btn-sm btn-outline-secondary me-1">View</a>
                      <% if (po.status === 'ACTIVE') { %>
                        <a href="/purchases/orders/<%= po.id %>/receive" class="btn btn-sm btn-outline-success">
                          <i class="bi bi-box-arrow-in-down me-1"></i>Receive
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">
                    <i class="bi bi-file-earmark-text display-6 d-block mb-2 text-secondary opacity-50"></i>
                    No purchase orders allocated to this project yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- 2B. Goods Receipts (GRN) -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Goods Receipts (GRN) & Store Deliveries</h6>
            <span class="text-muted small">Warehouse receipts against project procurement. Stock received without duplicate expense recognition.</span>
          </div>
          <a href="/purchases/receipts" class="btn btn-sm btn-outline-primary rounded-pill px-3">
            <i class="bi bi-box-seam me-1"></i> All Store Receipts
          </a>
        </div>

        <div class="table-responsive border rounded-3 bg-white mb-4">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">GRN #</th>
                <th>Receipt Date</th>
                <th>Supplier</th>
                <th>Challan #</th>
                <th>Store Location</th>
                <th>Items Received</th>
                <th class="pe-3 text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (goodsReceipts && goodsReceipts.length > 0) { %>
                <% goodsReceipts.forEach(grn => { %>
                  <tr id="project-grn-<%= grn.id %>">
                    <td class="ps-3 fw-bold">
                      <a href="/purchases/receipts/<%= grn.id %>" class="text-decoration-none text-primary font-monospace"><%= grn.receiptNumber %></a>
                    </td>
                    <td class="small text-muted"><%= new Date(grn.receiptDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td class="fw-semibold text-dark"><%= grn.supplierName %></td>
                    <td><span class="badge bg-light text-dark border font-monospace"><%= grn.deliveryChallanNumber || 'N/A' %></span></td>
                    <td><span class="badge bg-info-subtle text-info border border-info-subtle"><%= grn.storeLocation || 'Main Store' %></span></td>
                    <td><%= (grn.items || []).length %> items</td>
                    <td class="pe-3 text-center">
                      <span class="badge bg-<%= grn.status === 'ACTIVE' ? 'success' : 'secondary' %> rounded-pill px-2"><%= grn.status %></span>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">
                    <i class="bi bi-box-arrow-in-down display-6 d-block mb-2 text-secondary opacity-50"></i>
                    No goods receipts recorded for this project yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- 2C. Supplier Bills & Procurement Invoices -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Supplier Bills & External Invoices</h6>
            <span class="text-muted small">Purchased materials, equipment, and subcontractor invoices allocated to this project</span>
          </div>
          <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-register-bill">
            <i class="bi bi-plus-circle me-1"></i> Register Supplier Bill
          </button>
        </div>

        <div class="table-responsive border rounded-3 bg-white">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Internal Bill #</th>
                <th>Supplier / Vendor</th>
                <th>External Invoice #</th>
                <th>Bill Date</th>
                <th class="text-end">Taxable Value</th>
                <th class="text-end">GST Components</th>
                <th class="text-end">Round-Off</th>
                <th class="text-end">Bill Total</th>
                <th>Verification</th>
                <th class="pe-3 text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (supplierBills && supplierBills.length > 0) { %>
                <% supplierBills.forEach(b => { %>
                  <tr id="project-bill-<%= b.id %>">
                    <td class="ps-3 fw-bold text-primary"><%= b.billNumber %></td>
                    <td>
                      <div class="fw-semibold text-dark"><%= b.supplierName %></div>
                      <div class="small text-muted"><%= b.supplierGSTIN || 'Unregistered' %></div>
                    </td>
                    <td><span class="badge bg-light text-dark border font-monospace"><%= b.externalInvoiceNumber || '—' %></span></td>
                    <td class="small text-muted"><%= new Date(b.billDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td class="text-end fw-semibold">₹<%= (parseFloat(b.taxableAmount) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-end small">
                      <% if (parseFloat(b.igstAmount) > 0) { %>
                        <span class="text-primary">IGST: ₹<%= parseFloat(b.igstAmount).toFixed(2) %></span>
                      <% } else { %>
                        <span class="text-muted">C: ₹<%= parseFloat(b.cgstAmount || 0).toFixed(2) %> | S: ₹<%= parseFloat(b.sgstAmount || 0).toFixed(2) %></span>
                      <% } %>
                    </td>
                    <td class="text-end small text-muted">₹<%= parseFloat(b.roundOff || 0).toFixed(2) %></td>
                    <td class="text-end fw-bold text-dark">₹<%= parseFloat(b.totalAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td>
                      <span class="badge <%= b.verificationStatus === 'VERIFIED' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %> rounded-pill px-2">
                        <%= b.verificationStatus %>
                      </span>
                    </td>
                    <td class="pe-3 text-center">
                      <span class="badge <%= b.status === 'ACTIVE' ? 'bg-success' : 'bg-secondary' %>"><%= b.status %></span>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="10" class="text-center py-4 text-muted">
                    <i class="bi bi-receipt display-6 d-block mb-2 text-secondary opacity-50"></i>
                    No supplier bills recorded for this project yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

      </div>

      <!-- 3. MATERIALS & STOCK ISSUES TAB -->
      <div class="tab-pane fade" id="tab-materials" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Tracked Materials & Inventory Issues</h6>
            <span class="text-muted small">Warehouse stock issued to project. Recognised at time of issue to avoid double-counting. Returns credit project cost.</span>
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-warning rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-return-stock">
              <i class="bi bi-arrow-return-left me-1"></i> Return Material to Inventory
            </button>
            <button class="btn btn-sm btn-success rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-issue-stock">
              <i class="bi bi-box-arrow-up-right me-1"></i> Issue Material from Inventory
            </button>
          </div>
        </div>

        <div class="table-responsive border rounded-3 bg-white">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Movement #</th>
                <th>Type</th>
                <th>Item / Material</th>
                <th>Store Location</th>
                <th>Movement Date</th>
                <th class="text-end">Quantity</th>
                <th class="text-end">Unit Cost</th>
                <th class="text-end">Total Cost</th>
                <th class="pe-3">Notes</th>
              </tr>
            </thead>
            <tbody>
              <% if (stockMovements && stockMovements.length > 0) { %>
                <% stockMovements.forEach(sm => { %>
                  <% const isIssue = sm.movementType === 'ISSUE'; %>
                  <tr id="project-movement-<%= sm.id %>">
                    <td class="ps-3 fw-bold text-primary font-monospace"><%= sm.movementNumber %></td>
                    <td>
                      <span class="badge <%= isIssue ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-success-subtle text-success border border-success-subtle' %> rounded-pill px-2">
                        <%= isIssue ? 'ISSUE' : 'RETURN' %>
                      </span>
                    </td>
                    <td>
                      <div class="fw-bold text-dark"><%= sm.item ? sm.item.name : 'Unknown Item' %></div>
                      <div class="small text-muted">Code: <%= sm.item && sm.item.itemCode ? sm.item.itemCode : '—' %></div>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border"><%= sm.storeLocation || 'Main Store' %></span>
                    </td>
                    <td class="small text-muted"><%= new Date(sm.movementDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td class="text-end fw-semibold <%= isIssue ? 'text-dark' : 'text-success' %>">
                      <%= isIssue ? '-' : '+' %><%= Math.abs(parseFloat(sm.quantity)) %> <%= sm.item ? sm.item.unit : 'PCS' %>
                    </td>
                    <td class="text-end font-monospace">₹<%= parseFloat(sm.unitCost).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-end fw-bold font-monospace <%= isIssue ? 'text-danger' : 'text-success' %>">
                      <%= isIssue ? '' : '-' %>₹<%= parseFloat(sm.totalCost).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                    </td>
                    <td class="pe-3 small text-muted"><%= sm.notes || '—' %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="9" class="text-center py-4 text-muted">
                    <i class="bi bi-box-seam display-6 d-block mb-2 text-secondary opacity-50"></i>
                    No warehouse inventory has been issued to or returned from this project yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 4. LABOUR & CONTRACTORS TAB -->
      <div class="tab-pane fade" id="tab-labour" role="tabpanel">
        <!-- Sub-pills -->
        <ul class="nav nav-pills mb-4" id="labourSubTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4 btn-sm" id="pills-staff-btn" data-bs-toggle="pill" data-bs-target="#pills-staff" type="button" role="tab">
              <i class="bi bi-person-workspace me-1"></i> Internal Staff Timesheets (<%= (timesheets || []).length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 btn-sm ms-2" id="pills-daily-btn" data-bs-toggle="pill" data-bs-target="#pills-daily" type="button" role="tab">
              <i class="bi bi-people me-1"></i> Daily / Casual Labour Muster (<%= (dailyLabour || []).length %>)
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4 btn-sm ms-2" id="pills-contractors-btn" data-bs-toggle="pill" data-bs-target="#pills-contractors" type="button" role="tab">
              <i class="bi bi-shield-check me-1"></i> Labour Contractors & Subcontractors (<%= (contractorOrders || []).length %>)
            </button>
          </li>
        </ul>

        <div class="tab-content" id="labourSubTabContent">
          <!-- A. Internal Staff Timesheets -->
          <div class="tab-pane fade show active" id="pills-staff" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small">Internal staff hours recorded against project and tasks. Separate sales rate from cost rate.</span>
              <button class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modal-log-timesheet">
                <i class="bi bi-clock me-1"></i> Log Staff Timesheet
              </button>
            </div>
            <div class="table-responsive border rounded-3 bg-white">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                  <tr>
                    <th class="ps-3">Date</th>
                    <th>Team Member</th>
                    <th>Task</th>
                    <th class="text-end">Hours</th>
                    <th class="text-end">Billing Rate (Sales)</th>
                    <th class="text-end">Cost Rate</th>
                    <th class="text-end">Actual Cost</th>
                    <th class="text-center">Billable</th>
                    <th class="pe-3 text-center">Approval Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (timesheets && timesheets.length > 0) { %>
                    <% timesheets.forEach(ts => { %>
                      <tr id="project-timesheet-<%= ts.id %>">
                        <td class="ps-3 small text-muted"><%= new Date(ts.entryDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                        <td class="fw-semibold text-dark"><%= ts.user ? ts.user.name : 'Unknown' %></td>
                        <td class="small text-secondary"><%= ts.task ? ts.task.title : 'General' %></td>
                        <td class="text-end fw-bold"><%= parseFloat(ts.hours) %> hrs</td>
                        <td class="text-end text-muted small">₹<%= parseFloat(ts.hourlyRate).toFixed(2) %>/hr</td>
                        <td class="text-end text-muted small">₹<%= (parseFloat(project.costRate) || 0).toFixed(2) %>/hr</td>
                        <td class="text-end fw-bold text-danger">₹<%= parseFloat(ts.costAmount).toFixed(2) %></td>
                        <td class="text-center">
                          <span class="badge <%= ts.isBillable ? 'bg-info-subtle text-info' : 'bg-secondary-subtle text-secondary' %> rounded-pill px-2">
                            <%= ts.isBillable ? 'Yes' : 'No' %>
                          </span>
                        </td>
                        <td class="pe-3 text-center">
                          <% if (ts.status === 'APPROVED') { %>
                            <span class="badge bg-success-subtle text-success rounded-pill px-2">Approved</span>
                          <% } else { %>
                            <button class="btn btn-sm btn-outline-success py-0 px-2 rounded-pill btn-approve-timesheet" data-id="<%= ts.id %>">Approve</button>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="9" class="text-center py-4 text-muted">No staff timesheets logged for this project yet.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- B. Daily / Casual Labour Muster Roll -->
          <div class="tab-pane fade" id="pills-daily" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small">Daily attendance, trade, wage basis, advances and payable earnings.</span>
              <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modal-add-worker">
                  <i class="bi bi-person-plus me-1"></i> Register Worker
                </button>
                <button class="btn btn-sm btn-warning rounded-pill px-3 shadow-sm text-dark" data-bs-toggle="modal" data-bs-target="#modal-daily-labour">
                  <i class="bi bi-plus-circle me-1"></i> Record Daily Labour
                </button>
              </div>
            </div>
            <div class="table-responsive border rounded-3 bg-white">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                  <tr>
                    <th class="ps-3">Work Date</th>
                    <th>Worker Name</th>
                    <th>Trade</th>
                    <th class="text-end">Hours Worked</th>
                    <th class="text-end">Wage Rate / Basis</th>
                    <th class="text-end">Gross Payable</th>
                    <th class="text-end">Advances Deducted</th>
                    <th class="text-end">Net Payable</th>
                    <th>Payment</th>
                    <th class="pe-3 text-center">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (dailyLabour && dailyLabour.length > 0) { %>
                    <% dailyLabour.forEach(dl => { %>
                      <tr id="project-daily-labour-<%= dl.id %>">
                        <td class="ps-3 small text-muted"><%= new Date(dl.workDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                        <td class="fw-bold text-dark"><%= dl.worker ? dl.worker.name : 'Unknown' %></td>
                        <td><span class="badge bg-light text-dark border"><%= dl.trade || 'General Worker' %></span></td>
                        <td class="text-end fw-semibold"><%= parseFloat(dl.hours) %> hrs</td>
                        <td class="text-end small text-muted">₹<%= parseFloat(dl.wageRate).toFixed(2) %> (<%= dl.wageBasis %>)</td>
                        <td class="text-end fw-semibold">₹<%= parseFloat(dl.grossPayable).toFixed(2) %></td>
                        <td class="text-end text-muted small">₹<%= parseFloat(dl.advancesDeducted).toFixed(2) %></td>
                        <td class="text-end fw-bold text-danger">₹<%= parseFloat(dl.netPayable).toFixed(2) %></td>
                        <td><span class="badge bg-light text-dark border"><%= dl.paymentMethod %> / <%= dl.paymentStatus %></span></td>
                        <td class="pe-3 text-center"><span class="badge bg-success-subtle text-success rounded-pill px-2"><%= dl.status %></span></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="10" class="text-center py-4 text-muted">No daily labour attendance records logged for this project yet.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- C. Labour Contractors & Subcontractors -->
          <div class="tab-pane fade" id="pills-contractors" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small">Vendor contracts, work orders, agreed contract values, and withholding tax terms.</span>
              <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-contractor-order">
                <i class="bi bi-plus-circle me-1"></i> Create Contractor Work Order
              </button>
            </div>
            <div class="table-responsive border rounded-3 bg-white">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                  <tr>
                    <th class="ps-3">Work Order #</th>
                    <th>Contractor / Supplier</th>
                    <th>Contract Title</th>
                    <th class="text-end">Agreed Contract Value</th>
                    <th class="text-center">Withholding / TDS %</th>
                    <th>Timeline</th>
                    <th class="pe-3 text-center">Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (contractorOrders && contractorOrders.length > 0) { %>
                    <% contractorOrders.forEach(co => { %>
                      <tr id="project-contractor-order-<%= co.id %>">
                        <td class="ps-3 fw-bold text-primary font-monospace"><%= co.orderNumber %></td>
                        <td class="fw-semibold text-dark"><%= co.supplier ? co.supplier.name : 'Unknown' %></td>
                        <td><%= co.contractTitle %></td>
                        <td class="text-end fw-bold">₹<%= parseFloat(co.contractValue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                        <td class="text-center"><span class="badge bg-light text-dark border"><%= parseFloat(co.withholdingTaxRate) %>%</span></td>
                        <td class="small text-muted"><%= co.startDate ? new Date(co.startDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %> → <%= co.endDate ? new Date(co.endDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'Ongoing' %></td>
                        <td class="pe-3 text-center"><span class="badge bg-success-subtle text-success rounded-pill px-2"><%= co.status %></span></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="7" class="text-center py-4 text-muted">No contractor work orders active for this project yet.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. OTHER PROJECT EXPENSES TAB -->
      <div class="tab-pane fade" id="tab-expenses" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Other Direct Project Expenses</h6>
            <span class="text-muted small">Travel, logistics, site utilities, permits, and miscellaneous direct spend</span>
          </div>
        </div>
        <div class="table-responsive border rounded-3 bg-white">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Expense #</th>
                <th>Expense Date</th>
                <th>Category</th>
                <th>Description</th>
                <th class="pe-3 text-end">Amount (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% if (expenses && expenses.length > 0) { %>
                <% expenses.forEach(e => { %>
                  <tr id="project-expense-<%= e.id %>">
                    <td class="ps-3 fw-bold text-primary font-monospace"><%= e.expenseNumber || `EXP-${e.id}` %></td>
                    <td class="small text-muted"><%= new Date(e.expenseDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td><span class="badge bg-light text-dark border"><%= e.category || 'General' %></span></td>
                    <td class="small"><%= e.description %></td>
                    <td class="pe-3 text-end fw-bold text-danger">₹<%= parseFloat(e.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No direct miscellaneous expenses allocated to this project yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 6. SALES & REVENUE TAB -->
      <div class="tab-pane fade" id="tab-sales" role="tabpanel">
        <!-- 6A. Quotations & Estimates -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Quotations & Commercial Proposals</h6>
            <span class="text-muted small">Agreed scopes and client quotes linked to this project (conversion creates authoritative billing invoice)</span>
          </div>
          <a href="/documents/new?type=QUOTATION&projectId=<%= project.id %><%= project.clientId ? '&clientId=' + project.clientId : '' %>" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" id="btn-project-new-quotation">
            <i class="bi bi-file-earmark-plus me-1"></i> New Quotation
          </a>
        </div>

        <div class="table-responsive border rounded-3 bg-white mb-4">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Quotation #</th>
                <th>Quote Date</th>
                <th>Customer</th>
                <th class="text-end">Taxable Amount</th>
                <th class="text-end">GST Amount</th>
                <th class="text-end">Grand Total</th>
                <th class="text-center">Status</th>
                <th class="pe-3 text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (quotations && quotations.length > 0) { %>
                <% quotations.forEach(q => { %>
                  <tr>
                    <td class="ps-3 fw-bold text-primary font-monospace">
                      <a href="/documents/<%= q.id %>" class="text-decoration-none text-primary hover-underline">
                        <i class="bi bi-file-earmark-text me-1"></i><%= q.invoiceNumber %>
                      </a>
                    </td>
                    <td class="small text-muted"><%= new Date(q.invoiceDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td class="fw-semibold text-dark"><%= q.clientName %></td>
                    <td class="text-end fw-semibold">₹<%= (parseFloat(q.subtotal) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-end small text-muted">₹<%= (parseFloat(q.gstAmount) || 0).toFixed(2) %></td>
                    <td class="text-end fw-bold text-dark">₹<%= (parseFloat(q.grandTotal) || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-center">
                      <span class="badge <%= q.status === 'CONVERTED' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %> rounded-pill px-2">
                        <%= q.status %>
                      </span>
                    </td>
                    <td class="pe-3 text-end">
                      <a href="/documents/<%= q.id %>" class="btn btn-sm btn-outline-secondary me-1">View</a>
                      <% if (q.status !== 'CONVERTED') { %>
                        <a href="/documents/<%= q.id %>" class="btn btn-sm btn-outline-success">
                          <i class="bi bi-arrow-repeat me-1"></i>Convert
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center py-4 text-muted">
                    <i class="bi bi-file-earmark-ruled display-6 d-block mb-2 text-secondary opacity-50"></i>
                    No quotations recorded for this project yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- 6B. Customer Invoices & Collections -->
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Customer Invoices & Collections</h6>
            <span class="text-muted small">Invoiced sales revenue, credit notes, and actual cash receipts from customer</span>
          </div>
          <a href="/documents/new?type=INVOICE&projectId=<%= project.id %><%= project.clientId ? '&clientId=' + project.clientId : '' %>" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm text-white" id="btn-project-new-invoice">
            <i class="bi bi-plus-circle me-1"></i> New Invoice
          </a>
        </div>
        <div class="table-responsive border rounded-3 bg-white mb-4">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Invoice #</th>
                <th>Invoice Date</th>
                <th>Customer</th>
                <th class="text-end">Subtotal (Revenue)</th>
                <th class="text-end">GST Amount</th>
                <th class="text-end">Grand Total</th>
                <th class="text-end">Cash Received</th>
                <th class="text-end">Pending Cheques</th>
                <th class="text-end">Outstanding</th>
                <th class="pe-3 text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (invoices && invoices.length > 0) { %>
                <% invoices.forEach(inv => { %>
                  <% const paidAmt = inv.payments ? inv.payments.filter(payment => payment.status === 'POSTED').reduce((a, b) => a + (parseFloat(b.amount) || 0), 0) : 0; %>
                  <% const pendingChequeAmt = inv.payments ? inv.payments.filter(payment => payment.status === 'PENDING_CLEARANCE').reduce((a, b) => a + (parseFloat(b.amount) || 0), 0) : 0; %>
                  <tr id="project-invoice-<%= inv.id %>">
                    <td class="ps-3 fw-bold text-primary font-monospace">
                      <a href="/documents/<%= inv.id %>" class="text-decoration-none text-primary hover-underline" id="project-invoice-link-<%= inv.id %>">
                        <i class="bi bi-file-earmark-text me-1"></i><%= inv.invoiceNumber %>
                      </a>
                    </td>
                    <td class="small text-muted"><%= new Date(inv.invoiceDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td class="fw-semibold text-dark"><%= inv.clientName %></td>
                    <td class="text-end fw-bold text-success">₹<%= parseFloat(inv.subtotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-end small text-muted">₹<%= parseFloat(inv.gstAmount).toFixed(2) %></td>
                    <td class="text-end fw-semibold">₹<%= parseFloat(inv.grandTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-end text-primary">₹<%= paidAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-end text-warning fw-semibold">₹<%= pendingChequeAmt.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="text-end text-danger fw-semibold">₹<%= parseFloat(inv.outstandingAmount || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="pe-3 text-center"><span class="badge bg-success-subtle text-success rounded-pill px-2"><%= inv.status %></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="10" class="text-center py-4 text-muted">No customer sales invoices linked to this project yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Credit & Debit Notes</h6>
            <span class="text-muted small">Adjustments linked to project customer invoices</span>
          </div>
          <span class="badge bg-light text-dark border"><%= (creditNotes || []).length %> notes</span>
        </div>
        <div class="table-responsive border rounded-3 bg-white mb-4">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Note #</th>
                <th>Type</th>
                <th>Date</th>
                <th>Original Invoice</th>
                <th>Reason</th>
                <th class="text-end">Amount</th>
                <th class="pe-3 text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (creditNotes && creditNotes.length > 0) { %>
                <% creditNotes.forEach(note => { %>
                  <tr id="project-credit-note-<%= note.id %>">
                    <td class="ps-3 fw-bold font-monospace">
                      <a href="/credit-debit-notes/<%= note.id %>" class="text-decoration-none text-primary"><%= note.noteNumber %></a>
                    </td>
                    <td><span class="badge <%= note.noteType === 'CREDIT' ? 'bg-info-subtle text-info' : 'bg-warning-subtle text-warning' %>"><%= note.noteType %></span></td>
                    <td class="small text-muted"><%= new Date(note.noteDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td class="font-monospace"><%= note.originalInvoiceNumber %></td>
                    <td class="small"><%= note.reason %></td>
                    <td class="text-end fw-semibold">₹<%= parseFloat(note.grandTotal || 0).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                    <td class="pe-3 text-center"><span class="badge bg-secondary-subtle text-secondary"><%= note.status %></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7" class="text-center py-4 text-muted">No credit or debit notes linked to this project.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 7. TASKS & MILESTONES TAB -->
      <div class="tab-pane fade" id="tab-tasks" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Project Milestones & Task Progress</h6>
            <span class="text-muted small">Deliverables, assigned staff, estimated vs actual hours worked</span>
          </div>
          <button class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#modal-add-task">
            <i class="bi bi-plus-circle me-1"></i> Add Task
          </button>
        </div>
        <div class="table-responsive border rounded-3 bg-white">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Task Title</th>
                <th>Assigned To</th>
                <th class="text-end">Estimated Hours</th>
                <th class="text-end">Actual Hours Worked</th>
                <th>Due Date</th>
                <th class="pe-3 text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (tasks && tasks.length > 0) { %>
                <% tasks.forEach(t => { %>
                  <tr id="project-task-<%= t.id %>">
                    <td class="ps-3 fw-bold text-dark"><%= t.title %></td>
                    <td><%= t.assignedTo ? t.assignedTo.name : 'Unassigned' %></td>
                    <td class="text-end text-muted"><%= parseFloat(t.estimatedHours) %> hrs</td>
                    <td class="text-end fw-semibold text-primary"><%= parseFloat(t.actualHours) %> hrs</td>
                    <td class="small text-muted"><%= t.dueDate ? new Date(t.dueDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %></td>
                    <td class="pe-3 text-center">
                      <span class="badge <%= t.status === 'DONE' ? 'bg-success-subtle text-success' : 'bg-primary-subtle text-primary' %> rounded-pill px-2">
                        <%= t.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-4 text-muted">No tasks defined for this project yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 8. DOCUMENTS & ATTACHMENTS TAB -->
      <div class="tab-pane fade" id="tab-attachments" role="tabpanel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Secure File Attachments & Project Certificates</h6>
            <span class="text-muted small">Third-party certificates (TPT), insurance policies, engineering drawings, and regulatory permits stored in private encrypted storage.</span>
          </div>
          <button class="btn btn-sm btn-info rounded-pill px-3 shadow-sm text-white" data-bs-toggle="modal" data-bs-target="#modal-upload-attachment">
            <i class="bi bi-cloud-arrow-up me-1"></i> Upload File / Certificate
          </button>
        </div>

        <div class="table-responsive border rounded-3 bg-white">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Document Title / Scope</th>
                <th>Category</th>
                <th>Reference #</th>
                <th>Validity Dates</th>
                <th>File / Size</th>
                <th>Uploaded By</th>
                <th class="pe-3 text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (attachments && attachments.length > 0) { %>
                <% attachments.forEach(att => { %>
                  <tr>
                    <td class="ps-3">
                      <div class="fw-bold text-dark"><%= att.title || att.originalFilename %></div>
                      <% if (att.description) { %>
                        <div class="small text-muted text-truncate" style="max-width: 320px;"><%= att.description %></div>
                      <% } %>
                    </td>
                    <td>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2">
                        <%= att.category || att.entityType || 'OTHER' %>
                      </span>
                    </td>
                    <td><span class="badge bg-light text-dark border font-monospace"><%= att.referenceNumber || '—' %></span></td>
                    <td class="small text-muted">
                      <% if (att.issueDate || att.expiryDate) { %>
                        <%= att.issueDate ? new Date(att.issueDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : '—' %>
                        → <%= att.expiryDate ? new Date(att.expiryDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) : 'No Expiry' %>
                      <% } else { %>
                        —
                      <% } %>
                    </td>
                    <td>
                      <div class="small fw-semibold text-dark text-truncate" style="max-width: 150px;"><%= att.originalFilename %></div>
                      <div class="small text-muted"><%= (att.fileSize / 1024).toFixed(1) %> KB</div>
                    </td>
                    <td class="small text-muted">
                      <%= att.uploadedBy ? att.uploadedBy.name : 'System' %>
                      <div class="text-secondary" style="font-size: 0.75rem;"><%= new Date(att.createdAt).toLocaleDateString('en-IN') %></div>
                    </td>
                    <td class="pe-3 text-end">
                      <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2 me-1 btn-edit-att"
                        data-id="<%= att.id %>"
                        data-title="<%= att.title || '' %>"
                        data-category="<%= att.category || 'OTHER' %>"
                        data-ref="<%= att.referenceNumber || '' %>"
                        data-desc="<%= att.description || '' %>"
                        data-issue="<%= att.issueDate ? new Date(att.issueDate).toISOString().split('T')[0] : '' %>"
                        data-expiry="<%= att.expiryDate ? new Date(att.expiryDate).toISOString().split('T')[0] : '' %>"
                        onclick="openEditAttachmentModal(this)">
                        <i class="bi bi-pencil"></i>
                      </button>
                      <a href="/api/attachments/<%= att.id %>/download" class="btn btn-sm btn-outline-primary rounded-pill px-3" target="_blank">
                        <i class="bi bi-download me-1"></i> Download
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">
                    <i class="bi bi-folder display-6 d-block mb-2 text-secondary opacity-50"></i>
                    No attachments or certificates uploaded yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 9. REPORTS & RECONCILIATION TAB -->
      <div class="tab-pane fade" id="tab-reports" role="tabpanel">
        <div class="row g-4 mb-4">
          <div class="col-md-6">
            <div class="card border rounded-3 p-3 bg-white shadow-sm">
              <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check text-success me-2"></i>Subledger to General Ledger Reconciliation</h6>
              <p class="text-muted small mb-3">Automatic reconciliation verification comparing project subledger postings with authoritative financial transactions.</p>
              
              <div class="p-3 rounded-3 <%= reconciliation.isReconciled ? 'bg-success-subtle border border-success-subtle' : 'bg-danger-subtle border border-danger-subtle' %> mb-3">
                <div class="d-flex align-items-center gap-2">
                  <i class="bi <%= reconciliation.isReconciled ? 'bi-check-circle-fill text-success' : 'bi-exclamation-triangle-fill text-danger' %> fs-4"></i>
                  <div>
                    <div class="fw-bold <%= reconciliation.isReconciled ? 'text-success' : 'text-danger' %>">
                      <%= reconciliation.isReconciled ? 'Reconciled: Zero Discrepancy' : 'Reconciliation Discrepancy Detected' %>
                    </div>
                    <div class="small <%= reconciliation.isReconciled ? 'text-success' : 'text-danger' %>">
                      Subledger Total: ₹<%= reconciliation.subledgerTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %> | Authoritative Spend: ₹<%= reconciliation.ledgerTotal.toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                      <% if (!reconciliation.isReconciled) { %>
                        (Variance: ₹<%= reconciliation.discrepancy.toFixed(2) %>)
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-md-6">
            <div class="card border rounded-3 p-3 bg-white shadow-sm h-100 d-flex flex-column justify-content-between">
              <div>
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-printer text-primary me-2"></i>Export & Printing</h6>
                <p class="text-muted small">Export full project costing ledger and profitability report for executive review or audit documentation.</p>
              </div>
              <div class="d-flex gap-2">
                <button class="btn btn-outline-primary rounded-pill px-3 btn-sm" onclick="window.print()">
                  <i class="bi bi-printer me-1"></i> Print Summary Report
                </button>
                <a href="/reports/workbench?projectId=<%= project.id %>" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                  <i class="bi bi-table me-1"></i> Advanced Query in Workbench
                </a>
              </div>
            </div>
          </div>
        </div>

        <h6 class="fw-bold text-dark mb-2">Project Cost Subledger Transactions (<%= (subledgerCosts || []).length %>)</h6>
        <div class="table-responsive border rounded-3 bg-white">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
              <tr>
                <th class="ps-3">Date</th>
                <th>Category</th>
                <th>Source Type</th>
                <th>Source Reference</th>
                <th>Quantity</th>
                <th>Description</th>
                <th class="pe-3 text-end">Amount (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% if (subledgerCosts && subledgerCosts.length > 0) { %>
                <% subledgerCosts.forEach(sc => { %>
                  <tr>
                    <td class="ps-3 small text-muted"><%= new Date(sc.costDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                    <td><span class="badge bg-light text-dark border"><%= sc.category %></span></td>
                    <td class="small font-monospace"><%= sc.sourceType %></td>
                    <td class="small font-monospace text-primary"><%= sc.sourceReference %></td>
                    <td class="small text-muted"><%= sc.quantity ? `${sc.quantity} ${sc.unit || ''}` : '—' %></td>
                    <td class="small"><%= sc.description || '—' %></td>
                    <td class="pe-3 text-end fw-bold text-danger">₹<%= parseFloat(sc.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-4 text-muted">No subledger entries recorded.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- 10. UNIFIED ACTIVITY TIMELINE TAB -->
      <div class="tab-pane fade" id="tab-activity" role="tabpanel">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
          <div>
            <h6 class="fw-bold mb-0">Unified Chronological Activity Timeline</h6>
            <span class="text-muted small">Project records, invoices, customer and supplier payments, labour, costs, documents, and audit changes in date order.</span>
          </div>
          <div class="d-flex align-items-center gap-3">
            <label class="visually-hidden" for="projectActivitySearch">Search project activity</label>
            <input type="search" id="projectActivitySearch" class="form-control form-control-sm project-activity-search" placeholder="Search activity..." autocomplete="off">
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill font-monospace text-nowrap" id="projectActivityResultCount">
              <%= (timelineEvents || []).length %> events
            </span>
          </div>
        </div>

        <% if (timelineEvents && timelineEvents.length > 0) { %>
          <div class="project-timeline">
            <% timelineEvents.forEach(evt => { %>
              <div class="project-timeline-item" data-project-activity data-event-search="<%= [evt.badge, evt.title, evt.description, evt.actor, evt.status].filter(Boolean).join(' ').toLowerCase() %>">
                <div class="project-timeline-dot"></div>
                <div class="card project-timeline-card border-0 shadow-sm p-3 bg-white rounded-3">
                  <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-1">
                    <div class="d-flex align-items-center gap-2">
                      <span class="badge project-event-type rounded-pill px-2 small">
                        <%= evt.badge %>
                      </span>
                      <h6 class="fw-bold mb-0 text-dark"><%= evt.title %></h6>
                    </div>
                    <span class="small text-muted font-monospace">
                      <i class="bi bi-clock me-1"></i><%= new Date(evt.date).toLocaleString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                  </div>
                  <p class="text-muted small mb-2"><%= evt.description %></p>
                  <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                      <span><i class="bi bi-person me-1"></i><%= evt.actor || 'System' %></span>
                      <% if (evt.status) { %>
                        <span class="badge bg-light text-dark border"><%= evt.status %></span>
                      <% } %>
                    </div>
                    <% if (evt.link) { %>
                      <a href="<%= evt.link %>" class="text-decoration-none fw-semibold text-primary">
                        View Details <i class="bi bi-arrow-right ms-1"></i>
                      </a>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
          <div class="text-center text-muted small py-4 d-none" id="projectActivityNoMatches">No activity matches your search.</div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-clock-history display-5 d-block mb-2 text-secondary opacity-50"></i>
            No lifecycle activity recorded for this project yet.
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- ============================================================== -->
<!-- INTERACTIVE MODALS -->
<!-- ============================================================== -->

<!-- 1. Modal: Register Supplier Bill -->
<div class="modal fade" id="modal-register-bill" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold"><i class="bi bi-receipt text-primary me-2"></i>Register Supplier Bill for <%= project.code %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="form-register-bill">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Internal Bill # <span class="text-danger">*</span></label>
              <input type="text" id="bill-number" class="form-control form-control-sm" placeholder="e.g. SBILL-2026-0042" required />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Supplier External Invoice #</label>
              <input type="text" id="bill-ext-inv" class="form-control form-control-sm" placeholder="e.g. SME/26-27/6244" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Supplier / Vendor <span class="text-danger">*</span></label>
              <select id="bill-supplier" class="form-select form-select-sm" required>
                <option value="">Select supplier...</option>
                <% (helpers.suppliers || []).forEach(s => { %>
                  <option value="<%= s.id %>" data-gstin="<%= s.gstin || '' %>" data-state="<%= s.stateCode || '' %>"><%= s.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Bill Date <span class="text-danger">*</span></label>
              <input type="date" id="bill-date" class="form-control form-control-sm" value="<%= new Date().toISOString().split('T')[0] %>" required />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Taxable Subtotal (₹) <span class="text-danger">*</span></label>
              <input type="number" step="0.01" id="bill-taxable" class="form-control form-control-sm" placeholder="0.00" required />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">GST Rate (%)</label>
              <select id="bill-gst-rate" class="form-select form-select-sm">
                <option value="18">18% (Standard GST)</option>
                <option value="12">12%</option>
                <option value="5">5%</option>
                <option value="28">28%</option>
                <option value="0">0% (Nil / Exempt)</option>
              </select>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Charges / Cartage (₹)</label>
              <input type="number" step="0.01" id="bill-charges" class="form-control form-control-sm" value="0.00" />
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Round-Off (₹)</label>
              <input type="number" step="0.01" id="bill-roundoff" class="form-control form-control-sm" value="0.00" />
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Attach Invoice File (PDF/Image)</label>
              <input type="file" id="bill-file" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg,.webp" />
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3" id="btn-submit-bill">Save & Post Bill</button>
        </div>
      </form>
    </div>
  </div>
</div>

