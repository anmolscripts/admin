// 6. Upload Attachment Handler
const uploadAttachmentForm = document.getElementById('form-upload-attachment');
const attachmentFileInput = document.getElementById('att-file');
const attachmentDropzone = document.getElementById('att-dropzone');
const attachmentFileList = document.getElementById('att-file-list');
const attachmentUploadFeedback = document.getElementById('att-upload-feedback');
let selectedAttachmentFiles = [];

function renderSelectedAttachmentFiles() {
  attachmentFileList.replaceChildren();
  if (selectedAttachmentFiles.length === 0) {
    attachmentFileList.textContent = 'No files selected.';
    return;
  }

  selectedAttachmentFiles.forEach(file => {
    const fileRow = document.createElement('div');
    fileRow.className = 'd-flex align-items-center gap-2';
    const icon = document.createElement('i');
    icon.className = 'bi bi-file-earmark';
    const name = document.createElement('span');
    name.className = 'text-break';
    name.textContent = `${file.name} (${(file.size / (1024 * 1024)).toFixed(2)} MB)`;
    fileRow.append(icon, name);
    attachmentFileList.appendChild(fileRow);
  });
}

attachmentDropzone.addEventListener('click', event => {
  if (event.target !== attachmentFileInput && !event.target.closest('label')) {
    attachmentFileInput.click();
  }
});
attachmentDropzone.addEventListener('keydown', event => {
  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault();
    attachmentFileInput.click();
  }
});
attachmentDropzone.addEventListener('dragover', event => {
  event.preventDefault();
  attachmentDropzone.classList.add('is-dragging');
});
attachmentDropzone.addEventListener('dragleave', event => {
  if (!attachmentDropzone.contains(event.relatedTarget)) {
    attachmentDropzone.classList.remove('is-dragging');
  }
});
attachmentDropzone.addEventListener('drop', event => {
  event.preventDefault();
  attachmentDropzone.classList.remove('is-dragging');
  selectedAttachmentFiles = Array.from(event.dataTransfer.files);
  attachmentUploadFeedback.className = 'alert d-none mt-2 mb-0 small';
  renderSelectedAttachmentFiles();
});
attachmentFileInput.addEventListener('change', () => {
  selectedAttachmentFiles = Array.from(attachmentFileInput.files || []);
  attachmentFileInput.value = '';
  attachmentUploadFeedback.className = 'alert d-none mt-2 mb-0 small';
  renderSelectedAttachmentFiles();
});

uploadAttachmentForm.addEventListener('submit', async function(e) {
  e.preventDefault();
  attachmentUploadFeedback.className = 'alert d-none mt-2 mb-0 small';
  attachmentUploadFeedback.textContent = '';
  if (selectedAttachmentFiles.length === 0) {
    attachmentUploadFeedback.className = 'alert alert-danger mt-2 mb-0 small';
    attachmentUploadFeedback.textContent = 'Choose or drop at least one file to upload.';
    return;
  }

  const oversizedFile = selectedAttachmentFiles.find(file => file.size > 15 * 1024 * 1024);
  if (oversizedFile) {
    attachmentUploadFeedback.className = 'alert alert-danger mt-2 mb-0 small';
    attachmentUploadFeedback.textContent = `${oversizedFile.name} exceeds the 15MB per-file limit.`;
    return;
  }

  const btn = document.getElementById('btn-submit-att');
  btn.disabled = true;
  const title = document.getElementById('att-title').value.trim();
  let uploadedCount = 0;

  try {
    for (let index = 0; index < selectedAttachmentFiles.length; index++) {
      const file = selectedAttachmentFiles[index];
      btn.textContent = `Uploading ${index + 1} of ${selectedAttachmentFiles.length}...`;

      const formData = new FormData();
      formData.append('file', file);
      formData.append('entityType', document.getElementById('att-entity-type').value);
      formData.append('projectId', projectId);
      formData.append('title', selectedAttachmentFiles.length > 1 ? `${title} - ${file.name}`.slice(0, 255) : title);
      formData.append('category', document.getElementById('att-category').value);
      formData.append('referenceNumber', document.getElementById('att-reference-number').value.trim());
      formData.append('description', document.getElementById('att-description').value.trim());
      formData.append('issueDate', document.getElementById('att-issue-date').value || '');
      formData.append('expiryDate', document.getElementById('att-expiry-date').value || '');

      const response = await fetch(`/api/projects/${projectId}/attachments`, {
        method: 'POST',
        headers: { 'CSRF-Token': csrfToken },
        body: formData
      });
      const result = await response.json();
      if (!response.ok || !result.success) {
        throw new Error(`${file.name}: ${result.error || 'Upload failed.'}`);
      }
      uploadedCount++;
    }
    window.location.reload();
  } catch (err) {
    if (uploadedCount > 0) {
      alert(`Uploaded ${uploadedCount} of ${selectedAttachmentFiles.length} files. ${err.message} The project page will refresh to show completed uploads.`);
      window.location.reload();
      return;
    }
    attachmentUploadFeedback.className = 'alert alert-danger mt-2 mb-0 small';
    attachmentUploadFeedback.textContent = err.message || 'Communication error while uploading files.';
  } finally {
    btn.disabled = false;
    btn.textContent = 'Upload Securely';
  }
});

