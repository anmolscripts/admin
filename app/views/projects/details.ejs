<!-- Page JavaScript Handlers -->
<script>
const projectId = document.getElementById('project-id').value;
const csrfToken = document.getElementById('csrf-token').value;

// Persist the selected workspace section and vertical position across navigation.
const projectTabNav = document.getElementById('projectTab');
const projectViewStorageKey = `spark:project-view:${projectId}`;
let savedProjectView = null;
try {
  const storedView = sessionStorage.getItem(projectViewStorageKey);
  savedProjectView = storedView ? JSON.parse(storedView) : null;
} catch (error) {
  console.warn('Unable to restore the previous project view state.', error);
}

function saveProjectViewState() {
  const activeTab = projectTabNav && projectTabNav.querySelector('.nav-link.active');
  const tabId = activeTab && activeTab.dataset.bsTarget
    ? activeTab.dataset.bsTarget.slice(1)
    : 'tab-overview';
  try {
    sessionStorage.setItem(projectViewStorageKey, JSON.stringify({ tabId, scrollY: window.scrollY }));
  } catch (error) {
    console.warn('Unable to save the current project view state.', error);
  }
}

function setProjectViewHash(tabId) {
  const url = new URL(window.location.href);
  url.hash = tabId;
  window.history.replaceState(null, '', url);
}

function restoreProjectScroll() {
  const scrollY = Number(savedProjectView && savedProjectView.scrollY);
  if (Number.isFinite(scrollY) && scrollY >= 0) {
    window.requestAnimationFrame(() => window.scrollTo({ top: scrollY, behavior: 'auto' }));
  }
}

if (projectTabNav) {
  projectTabNav.addEventListener('shown.bs.tab', (event) => {
    if (!projectTabNav.contains(event.target)) return;
    const tabId = event.target.dataset.bsTarget.slice(1);
    setProjectViewHash(tabId);
    saveProjectViewState();
  });

  function getProjectPaneChain(target) {
    const panes = [];
    let pane = target && target.closest('.tab-pane');
    while (pane) {
      panes.unshift(pane);
      pane = pane.parentElement ? pane.parentElement.closest('.tab-pane') : null;
    }
    return panes;
  }

  function activateProjectPaneChain(panes, index, onComplete) {
    if (index >= panes.length) {
      onComplete();
      return;
    }
    const pane = panes[index];
    const button = Array.from(document.querySelectorAll('[data-bs-toggle="tab"], [data-bs-toggle="pill"]'))
      .find((candidate) => candidate.dataset.bsTarget === `#${pane.id}`);
    if (!button || button.classList.contains('active')) {
      activateProjectPaneChain(panes, index + 1, onComplete);
      return;
    }
    button.addEventListener('shown.bs.tab', () => {
      activateProjectPaneChain(panes, index + 1, onComplete);
    }, { once: true });
    bootstrap.Tab.getOrCreateInstance(button).show();
  }

  document.querySelectorAll('.project-timeline a[href^="#project-"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      const panes = getProjectPaneChain(target);
      if (!target || !panes.length) return;

      event.preventDefault();
      const jumpToTarget = () => {
        window.requestAnimationFrame(() => {
          target.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            block: 'center'
          });
          setProjectViewHash(target.id);
          saveProjectViewState();
        });
      };
      activateProjectPaneChain(panes, 0, jumpToTarget);
    });
  });

  const activitySearch = document.getElementById('projectActivitySearch');
  const activityItems = Array.from(document.querySelectorAll('[data-project-activity]'));
  const activityCount = document.getElementById('projectActivityResultCount');
  const activityNoMatches = document.getElementById('projectActivityNoMatches');
  if (activitySearch && activityCount) {
    const filterActivity = () => {
      const query = activitySearch.value.trim().toLowerCase();
      let visible = 0;
      for (const item of activityItems) {
        const matches = !query || item.dataset.eventSearch.includes(query);
        item.classList.toggle('d-none', !matches);
        if (matches) visible++;
      }
      activityCount.textContent = query ? `${visible} of ${activityItems.length} events` : `${activityItems.length} events`;
      if (activityNoMatches) activityNoMatches.classList.toggle('d-none', visible > 0);
    };
    activitySearch.addEventListener('input', filterActivity);
  }

  const restoreProjectView = () => {
    const hashTarget = document.getElementById(window.location.hash.slice(1));
    const hashPanes = getProjectPaneChain(hashTarget);
    const storedPane = savedProjectView && document.getElementById(savedProjectView.tabId);
    const panesToRestore = hashPanes.length
      ? hashPanes
      : (storedPane && storedPane.classList.contains('tab-pane') ? [storedPane] : []);
    activateProjectPaneChain(panesToRestore, 0, () => {
      if (hashTarget && hashTarget !== panesToRestore[panesToRestore.length - 1]) {
        hashTarget.scrollIntoView({ behavior: 'auto', block: 'center' });
      } else {
        restoreProjectScroll();
      }
    });
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', restoreProjectView, { once: true });
  } else {
    restoreProjectView();
  }

  let projectScrollSaveTimer = null;
  window.addEventListener('scroll', () => {
    window.clearTimeout(projectScrollSaveTimer);
    projectScrollSaveTimer = window.setTimeout(saveProjectViewState, 120);
  }, { passive: true });
  window.addEventListener('pagehide', () => {
    window.clearTimeout(projectScrollSaveTimer);
    saveProjectViewState();
  });
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) restoreProjectScroll();
  });
}

// 1. Register Supplier Bill Handler
document.getElementById('form-register-bill').addEventListener('submit', async function(e) {
  e.preventDefault();
  const btn = document.getElementById('btn-submit-bill');
  btn.disabled = true;

  const supplierSelect = document.getElementById('bill-supplier');
  const selectedOpt = supplierSelect.options[supplierSelect.selectedIndex];

  const payload = {
    billNumber: document.getElementById('bill-number').value.trim(),
    externalInvoiceNumber: document.getElementById('bill-ext-inv').value.trim(),
    supplierId: parseInt(supplierSelect.value, 10),
    supplierName: selectedOpt ? selectedOpt.text : '',
    supplierGSTIN: selectedOpt ? selectedOpt.getAttribute('data-gstin') : '',
    supplierStateCode: selectedOpt ? selectedOpt.getAttribute('data-state') : '',
    billDate: document.getElementById('bill-date').value,
    projectId: parseInt(projectId, 10),
    gstRate: parseFloat(document.getElementById('bill-gst-rate').value) || 0,
    chargesAmount: parseFloat(document.getElementById('bill-charges').value) || 0,
    roundOff: parseFloat(document.getElementById('bill-roundoff').value) || 0,
    items: [
      {
        name: `Project Procurement (${document.getElementById('bill-ext-inv').value || 'Bill'})`,
        quantity: 1,
        unit: 'LOT',
        rate: parseFloat(document.getElementById('bill-taxable').value) || 0,
        projectId: parseInt(projectId, 10),
        costCode: 'MATERIALS'
      }
    ]
  };

  try {
    const fileInput = document.getElementById('bill-file');
    if (fileInput.files.length > 0) {
      const formData = new FormData();
      formData.append('file', fileInput.files[0]);
      formData.append('entityType', 'SUPPLIER_INVOICE');
      formData.append('projectId', projectId);

      const attRes = await fetch(`/api/projects/${projectId}/attachments`, {
        method: 'POST',
        headers: { 'CSRF-Token': csrfToken },
        body: formData
      });
      const attData = await attRes.json();
      if (attRes.ok && attData.success) {
        payload.attachmentId = attData.attachment.id;
      }
    }

    const res = await fetch('/api/supplier-bills', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'CSRF-Token': csrfToken
      },
      body: JSON.stringify(payload)
    });

    const data = await res.json();
    if (res.ok && data.success) {
      window.location.reload();
    } else {
      alert(data.error || 'Failed to post supplier bill.');
      btn.disabled = false;
    }
  } catch (err) {
    alert('Communication error: ' + err.message);
    btn.disabled = false;
  }
});

