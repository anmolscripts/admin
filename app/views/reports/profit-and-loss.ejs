<%
  const plHeaderAction = `
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-printer"></i>
        <span>Print Statement</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: pageTitle || 'Profit & Loss Statement',
    pageSubtitle: pageSubtitle || 'Summary of operating revenues, expenses, and net profit or loss.',
    headerAction: plHeaderAction
}) %>

<div class="content-wrapper p-4">

  <!-- Filters Toolbar (Glass Panel) -->
  <div class="card-glass p-3 mb-4">
    <form method="GET" action="/reports/profit-and-loss" class="row g-2 align-items-center">
      <!-- FY Filter -->
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Financial Year</label>
        <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All Financial Years</option>
          <% if (locals.financialYears) { %>
            <% financialYears.forEach(fy => { %>
              <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                <%= fy.code %> (<%= fy.status %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- From Date -->
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">From Date</label>
        <input type="date" name="fromDate" class="form-control form-control-sm" value="<%= filters.fromDate || '' %>">
      </div>

      <!-- To Date -->
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">To Date</label>
        <input type="date" name="toDate" class="form-control form-control-sm" value="<%= filters.toDate || '' %>">
      </div>

      <!-- Actions -->
      <div class="col-md-3 d-flex align-items-end gap-2 pt-2">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1 rounded-pill">Apply Filter</button>
        <a href="/reports/profit-and-loss" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Reset">
          <i class="bi bi-arrow-counterclockwise"></i> Reset
        </a>
      </div>
    </form>
  </div>

  <!-- Net Result Summary Banner (Glass Card) -->
  <div class="card-glass p-4 mb-4" style="background: <%= report.summary.isProfit ? 'linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(59, 130, 246, 0.08) 100%)' : 'linear-gradient(135deg, rgba(239, 68, 68, 0.12) 0%, rgba(245, 158, 11, 0.08) 100%)' %>; border-left: 5px solid <%= report.summary.isProfit ? 'var(--sa-teal, #10B981)' : 'var(--sa-status-danger, #EF4444)' %>;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="text-uppercase small fw-bold" style="color: <%= report.summary.isProfit ? '#059669' : '#DC2626' %>; letter-spacing: 0.6px;">
          <i class="bi <%= report.summary.isProfit ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' %> me-1"></i>
          <%= report.summary.isProfit ? 'Net Operating Profit' : 'Net Operating Loss' %>
        </div>
        <div class="fs-1 fw-bold mt-1" style="color: <%= report.summary.isProfit ? '#065F46' : '#991B1B' %>;">
          ₹<%= parseFloat(report.summary.netProfitOrLoss).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
        </div>
        <div class="small text-muted mt-1">
          Net Revenue (₹<%= parseFloat(report.summary.totalIncome).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>) minus Total Operating Expenses (₹<%= parseFloat(report.summary.totalExpenses).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>)
        </div>
      </div>
      <div class="d-flex gap-4 text-end">
        <div>
          <div class="small text-muted">Gross Profit</div>
          <div class="fs-4 fw-bold text-dark">₹<%= parseFloat(report.grossProfit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        </div>
        <div>
          <div class="small text-muted">Cost of Goods Sold</div>
          <div class="fs-4 fw-bold text-secondary">₹<%= parseFloat(report.cogs.totalCOGS).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- P&L Visual Breakdown Row (ApexCharts) -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-lg-7">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Operating Performance Comparison</div>
            <div class="chart-subtitle">Revenue, COGS, expenses, and resulting profit</div>
          </div>
          <i class="bi bi-bar-chart-line text-muted"></i>
        </div>
        <div id="chart-pnl-waterfall" style="min-height: 280px;"></div>
      </div>
    </div>
    <div class="col-12 col-lg-5">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Expense Allocation by Account</div>
            <div class="chart-subtitle">Direct breakdown of operational cost centres</div>
          </div>
          <i class="bi bi-pie-chart text-muted"></i>
        </div>
        <div id="chart-pnl-expenses-donut" style="min-height: 280px;"></div>
      </div>
    </div>
  </div>

  <!-- Detailed P&L Statement Tables (Glass Panels) -->
  <div class="row g-4 mb-4">
    <!-- REVENUE / INCOME -->
    <div class="col-lg-6">
      <div class="card-glass overflow-hidden h-100">
        <div class="py-3 px-4 border-bottom bg-white d-flex align-items-center justify-content-between">
          <h6 class="fw-bold mb-0 text-primary">
            <i class="bi bi-arrow-up-right-circle me-2"></i>Operating Revenue & Income
          </h6>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Account Group 4000</span>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Account</th>
                <th class="text-end pe-4">Amount (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.revenue.items.forEach(item => { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold text-dark"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %> <%= item.isContra ? '(Contra-Revenue)' : '' %></div>
                  </td>
                  <td class="text-end pe-4 fw-bold <%= item.isContra ? 'text-danger' : 'text-success' %>">
                    <%= item.isContra ? '- ₹' + parseFloat(item.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '₹' + parseFloat(item.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th class="ps-4 py-3">Gross Operating Revenue:</th>
                <th class="text-end pe-4 py-3 text-dark">
                  ₹<%= parseFloat(report.revenue.grossRevenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <% if (parseFloat(report.revenue.salesReturns) > 0) { %>
                <tr>
                  <th class="ps-4 py-2 text-danger small">Less: Sales Returns & Rebates:</th>
                  <th class="text-end pe-4 py-2 text-danger small">
                    - ₹<%= parseFloat(report.revenue.salesReturns).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </th>
                </tr>
              <% } %>
              <tr class="table-primary text-primary">
                <th class="ps-4 py-3 fs-6">Net Operating Revenue:</th>
                <th class="text-end pe-4 py-3 fs-6">
                  ₹<%= parseFloat(report.revenue.netRevenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- EXPENSES & COST OF SALES -->
    <div class="col-lg-6">
      <div class="card-glass overflow-hidden h-100">
        <div class="py-3 px-4 border-bottom bg-white d-flex align-items-center justify-content-between">
          <h6 class="fw-bold mb-0 text-danger">
            <i class="bi bi-arrow-down-left-circle me-2"></i>Cost of Sales & Expenses
          </h6>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Account Group 5000</span>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Expense Category</th>
                <th class="text-end pe-4">Amount (₹)</th>
              </tr>
            </thead>
            <tbody>
              <!-- COGS Subheading -->
              <tr class="table-light">
                <td colspan="2" class="ps-4 py-2 fw-bold text-uppercase small text-muted">Cost of Goods Sold (COGS)</td>
              </tr>
              <% if (report.cogs.items.length === 0) { %>
                <tr>
                  <td class="ps-4 text-muted small fst-italic">No direct material costs recorded</td>
                  <td class="text-end pe-4 text-muted small">₹0.00</td>
                </tr>
              <% } else { %>
                <% report.cogs.items.forEach(c => { %>
                  <tr>
                    <td class="ps-4">
                      <div class="fw-semibold text-dark"><%= c.name %></div>
                      <div class="small text-muted font-monospace"><%= c.code %></div>
                    </td>
                    <td class="text-end pe-4 fw-bold text-danger">
                      ₹<%= parseFloat(c.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>

              <!-- Operating Expenses Subheading -->
              <tr class="table-light">
                <td colspan="2" class="ps-4 py-2 fw-bold text-uppercase small text-muted">Operating & Administrative Expenses</td>
              </tr>
              <% report.operatingExpenses.items.forEach(e => { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold text-dark"><%= e.name %></div>
                    <div class="small text-muted font-monospace"><%= e.code %></div>
                  </td>
                  <td class="text-end pe-4 fw-bold text-danger">
                    ₹<%= parseFloat(e.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th class="ps-4 py-3">Total Cost of Sales:</th>
                <th class="text-end pe-4 py-3 text-dark">
                  ₹<%= parseFloat(report.cogs.totalCOGS).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <tr>
                <th class="ps-4 py-3">Total Operating Expenses:</th>
                <th class="text-end pe-4 py-3 text-dark">
                  ₹<%= parseFloat(report.operatingExpenses.totalExpenses).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <tr class="table-danger text-danger">
                <th class="ps-4 py-3 fs-6">Total Expenses:</th>
                <th class="text-end pe-4 py-3 fs-6">
                  ₹<%= parseFloat(report.summary.totalExpenses).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer', {
  extraJs: `
    <script>
      (function() {
        if (!window.ApexCharts) return;

        // 1. Operating Performance Bar Chart
        const revenue = ${parseFloat(report.revenue.netRevenue) || 0};
        const cogs = ${parseFloat(report.cogs.totalCOGS) || 0};
        const expenses = ${parseFloat(report.operatingExpenses.totalExpenses) || 0};
        const grossProfit = ${parseFloat(report.grossProfit) || 0};
        const netProfit = ${parseFloat(report.summary.netProfitOrLoss) || 0};

        const barOptions = {
          series: [{
            name: 'Amount (₹)',
            data: [revenue, cogs, expenses, grossProfit, netProfit]
          }],
          chart: {
            type: 'bar',
            height: 280,
            toolbar: { show: false },
            fontFamily: 'inherit'
          },
          plotOptions: {
            bar: {
              distributed: true,
              borderRadius: 5,
              columnWidth: '45%'
            }
          },
          colors: ['#16B8AF', '#65BCE8', '#FF896F', '#135E5A', netProfit >= 0 ? '#B8F16A' : '#FF896F'],
          dataLabels: { enabled: false },
          xaxis: {
            categories: ['Net Revenue', 'COGS', 'Expenses', 'Gross Profit', 'Net Profit/Loss'],
            labels: { style: { fontSize: '11px', colors: '#64748B' } }
          },
          yaxis: {
            labels: {
              formatter: function(val) {
                return '₹' + (Math.abs(val) >= 1000 ? (val / 1000).toFixed(0) + 'k' : val.toFixed(0));
              },
              style: { fontSize: '11px', colors: '#64748B' }
            }
          },
          grid: {
            borderColor: 'rgba(226, 232, 240, 0.7)',
            strokeDashArray: 4
          },
          legend: { show: false },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          }
        };

        const waterfallEl = document.getElementById('chart-pnl-waterfall');
        if (waterfallEl) {
          const chart = new ApexCharts(waterfallEl, barOptions);
          chart.render();
        }

        // 2. Expense Structure Donut Chart
        const expenseItems = ${JSON.stringify(report.operatingExpenses.items || [])};
        const expenseLabels = expenseItems.map(i => i.name);
        const expenseAmounts = expenseItems.map(i => parseFloat(i.amount) || 0);
        const hasExpenses = expenseAmounts.some(v => v > 0);

        const expenseDonutOptions = {
          series: hasExpenses ? expenseAmounts : [],
          labels: hasExpenses ? expenseLabels : [],
          chart: {
            type: 'donut',
            height: 280,
            fontFamily: 'inherit'
          },
          colors: ['#16B8AF', '#65BCE8', '#9B8AFB', '#FF896F', '#B8F16A', '#135E5A'],
          plotOptions: {
            pie: {
              donut: {
                size: '72%',
                labels: {
                  show: true,
                  total: {
                    show: true,
                    label: 'Total Expenses',
                    fontSize: '11px',
                    formatter: function(w) {
                      const sum = w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                      return '₹' + (sum >= 1000 ? (sum / 1000).toFixed(1) + 'k' : sum.toFixed(0));
                    }
                  }
                }
              }
            }
          },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', fontSize: '11px', labels: { colors: '#64748B' } },
          stroke: { width: 2, colors: ['#ffffff'] },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          },
          noData: { text: 'No operating expenses in period', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
        };

        const donutEl = document.getElementById('chart-pnl-expenses-donut');
        if (donutEl) {
          const chart = new ApexCharts(donutEl, expenseDonutOptions);
          chart.render();
        }
      })();
    </script>
  `
}) %>
