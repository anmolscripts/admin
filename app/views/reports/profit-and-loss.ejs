<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-printer"></i>
        <span>Print Statement</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/reports/profit-and-loss" class="row g-2 align-items-center">
        <!-- FY Filter -->
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Financial Year</label>
          <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Financial Years</option>
            <% if (locals.financialYears) { %>
              <% financialYears.forEach(fy => { %>
                <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                  <%= fy.code %> (<%= fy.status %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- From Date -->
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">From Date</label>
          <input type="date" name="fromDate" class="form-control form-control-sm" value="<%= filters.fromDate || '' %>">
        </div>

        <!-- To Date -->
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">To Date</label>
          <input type="date" name="toDate" class="form-control form-control-sm" value="<%= filters.toDate || '' %>">
        </div>

        <!-- Actions -->
        <div class="col-md-3 d-flex align-items-end gap-2 pt-4">
          <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply</button>
          <a href="/reports/profit-and-loss" class="btn btn-sm btn-outline-secondary" title="Reset">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Net Result Banner -->
  <div class="card border-0 shadow-sm mb-4 <%= report.summary.isProfit ? 'bg-success text-white' : 'bg-danger text-white' %>">
    <div class="card-body p-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div>
        <div class="text-uppercase small fw-bold opacity-75">
          <%= report.summary.isProfit ? 'Net Operating Profit' : 'Net Operating Loss' %>
        </div>
        <div class="fs-2 fw-bold mt-1">
          ₹<%= parseFloat(report.summary.netProfitOrLoss).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
        </div>
        <div class="small opacity-75 mt-1">
          Net Revenue (₹<%= parseFloat(report.summary.totalIncome).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>) minus Total Expenses (₹<%= parseFloat(report.summary.totalExpenses).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>)
        </div>
      </div>
      <div class="d-flex gap-3 text-end">
        <div>
          <div class="small opacity-75">Gross Profit</div>
          <div class="fs-4 fw-bold">₹<%= parseFloat(report.grossProfit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed P&L Statement Tables -->
  <div class="row g-4 mb-4">
    <!-- REVENUE / INCOME -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3">
          <h6 class="fw-bold mb-0 text-primary">
            <i class="bi bi-arrow-up-right-circle me-2"></i>Operating Revenue & Income
          </h6>
        </div>
        <div class="card-body p-0">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Account</th>
                <th class="text-end pe-3">Amount (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.revenue.items.forEach(item => { %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %> <%= item.isContra ? '(Contra-Revenue)' : '' %></div>
                  </td>
                  <td class="text-end pe-3 fw-bold <%= item.isContra ? 'text-danger' : 'text-success' %>">
                    <%= item.isContra ? '- ₹' + parseFloat(item.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '₹' + parseFloat(item.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th class="ps-3 py-3">Gross Operating Revenue:</th>
                <th class="text-end pe-3 py-3 text-dark">
                  ₹<%= parseFloat(report.revenue.grossRevenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <% if (parseFloat(report.revenue.salesReturns) > 0) { %>
                <tr>
                  <th class="ps-3 py-2 text-danger small">Less: Sales Returns & Rebates:</th>
                  <th class="text-end pe-3 py-2 text-danger small">
                    - ₹<%= parseFloat(report.revenue.salesReturns).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </th>
                </tr>
              <% } %>
              <tr class="table-primary text-primary">
                <th class="ps-3 py-3 fs-6">Net Operating Revenue:</th>
                <th class="text-end pe-3 py-3 fs-6">
                  ₹<%= parseFloat(report.revenue.netRevenue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- EXPENSES & COST OF SALES -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3">
          <h6 class="fw-bold mb-0 text-danger">
            <i class="bi bi-arrow-down-left-circle me-2"></i>Cost of Sales & Operating Expenses
          </h6>
        </div>
        <div class="card-body p-0">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Expense Category</th>
                <th class="text-end pe-3">Amount (₹)</th>
              </tr>
            </thead>
            <tbody>
              <!-- COGS Subheading -->
              <tr class="table-light">
                <td colspan="2" class="ps-3 py-2 fw-bold text-uppercase small text-muted">Cost of Goods Sold (COGS)</td>
              </tr>
              <% if (report.cogs.items.length === 0) { %>
                <tr>
                  <td class="ps-3 text-muted small fst-italic">No direct material costs recorded</td>
                  <td class="text-end pe-3 text-muted small">₹0.00</td>
                </tr>
              <% } else { %>
                <% report.cogs.items.forEach(c => { %>
                  <tr>
                    <td class="ps-3">
                      <div class="fw-semibold"><%= c.name %></div>
                      <div class="small text-muted font-monospace"><%= c.code %></div>
                    </td>
                    <td class="text-end pe-3 fw-bold text-danger">
                      ₹<%= parseFloat(c.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } %>

              <!-- Operating Expenses Subheading -->
              <tr class="table-light">
                <td colspan="2" class="ps-3 py-2 fw-bold text-uppercase small text-muted">Operating & Administrative Expenses</td>
              </tr>
              <% report.operatingExpenses.items.forEach(e => { %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold"><%= e.name %></div>
                    <div class="small text-muted font-monospace"><%= e.code %></div>
                  </td>
                  <td class="text-end pe-3 fw-bold text-danger">
                    ₹<%= parseFloat(e.amount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th class="ps-3 py-3">Total Cost of Sales:</th>
                <th class="text-end pe-3 py-3 text-dark">
                  ₹<%= parseFloat(report.cogs.totalCOGS).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <tr>
                <th class="ps-3 py-3">Total Operating Expenses:</th>
                <th class="text-end pe-3 py-3 text-dark">
                  ₹<%= parseFloat(report.operatingExpenses.totalExpenses).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <tr class="table-danger text-danger">
                <th class="ps-3 py-3 fs-6">Total Expenses:</th>
                <th class="text-end pe-3 py-3 fs-6">
                  ₹<%= parseFloat(report.summary.totalExpenses).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
