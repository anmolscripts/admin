<%
  const crHeaderAction = `
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-printer"></i>
        <span>Print Report</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: pageTitle || 'Customer Receivables & Ageing',
    pageSubtitle: pageSubtitle || 'Accounts receivable ageing breakdown and client subledger balance.',
    headerAction: crHeaderAction
}) %>

<div class="content-wrapper p-4">

  <!-- Filters Toolbar (Glass Panel) -->
  <div class="card-glass p-3 mb-4">
    <form method="GET" action="/reports/customer-receivables" class="row g-2 align-items-center">
      <!-- As Of Date -->
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">As-Of Date</label>
        <input type="date" name="asOfDate" class="form-control form-control-sm" value="<%= filters.asOfDate || '' %>">
      </div>

      <!-- Search Customer -->
      <div class="col-md-5">
        <label class="form-label small text-muted mb-1">Search Customer Name</label>
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-white border-end-0 text-muted">
            <i class="bi bi-search"></i>
          </span>
          <input type="text" name="search" class="form-control form-control-sm border-start-0"
                 placeholder="Client name or GSTIN..."
                 value="<%= filters.search || '' %>">
        </div>
      </div>

      <!-- Filter Actions -->
      <div class="col-md-4 d-flex align-items-end gap-2 pt-2">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1 rounded-pill">Apply Filter</button>
        <a href="/reports/customer-receivables" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Reset">
          <i class="bi bi-arrow-counterclockwise"></i> Reset
        </a>
      </div>
    </form>
  </div>

  <!-- Reconciliation Status Banner -->
  <% if (report.summary.isReconciled) { %>
    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm rounded-3" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-shield-check fs-2 text-success"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Customer Subledger Perfectly Reconciled with GL 1121</h6>
          <div class="small">
            Sum of all client subledger balances (₹<%= parseFloat(report.summary.totalSubledger).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>) strictly equals General Ledger Accounts Receivable control account 1121 (₹<%= parseFloat(report.summary.glAccountsReceivable).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>).
          </div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">Reconciled (Diff: ₹0.00)</span>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm rounded-3" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-triangle-fill fs-2 text-warning"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Subledger to General Ledger Discrepancy</h6>
          <div class="small">
            Subledger Total: ₹<%= report.summary.totalSubledger %> vs GL Control Total: ₹<%= report.summary.glAccountsReceivable %> (Difference: ₹<%= report.summary.difference %>).
          </div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">Diff: ₹<%= report.summary.difference %></span>
      </div>
    </div>
  <% } %>

  <!-- Ageing Breakdown KPI Strip (Glass KPI Cards) -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-green"></div>
        <div class="kpi-label">Current (0–30 Days)</div>
        <div class="kpi-value text-success mt-2">₹<%= parseFloat(report.summary.ageingSummary.current).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Recent / on-time billings</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-blue"></div>
        <div class="kpi-label">31–60 Days</div>
        <div class="kpi-value text-primary mt-2">₹<%= parseFloat(report.summary.ageingSummary.days31to60).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Standard credit window</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-amber"></div>
        <div class="kpi-label">61–90 Days</div>
        <div class="kpi-value text-warning mt-2">₹<%= parseFloat(report.summary.ageingSummary.days61to90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Follow-up required</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-red"></div>
        <div class="kpi-label">Over 90 Days</div>
        <div class="kpi-value text-danger mt-2">₹<%= parseFloat(report.summary.ageingSummary.daysOver90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Critical overdue exposure</div>
      </div>
    </div>
  </div>

  <!-- Charts Row: Visual Distribution & Top Debtors -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-lg-5">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Receivables Ageing Distribution</div>
            <div class="chart-subtitle">Proportion of debt by age category</div>
          </div>
          <i class="bi bi-pie-chart text-muted"></i>
        </div>
        <div id="chart-receivables-donut" style="min-height: 270px;"></div>
      </div>
    </div>
    <div class="col-12 col-lg-7">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Top Customer Exposures</div>
            <div class="chart-subtitle">Largest outstanding client balances</div>
          </div>
          <i class="bi bi-bar-chart text-muted"></i>
        </div>
        <div id="chart-top-clients" style="min-height: 270px;"></div>
      </div>
    </div>
  </div>

  <!-- Customer Receivables Table (Glass Panel) -->
  <div class="card-glass overflow-hidden mb-4">
    <div class="py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
      <div>
        <h6 class="fw-bold mb-0 text-dark">Customer Outstanding & Ageing Schedule</h6>
        <span class="text-muted small">Comprehensive subledger debtor breakdown</span>
      </div>
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3"><%= report.clients.length %> Client(s)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">Customer</th>
            <th class="text-end" style="width: 120px;">Invoiced (₹)</th>
            <th class="text-end" style="width: 120px;">Paid (₹)</th>
            <th class="text-end" style="width: 110px;">Adjustments</th>
            <th class="text-end" style="width: 130px;">Outstanding (₹)</th>
            <th class="text-end" style="width: 110px;">0–30d</th>
            <th class="text-end" style="width: 110px;">31–60d</th>
            <th class="text-end" style="width: 110px;">61–90d</th>
            <th class="text-end" style="width: 110px;">90d+</th>
            <th class="text-end pe-4" style="width: 90px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (report.clients.length === 0) { %>
            <tr>
              <td colspan="10" class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2 text-muted"></i>
                <div class="fw-semibold">No customers with receivable balances found</div>
              </td>
            </tr>
          <% } else { %>
            <% report.clients.forEach(c => { %>
              <tr class="cursor-pointer" onclick="window.location.href='/reports/customer-statement/' + <%= c.id %>" title="View Customer Sub-Ledger Statement">
                <td class="ps-4">
                  <a href="/reports/customer-statement/<%= c.id %>" class="fw-bold text-dark text-decoration-none" onclick="event.stopPropagation()">
                    <%= c.name %>
                  </a>
                  <% if (c.gstin) { %>
                    <div class="small text-muted font-monospace"><%= c.gstin %></div>
                  <% } %>
                </td>
                <td class="text-end text-muted small">
                  ₹<%= parseFloat(c.totalInvoiced).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end text-muted small">
                  ₹<%= parseFloat(c.totalPaid).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end text-muted small">
                  <% const netAdj = parseFloat(c.debitNotes) - parseFloat(c.creditNotes); %>
                  <span class="<%= netAdj < 0 ? 'text-danger' : (netAdj > 0 ? 'text-primary' : 'text-muted') %>">
                    <%= netAdj !== 0 ? (netAdj < 0 ? '-₹' + Math.abs(netAdj).toFixed(2) : '+₹' + netAdj.toFixed(2)) : '—' %>
                  </span>
                </td>
                <td class="text-end fw-bold text-dark">
                  ₹<%= parseFloat(c.outstanding).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.current) > 0 ? 'text-success fw-semibold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.current) > 0 ? '₹' + parseFloat(c.ageing.current).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.days31to60) > 0 ? 'text-primary fw-semibold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.days31to60) > 0 ? '₹' + parseFloat(c.ageing.days31to60).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.days61to90) > 0 ? 'text-warning fw-semibold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.days61to90) > 0 ? '₹' + parseFloat(c.ageing.days61to90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.daysOver90) > 0 ? 'text-danger fw-bold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.daysOver90) > 0 ? '₹' + parseFloat(c.ageing.daysOver90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end pe-4">
                  <a href="/reports/customer-statement/<%= c.id %>" class="btn btn-sm btn-light border rounded-circle" title="View Customer Account Statement">
                    <i class="bi bi-file-text"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
        <tfoot class="table-light border-top">
          <tr>
            <th class="ps-4 py-3 fw-bold">Grand Totals:</th>
            <th class="text-end py-3">₹<%= parseFloat(report.summary.totalInvoiced).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3">₹<%= parseFloat(report.summary.totalPaid).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3">—</th>
            <th class="text-end py-3 fs-6 fw-bold text-dark">₹<%= parseFloat(report.summary.totalOutstanding).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-success">₹<%= parseFloat(report.summary.ageingSummary.current).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-primary">₹<%= parseFloat(report.summary.ageingSummary.days31to60).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-warning">₹<%= parseFloat(report.summary.ageingSummary.days61to90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-danger">₹<%= parseFloat(report.summary.ageingSummary.daysOver90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="pe-4"></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<%
  const sortedClients = [...(report.clients || [])]
    .sort((a, b) => parseFloat(b.outstanding) - parseFloat(a.outstanding))
    .slice(0, 5);
  const topClientsNamesJson = JSON.stringify(sortedClients.map(c => c.name));
  const topClientsBalancesJson = JSON.stringify(sortedClients.map(c => parseFloat(c.outstanding) || 0));
%>

<%- include('../layouts/footer', {
  extraJs: `
    <script>
      (function() {
        if (!window.ApexCharts) return;

        // Ageing Donut Chart
        const ageingSeries = [
          ${parseFloat(report.summary.ageingSummary.current) || 0},
          ${parseFloat(report.summary.ageingSummary.days31to60) || 0},
          ${parseFloat(report.summary.ageingSummary.days61to90) || 0},
          ${parseFloat(report.summary.ageingSummary.daysOver90) || 0}
        ];
        const hasAgeingData = ageingSeries.some(v => v > 0);

        const donutOptions = {
          series: hasAgeingData ? ageingSeries : [],
          labels: ['Current (0-30d)', '31-60 Days', '61-90 Days', 'Over 90 Days'],
          chart: {
            type: 'donut',
            height: 270,
            fontFamily: 'inherit'
          },
          colors: ['#B8F16A', '#16B8AF', '#65BCE8', '#FF896F'],
          plotOptions: {
            pie: {
              donut: {
                size: '72%',
                labels: {
                  show: true,
                  total: {
                    show: true,
                    label: 'Outstanding',
                    fontSize: '11px',
                    formatter: function(w) {
                      const sum = w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                      return '₹' + (sum >= 1000 ? (sum / 1000).toFixed(1) + 'k' : sum.toFixed(0));
                    }
                  }
                }
              }
            }
          },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', fontSize: '11px', labels: { colors: '#64748B' } },
          stroke: { width: 2, colors: ['#ffffff'] },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          },
          noData: { text: 'No outstanding debt', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
        };

        const donutEl = document.getElementById('chart-receivables-donut');
        if (donutEl) {
          const donutChart = new ApexCharts(donutEl, donutOptions);
          donutChart.render();
        }

        // Top Clients Exposure Bar Chart
        const topClientsNames = ${topClientsNamesJson};
        const topClientsBalances = ${topClientsBalancesJson};

        const barOptions = {
          series: [{
            name: 'Outstanding Balance',
            data: topClientsBalances
          }],
          chart: {
            type: 'bar',
            height: 270,
            toolbar: { show: false },
            fontFamily: 'inherit'
          },
          colors: ['#16B8AF'],
          plotOptions: {
            bar: {
              horizontal: true,
              borderRadius: 4,
              barHeight: '50%'
            }
          },
          dataLabels: { enabled: false },
          xaxis: {
            categories: topClientsNames,
            labels: {
              formatter: function(val) {
                return '₹' + (val >= 1000 ? (val / 1000).toFixed(0) + 'k' : val.toFixed(0));
              },
              style: { fontSize: '11px', colors: '#64748B' }
            }
          },
          yaxis: {
            labels: { style: { fontSize: '11px', colors: '#64748B' } }
          },
          grid: {
            borderColor: 'rgba(226, 232, 240, 0.7)',
            strokeDashArray: 4
          },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          },
          noData: { text: 'No client debtor balances', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
        };

        const barEl = document.getElementById('chart-top-clients');
        if (barEl) {
          const barChart = new ApexCharts(barEl, barOptions);
          barChart.render();
        }
      })();
    </script>
  `
}) %>
