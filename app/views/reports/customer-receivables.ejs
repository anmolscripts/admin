<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-printer"></i>
        <span>Print Report</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/reports/customer-receivables" class="row g-2 align-items-center">
        <!-- As Of Date -->
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">As-Of Date</label>
          <input type="date" name="asOfDate" class="form-control form-control-sm" value="<%= filters.asOfDate || '' %>">
        </div>

        <!-- Search Customer -->
        <div class="col-md-4">
          <label class="form-label small text-muted mb-1">Search Customer Name</label>
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light border-end-0 text-muted">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" name="search" class="form-control form-control-sm border-start-0"
                   placeholder="Client name or GSTIN..."
                   value="<%= filters.search || '' %>">
          </div>
        </div>

        <!-- Filter Actions -->
        <div class="col-md-3 d-flex align-items-end gap-2 pt-4">
          <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply Filter</button>
          <a href="/reports/customer-receivables" class="btn btn-sm btn-outline-secondary" title="Reset">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Reconciliation Status Banner -->
  <% if (report.summary.isReconciled) { %>
    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-shield-check fs-2 text-success"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Customer Subledger Perfectly Reconciled with GL 1121</h6>
          <div class="small">
            Sum of all client subledger balances (₹<%= parseFloat(report.summary.totalSubledger).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>) strictly equals General Ledger Accounts Receivable control account 1121 (₹<%= parseFloat(report.summary.glAccountsReceivable).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>).
          </div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-success fs-6 px-3 py-2">Reconciled (Diff: ₹0.00)</span>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-triangle-fill fs-2 text-warning"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Subledger to General Ledger Discrepancy</h6>
          <div class="small">
            Subledger Total: ₹<%= report.summary.totalSubledger %> vs GL Control Total: ₹<%= report.summary.glAccountsReceivable %> (Difference: ₹<%= report.summary.difference %>).
          </div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-warning text-dark fs-6 px-3 py-2">Diff: ₹<%= report.summary.difference %></span>
      </div>
    </div>
  <% } %>

  <!-- Ageing Breakdown KPI Strip -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Current (0–30 Days)</div>
          <div class="fs-4 fw-bold text-success mt-1">₹<%= parseFloat(report.summary.ageingSummary.current).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">On time / recent billings</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">31–60 Days</div>
          <div class="fs-4 fw-bold text-primary mt-1">₹<%= parseFloat(report.summary.ageingSummary.days31to60).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Standard credit term</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">61–90 Days</div>
          <div class="fs-4 fw-bold text-warning mt-1">₹<%= parseFloat(report.summary.ageingSummary.days61to90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Follow-up required</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Over 90 Days</div>
          <div class="fs-4 fw-bold text-danger mt-1">₹<%= parseFloat(report.summary.ageingSummary.daysOver90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Critical overdue</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Customer Receivables Table -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0">Customer Outstanding & Ageing Schedule</h6>
      <span class="badge bg-light text-dark border"><%= report.clients.length %> Client(s)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3">Customer</th>
            <th class="text-end" style="width: 120px;">Invoiced (₹)</th>
            <th class="text-end" style="width: 120px;">Paid (₹)</th>
            <th class="text-end" style="width: 110px;">Adjustments</th>
            <th class="text-end" style="width: 130px;">Outstanding (₹)</th>
            <th class="text-end" style="width: 110px;">0–30d</th>
            <th class="text-end" style="width: 110px;">31–60d</th>
            <th class="text-end" style="width: 110px;">61–90d</th>
            <th class="text-end" style="width: 110px;">90d+</th>
            <th class="text-end pe-3" style="width: 90px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (report.clients.length === 0) { %>
            <tr>
              <td colspan="10" class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 d-block mb-2"></i>
                <div class="fw-semibold">No customers with receivable balances found</div>
              </td>
            </tr>
          <% } else { %>
            <% report.clients.forEach(c => { %>
              <tr>
                <td class="ps-3">
                  <a href="/reports/customer-statement/<%= c.id %>" class="fw-bold text-dark text-decoration-none">
                    <%= c.name %>
                  </a>
                  <% if (c.gstin) { %>
                    <div class="small text-muted font-monospace"><%= c.gstin %></div>
                  <% } %>
                </td>
                <td class="text-end text-muted small">
                  ₹<%= parseFloat(c.totalInvoiced).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end text-muted small">
                  ₹<%= parseFloat(c.totalPaid).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end text-muted small">
                  <% const netAdj = parseFloat(c.debitNotes) - parseFloat(c.creditNotes); %>
                  <span class="<%= netAdj < 0 ? 'text-danger' : (netAdj > 0 ? 'text-primary' : 'text-muted') %>">
                    <%= netAdj !== 0 ? (netAdj < 0 ? '-₹' + Math.abs(netAdj).toFixed(2) : '+₹' + netAdj.toFixed(2)) : '—' %>
                  </span>
                </td>
                <td class="text-end fw-bold text-dark">
                  ₹<%= parseFloat(c.outstanding).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.current) > 0 ? 'text-success fw-semibold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.current) > 0 ? '₹' + parseFloat(c.ageing.current).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.days31to60) > 0 ? 'text-primary fw-semibold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.days31to60) > 0 ? '₹' + parseFloat(c.ageing.days31to60).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.days61to90) > 0 ? 'text-warning fw-semibold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.days61to90) > 0 ? '₹' + parseFloat(c.ageing.days61to90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end small <%= parseFloat(c.ageing.daysOver90) > 0 ? 'text-danger fw-bold' : 'text-muted' %>">
                  <%= parseFloat(c.ageing.daysOver90) > 0 ? '₹' + parseFloat(c.ageing.daysOver90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end pe-3">
                  <a href="/reports/customer-statement/<%= c.id %>" class="btn btn-sm btn-outline-primary" title="View Customer Account Statement">
                    <i class="bi bi-file-text"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
        <tfoot class="table-light border-top">
          <tr>
            <th class="ps-3 py-3 fw-bold">Grand Totals:</th>
            <th class="text-end py-3">₹<%= parseFloat(report.summary.totalInvoiced).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3">₹<%= parseFloat(report.summary.totalPaid).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3">—</th>
            <th class="text-end py-3 fs-6 fw-bold text-dark">₹<%= parseFloat(report.summary.totalOutstanding).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-success">₹<%= parseFloat(report.summary.ageingSummary.current).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-primary">₹<%= parseFloat(report.summary.ageingSummary.days31to60).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-warning">₹<%= parseFloat(report.summary.ageingSummary.days61to90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 text-danger">₹<%= parseFloat(report.summary.ageingSummary.daysOver90).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="pe-3"></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
