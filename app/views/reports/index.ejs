<%
  const reportsHeaderAction = `
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <a href="/reports/workbench" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-pill px-3 shadow-xs">
        <i class="bi bi-clipboard-data-fill"></i>
        <span>Analytics Workbench</span>
      </a>
      <a href="/reports/trial-balance" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-scale"></i>
        <span>Trial Balance</span>
      </a>
      <a href="/financial-years" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-calendar2-range"></i>
        <span>Financial Years</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: 'Financial Reports & Accounting',
    pageSubtitle: 'Authoritative double-entry reporting, ledgers, statements, and reconciliation.',
    headerAction: reportsHeaderAction
}) %>

<div class="content-wrapper p-4">
  <!-- SECTION 1: FINANCIAL STATEMENTS -->
  <div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-3">
      <div class="p-2 rounded-3" style="background: rgba(22, 184, 175, 0.12); color: var(--sa-turquoise, #16B8AF);">
        <i class="bi bi-file-earmark-bar-graph fs-5"></i>
      </div>
      <div>
        <h5 class="fw-bold mb-0" style="color: var(--sa-text-main);">Core Financial Statements</h5>
        <span class="small" style="color: var(--sa-text-secondary);">Authoritative financial performance and balance sheet position</span>
      </div>
    </div>

    <div class="row g-4">
      <!-- Profit & Loss Statement -->
      <div class="col-md-6">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(184, 241, 106, 0.18); color: var(--sa-mint-text, #19460E);">
              <i class="bi bi-graph-up fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">Profit & Loss Statement</h5>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Income & Expenses</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            Summary of operating revenues, cost of goods sold, gross margin, operating expenses, and net profit or loss for any selected period.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/profit-and-loss" class="btn btn-sm btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open Profit & Loss</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Balance Sheet -->
      <div class="col-md-6">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(19, 94, 90, 0.14); color: var(--sa-deep-teal, #135E5A);">
              <i class="bi bi-bank fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">Balance Sheet</h5>
              <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Financial Position</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            Statement of financial position showing Total Assets, Total Liabilities, and Equity including retained earnings, verifying Assets = Liabilities + Equity.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/balance-sheet" class="btn btn-sm btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open Balance Sheet</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2: GENERAL LEDGER & AUDIT TRAIL -->
  <div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-3 mt-4">
      <div class="p-2 rounded-3" style="background: rgba(101, 188, 232, 0.14); color: var(--sa-sky-blue, #65BCE8);">
        <i class="bi bi-shield-check fs-5"></i>
      </div>
      <div>
        <h5 class="fw-bold mb-0" style="color: var(--sa-text-main);">General Ledger & Audit Trail</h5>
        <span class="small" style="color: var(--sa-text-secondary);">Double-entry movement journals and fundamental equilibrium verification</span>
      </div>
    </div>

    <div class="row g-4">
      <!-- General Ledger -->
      <div class="col-md-6 col-lg-4">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(22, 184, 175, 0.14); color: var(--sa-turquoise, #16B8AF);">
              <i class="bi bi-book fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">General Ledger</h5>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Account Statements</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            Account-wise chronological transaction movements, opening balances, running balances, and complete double-entry debit/credit activity across the chart of accounts.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/general-ledger" class="btn btn-sm btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open General Ledger</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Trial Balance -->
      <div class="col-md-6 col-lg-4">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(101, 188, 232, 0.14); color: var(--sa-sky-blue, #65BCE8);">
              <i class="bi bi-scale fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">Trial Balance</h5>
              <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Equilibrium Check</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            As-of date account balances verifying the fundamental double-entry invariant: Total Debits must equal Total Credits down to the exact cent across all 5 account classes.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/trial-balance" class="btn btn-sm btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open Trial Balance</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Journal Register -->
      <div class="col-md-6 col-lg-4">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(155, 138, 251, 0.14); color: var(--sa-soft-violet, #9B8AFB);">
              <i class="bi bi-journal-text fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">Journal Register</h5>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Audit & Ledger</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            Complete chronological record of all posted and reversed double-entry transactions with entry lines, debit/credit balance verification, and source links.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/journals" class="btn btn-sm btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open Journal Register</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 3: RECEIVABLES & ANALYTICS -->
  <div class="mb-4">
    <div class="d-flex align-items-center gap-2 mb-3 mt-4">
      <div class="p-2 rounded-3" style="background: rgba(255, 137, 111, 0.14); color: var(--sa-coral, #FF896F);">
        <i class="bi bi-people-fill fs-5"></i>
      </div>
      <div>
        <h5 class="fw-bold mb-0" style="color: var(--sa-text-main);">Receivables & Visual Analytics</h5>
        <span class="small" style="color: var(--sa-text-secondary);">Customer subledger ageing and interactive multidimensional analytics</span>
      </div>
    </div>

    <div class="row g-4">
      <!-- Customer Receivables -->
      <div class="col-md-6 col-lg-4">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(255, 137, 111, 0.14); color: var(--sa-coral, #FF896F);">
              <i class="bi bi-pie-chart fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">Customer Receivables & Ageing</h5>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Ageing & GL 1121</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            Accounts receivable ageing breakdown (0-30, 31-60, 61-90, 90+ days) and cross-reconciliation with General Ledger control account 1121.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/customer-receivables" class="btn btn-sm btn-outline-danger w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open Receivables</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Customer Sub-Ledger Reports & Statements -->
      <div class="col-md-6 col-lg-4">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(2, 132, 199, 0.14); color: var(--sa-primary, #0284c7);">
              <i class="bi bi-person-lines-fill fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">Customer Sub-Ledger</h5>
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Sub-Ledger & Export</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            Chronological customer sub-ledger statements with partial search, date range filtering, opening balances, payment settlements, and CSV export.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/customer-statement" class="btn btn-sm btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open Sub-Ledger</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>

      <!-- Reporting & Analytics Workbench -->
      <div class="col-md-12 col-lg-4">
        <div class="card-glass h-100 p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="p-3 rounded-3" style="background: rgba(22, 184, 175, 0.14); color: var(--sa-turquoise, #16B8AF);">
              <i class="bi bi-clipboard-data-fill fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1" style="color: var(--sa-text-main);">Analytics Workbench</h5>
              <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill">Visual Analytics</span>
            </div>
          </div>
          <p class="small flex-grow-1" style="color: var(--sa-text-secondary); line-height: 1.5;">
            Interactive multi-dimensional financial explorer with revenue trends, document breakdown charts, quotation conversion metrics, and comparative filters.
          </p>
          <div class="pt-3 border-top mt-auto" style="border-color: var(--sa-border) !important;">
            <a href="/reports/workbench" class="btn btn-sm btn-outline-info w-100 d-inline-flex justify-content-center align-items-center gap-2 rounded-pill py-2">
              <span>Open Analytics Workbench</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 4: FINANCIAL YEARS OVERVIEW -->
  <% if (locals.financialYears && financialYears.length > 0) { %>
    <div class="card-glass p-4 mt-4">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div class="d-flex align-items-center gap-2">
          <div class="p-2 rounded-3 bg-primary-subtle text-primary">
            <i class="bi bi-calendar2-range fs-5"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-0" style="color: var(--sa-text-main);">Configured Financial Years & Accounting Periods</h6>
            <span class="small" style="color: var(--sa-text-secondary);">Posting windows, period locking, and opening balance status</span>
          </div>
        </div>
        <a href="/financial-years" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center gap-2">
          <span>Manage Financial Years</span>
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>

      <div class="row g-3">
        <% financialYears.forEach(fy => { %>
          <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="p-3 rounded-3 h-100 d-flex flex-column justify-content-between" style="background: var(--sa-surface-secondary, rgba(255, 255, 255, 0.04)); border: 1px solid var(--sa-border);">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="font-monospace fw-bold" style="color: var(--sa-text-main); font-size: 0.95rem;"><%= fy.code %></span>
                <span class="badge <%= fy.status === 'OPEN' ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-secondary-subtle text-secondary border border-secondary-subtle' %> rounded-pill px-2 py-1"><%= fy.status %></span>
              </div>
              <div class="small" style="color: var(--sa-text-secondary); font-size: 0.78rem;">
                <i class="bi bi-clock-history me-1"></i><%= new Date(fy.startDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> — <%= new Date(fy.endDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>
