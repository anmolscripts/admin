<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <a href="/reports/trial-balance" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-scale"></i>
        <span>Check Trial Balance</span>
      </a>
      <a href="/reports/journals" class="btn btn-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-journal-text"></i>
        <span>View Journal Register</span>
      </a>
    </div>
  </div>

  <!-- Reports Navigation Cards Grid -->
  <div class="row g-4 mb-4">
    <!-- 1. Journal Register -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-3">
              <i class="bi bi-journal-text fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1">Journal Register</h5>
              <span class="badge bg-light text-primary border">Audit & Ledger</span>
            </div>
          </div>
          <p class="text-muted small flex-grow-1">
            Complete chronological record of all posted and reversed double-entry transactions with entry lines, debit/credit balance verification, and source links.
          </p>
          <div class="pt-3 border-top mt-auto">
            <a href="/reports/journals" class="btn btn-sm btn-outline-primary w-100 d-inline-flex justify-content-center align-items-center gap-2">
              <span>Open Journal Register</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 2. General Ledger -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-success bg-opacity-10 text-success p-3 rounded-3">
              <i class="bi bi-book fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1">General Ledger</h5>
              <span class="badge bg-light text-success border">Account Statements</span>
            </div>
          </div>
          <p class="text-muted small flex-grow-1">
            Account-wise chronological transaction movements, opening balances, running balances, and complete double-entry debit/credit activity across the chart of accounts.
          </p>
          <div class="pt-3 border-top mt-auto">
            <a href="/reports/general-ledger" class="btn btn-sm btn-outline-success w-100 d-inline-flex justify-content-center align-items-center gap-2">
              <span>Open General Ledger</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Trial Balance -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-info bg-opacity-10 text-info p-3 rounded-3">
              <i class="bi bi-scale fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1">Trial Balance</h5>
              <span class="badge bg-light text-info border">Equilibrium Check</span>
            </div>
          </div>
          <p class="text-muted small flex-grow-1">
            As-of date account balances verifying the fundamental double-entry invariant: Total Debits must equal Total Credits down to the exact cent across all 5 account classes.
          </p>
          <div class="pt-3 border-top mt-auto">
            <a href="/reports/trial-balance" class="btn btn-sm btn-outline-info w-100 d-inline-flex justify-content-center align-items-center gap-2">
              <span>Open Trial Balance</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 4. Profit & Loss Statement -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-warning bg-opacity-10 text-warning p-3 rounded-3">
              <i class="bi bi-graph-up fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1">Profit & Loss Statement</h5>
              <span class="badge bg-light text-warning border">Income & Expenses</span>
            </div>
          </div>
          <p class="text-muted small flex-grow-1">
            Summary of operating revenues (sales, service, returns), cost of goods sold, gross profit, operating expenses, and net profit or loss for any selected period.
          </p>
          <div class="pt-3 border-top mt-auto">
            <a href="/reports/profit-and-loss" class="btn btn-sm btn-outline-warning w-100 d-inline-flex justify-content-center align-items-center gap-2">
              <span>Open Profit & Loss</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 5. Balance Sheet -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-secondary bg-opacity-10 text-secondary p-3 rounded-3">
              <i class="bi bi-bank fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1">Balance Sheet</h5>
              <span class="badge bg-light text-secondary border">Financial Position</span>
            </div>
          </div>
          <p class="text-muted small flex-grow-1">
            Statement of financial position showing Total Assets, Total Liabilities, and Equity including current period net profit/loss, verifying Assets = Liabilities + Equity.
          </p>
          <div class="pt-3 border-top mt-auto">
            <a href="/reports/balance-sheet" class="btn btn-sm btn-outline-secondary w-100 d-inline-flex justify-content-center align-items-center gap-2">
              <span>Open Balance Sheet</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. Customer Receivables & Subledger -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm hover-shadow transition">
        <div class="card-body p-4 d-flex flex-column">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-danger bg-opacity-10 text-danger p-3 rounded-3">
              <i class="bi bi-people fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1">Customer Receivables</h5>
              <span class="badge bg-light text-danger border">Subledger & Ageing</span>
            </div>
          </div>
          <p class="text-muted small flex-grow-1">
            Accounts receivable ageing breakdown (0-30, 31-60, 61-90, 90+ days), client statements, and full cross-reconciliation with General Ledger control account 1121.
          </p>
          <div class="pt-3 border-top mt-auto">
            <a href="/reports/customer-receivables" class="btn btn-sm btn-outline-danger w-100 d-inline-flex justify-content-center align-items-center gap-2">
              <span>Open Customer Receivables</span>
              <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Filter Box by Financial Year -->
  <% if (locals.financialYears && financialYears.length > 0) { %>
    <div class="card border-0 shadow-sm bg-light">
      <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-calendar3 text-muted"></i>
          <span class="fw-bold small text-muted text-uppercase">Configured Financial Years:</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <% financialYears.forEach(fy => { %>
            <div class="badge bg-white text-dark border p-2 d-inline-flex align-items-center gap-2">
              <span class="fw-bold"><%= fy.code %></span>
              <span class="text-muted small">(<%= new Date(fy.startDate).toLocaleDateString('en-IN') %> to <%= new Date(fy.endDate).toLocaleDateString('en-IN') %>)</span>
              <span class="badge <%= fy.status === 'OPEN' ? 'bg-success' : 'bg-secondary' %>"><%= fy.status %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>
