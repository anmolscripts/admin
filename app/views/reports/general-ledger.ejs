<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-printer"></i>
        <span>Print Ledger</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/reports/general-ledger" class="row g-2 align-items-center">
        <!-- Account Selector -->
        <div class="col-md-4">
          <label class="form-label small text-muted mb-1">Select Account</label>
          <select name="accountId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">— All Accounts Summary —</option>
            <% if (locals.accounts) { %>
              <% accounts.forEach(acc => { %>
                <option value="<%= acc.id %>" <%= selectedAccountId == acc.id ? 'selected' : '' %>>
                  <%= acc.code %> — <%= acc.name %> (<%= acc.type %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Financial Year Filter -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">Financial Year</label>
          <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Financial Years</option>
            <% if (locals.financialYears) { %>
              <% financialYears.forEach(fy => { %>
                <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                  <%= fy.code %> (<%= fy.status %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- From Date -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">From Date</label>
          <input type="date" name="fromDate" class="form-control form-control-sm" value="<%= filters.fromDate || '' %>">
        </div>

        <!-- To Date -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">To Date</label>
          <input type="date" name="toDate" class="form-control form-control-sm" value="<%= filters.toDate || '' %>">
        </div>

        <!-- Actions -->
        <div class="col-md-2 d-flex align-items-end gap-2 pt-4">
          <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply</button>
          <a href="/reports/general-ledger" class="btn btn-sm btn-outline-secondary" title="Reset">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <% if (report.account) { %>
    <!-- SINGLE ACCOUNT STATEMENT VIEW -->
    <!-- Account KPI Summary Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light">
          <div class="card-body p-3">
            <div class="text-muted small text-uppercase fw-bold">Opening Balance</div>
            <div class="fs-4 fw-bold mt-1">₹<%= parseFloat(report.account.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
            <div class="small text-muted"><%= report.account.isDebitNormal ? 'Debit Normal' : 'Credit Normal' %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light">
          <div class="card-body p-3">
            <div class="text-muted small text-uppercase fw-bold">Period Debits</div>
            <div class="fs-4 fw-bold text-primary mt-1">₹<%= parseFloat(report.summary.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
            <div class="small text-muted"><%= report.summary.transactionCount %> transaction(s)</div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light">
          <div class="card-body p-3">
            <div class="text-muted small text-uppercase fw-bold">Period Credits</div>
            <div class="fs-4 fw-bold text-success mt-1">₹<%= parseFloat(report.summary.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
            <div class="small text-muted">Net: ₹<%= parseFloat(report.summary.netMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card border-0 shadow-sm bg-light">
          <div class="card-body p-3">
            <div class="text-muted small text-uppercase fw-bold">Closing Balance</div>
            <div class="fs-4 fw-bold mt-1 text-dark">₹<%= parseFloat(report.account.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
            <div class="small text-muted">As of period end</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Transactions Table -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">Ledger Statement Transactions</h6>
        <span class="badge bg-light text-dark border">Total: <%= report.transactions.length %> entries</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3" style="width: 110px;">Date</th>
              <th style="width: 140px;">Journal #</th>
              <th style="width: 120px;">Source</th>
              <th>Narration / Particulars</th>
              <th>Subledger Client</th>
              <th class="text-end" style="width: 130px;">Debit (₹)</th>
              <th class="text-end" style="width: 130px;">Credit (₹)</th>
              <th class="text-end pe-3" style="width: 140px;">Running Balance (₹)</th>
            </tr>
          </thead>
          <tbody>
            <!-- Opening Balance Row -->
            <tr class="table-light">
              <td class="ps-3 text-muted fst-italic">—</td>
              <td colspan="4" class="fw-semibold text-muted fst-italic">Opening Balance</td>
              <td class="text-end">—</td>
              <td class="text-end">—</td>
              <td class="text-end pe-3 fw-bold">₹<%= parseFloat(report.account.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
            </tr>
            <% if (report.transactions.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">
                  No transaction activity in the selected period.
                </td>
              </tr>
            <% } else { %>
              <% report.transactions.forEach(t => { %>
                <tr>
                  <td class="ps-3 text-nowrap"><%= new Date(t.entryDate).toLocaleDateString('en-IN') %></td>
                  <td>
                    <a href="/reports/journals/<%= t.journalId %>" class="fw-bold text-decoration-none">
                      <%= t.entryNumber %>
                    </a>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= t.sourceType %> <%= t.sourceId ? '#' + t.sourceId : '' %></span>
                  </td>
                  <td>
                    <div class="fw-semibold"><%= t.narration %></div>
                    <% if (t.description) { %>
                      <div class="small text-muted"><%= t.description %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (t.client) { %>
                      <a href="/reports/customer-statement/<%= t.client.id %>" class="fw-semibold text-decoration-none">
                        <%= t.client.name %>
                      </a>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                  <td class="text-end fw-bold text-primary">
                    <%= parseFloat(t.debit) > 0 ? '₹' + parseFloat(t.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="text-end fw-bold text-success">
                    <%= parseFloat(t.credit) > 0 ? '₹' + parseFloat(t.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="text-end pe-3 fw-bold">
                    ₹<%= parseFloat(t.runningBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
          <tfoot class="table-light border-top">
            <tr>
              <th colspan="5" class="text-end ps-3 py-3 fw-bold">Period Totals & Closing Balance:</th>
              <th class="text-end py-3 text-primary fw-bold">
                ₹<%= parseFloat(report.summary.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th class="text-end py-3 text-success fw-bold">
                ₹<%= parseFloat(report.summary.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th class="text-end pe-3 py-3 fw-bold fs-6">
                ₹<%= parseFloat(report.account.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% } else { %>
    <!-- MULTI-ACCOUNT GENERAL LEDGER SUMMARY VIEW -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0">General Ledger Accounts Summary</h6>
        <div class="d-flex align-items-center gap-2">
          <% if (report.summary.isBalanced) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
              <i class="bi bi-check-circle me-1"></i> Equilibrium Verified (Dr = Cr)
            </span>
          <% } %>
          <span class="badge bg-light text-dark border">Total Accounts: <%= report.accounts.length %></span>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3" style="width: 100px;">Code</th>
              <th>Account Name</th>
              <th style="width: 120px;">Type</th>
              <th style="width: 150px;">Subtype</th>
              <th class="text-end" style="width: 130px;">Opening (₹)</th>
              <th class="text-end" style="width: 130px;">Debit (₹)</th>
              <th class="text-end" style="width: 130px;">Credit (₹)</th>
              <th class="text-end" style="width: 140px;">Closing (₹)</th>
              <th class="text-end pe-3" style="width: 90px;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% report.accounts.forEach(acc => { %>
              <tr>
                <td class="ps-3 font-monospace fw-bold"><%= acc.code %></td>
                <td>
                  <a href="?accountId=<%= acc.id %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>" class="fw-bold text-dark text-decoration-none">
                    <%= acc.name %>
                  </a>
                </td>
                <td><span class="badge bg-light text-dark border"><%= acc.type %></span></td>
                <td class="text-muted small"><%= acc.subtype || '—' %></td>
                <td class="text-end">₹<%= parseFloat(acc.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end fw-bold text-primary">₹<%= parseFloat(acc.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end fw-bold text-success">₹<%= parseFloat(acc.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end fw-bold">₹<%= parseFloat(acc.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end pe-3">
                  <a href="?accountId=<%= acc.id %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>" class="btn btn-sm btn-outline-primary" title="View Detailed Account Statement">
                    <i class="bi bi-file-text"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot class="table-light border-top">
            <tr>
              <th colspan="5" class="text-end ps-3 py-3 fw-bold">Total Ledger Movements:</th>
              <th class="text-end py-3 text-primary fw-bold fs-6">
                ₹<%= parseFloat(report.summary.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th class="text-end py-3 text-success fw-bold fs-6">
                ₹<%= parseFloat(report.summary.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th colspan="2" class="text-center py-3">
                <% if (report.summary.isBalanced) { %>
                  <span class="badge bg-success">Balanced</span>
                <% } else { %>
                  <span class="badge bg-danger">Unbalanced</span>
                <% } %>
              </th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% } %>
</div>

<%- include('../layouts/footer') %>
