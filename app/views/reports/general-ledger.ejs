<%
  const glHeaderAction = `
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-printer"></i>
        <span>Print Ledger</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 rounded-pill px-3">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: pageTitle || 'General Ledger',
    pageSubtitle: pageSubtitle || 'Account-wise chronological transaction movements and balances.',
    headerAction: glHeaderAction
}) %>

<div class="content-wrapper p-4">

  <!-- Filters Toolbar (Glass Panel) -->
  <div class="card-glass p-3 mb-4">
    <form method="GET" action="/reports/general-ledger" class="row g-2 align-items-center">
      <!-- Account Selector -->
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Select Account</label>
        <select name="accountId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">— All Accounts Summary —</option>
          <% if (locals.accounts) { %>
            <% accounts.forEach(acc => { %>
              <option value="<%= acc.id %>" <%= selectedAccountId == acc.id ? 'selected' : '' %>>
                <%= acc.code %> — <%= acc.name %> (<%= acc.type %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- Financial Year Filter -->
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Financial Year</label>
        <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All Financial Years</option>
          <% if (locals.financialYears) { %>
            <% financialYears.forEach(fy => { %>
              <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                <%= fy.code %> (<%= fy.status %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- From Date -->
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">From Date</label>
        <input type="date" name="fromDate" class="form-control form-control-sm" value="<%= filters.fromDate || '' %>">
      </div>

      <!-- To Date -->
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">To Date</label>
        <input type="date" name="toDate" class="form-control form-control-sm" value="<%= filters.toDate || '' %>">
      </div>

      <!-- Actions -->
      <div class="col-md-2 d-flex align-items-end gap-2 pt-2">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1 rounded-pill">Apply</button>
        <a href="/reports/general-ledger" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Reset">
          <i class="bi bi-arrow-counterclockwise"></i>
        </a>
      </div>
    </form>
  </div>

  <% if (report.account) { %>
    <!-- SINGLE ACCOUNT STATEMENT VIEW -->
    <!-- Account KPI Summary Cards -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-accent-bar accent-blue"></div>
          <div class="kpi-label">Opening Balance</div>
          <div class="kpi-value mt-2 font-monospace">₹<%= parseFloat(report.account.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="kpi-subtext"><%= report.account.isDebitNormal ? 'Debit Normal' : 'Credit Normal' %></div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-accent-bar accent-cyan"></div>
          <div class="kpi-label">Period Debits</div>
          <div class="kpi-value text-primary mt-2 font-monospace">₹<%= parseFloat(report.summary.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="kpi-subtext"><%= report.summary.transactionCount %> transaction(s)</div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-accent-bar accent-green"></div>
          <div class="kpi-label">Period Credits</div>
          <div class="kpi-value text-success mt-2 font-monospace">₹<%= parseFloat(report.summary.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="kpi-subtext">Net: ₹<%= parseFloat(report.summary.netMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="kpi-card">
          <div class="kpi-accent-bar accent-purple"></div>
          <div class="kpi-label">Closing Balance</div>
          <div class="kpi-value mt-2 font-monospace text-dark">₹<%= parseFloat(report.account.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="kpi-subtext">As of period end</div>
        </div>
      </div>
    </div>

    <!-- Visual Charts Row: Running Balance & Movement -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-lg-8">
        <div class="chart-card">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
              <div class="chart-title">Running Balance Progression</div>
              <div class="chart-subtitle">Historical balance movements across all journal postings</div>
            </div>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">INR (₹)</span>
          </div>
          <div id="chart-gl-balance-trend" style="min-height: 270px;"></div>
        </div>
      </div>
      <div class="col-12 col-lg-4">
        <div class="chart-card">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
              <div class="chart-title">Debit vs Credit Allocation</div>
              <div class="chart-subtitle">Total posted debit vs credit flows</div>
            </div>
            <i class="bi bi-pie-chart text-muted"></i>
          </div>
          <div id="chart-gl-movement-donut" style="min-height: 270px;"></div>
        </div>
      </div>
    </div>

    <!-- Transactions Table (Glass Panel) -->
    <div class="card-glass overflow-hidden mb-4">
      <div class="py-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">Ledger Statement Transactions (<%= report.account.code %> — <%= report.account.name %>)</h6>
        <span class="badge bg-light text-dark border">Total: <%= report.transactions.length %> entries</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4" style="width: 110px;">Date</th>
              <th style="width: 140px;">Journal #</th>
              <th style="width: 120px;">Source</th>
              <th>Narration / Particulars</th>
              <th>Subledger Client</th>
              <th class="text-end" style="width: 130px;">Debit (₹)</th>
              <th class="text-end" style="width: 130px;">Credit (₹)</th>
              <th class="text-end pe-4" style="width: 140px;">Running Balance (₹)</th>
            </tr>
          </thead>
          <tbody>
            <!-- Opening Balance Row -->
            <tr class="table-light">
              <td class="ps-4 text-muted fst-italic">—</td>
              <td colspan="4" class="fw-semibold text-muted fst-italic">Opening Balance</td>
              <td class="text-end text-muted font-monospace">—</td>
              <td class="text-end text-muted font-monospace">—</td>
              <td class="text-end pe-4 fw-bold font-monospace">₹<%= parseFloat(report.account.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
            </tr>

            <% if (report.transactions.length > 0) { %>
              <% report.transactions.forEach(tx => { %>
                <tr>
                  <td class="ps-4 small text-muted"><%= new Date(tx.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                  <td class="font-monospace fw-bold">
                    <a href="/reports/journals/<%= tx.journalId %>" class="text-decoration-none text-primary">
                      <%= tx.journalNumber %>
                    </a>
                  </td>
                  <td>
                    <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 0.7rem;">
                      <%= tx.sourceType %>
                    </span>
                  </td>
                  <td>
                    <div class="text-dark small fw-medium"><%= tx.narration || 'Journal transaction' %></div>
                    <% if (tx.reference) { %>
                      <div class="text-muted" style="font-size: 0.72rem;">Ref: <%= tx.reference %></div>
                    <% } %>
                  </td>
                  <td class="small text-muted"><%= tx.clientName || '—' %></td>
                  <td class="text-end font-monospace <%= tx.debit > 0 ? 'fw-bold text-primary' : 'text-muted' %>">
                    <%= tx.debit > 0 ? '₹' + parseFloat(tx.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="text-end font-monospace <%= tx.credit > 0 ? 'fw-bold text-success' : 'text-muted' %>">
                    <%= tx.credit > 0 ? '₹' + parseFloat(tx.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="text-end pe-4 fw-bold font-monospace text-dark">
                    ₹<%= parseFloat(tx.runningBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">
                  No transaction movements in this period for the selected account.
                </td>
              </tr>
            <% } %>
          </tbody>
          <tfoot class="table-light border-top">
            <tr>
              <th colspan="5" class="text-end ps-4 py-3 fw-bold">Period Movement & Closing Balance:</th>
              <th class="text-end py-3 text-primary fw-bold font-monospace">
                ₹<%= parseFloat(report.summary.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th class="text-end py-3 text-success fw-bold font-monospace">
                ₹<%= parseFloat(report.summary.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th class="text-end pe-4 py-3 fw-bold font-monospace fs-6">
                ₹<%= parseFloat(report.account.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% } else { %>
    <!-- MULTI-ACCOUNT GENERAL LEDGER SUMMARY VIEW -->
    <!-- Summary KPI Strip -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-sm-6 col-xl-4">
        <div class="kpi-card">
          <div class="kpi-accent-bar accent-blue"></div>
          <div class="kpi-label">Total Accounts</div>
          <div class="kpi-value text-primary mt-2"><%= report.accounts.length %></div>
          <div class="kpi-subtext">Active general ledger accounts</div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-4">
        <div class="kpi-card">
          <div class="kpi-accent-bar accent-cyan"></div>
          <div class="kpi-label">Total Debit Turnover</div>
          <div class="kpi-value mt-2 font-monospace">₹<%= parseFloat(report.summary.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="kpi-subtext">Turnover movements across all accounts</div>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-4">
        <div class="kpi-card">
          <div class="kpi-accent-bar accent-green"></div>
          <div class="kpi-label">Total Credit Turnover</div>
          <div class="kpi-value text-success mt-2 font-monospace">₹<%= parseFloat(report.summary.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="kpi-subtext">
            <% if (report.summary.isBalanced) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">Balanced (Dr = Cr)</span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">Unbalanced</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Summary Visual Charts Row -->
    <div class="row g-3 mb-4">
      <div class="col-12 col-lg-8">
        <div class="chart-card">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
              <div class="chart-title">Top Active Accounts by Transaction Volume</div>
              <div class="chart-subtitle">Accounts with greatest debit and credit movements in period</div>
            </div>
            <i class="bi bi-bar-chart-line text-muted"></i>
          </div>
          <div id="chart-gl-top-accounts" style="min-height: 270px;"></div>
        </div>
      </div>
      <div class="col-12 col-lg-4">
        <div class="chart-card">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
              <div class="chart-title">Account Type Breakdown</div>
              <div class="chart-subtitle">Distribution of accounts by classification</div>
            </div>
            <i class="bi bi-pie-chart text-muted"></i>
          </div>
          <div id="chart-gl-type-dist" style="min-height: 270px;"></div>
        </div>
      </div>
    </div>

    <!-- Summary Accounts Table (Glass Panel) -->
    <div class="card-glass overflow-hidden mb-4">
      <div class="py-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">General Ledger Accounts Summary</h6>
        <div class="d-flex align-items-center gap-2">
          <% if (report.summary.isBalanced) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
              <i class="bi bi-check-circle me-1"></i> Equilibrium Verified (Dr = Cr)
            </span>
          <% } %>
          <span class="badge bg-light text-dark border">Total Accounts: <%= report.accounts.length %></span>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-4" style="width: 100px;">Code</th>
              <th>Account Name</th>
              <th style="width: 120px;">Type</th>
              <th style="width: 150px;">Subtype</th>
              <th class="text-end" style="width: 130px;">Opening (₹)</th>
              <th class="text-end" style="width: 130px;">Debit (₹)</th>
              <th class="text-end" style="width: 130px;">Credit (₹)</th>
              <th class="text-end" style="width: 140px;">Closing (₹)</th>
              <th class="text-end pe-4" style="width: 90px;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% report.accounts.forEach(acc => { %>
              <tr>
                <td class="ps-4 font-monospace fw-bold"><%= acc.code %></td>
                <td>
                  <a href="?accountId=<%= acc.id %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>" class="fw-bold text-dark text-decoration-none">
                    <%= acc.name %>
                  </a>
                </td>
                <td><span class="badge bg-light text-dark border font-monospace"><%= acc.type %></span></td>
                <td class="text-muted small"><%= acc.subtype || '—' %></td>
                <td class="text-end font-monospace">₹<%= parseFloat(acc.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end fw-bold text-primary font-monospace">₹<%= parseFloat(acc.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end fw-bold text-success font-monospace">₹<%= parseFloat(acc.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end fw-bold font-monospace">₹<%= parseFloat(acc.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                <td class="text-end pe-4">
                  <a href="?accountId=<%= acc.id %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>" class="btn btn-sm btn-outline-primary rounded-circle" title="View Detailed Account Statement">
                    <i class="bi bi-file-text"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot class="table-light border-top">
            <tr>
              <th colspan="5" class="text-end ps-4 py-3 fw-bold">Total Ledger Movements:</th>
              <th class="text-end py-3 text-primary fw-bold fs-6 font-monospace">
                ₹<%= parseFloat(report.summary.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th class="text-end py-3 text-success fw-bold fs-6 font-monospace">
                ₹<%= parseFloat(report.summary.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
              </th>
              <th colspan="2" class="text-center py-3">
                <% if (report.summary.isBalanced) { %>
                  <span class="badge bg-success rounded-pill px-3">Balanced</span>
                <% } else { %>
                  <span class="badge bg-danger rounded-pill px-3">Unbalanced</span>
                <% } %>
              </th>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% } %>
</div>

<%
  let glScript = '';
  if (report.account) {
    const txLabels = ['Opening', ...(report.transactions || []).map(t => new Date(t.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }))];
    const runningSeries = [parseFloat(report.account.openingBalance) || 0, ...(report.transactions || []).map(t => parseFloat(t.runningBalance) || 0)];
    const totalDeb = parseFloat(report.summary.totalDebit) || 0;
    const totalCred = parseFloat(report.summary.totalCredit) || 0;
    glScript = `
      const trendOptions = {
        series: [{ name: 'Running Balance', data: ${JSON.stringify(runningSeries)} }],
        chart: { type: 'area', height: 270, toolbar: { show: false }, fontFamily: 'inherit' },
        colors: ['#16B8AF'],
        fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.45, opacityTo: 0.05, stops: [20, 100] } },
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2.5 },
        xaxis: { categories: ${JSON.stringify(txLabels)}, labels: { style: { fontSize: '11px', colors: '#64748B' } } },
        yaxis: { labels: { formatter: val => '₹' + (val >= 1000 ? (val / 1000).toFixed(0) + 'k' : val.toFixed(0)), style: { fontSize: '11px', colors: '#64748B' } } },
        grid: { borderColor: 'rgba(226, 232, 240, 0.7)', strokeDashArray: 4 },
        tooltip: { y: { formatter: val => '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 }) } }
      };
      const trendEl = document.getElementById('chart-gl-balance-trend');
      if (trendEl) new ApexCharts(trendEl, trendOptions).render();

      const hasMovement = (${totalDeb} > 0 || ${totalCred} > 0);
      const donutOptions = {
        series: hasMovement ? [${totalDeb}, ${totalCred}] : [],
        labels: ['Total Debits (Dr)', 'Total Credits (Cr)'],
        chart: { type: 'donut', height: 270, fontFamily: 'inherit' },
        colors: ['#16B8AF', '#B8F16A'],
        plotOptions: { pie: { donut: { size: '72%' } } },
        dataLabels: { enabled: false },
        legend: { position: 'bottom', fontSize: '11px', labels: { colors: '#64748B' } },
        stroke: { width: 2, colors: ['#ffffff'] },
        tooltip: { y: { formatter: val => '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 }) } },
        noData: { text: 'No movement in period', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
      };
      const donutEl = document.getElementById('chart-gl-movement-donut');
      if (donutEl) new ApexCharts(donutEl, donutOptions).render();
    `;
  } else {
    const sortedAccs = [...(report.accounts || [])]
      .sort((a, b) => (parseFloat(b.debit) + parseFloat(b.credit)) - (parseFloat(a.debit) + parseFloat(a.credit)))
      .slice(0, 6);
    const accNames = sortedAccs.map(a => a.name);
    const accDebits = sortedAccs.map(a => parseFloat(a.debit) || 0);
    const accCredits = sortedAccs.map(a => parseFloat(a.credit) || 0);

    const typeCounts = {};
    (report.accounts || []).forEach(a => {
      typeCounts[a.type] = (typeCounts[a.type] || 0) + 1;
    });
    const typeLabels = Object.keys(typeCounts);
    const typeSeries = Object.values(typeCounts);

    glScript = `
      const barOptions = {
        series: [
          { name: 'Debits (Dr)', data: ${JSON.stringify(accDebits)} },
          { name: 'Credits (Cr)', data: ${JSON.stringify(accCredits)} }
        ],
        chart: { type: 'bar', height: 270, toolbar: { show: false }, fontFamily: 'inherit' },
        colors: ['#16B8AF', '#B8F16A'],
        plotOptions: { bar: { horizontal: false, columnWidth: '45%', borderRadius: 4 } },
        dataLabels: { enabled: false },
        xaxis: { categories: ${JSON.stringify(accNames)}, labels: { style: { fontSize: '10px', colors: '#64748B' } } },
        yaxis: { labels: { formatter: val => '₹' + (val >= 1000 ? (val / 1000).toFixed(0) + 'k' : val.toFixed(0)), style: { fontSize: '11px', colors: '#64748B' } } },
        grid: { borderColor: 'rgba(226, 232, 240, 0.7)', strokeDashArray: 4 },
        legend: { position: 'top', horizontalAlign: 'right', fontSize: '11px', labels: { colors: '#64748B' } },
        tooltip: { y: { formatter: val => '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 }) } },
        noData: { text: 'No active transactions', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
      };
      const barEl = document.getElementById('chart-gl-top-accounts');
      if (barEl) new ApexCharts(barEl, barOptions).render();

      const typeOptions = {
        series: ${JSON.stringify(typeSeries)},
        labels: ${JSON.stringify(typeLabels)},
        chart: { type: 'donut', height: 270, fontFamily: 'inherit' },
        colors: ['#16B8AF', '#FF896F', '#9B8AFB', '#B8F16A', '#65BCE8'],
        plotOptions: { pie: { donut: { size: '72%' } } },
        dataLabels: { enabled: false },
        legend: { position: 'bottom', fontSize: '11px', labels: { colors: '#64748B' } },
        stroke: { width: 2, colors: ['#ffffff'] },
        noData: { text: 'No accounts', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
      };
      const typeEl = document.getElementById('chart-gl-type-dist');
      if (typeEl) new ApexCharts(typeEl, typeOptions).render();
    `;
  }
%>

<%- include('../layouts/footer', {
  extraJs: `
    <script>
      (function() {
        if (!window.ApexCharts) return;
        ${glScript}
      })();
    </script>
  `
}) %>
