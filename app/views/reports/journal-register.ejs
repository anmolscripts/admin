<%
  const jrHeaderAction = `
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-printer"></i>
        <span>Print Register</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: pageTitle || 'Journal Register',
    pageSubtitle: pageSubtitle || 'Chronological audit trail of all posted and reversed double-entry transactions.',
    headerAction: jrHeaderAction
}) %>

<div class="content-wrapper p-4">

  <!-- Filters Toolbar (Glass Panel) -->
  <div class="card-glass p-3 mb-4">
    <form method="GET" action="/reports/journals" class="row g-2 align-items-center">
      <!-- FY Filter -->
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Financial Year</label>
        <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All Financial Years</option>
          <% if (locals.financialYears) { %>
            <% financialYears.forEach(fy => { %>
              <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                <%= fy.code %> (<%= fy.status %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- Date Range Filter -->
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Date Range</label>
        <div class="spark-daterange-picker w-100" data-from-name="fromDate" data-to-name="toDate" data-auto-submit="true">
          <div class="d-flex align-items-center gap-1">
            <button class="btn-date-picker btn-date-picker-sm flex-grow-1" type="button" aria-label="Select date range">
              <span class="d-flex align-items-center gap-2 text-truncate">
                <i class="bi bi-calendar4-event text-primary"></i>
                <span class="spark-daterange-label text-truncate">All Dates</span>
              </span>
              <i class="bi bi-chevron-down text-muted ms-auto"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-daterange-clear d-none" title="Clear date range" aria-label="Clear date range">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <input type="hidden" name="fromDate" value="<%= filters.fromDate || '' %>">
          <input type="hidden" name="toDate" value="<%= filters.toDate || '' %>">
        </div>
      </div>

      <!-- Source Type -->
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Source Type</label>
        <select name="sourceType" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All Sources</option>
          <option value="INVOICE" <%= filters.sourceType === 'INVOICE' ? 'selected' : '' %>>Invoices</option>
          <option value="PAYMENT" <%= filters.sourceType === 'PAYMENT' ? 'selected' : '' %>>Payments</option>
          <option value="CREDIT_NOTE" <%= filters.sourceType === 'CREDIT_NOTE' ? 'selected' : '' %>>Credit Notes</option>
          <option value="DEBIT_NOTE" <%= filters.sourceType === 'DEBIT_NOTE' ? 'selected' : '' %>>Debit Notes</option>
          <option value="YEAR_END_CLOSE" <%= filters.sourceType === 'YEAR_END_CLOSE' ? 'selected' : '' %>>Year-End Closing</option>
          <option value="OPENING_BALANCE" <%= filters.sourceType === 'OPENING_BALANCE' ? 'selected' : '' %>>Opening Balances</option>
          <option value="MANUAL" <%= filters.sourceType === 'MANUAL' ? 'selected' : '' %>>Manual Journals</option>
        </select>
      </div>

      <!-- Status -->
      <div class="col-md-2">
        <label class="form-label small text-muted mb-1">Status</label>
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All Statuses</option>
          <option value="POSTED" <%= !filters.status || filters.status === 'POSTED' ? 'selected' : '' %>>Posted</option>
          <option value="REVERSED" <%= filters.status === 'REVERSED' ? 'selected' : '' %>>Reversed</option>
        </select>
      </div>

      <!-- Filter Actions -->
      <div class="col-md-2 d-flex align-items-end gap-2 pt-2">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply</button>
        <a href="/reports/journals" class="btn btn-sm btn-outline-secondary px-3" title="Clear Filters">
          <i class="bi bi-arrow-counterclockwise"></i>
        </a>
      </div>
    </form>
  </div>

  <!-- Summary KPI Strip (Glass KPI Cards) -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-4">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-blue"></div>
        <div class="kpi-label">Total Entries</div>
        <div class="kpi-value text-primary mt-2"><%= report.summary.totalEntries %></div>
        <div class="kpi-subtext">Page records: <%= report.entries.length %></div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-cyan"></div>
        <div class="kpi-label">Page Total Debits</div>
        <div class="kpi-value mt-2 font-monospace">₹<%= parseFloat(report.summary.pageDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Sum of debit lines</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-4">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-green"></div>
        <div class="kpi-label">Page Total Credits</div>
        <div class="kpi-value text-success mt-2 font-monospace">₹<%= parseFloat(report.summary.pageCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">
          <% if (report.summary.isBalanced) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
              <i class="bi bi-check-circle me-1"></i> Balanced (Dr = Cr)
            </span>
          <% } else { %>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
              <i class="bi bi-exclamation-triangle me-1"></i> Unbalanced
            </span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Visual Analytics Charts Row -->
  <div class="row g-3 mb-4">
    <!-- Chart 1: Source Type Distribution -->
    <div class="col-12 col-lg-5">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Journal Entries by Source Module</div>
            <div class="chart-subtitle">Distribution of posted transactions by business source</div>
          </div>
          <i class="bi bi-pie-chart text-muted"></i>
        </div>
        <div id="chart-jr-source-type" style="min-height: 270px;"></div>
      </div>
    </div>

    <!-- Chart 2: Posting Volume by Date -->
    <div class="col-12 col-lg-7">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Transaction Posting Value by Date</div>
            <div class="chart-subtitle">Chronological ledger debit flows for filtered entries</div>
          </div>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">INR (₹)</span>
        </div>
        <div id="chart-jr-volume" style="min-height: 270px;"></div>
      </div>
    </div>
  </div>

  <!-- Journal Entries Table (Glass Panel) -->
  <div class="card-glass overflow-hidden mb-4">
    <div class="py-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 text-dark">Chronological Journal Register</h6>
      <span class="badge bg-light text-dark border">Showing <%= report.entries.length %> records</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4" style="width: 110px;">Date</th>
            <th style="width: 140px;">Entry #</th>
            <th style="width: 120px;">Source</th>
            <th>Narration & Posting Accounts</th>
            <th class="text-end" style="width: 130px;">Debit (₹)</th>
            <th class="text-end" style="width: 130px;">Credit (₹)</th>
            <th class="text-center" style="width: 100px;">Status</th>
            <th class="text-end pe-4" style="width: 80px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (report.entries.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
                No journal entries found matching the specified filters.
              </td>
            </tr>
          <% } else { %>
            <% report.entries.forEach(entry => { %>
              <tr class="report-row-clickable cursor-pointer" data-source-type="<%= entry.sourceType %>" data-source-id="<%= entry.sourceId || '' %>" data-journal-id="<%= entry.id %>" data-source-ref="<%= entry.entryNumber %>" title="Click to view details in modal">
                <td class="ps-4 small text-muted"><%= new Date(entry.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                <td class="font-monospace fw-bold">
                  <a href="/reports/journals/<%= entry.id %>" class="text-decoration-none text-primary" onclick="event.stopPropagation()">
                    <%= entry.entryNumber %>
                  </a>
                </td>
                <td>
                  <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 0.72rem;">
                    <%= entry.sourceType %>
                  </span>
                </td>
                <td>
                  <div class="text-dark small fw-medium"><%= entry.narration || 'General journal posting' %></div>
                  <div class="text-muted" style="font-size: 0.72rem;">
                    <% (entry.lines || []).slice(0, 3).forEach((line, idx) => { %>
                      <span class="badge bg-light text-dark border font-monospace me-1"><%= line.accountCode %>: ₹<%= parseFloat(line.debit > 0 ? line.debit : line.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
                    <% }); %>
                    <% if ((entry.lines || []).length > 3) { %>
                      <span class="badge bg-light text-muted border">+<%= entry.lines.length - 3 %> lines</span>
                    <% } %>
                  </div>
                </td>
                <td class="text-end font-monospace fw-bold text-primary">
                  ₹<%= parseFloat(entry.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end font-monospace fw-bold text-success">
                  ₹<%= parseFloat(entry.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-center">
                  <% if (entry.status === 'POSTED') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">POSTED</span>
                  <% } else if (entry.status === 'REVERSED') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">REVERSED</span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill"><%= entry.status %></span>
                  <% } %>
                </td>
                <td class="text-end pe-4">
                  <a href="/reports/journals/<%= entry.id %>" class="btn btn-sm btn-outline-primary rounded-circle" title="View Journal Detail">
                    <i class="bi bi-eye"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (report.pagination.totalPages > 1) { %>
      <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center p-3">
        <div class="small text-muted">
          Showing page <strong><%= report.pagination.page %></strong> of <strong><%= report.pagination.totalPages %></strong>
          (<%= report.pagination.total %> total records)
        </div>
        <ul class="pagination pagination-sm mb-0">
          <% if (report.pagination.page > 1) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= report.pagination.page - 1 %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>&sourceType=<%= filters.sourceType || '' %>&status=<%= filters.status || '' %>">Previous</a>
            </li>
          <% } %>
          <% for (let p = 1; p <= report.pagination.totalPages; p++) { %>
            <li class="page-item <%= p === report.pagination.page ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= p %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>&sourceType=<%= filters.sourceType || '' %>&status=<%= filters.status || '' %>"><%= p %></a>
            </li>
          <% } %>
          <% if (report.pagination.page < report.pagination.totalPages) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= report.pagination.page + 1 %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>&sourceType=<%= filters.sourceType || '' %>&status=<%= filters.status || '' %>">Next</a>
            </li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%
  const sourceCounts = {};
  const dateMap = {};
  (report.entries || []).forEach(e => {
    const st = e.sourceType || 'MANUAL';
    sourceCounts[st] = (sourceCounts[st] || 0) + 1;
    const d = new Date(e.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' });
    dateMap[d] = (dateMap[d] || 0) + (parseFloat(e.totalDebit) || 0);
  });
  const sourceLabels = Object.keys(sourceCounts);
  const sourceSeries = Object.values(sourceCounts);
  const dateLabels = Object.keys(dateMap).slice(0, 10);
  const dateSeries = dateLabels.map(d => dateMap[d]);
%>

<%- include('../layouts/footer', {
  extraJs: `
    <script src="/js/report-drilldown.js"></script>
    <script>
      (function() {
        if (!window.ApexCharts) return;

        // 1. Source Type Donut Chart
        const sourceOptions = {
          series: ${JSON.stringify(sourceSeries)},
          labels: ${JSON.stringify(sourceLabels)},
          chart: {
            type: 'donut',
            height: 270,
            fontFamily: 'inherit'
          },
          colors: ['#16B8AF', '#65BCE8', '#B8F16A', '#FF896F', '#9B8AFB', '#135E5A'],
          plotOptions: {
            pie: {
              donut: {
                size: '72%',
                labels: {
                  show: true,
                  total: {
                    show: true,
                    label: 'Total Entries',
                    fontSize: '11px',
                    formatter: function(w) {
                      return w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                    }
                  }
                }
              }
            }
          },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', fontSize: '11px', labels: { colors: '#64748B' } },
          stroke: { width: 2, colors: ['#ffffff'] },
          noData: { text: 'No journal entries in period', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
        };

        const sourceEl = document.getElementById('chart-jr-source-type');
        if (sourceEl) {
          const chart = new ApexCharts(sourceEl, sourceOptions);
          chart.render();
        }

        // 2. Daily Posting Value Column Chart
        const volumeOptions = {
          series: [{
            name: 'Total Debit Posted (₹)',
            data: ${JSON.stringify(dateSeries)}
          }],
          chart: {
            type: 'bar',
            height: 270,
            toolbar: { show: false },
            fontFamily: 'inherit'
          },
          colors: ['#16B8AF'],
          plotOptions: {
            bar: {
              columnWidth: '40%',
              borderRadius: 4
            }
          },
          dataLabels: { enabled: false },
          xaxis: {
            categories: ${JSON.stringify(dateLabels)},
            labels: { style: { fontSize: '11px', colors: '#64748B' } }
          },
          yaxis: {
            labels: {
              formatter: function(val) {
                return '₹' + (val >= 1000 ? (val / 1000).toFixed(0) + 'k' : val.toFixed(0));
              },
              style: { fontSize: '11px', colors: '#64748B' }
            }
          },
          grid: {
            borderColor: 'rgba(226, 232, 240, 0.7)',
            strokeDashArray: 4
          },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          },
          noData: { text: 'No entry dates to display', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
        };

        const volumeEl = document.getElementById('chart-jr-volume');
        if (volumeEl) {
          const chart = new ApexCharts(volumeEl, volumeOptions);
          chart.render();
        }
      })();
    </script>
  `
}) %>
