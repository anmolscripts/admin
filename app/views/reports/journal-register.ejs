<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-printer"></i>
        <span>Print Register</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/reports/journals" class="row g-2 align-items-center">
        <!-- FY Filter -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">Financial Year</label>
          <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Financial Years</option>
            <% if (locals.financialYears) { %>
              <% financialYears.forEach(fy => { %>
                <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                  <%= fy.code %> (<%= fy.status %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- From Date -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">From Date</label>
          <input type="date" name="fromDate" class="form-control form-control-sm" value="<%= filters.fromDate || '' %>">
        </div>

        <!-- To Date -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">To Date</label>
          <input type="date" name="toDate" class="form-control form-control-sm" value="<%= filters.toDate || '' %>">
        </div>

        <!-- Source Type -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">Source Type</label>
          <select name="sourceType" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Sources</option>
            <option value="INVOICE" <%= filters.sourceType === 'INVOICE' ? 'selected' : '' %>>Invoices</option>
            <option value="PAYMENT" <%= filters.sourceType === 'PAYMENT' ? 'selected' : '' %>>Payments</option>
            <option value="CREDIT_NOTE" <%= filters.sourceType === 'CREDIT_NOTE' ? 'selected' : '' %>>Credit Notes</option>
            <option value="DEBIT_NOTE" <%= filters.sourceType === 'DEBIT_NOTE' ? 'selected' : '' %>>Debit Notes</option>
            <option value="YEAR_END_CLOSE" <%= filters.sourceType === 'YEAR_END_CLOSE' ? 'selected' : '' %>>Year-End Closing</option>
            <option value="OPENING_BALANCE" <%= filters.sourceType === 'OPENING_BALANCE' ? 'selected' : '' %>>Opening Balances</option>
            <option value="MANUAL" <%= filters.sourceType === 'MANUAL' ? 'selected' : '' %>>Manual Journals</option>
          </select>
        </div>

        <!-- Status -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">Status</label>
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All Statuses</option>
            <option value="POSTED" <%= !filters.status || filters.status === 'POSTED' ? 'selected' : '' %>>Posted</option>
            <option value="REVERSED" <%= filters.status === 'REVERSED' ? 'selected' : '' %>>Reversed</option>
          </select>
        </div>

        <!-- Filter Actions -->
        <div class="col-md-2 d-flex align-items-end gap-2 pt-4">
          <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply</button>
          <a href="/reports/journals" class="btn btn-sm btn-outline-secondary" title="Clear Filters">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Total Entries</div>
          <div class="fs-4 fw-bold mt-1"><%= report.summary.totalEntries %></div>
          <div class="small text-muted">Page records: <%= report.entries.length %></div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Page Total Debits</div>
          <div class="fs-4 fw-bold text-primary mt-1">₹<%= parseFloat(report.summary.pageDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Sum of debit lines</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Page Total Credits</div>
          <div class="fs-4 fw-bold text-success mt-1">₹<%= parseFloat(report.summary.pageCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small">
            <% if (report.summary.isBalanced) { %>
              <span class="badge bg-success-subtle text-success border border-success-subtle">
                <i class="bi bi-check-circle me-1"></i> Balanced (Dr = Cr)
              </span>
            <% } else { %>
              <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                <i class="bi bi-exclamation-triangle me-1"></i> Unbalanced
              </span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Journal Entries Table -->
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="width: 110px;">Date</th>
            <th style="width: 140px;">Entry #</th>
            <th style="width: 120px;">Source</th>
            <th>Narration & Posting Accounts</th>
            <th class="text-end" style="width: 130px;">Debit (₹)</th>
            <th class="text-end" style="width: 130px;">Credit (₹)</th>
            <th style="width: 100px;">Status</th>
            <th class="text-end pe-3" style="width: 90px;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (report.entries.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="bi bi-journal-x fs-1 d-block mb-2 text-muted"></i>
                <div class="fw-semibold">No journal entries found</div>
                <div class="small">Try adjusting your filters or date range.</div>
              </td>
            </tr>
          <% } else { %>
            <% report.entries.forEach(entry => { %>
              <tr>
                <td class="ps-3 text-nowrap">
                  <div class="fw-semibold"><%= new Date(entry.entryDate).toLocaleDateString('en-IN') %></div>
                  <div class="text-muted small"><%= entry.financialYear ? entry.financialYear.code : '' %></div>
                </td>
                <td>
                  <a href="/reports/journals/<%= entry.id %>" class="fw-bold text-decoration-none">
                    <%= entry.entryNumber %>
                  </a>
                  <% if (entry.reversedEntry) { %>
                    <div class="small text-danger" title="Reversal of <%= entry.reversedEntry.entryNumber %>">
                      <i class="bi bi-arrow-counterclockwise"></i> Rev of <%= entry.reversedEntry.entryNumber %>
                    </div>
                  <% } %>
                  <% if (entry.reversingEntry) { %>
                    <div class="small text-muted" title="Reversed by <%= entry.reversingEntry.entryNumber %>">
                      <i class="bi bi-arrow-return-right"></i> Reversed by <%= entry.reversingEntry.entryNumber %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <% if (entry.sourceType === 'INVOICE') { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                      <i class="bi bi-receipt me-1"></i> Invoice
                    </span>
                  <% } else if (entry.sourceType === 'PAYMENT') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                      <i class="bi bi-cash-stack me-1"></i> Payment
                    </span>
                  <% } else if (entry.sourceType === 'CREDIT_NOTE') { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                      <i class="bi bi-dash-circle me-1"></i> Credit Note
                    </span>
                  <% } else if (entry.sourceType === 'DEBIT_NOTE') { %>
                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                      <i class="bi bi-plus-circle me-1"></i> Debit Note
                    </span>
                  <% } else if (entry.sourceType === 'YEAR_END_CLOSE') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                      <i class="bi bi-lock-fill me-1"></i> Year-End Close
                    </span>
                  <% } else if (entry.sourceType === 'YEAR_END_CLOSE_REVERSAL') { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                      <i class="bi bi-unlock-fill me-1"></i> Close Reversal
                    </span>
                  <% } else if (entry.sourceType === 'OPENING_BALANCE') { %>
                    <span class="badge bg-purple-subtle text-primary border border-primary-subtle">
                      <i class="bi bi-arrow-right-circle me-1"></i> Opening Balance
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                      Manual
                    </span>
                  <% } %>
                  <% if (entry.sourceId) { %>
                    <div class="text-muted small mt-1">Ref #<%= entry.sourceId %></div>
                  <% } %>
                </td>
                <td>
                  <div class="fw-semibold mb-1"><%= entry.narration %></div>
                  <div class="small text-muted">
                    <% entry.lines.forEach((l, idx) => { %>
                      <span class="badge bg-light text-dark border me-1">
                        <%= l.account ? l.account.code : '' %> <%= l.account ? l.account.name : '' %>
                        (<%= parseFloat(l.debit) > 0 ? 'Dr ₹' + l.debit : 'Cr ₹' + l.credit %>)
                        <% if (l.client) { %> [<%= l.client.name %>]<% } %>
                      </span>
                    <% }); %>
                  </div>
                </td>
                <td class="text-end fw-bold text-primary">
                  ₹<%= parseFloat(entry.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td class="text-end fw-bold text-success">
                  ₹<%= parseFloat(entry.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
                <td>
                  <% if (entry.status === 'POSTED') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">POSTED</span>
                  <% } else if (entry.status === 'REVERSED') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">REVERSED</span>
                  <% } else { %>
                    <span class="badge bg-secondary"><%= entry.status %></span>
                  <% } %>
                </td>
                <td class="text-end pe-3">
                  <a href="/reports/journals/<%= entry.id %>" class="btn btn-sm btn-outline-primary" title="View Journal Detail">
                    <i class="bi bi-eye"></i>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (report.pagination.totalPages > 1) { %>
      <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center p-3">
        <div class="small text-muted">
          Showing page <strong><%= report.pagination.page %></strong> of <strong><%= report.pagination.totalPages %></strong>
          (<%= report.pagination.total %> total records)
        </div>
        <ul class="pagination pagination-sm mb-0">
          <% if (report.pagination.page > 1) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= report.pagination.page - 1 %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>&sourceType=<%= filters.sourceType || '' %>&status=<%= filters.status || '' %>">Previous</a>
            </li>
          <% } %>
          <% for (let p = 1; p <= report.pagination.totalPages; p++) { %>
            <li class="page-item <%= p === report.pagination.page ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= p %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>&sourceType=<%= filters.sourceType || '' %>&status=<%= filters.status || '' %>"><%= p %></a>
            </li>
          <% } %>
          <% if (report.pagination.page < report.pagination.totalPages) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= report.pagination.page + 1 %>&financialYearId=<%= filters.financialYearId || '' %>&fromDate=<%= filters.fromDate || '' %>&toDate=<%= filters.toDate || '' %>&sourceType=<%= filters.sourceType || '' %>&status=<%= filters.status || '' %>">Next</a>
            </li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('../layouts/footer') %>
