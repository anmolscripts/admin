<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-printer"></i>
        <span>Print Trial Balance</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/reports/trial-balance" class="row g-2 align-items-center">
        <!-- FY Filter -->
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">Financial Year</label>
          <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Financial Years</option>
            <% if (locals.financialYears) { %>
              <% financialYears.forEach(fy => { %>
                <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                  <%= fy.code %> (<%= fy.status %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- As Of Date Cutoff -->
        <div class="col-md-3">
          <label class="form-label small text-muted mb-1">As-Of Cutoff Date</label>
          <input type="date" name="asOfDate" class="form-control form-control-sm" value="<%= filters.asOfDate || '' %>">
        </div>

        <!-- From Date -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">From Date</label>
          <input type="date" name="fromDate" class="form-control form-control-sm" value="<%= filters.fromDate || '' %>">
        </div>

        <!-- To Date -->
        <div class="col-md-2">
          <label class="form-label small text-muted mb-1">To Date</label>
          <input type="date" name="toDate" class="form-control form-control-sm" value="<%= filters.toDate || '' %>">
        </div>

        <!-- Actions -->
        <div class="col-md-2 d-flex align-items-end gap-2 pt-4">
          <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply</button>
          <a href="/reports/trial-balance" class="btn btn-sm btn-outline-secondary" title="Reset">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Balance Status Banner -->
  <% if (report.summary.isBalanced) { %>
    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Trial Balance is in Perfect Equilibrium</h6>
          <div class="small">Total Debits equal Total Credits down to the exact cent across all general ledger accounts.</div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-success fs-6 px-3 py-2">₹<%= parseFloat(report.summary.totalDebitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-triangle-fill fs-3 text-danger"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Discrepancy Detected in Trial Balance!</h6>
          <div class="small">Difference between Total Debits and Total Credits: ₹<%= report.summary.difference %></div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-danger fs-6 px-3 py-2">Diff: ₹<%= report.summary.difference %></span>
      </div>
    </div>
  <% } %>

  <!-- KPI Strip -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Total Debit Balance</div>
          <div class="fs-4 fw-bold text-primary mt-1">₹<%= parseFloat(report.summary.totalDebitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Closing debit totals</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Total Credit Balance</div>
          <div class="fs-4 fw-bold text-success mt-1">₹<%= parseFloat(report.summary.totalCreditBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Closing credit totals</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Period Debit Movements</div>
          <div class="fs-4 fw-bold text-dark mt-1">₹<%= parseFloat(report.summary.totalDebitMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Transaction turnover</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Period Credit Movements</div>
          <div class="fs-4 fw-bold text-dark mt-1">₹<%= parseFloat(report.summary.totalCreditMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Transaction turnover</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Trial Balance Table -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="width: 100px;">Code</th>
            <th>Account Description</th>
            <th style="width: 130px;">Subtype</th>
            <th class="text-end" style="width: 140px;">Period Dr (₹)</th>
            <th class="text-end" style="width: 140px;">Period Cr (₹)</th>
            <th class="text-end" style="width: 150px;">Debit Balance (₹)</th>
            <th class="text-end pe-4" style="width: 150px;">Credit Balance (₹)</th>
          </tr>
        </thead>
        <tbody>
          <% const accountTypes = [
            { key: 'ASSET', title: '1000 — ASSETS' },
            { key: 'LIABILITY', title: '2000 — LIABILITIES' },
            { key: 'EQUITY', title: '3000 — EQUITY & CAPITAL' },
            { key: 'INCOME', title: '4000 — REVENUE & INCOME' },
            { key: 'EXPENSE', title: '5000 — EXPENSES' }
          ]; %>

          <% accountTypes.forEach(t => { %>
            <% const items = report.groupedByType[t.key] || []; %>
            <% if (items.length > 0) { %>
              <tr class="table-light">
                <td colspan="7" class="ps-3 py-2 fw-bold text-uppercase text-secondary small">
                  <i class="bi bi-folder2-open me-2"></i><%= t.title %>
                </td>
              </tr>
              <% items.forEach(acc => { %>
                <tr>
                  <td class="ps-3 font-monospace fw-bold"><%= acc.code %></td>
                  <td>
                    <a href="/reports/general-ledger?accountId=<%= acc.id %>" class="fw-semibold text-dark text-decoration-none">
                      <%= acc.name %>
                    </a>
                  </td>
                  <td class="text-muted small"><%= acc.subtype || '—' %></td>
                  <td class="text-end text-muted small">₹<%= parseFloat(acc.periodDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="text-end text-muted small">₹<%= parseFloat(acc.periodCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="text-end fw-bold text-primary">
                    <%= parseFloat(acc.debitBalance) > 0 ? '₹' + parseFloat(acc.debitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="text-end pe-4 fw-bold text-success">
                    <%= parseFloat(acc.creditBalance) > 0 ? '₹' + parseFloat(acc.creditBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          <% }); %>
        </tbody>
        <tfoot class="table-dark">
          <tr>
            <th colspan="3" class="ps-3 py-3 fs-6">CONTROL TOTALS:</th>
            <th class="text-end py-3">₹<%= parseFloat(report.summary.totalDebitMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3">₹<%= parseFloat(report.summary.totalCreditMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 fs-6 text-info">₹<%= parseFloat(report.summary.totalDebitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end pe-4 py-3 fs-6 text-warning">₹<%= parseFloat(report.summary.totalCreditBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
