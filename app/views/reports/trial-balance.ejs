<%
  const tbHeaderAction = `
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-printer"></i>
        <span>Print Trial Balance</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: pageTitle || 'Trial Balance',
    pageSubtitle: pageSubtitle || 'As-of date equilibrium check verifying Total Debits equal Total Credits.',
    headerAction: tbHeaderAction
}) %>

<div class="content-wrapper p-4">

  <!-- Filters Toolbar (Glass Panel) -->
  <div class="card-glass p-3 mb-4">
    <form method="GET" action="/reports/trial-balance" class="row g-2 align-items-center">
      <!-- FY Filter -->
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">Financial Year</label>
        <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All Financial Years</option>
          <% if (locals.financialYears) { %>
            <% financialYears.forEach(fy => { %>
              <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                <%= fy.code %> (<%= fy.status %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- As Of Date Cutoff -->
      <div class="col-md-3">
        <label class="form-label small text-muted mb-1">As-Of Cutoff Date</label>
        <input type="date" name="asOfDate" class="form-control form-control-sm" value="<%= filters.asOfDate || '' %>">
      </div>

      <!-- Date Range Filter -->
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Date Range</label>
        <div class="spark-daterange-picker w-100" data-from-name="fromDate" data-to-name="toDate" data-auto-submit="true">
          <div class="d-flex align-items-center gap-1">
            <button class="btn-date-picker btn-date-picker-sm flex-grow-1" type="button" aria-label="Select date range">
              <span class="d-flex align-items-center gap-2 text-truncate">
                <i class="bi bi-calendar4-event text-primary"></i>
                <span class="spark-daterange-label text-truncate">All Dates</span>
              </span>
              <i class="bi bi-chevron-down text-muted ms-auto"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary btn-daterange-clear d-none" title="Clear date range" aria-label="Clear date range">
              <i class="bi bi-x-lg"></i>
            </button>
          </div>
          <input type="hidden" name="fromDate" value="<%= filters.fromDate || '' %>">
          <input type="hidden" name="toDate" value="<%= filters.toDate || '' %>">
        </div>
      </div>

      <!-- Actions -->
      <div class="col-md-2 d-flex align-items-end gap-2 pt-2">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply</button>
        <a href="/reports/trial-balance" class="btn btn-sm btn-outline-secondary px-3" title="Reset">
          <i class="bi bi-arrow-counterclockwise"></i>
        </a>
      </div>
    </form>
  </div>

  <!-- Balance Status Banner -->
  <% if (report.summary.isBalanced) { %>
    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm rounded-3" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-shield-check fs-2 text-success"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Trial Balance is in Perfect Equilibrium</h6>
          <div class="small">Total Debits equal Total Credits down to the exact cent across all general ledger accounts.</div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">₹<%= parseFloat(report.summary.totalDebitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></span>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-danger d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm rounded-3" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-triangle-fill fs-2 text-danger"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Discrepancy Detected in Trial Balance!</h6>
          <div class="small">Difference between Total Debits and Total Credits: ₹<%= report.summary.difference %></div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill">Diff: ₹<%= report.summary.difference %></span>
      </div>
    </div>
  <% } %>

  <!-- KPI Strip (Glass KPI Cards) -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-blue"></div>
        <div class="kpi-label">Total Debit Balance</div>
        <div class="kpi-value text-primary mt-2">₹<%= parseFloat(report.summary.totalDebitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Closing debit totals</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-green"></div>
        <div class="kpi-label">Total Credit Balance</div>
        <div class="kpi-value text-success mt-2">₹<%= parseFloat(report.summary.totalCreditBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Closing credit totals</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-purple"></div>
        <div class="kpi-label">Period Debit Movements</div>
        <div class="kpi-value mt-2">₹<%= parseFloat(report.summary.totalDebitMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Transaction turnover</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-amber"></div>
        <div class="kpi-label">Period Credit Movements</div>
        <div class="kpi-value mt-2">₹<%= parseFloat(report.summary.totalCreditMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Transaction turnover</div>
      </div>
    </div>
  </div>

  <!-- Visual Analytics Charts (ApexCharts) -->
  <div class="row g-3 mb-4">
    <!-- Chart 1: Classification Composition -->
    <div class="col-12 col-lg-6">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Account Classification Balance Distribution</div>
            <div class="chart-subtitle">Aggregate closing balances across the 5 primary account types</div>
          </div>
          <i class="bi bi-pie-chart text-muted"></i>
        </div>
        <div id="chart-tb-classes" style="min-height: 270px;"></div>
      </div>
    </div>

    <!-- Chart 2: Debit vs Credit Equilibrium -->
    <div class="col-12 col-lg-6">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Debit vs Credit Equilibrium Verification</div>
            <div class="chart-subtitle">Comparison of period movement turnover and closing balance totals</div>
          </div>
          <i class="bi bi-scale text-muted"></i>
        </div>
        <div id="chart-tb-equilibrium" style="min-height: 270px;"></div>
      </div>
    </div>
  </div>

  <!-- Trial Balance Table (Glass Panel) -->
  <div class="card-glass overflow-hidden mb-4">
    <div class="py-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 text-dark">Trial Balance Ledger Breakdown</h6>
      <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">INR (₹)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4" style="width: 100px;">Code</th>
            <th>Account Description</th>
            <th style="width: 130px;">Subtype</th>
            <th class="text-end" style="width: 140px;">Period Dr (₹)</th>
            <th class="text-end" style="width: 140px;">Period Cr (₹)</th>
            <th class="text-end" style="width: 150px;">Debit Balance (₹)</th>
            <th class="text-end pe-4" style="width: 150px;">Credit Balance (₹)</th>
          </tr>
        </thead>
        <tbody>
          <% const accountTypes = [
            { key: 'ASSET', title: '1000 — ASSETS' },
            { key: 'LIABILITY', title: '2000 — LIABILITIES' },
            { key: 'EQUITY', title: '3000 — EQUITY & CAPITAL' },
            { key: 'INCOME', title: '4000 — REVENUE & INCOME' },
            { key: 'EXPENSE', title: '5000 — EXPENSES' }
          ]; %>

          <% accountTypes.forEach(t => { %>
            <% const items = report.groupedByType[t.key] || []; %>
            <% if (items.length > 0) { %>
              <tr class="table-light">
                <td colspan="7" class="ps-4 py-2 fw-bold text-uppercase text-secondary small">
                  <i class="bi bi-folder2-open me-2"></i><%= t.title %>
                </td>
              </tr>
              <% items.forEach(acc => { %>
                <tr>
                  <td class="ps-4 font-monospace fw-bold"><%= acc.code %></td>
                  <td>
                    <a href="/reports/general-ledger?accountId=<%= acc.id %>" class="fw-semibold text-dark text-decoration-none">
                      <%= acc.name %>
                    </a>
                  </td>
                  <td class="text-muted small"><%= acc.subtype || '—' %></td>
                  <td class="text-end text-muted small font-monospace">₹<%= parseFloat(acc.periodDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="text-end text-muted small font-monospace">₹<%= parseFloat(acc.periodCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="text-end fw-bold text-primary font-monospace">
                    <%= parseFloat(acc.debitBalance) > 0 ? '₹' + parseFloat(acc.debitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="text-end pe-4 fw-bold text-success font-monospace">
                    <%= parseFloat(acc.creditBalance) > 0 ? '₹' + parseFloat(acc.creditBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          <% }); %>
        </tbody>
        <tfoot class="table-dark">
          <tr>
            <th colspan="3" class="ps-4 py-3 fs-6">CONTROL TOTALS:</th>
            <th class="text-end py-3 font-monospace">₹<%= parseFloat(report.summary.totalDebitMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 font-monospace">₹<%= parseFloat(report.summary.totalCreditMovement).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end py-3 fs-6 text-info font-monospace">₹<%= parseFloat(report.summary.totalDebitBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
            <th class="text-end pe-4 py-3 fs-6 text-warning font-monospace">₹<%= parseFloat(report.summary.totalCreditBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<%
  const classTotals = { ASSET: 0, LIABILITY: 0, EQUITY: 0, INCOME: 0, EXPENSE: 0 };
  Object.keys(report.groupedByType || {}).forEach(k => {
    const list = report.groupedByType[k] || [];
    list.forEach(a => {
      const bal = Math.max(parseFloat(a.debitBalance) || 0, parseFloat(a.creditBalance) || 0);
      classTotals[k] = (classTotals[k] || 0) + bal;
    });
  });
  const classSeriesJson = JSON.stringify([
    Number(classTotals.ASSET || 0).toFixed(2),
    Number(classTotals.LIABILITY || 0).toFixed(2),
    Number(classTotals.EQUITY || 0).toFixed(2),
    Number(classTotals.INCOME || 0).toFixed(2),
    Number(classTotals.EXPENSE || 0).toFixed(2)
  ].map(Number));
%>

<%- include('../layouts/footer', {
  extraJs: `
    <script>
      (function() {
        if (!window.ApexCharts) return;

        // 1. Account Class Balance Donut Chart
        const classSeries = ${classSeriesJson};
        const hasClassData = classSeries.some(v => v > 0);

        const classOptions = {
          series: hasClassData ? classSeries : [],
          labels: ['Assets', 'Liabilities', 'Equity', 'Revenue', 'Expenses'],
          chart: {
            type: 'donut',
            height: 270,
            fontFamily: 'inherit'
          },
          colors: ['#16B8AF', '#FF896F', '#9B8AFB', '#B8F16A', '#65BCE8'],
          plotOptions: {
            pie: {
              donut: {
                size: '72%',
                labels: {
                  show: true,
                  total: {
                    show: true,
                    label: 'Total Balances',
                    fontSize: '11px',
                    formatter: function(w) {
                      const sum = w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                      return '₹' + (sum >= 1000 ? (sum / 1000).toFixed(0) + 'k' : sum.toFixed(0));
                    }
                  }
                }
              }
            }
          },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', fontSize: '11px', labels: { colors: '#64748B' } },
          stroke: { width: 2, colors: ['#ffffff'] },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          },
          noData: { text: 'No active accounts with balance', align: 'center', verticalAlign: 'middle', style: { color: '#94a3b8' } }
        };

        const classEl = document.getElementById('chart-tb-classes');
        if (classEl) {
          const chart = new ApexCharts(classEl, classOptions);
          chart.render();
        }

        // 2. Debit vs Credit Equilibrium Comparison Bar Chart
        const totalDebitBal = ${parseFloat(report.summary.totalDebitBalance) || 0};
        const totalCreditBal = ${parseFloat(report.summary.totalCreditBalance) || 0};
        const totalDebitMov = ${parseFloat(report.summary.totalDebitMovement) || 0};
        const totalCreditMov = ${parseFloat(report.summary.totalCreditMovement) || 0};

        const eqOptions = {
          series: [
            { name: 'Debits (Dr)', data: [totalDebitBal, totalDebitMov] },
            { name: 'Credits (Cr)', data: [totalCreditBal, totalCreditMov] }
          ],
          chart: {
            type: 'bar',
            height: 270,
            toolbar: { show: false },
            fontFamily: 'inherit'
          },
          colors: ['#16B8AF', '#B8F16A'],
          plotOptions: {
            bar: {
              horizontal: false,
              columnWidth: '40%',
              borderRadius: 4
            }
          },
          dataLabels: { enabled: false },
          xaxis: {
            categories: ['Closing Balances', 'Period Turnover'],
            labels: { style: { fontSize: '11px', colors: '#64748B' } }
          },
          yaxis: {
            labels: {
              formatter: function(val) {
                return '₹' + (val >= 1000 ? (val / 1000).toFixed(0) + 'k' : val.toFixed(0));
              },
              style: { fontSize: '11px', colors: '#64748B' }
            }
          },
          grid: {
            borderColor: 'rgba(226, 232, 240, 0.7)',
            strokeDashArray: 4
          },
          legend: { position: 'top', horizontalAlign: 'right', fontSize: '11px', labels: { colors: '#64748B' } },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          }
        };

        const eqEl = document.getElementById('chart-tb-equilibrium');
        if (eqEl) {
          const chart = new ApexCharts(eqEl, eqOptions);
          chart.render();
        }
      })();
    </script>
  `
}) %>
