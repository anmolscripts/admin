<%
  const bsHeaderAction = `
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-printer"></i>
        <span>Print Statement</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: pageTitle || 'Balance Sheet',
    pageSubtitle: pageSubtitle || 'Statement of financial position showing Total Assets, Total Liabilities, and Equity.',
    headerAction: bsHeaderAction
}) %>

<div class="content-wrapper p-4">

  <!-- Filters Toolbar (Glass Panel) -->
  <div class="card-glass p-3 mb-4">
    <form method="GET" action="/reports/balance-sheet" class="row g-2 align-items-center">
      <!-- FY Filter -->
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">Financial Year</label>
        <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">All Financial Years</option>
          <% if (locals.financialYears) { %>
            <% financialYears.forEach(fy => { %>
              <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                <%= fy.code %> (<%= fy.status %>)
              </option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <!-- As-Of Cutoff Date -->
      <div class="col-md-4">
        <label class="form-label small text-muted mb-1">As-Of Date</label>
        <input type="date" name="asOfDate" class="form-control form-control-sm" value="<%= filters.asOfDate || '' %>">
      </div>

      <!-- Actions -->
      <div class="col-md-4 d-flex align-items-end gap-2 pt-2">
        <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply Cutoff</button>
        <a href="/reports/balance-sheet" class="btn btn-sm btn-outline-secondary px-3" title="Reset">
          <i class="bi bi-arrow-counterclockwise"></i> Reset
        </a>
      </div>
    </form>
  </div>

  <!-- Equation Equilibrium Banner -->
  <% if (report.summary.isBalanced) { %>
    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm rounded-3" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-shield-check fs-2 text-success"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Fundamental Accounting Equation Satisfied</h6>
          <div class="small">Total Assets (₹<%= parseFloat(report.summary.totalAssets).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>) equal Total Liabilities & Equity (₹<%= parseFloat(report.summary.totalLiabilitiesAndEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>).</div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-success fs-6 px-3 py-2 rounded-pill">Assets = Liabilities + Equity</span>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm rounded-3" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-circle-fill fs-2 text-warning"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Unbalanced Balance Sheet Detected</h6>
          <div class="small">Discrepancy: ₹<%= report.summary.difference %></div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">Diff: ₹<%= report.summary.difference %></span>
      </div>
    </div>
  <% } %>

  <!-- Capital & Asset Visual Structure (ApexCharts) -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Asset Allocation Distribution</div>
            <div class="chart-subtitle">Breakdown across active asset classifications</div>
          </div>
          <i class="bi bi-wallet2 text-muted"></i>
        </div>
        <div id="chart-assets-donut" style="min-height: 270px;"></div>
      </div>
    </div>
    <div class="col-12 col-lg-6">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Capital & Funding Structure</div>
            <div class="chart-subtitle">External obligations vs owner equity capital</div>
          </div>
          <i class="bi bi-bank text-muted"></i>
        </div>
        <div id="chart-liab-equity-donut" style="min-height: 270px;"></div>
      </div>
    </div>
  </div>

  <!-- Two-Column Statement Layout -->
  <div class="row g-4 mb-4">
    <!-- LEFT COLUMN: ASSETS -->
    <div class="col-lg-6">
      <div class="card-glass overflow-hidden h-100">
        <div class="py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--sa-border) !important;">
          <h6 class="fw-bold mb-0 text-primary">
            <i class="bi bi-wallet2 me-2"></i>Assets (1000)
          </h6>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
            ₹<%= parseFloat(report.assets.totalAssets).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </span>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Asset Classification</th>
                <th style="width: 140px;">Subtype</th>
                <th class="text-end pe-4" style="width: 150px;">Balance (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.assets.items.forEach(item => { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold text-dark"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %></div>
                  </td>
                  <td class="text-muted small"><%= item.subtype || '—' %></td>
                  <td class="text-end pe-4 fw-bold text-primary">
                    ₹<%= parseFloat(item.balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr class="table-primary text-primary">
                <th colspan="2" class="ps-4 py-3 fs-6">TOTAL ASSETS:</th>
                <th class="text-end pe-4 py-3 fs-6">
                  ₹<%= parseFloat(report.assets.totalAssets).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: LIABILITIES & EQUITY -->
    <div class="col-lg-6">
      <!-- LIABILITIES -->
      <div class="card-glass overflow-hidden mb-4">
        <div class="py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--sa-border) !important;">
          <h6 class="fw-bold mb-0 text-danger">
            <i class="bi bi-credit-card me-2"></i>Liabilities (2000)
          </h6>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
            ₹<%= parseFloat(report.liabilities.totalLiabilities).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </span>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Liability Classification</th>
                <th style="width: 140px;">Subtype</th>
                <th class="text-end pe-4" style="width: 150px;">Balance (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.liabilities.items.forEach(item => { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold text-dark"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %></div>
                  </td>
                  <td class="text-muted small"><%= item.subtype || '—' %></td>
                  <td class="text-end pe-4 fw-bold text-danger">
                    ₹<%= parseFloat(item.balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th colspan="2" class="ps-4 py-2 text-danger">Total Liabilities:</th>
                <th class="text-end pe-4 py-2 text-danger fw-bold">
                  ₹<%= parseFloat(report.liabilities.totalLiabilities).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- EQUITY -->
      <div class="card-glass overflow-hidden">
        <div class="py-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="border-color: var(--sa-border) !important;">
          <h6 class="fw-bold mb-0 text-success">
            <i class="bi bi-cash-coin me-2"></i>Equity & Capital (3000)
          </h6>
          <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
            ₹<%= parseFloat(report.equity.effectiveEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </span>
        </div>
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Equity Classification</th>
                <th style="width: 140px;">Type</th>
                <th class="text-end pe-4" style="width: 150px;">Balance (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.equity.items.forEach(item => { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold text-dark"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %></div>
                  </td>
                  <td class="text-muted small"><%= item.subtype || '—' %></td>
                  <td class="text-end pe-4 fw-bold text-success">
                    ₹<%= parseFloat(item.balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
              <!-- Current Period Earnings Row -->
              <tr class="table-light">
                <td class="ps-4">
                  <div class="fw-semibold text-dark">Current Period Net Profit / (Loss)</div>
                  <div class="small text-muted fst-italic">Derived from Profit & Loss statement up to cutoff</div>
                </td>
                <td class="text-muted small">P&L Net Income</td>
                <td class="text-end pe-4 fw-bold <%= parseFloat(report.equity.currentPeriodEarnings) >= 0 ? 'text-success' : 'text-danger' %>">
                  ₹<%= parseFloat(report.equity.currentPeriodEarnings).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
              </tr>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th colspan="2" class="ps-4 py-2 text-success">Total Equity & Capital:</th>
                <th class="text-end pe-4 py-2 text-success fw-bold">
                  ₹<%= parseFloat(report.equity.effectiveEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <tr class="table-dark text-white">
                <th colspan="2" class="ps-4 py-3 fs-6">TOTAL LIABILITIES & EQUITY:</th>
                <th class="text-end pe-4 py-3 fs-6 text-warning">
                  ₹<%= parseFloat(report.summary.totalLiabilitiesAndEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer', {
  extraJs: `
    <script>
      (function() {
        if (!window.ApexCharts) return;

        // 1. Assets Donut Chart
        const assetItems = ${JSON.stringify(report.assets.items || [])};
        const assetLabels = assetItems.map(i => i.name);
        const assetBalances = assetItems.map(i => parseFloat(i.balance) || 0);
        const hasAssetData = assetBalances.some(v => v > 0);

        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        const strokeColor = isDark ? '#192731' : '#ffffff';
        const textColor = isDark ? '#A6BBC5' : '#667985';

        const assetDonutOptions = {
          series: hasAssetData ? assetBalances : [],
          labels: hasAssetData ? assetLabels : [],
          chart: {
            type: 'donut',
            height: 270,
            background: 'transparent',
            fontFamily: 'inherit'
          },
          theme: { mode: isDark ? 'dark' : 'light' },
          colors: ['#135E5A', '#16B8AF', '#65BCE8', '#B8F16A', '#9B8AFB'],
          plotOptions: {
            pie: {
              donut: {
                size: '72%',
                labels: {
                  show: true,
                  total: {
                    show: true,
                    label: 'Total Assets',
                    fontSize: '11px',
                    color: textColor,
                    formatter: function(w) {
                      const sum = w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                      return '₹' + (sum >= 1000 ? (sum / 1000).toFixed(1) + 'k' : sum.toFixed(0));
                    }
                  }
                }
              }
            }
          },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', fontSize: '11px', labels: { colors: textColor } },
          stroke: { width: 2, colors: [strokeColor] },
          tooltip: {
            theme: isDark ? 'dark' : 'light',
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          },
          noData: { text: 'No asset balances recorded', align: 'center', verticalAlign: 'middle', style: { color: '#889ba6' } }
        };

        const assetEl = document.getElementById('chart-assets-donut');
        if (assetEl) {
          const chart = new ApexCharts(assetEl, assetDonutOptions);
          chart.render();
        }

        // 2. Liabilities vs Equity Structure Donut Chart
        const totalLiabilities = ${parseFloat(report.liabilities.totalLiabilities) || 0};
        const totalEquity = ${parseFloat(report.equity.effectiveEquity) || 0};
        const fundingSeries = [totalLiabilities, totalEquity];
        const hasFunding = fundingSeries.some(v => v > 0);

        const fundingOptions = {
          series: hasFunding ? fundingSeries : [],
          labels: ['Total Liabilities', 'Total Equity & Capital'],
          chart: {
            type: 'donut',
            height: 270,
            background: 'transparent',
            fontFamily: 'inherit'
          },
          theme: { mode: isDark ? 'dark' : 'light' },
          colors: ['#FF896F', '#B8F16A'],
          plotOptions: {
            pie: {
              donut: {
                size: '72%',
                labels: {
                  show: true,
                  total: {
                    show: true,
                    label: 'Total Capital',
                    fontSize: '11px',
                    color: textColor,
                    formatter: function(w) {
                      const sum = w.globals.seriesTotals.reduce((a, b) => a + b, 0);
                      return '₹' + (sum >= 1000 ? (sum / 1000).toFixed(1) + 'k' : sum.toFixed(0));
                    }
                  }
                }
              }
            }
          },
          dataLabels: { enabled: false },
          legend: { position: 'bottom', fontSize: '11px', labels: { colors: textColor } },
          stroke: { width: 2, colors: [strokeColor] },
          tooltip: {
            theme: isDark ? 'dark' : 'light',
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          },
          noData: { text: 'No liabilities or equity recorded', align: 'center', verticalAlign: 'middle', style: { color: '#889ba6' } }
        };

        const fundingEl = document.getElementById('chart-liab-equity-donut');
        if (fundingEl) {
          const chart = new ApexCharts(fundingEl, fundingOptions);
          chart.render();
        }
      })();
    </script>
  `
}) %>
