<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-printer"></i>
        <span>Print Statement</span>
      </button>
      <a href="/reports" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>All Reports</span>
      </a>
    </div>
  </div>

  <!-- Filters Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/reports/balance-sheet" class="row g-2 align-items-center">
        <!-- FY Filter -->
        <div class="col-md-4">
          <label class="form-label small text-muted mb-1">Financial Year</label>
          <select name="financialYearId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Financial Years</option>
            <% if (locals.financialYears) { %>
              <% financialYears.forEach(fy => { %>
                <option value="<%= fy.id %>" <%= filters.financialYearId == fy.id ? 'selected' : '' %>>
                  <%= fy.code %> (<%= fy.status %>)
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- As-Of Cutoff Date -->
        <div class="col-md-4">
          <label class="form-label small text-muted mb-1">As-Of Date</label>
          <input type="date" name="asOfDate" class="form-control form-control-sm" value="<%= filters.asOfDate || '' %>">
        </div>

        <!-- Actions -->
        <div class="col-md-4 d-flex align-items-end gap-2 pt-4">
          <button type="submit" class="btn btn-sm btn-primary flex-grow-1">Apply Cutoff</button>
          <a href="/reports/balance-sheet" class="btn btn-sm btn-outline-secondary" title="Reset">
            <i class="bi bi-x-lg"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Equation Equilibrium Banner -->
  <% if (report.summary.isBalanced) { %>
    <div class="alert alert-success d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-shield-check fs-2 text-success"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Fundamental Accounting Equation Satisfied</h6>
          <div class="small">Total Assets (₹<%= parseFloat(report.summary.totalAssets).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>) equal Total Liabilities & Equity (₹<%= parseFloat(report.summary.totalLiabilitiesAndEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>).</div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-success fs-6 px-3 py-2">Assets = Liabilities + Equity</span>
      </div>
    </div>
  <% } else { %>
    <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 border-0 shadow-sm" role="alert">
      <div class="d-flex align-items-center gap-3">
        <i class="bi bi-exclamation-circle-fill fs-2 text-warning"></i>
        <div>
          <h6 class="alert-heading fw-bold mb-0">Unbalanced Balance Sheet Detected</h6>
          <div class="small">Discrepancy: ₹<%= report.summary.difference %></div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-warning text-dark fs-6 px-3 py-2">Diff: ₹<%= report.summary.difference %></span>
      </div>
    </div>
  <% } %>

  <!-- Two-Column Statement Layout -->
  <div class="row g-4 mb-4">
    <!-- LEFT COLUMN: ASSETS -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0 text-primary">
            <i class="bi bi-wallet2 me-2"></i>Assets (1000)
          </h6>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
            ₹<%= parseFloat(report.assets.totalAssets).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </span>
        </div>
        <div class="card-body p-0">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Asset Classification</th>
                <th style="width: 140px;">Subtype</th>
                <th class="text-end pe-3" style="width: 150px;">Balance (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.assets.items.forEach(item => { %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %></div>
                  </td>
                  <td class="text-muted small"><%= item.subtype || '—' %></td>
                  <td class="text-end pe-3 fw-bold text-primary">
                    ₹<%= parseFloat(item.balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr class="table-primary text-primary">
                <th colspan="2" class="ps-3 py-3 fs-6">TOTAL ASSETS:</th>
                <th class="text-end pe-3 py-3 fs-6">
                  ₹<%= parseFloat(report.assets.totalAssets).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: LIABILITIES & EQUITY -->
    <div class="col-lg-6">
      <!-- LIABILITIES -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0 text-danger">
            <i class="bi bi-credit-card me-2"></i>Liabilities (2000)
          </h6>
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
            ₹<%= parseFloat(report.liabilities.totalLiabilities).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </span>
        </div>
        <div class="card-body p-0">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Liability Classification</th>
                <th style="width: 140px;">Subtype</th>
                <th class="text-end pe-3" style="width: 150px;">Balance (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.liabilities.items.forEach(item => { %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %></div>
                  </td>
                  <td class="text-muted small"><%= item.subtype || '—' %></td>
                  <td class="text-end pe-3 fw-bold text-danger">
                    ₹<%= parseFloat(item.balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th colspan="2" class="ps-3 py-2 text-danger">Total Liabilities:</th>
                <th class="text-end pe-3 py-2 text-danger fw-bold">
                  ₹<%= parseFloat(report.liabilities.totalLiabilities).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- EQUITY -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0 text-success">
            <i class="bi bi-cash-coin me-2"></i>Equity & Capital (3000)
          </h6>
          <span class="badge bg-success-subtle text-success border border-success-subtle">
            ₹<%= parseFloat(report.equity.effectiveEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </span>
        </div>
        <div class="card-body p-0">
          <table class="table align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">Equity Classification</th>
                <th style="width: 140px;">Type</th>
                <th class="text-end pe-3" style="width: 150px;">Balance (₹)</th>
              </tr>
            </thead>
            <tbody>
              <% report.equity.items.forEach(item => { %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold"><%= item.name %></div>
                    <div class="small text-muted font-monospace"><%= item.code %></div>
                  </td>
                  <td class="text-muted small"><%= item.subtype || '—' %></td>
                  <td class="text-end pe-3 fw-bold text-success">
                    ₹<%= parseFloat(item.balance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                </tr>
              <% }); %>
              <!-- Current Period Earnings Row -->
              <tr class="table-light">
                <td class="ps-3">
                  <div class="fw-semibold">Current Period Net Profit / (Loss)</div>
                  <div class="small text-muted fst-italic">Derived from Profit & Loss statement up to cutoff</div>
                </td>
                <td class="text-muted small">P&L Net Income</td>
                <td class="text-end pe-3 fw-bold <%= parseFloat(report.equity.currentPeriodEarnings) >= 0 ? 'text-success' : 'text-danger' %>">
                  ₹<%= parseFloat(report.equity.currentPeriodEarnings).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
              </tr>
            </tbody>
            <tfoot class="table-light border-top">
              <tr>
                <th colspan="2" class="ps-3 py-2 text-success">Total Equity & Capital:</th>
                <th class="text-end pe-3 py-2 text-success fw-bold">
                  ₹<%= parseFloat(report.equity.effectiveEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
              <tr class="table-dark text-white">
                <th colspan="2" class="ps-3 py-3 fs-6">TOTAL LIABILITIES & EQUITY:</th>
                <th class="text-end pe-3 py-3 fs-6 text-warning">
                  ₹<%= parseFloat(report.summary.totalLiabilitiesAndEquity).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </th>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
