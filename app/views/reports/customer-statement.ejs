<%- include('../layouts/header', { showPageHeader: false }) %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="page-title fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (report && report.client) { %>
        <a href="/reports/customer-statement/<%= report.client.id %>/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-outline-success d-inline-flex align-items-center gap-2 px-3" id="btn-export-subledger">
          <i class="bi bi-file-earmark-spreadsheet"></i>
          <span>Export Sub-Ledger (CSV)</span>
        </a>
      <% } %>
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-printer"></i>
        <span>Print Statement</span>
      </button>
      <a href="/reports/customer-receivables" class="btn btn-outline-primary d-inline-flex align-items-center gap-2 px-3">
        <i class="bi bi-arrow-left"></i>
        <span>Customer Receivables</span>
      </a>
    </div>
  </div>

  <!-- Customer Selector & Date Range Filter Card (Glass Panel) -->
  <div class="card-glass p-4 mb-4">
    <div class="row g-3 align-items-end">
      <!-- Partial Client Search / Selector -->
      <div class="col-md-5">
        <label class="form-label small text-muted mb-1 fw-semibold">Customer / Client Account</label>
        <select id="subledgerClientSelect" name="clientId" class="form-select form-select-sm" data-tom-select="true" onchange="if(this.value) window.location.href='/reports/customer-statement/' + this.value + (window.location.search ? window.location.search : '')">
          <option value="">— Search or Select Client (Name, GSTIN, Phone) —</option>
          <% (clients || []).forEach(c => { %>
            <option value="<%= c.id %>" <%= (selectedClientId && selectedClientId == c.id) ? 'selected' : '' %>>
              <%= c.name %><%= c.gstin ? ' [' + c.gstin + ']' : (c.phone ? ' (' + c.phone + ')' : '') %>
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Date Range Filter Form -->
      <div class="col-md-7">
        <% if (report && report.client) { %>
        <form method="GET" action="/reports/customer-statement/<%= report.client.id %>" class="row g-2 align-items-end">
          <div class="col-sm-9">
            <label class="form-label small text-muted mb-1 fw-semibold">Sub-Ledger Date Range</label>
            <div class="spark-daterange-picker w-100" data-from-name="fromDate" data-to-name="toDate" data-auto-submit="true">
              <div class="d-flex align-items-center gap-1">
                <button class="btn-date-picker btn-date-picker-sm flex-grow-1" type="button" aria-label="Select date range">
                  <span class="d-flex align-items-center gap-2 text-truncate">
                    <i class="bi bi-calendar4-event text-primary"></i>
                    <span class="spark-daterange-label text-truncate">All Dates</span>
                  </span>
                  <i class="bi bi-chevron-down text-muted ms-auto"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-daterange-clear d-none" title="Clear date range" aria-label="Clear date range">
                  <i class="bi bi-x-lg"></i>
                </button>
              </div>
              <input type="hidden" name="fromDate" value="<%= filters.fromDate || '' %>">
              <input type="hidden" name="toDate" value="<%= filters.toDate || '' %>">
            </div>
          </div>
          <div class="col-sm-3">
            <button type="submit" class="btn btn-sm btn-primary w-100">Filter Range</button>
          </div>
        </form>
        <% } %>
      </div>
    </div>

    <% if (report && report.client) { %>
    <hr class="my-3 opacity-10">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-1">
      <div class="d-flex align-items-center gap-3">
        <div class="p-2 rounded-circle" style="background: rgba(22, 184, 175, 0.12); color: #16B8AF;">
          <i class="bi bi-person-check-fill fs-4"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-0 text-dark"><%= report.client.name %></h5>
          <div class="text-muted small">
            <% if (report.client.gstin) { %>
              <span class="me-3"><strong>GSTIN:</strong> <%= report.client.gstin %></span>
            <% } %>
            <% if (report.client.phone) { %>
              <span class="me-3"><strong>Phone:</strong> <%= report.client.phone %></span>
            <% } %>
            <% if (report.client.email) { %>
              <span><strong>Email:</strong> <%= report.client.email %></span>
            <% } %>
          </div>
        </div>
      </div>
      <div class="text-end">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 font-monospace">
          Subledger Account: 1121 — Accounts Receivable
        </span>
      </div>
    </div>
    <% } %>
  </div>

  <% if (!report || !report.client) { %>
    <div class="card-glass p-5 text-center mb-4">
      <i class="bi bi-person-lines-fill fs-1 text-muted d-block mb-3"></i>
      <h5 class="fw-bold text-dark">No Customer Account Selected</h5>
      <p class="text-muted small mb-0">Please search and select a client from the dropdown above to view their comprehensive sub-ledger transactions and ledger balance movements.</p>
    </div>
  <% } else { %>

  <!-- Statement Summary KPI Strip (Glass KPI Cards) -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-blue"></div>
        <div class="kpi-label">Opening Balance</div>
        <div class="kpi-value mt-2 font-monospace">₹<%= parseFloat(report.statement.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Prior period balance</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-cyan"></div>
        <div class="kpi-label">Period Debits (Invoiced)</div>
        <div class="kpi-value text-primary mt-2 font-monospace">₹<%= parseFloat(report.statement.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Invoices & debit notes</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-green"></div>
        <div class="kpi-label">Period Credits (Paid)</div>
        <div class="kpi-value text-success mt-2 font-monospace">₹<%= parseFloat(report.statement.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Receipts & credit notes</div>
      </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="kpi-card">
        <div class="kpi-accent-bar accent-purple"></div>
        <div class="kpi-label">Closing Balance Due</div>
        <div class="kpi-value text-dark mt-2 font-monospace">₹<%= parseFloat(report.statement.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
        <div class="kpi-subtext">Effective receivable</div>
      </div>
    </div>
  </div>

  <!-- Statement Balance Trend Chart -->
  <div class="row g-3 mb-4">
    <div class="col-12">
      <div class="chart-card">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <div class="chart-title">Customer Balance History & Settlement Flow</div>
            <div class="chart-subtitle">Chronological ledger movement of invoice obligations and payment receipts</div>
          </div>
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace">INR (₹)</span>
        </div>
        <div id="chart-statement-trend" style="min-height: 270px;"></div>
      </div>
    </div>
  </div>

  <!-- Customer Statement Transactions Table (Glass Panel) -->
  <div class="card-glass overflow-hidden mb-4">
    <div class="py-3 px-4 border-bottom bg-white d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0 text-dark">Customer Account Statement Transactions</h6>
      <span class="badge bg-light text-dark border"><%= report.transactions.length %> Transaction(s)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4" style="width: 110px;">Date</th>
            <th style="width: 140px;">Journal #</th>
            <th style="width: 120px;">Source</th>
            <th>Particulars & Narration</th>
            <th class="text-end" style="width: 140px;">Debit (₹)</th>
            <th class="text-end" style="width: 140px;">Credit (₹)</th>
            <th class="text-end pe-4" style="width: 150px;">Running Balance (₹)</th>
          </tr>
        </thead>
        <tbody>
          <!-- Opening Balance Row -->
          <tr class="table-light">
            <td class="ps-4 text-muted fst-italic">—</td>
            <td colspan="3" class="fw-semibold text-muted fst-italic">Opening Balance</td>
            <td class="text-end text-muted font-monospace">—</td>
            <td class="text-end text-muted font-monospace">—</td>
            <td class="text-end pe-4 fw-bold font-monospace">₹<%= parseFloat(report.statement.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
          </tr>
          <% if (report.transactions.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                No transactions recorded for this customer in the selected date range.
              </td>
            </tr>
          <% } else { %>
            <% report.transactions.forEach(t => { %>
              <tr class="report-row-clickable cursor-pointer" data-source-type="<%= t.sourceType %>" data-source-id="<%= t.sourceId || '' %>" data-journal-id="<%= t.journalId %>" data-source-ref="<%= t.entryNumber %>" title="Click to view transaction details in modal">
                <td class="ps-4 text-nowrap small text-muted"><%= new Date(t.entryDate).toLocaleDateString('en-IN') %></td>
                <td class="font-monospace fw-bold">
                  <% if (t.journalId) { %>
                    <a href="/reports/journals/<%= t.journalId %>" class="text-decoration-none text-primary" onclick="event.stopPropagation()">
                      <%= t.entryNumber %>
                    </a>
                  <% } else { %>
                    <span class="text-warning-emphasis"><%= t.entryNumber %></span>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-secondary-subtle text-secondary font-monospace" style="font-size: 0.72rem;"><%= t.sourceType %> <%= t.sourceId ? '#' + t.sourceId : '' %></span>
                  <% if (t.status === 'UNPOSTED') { %>
                    <span class="badge bg-warning-subtle text-warning ms-1">NOT POSTED</span>
                  <% } %>
                </td>
                <td>
                  <div class="fw-medium text-dark small"><%= t.narration %></div>
                  <% if (t.description) { %>
                    <div class="small text-muted" style="font-size: 0.72rem;"><%= t.description %></div>
                  <% } %>
                </td>
                <td class="text-end fw-bold font-monospace text-primary">
                  <%= parseFloat(t.debit) > 0 ? '₹' + parseFloat(t.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end fw-bold font-monospace text-success">
                  <%= parseFloat(t.credit) > 0 ? '₹' + parseFloat(t.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end pe-4 fw-bold font-monospace text-dark">
                  ₹<%= parseFloat(t.runningBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
        <tfoot class="table-light border-top">
          <tr>
            <th colspan="4" class="text-end ps-4 py-3 fw-bold">Period Totals & Final Balance:</th>
            <th class="text-end py-3 text-primary fw-bold font-monospace">
              ₹<%= parseFloat(report.statement.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
            </th>
            <th class="text-end py-3 text-success fw-bold font-monospace">
              ₹<%= parseFloat(report.statement.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
            </th>
            <th class="text-end pe-4 py-3 fw-bold fs-6 font-monospace">
              ₹<%= parseFloat(report.statement.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
            </th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
  <% } %>
</div>

<%
  const statementDates = report ? ['Opening', ...(report.transactions || []).map(t => new Date(t.entryDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }))] : [];
  const statementBalances = report ? [parseFloat(report.statement.openingBalance) || 0, ...(report.transactions || []).map(t => parseFloat(t.runningBalance) || 0)] : [];
%>

<%- include('../layouts/footer', {
  extraJs: `
    <script src="/js/report-drilldown.js"></script>
    <script>
      (function() {
        if (!window.ApexCharts) return;

        const trendOptions = {
          series: [{
            name: 'Running Due Balance',
            data: ${JSON.stringify(statementBalances)}
          }],
          chart: {
            type: 'area',
            height: 270,
            toolbar: { show: false },
            fontFamily: 'inherit'
          },
          colors: ['#16B8AF'],
          fill: {
            type: 'gradient',
            gradient: { shadeIntensity: 1, opacityFrom: 0.45, opacityTo: 0.05, stops: [20, 100] }
          },
          dataLabels: { enabled: false },
          stroke: { curve: 'smooth', width: 2.5 },
          xaxis: {
            categories: ${JSON.stringify(statementDates)},
            labels: { style: { fontSize: '11px', colors: '#64748B' } }
          },
          yaxis: {
            labels: {
              formatter: function(val) {
                return '₹' + (val >= 1000 ? (val / 1000).toFixed(0) + 'k' : val.toFixed(0));
              },
              style: { fontSize: '11px', colors: '#64748B' }
            }
          },
          grid: {
            borderColor: 'rgba(226, 232, 240, 0.7)',
            strokeDashArray: 4
          },
          tooltip: {
            y: {
              formatter: function(val) {
                return '₹' + Number(val).toLocaleString('en-IN', { minimumFractionDigits: 2 });
              }
            }
          }
        };

        const trendEl = document.getElementById('chart-statement-trend');
        if (trendEl) {
          const chart = new ApexCharts(trendEl, trendOptions);
          chart.render();
        }
      })();
    </script>
  `
}) %>
