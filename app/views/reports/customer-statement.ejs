<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-printer"></i>
        <span>Print Statement</span>
      </button>
      <a href="/reports/customer-receivables" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-arrow-left"></i>
        <span>Receivables Schedule</span>
      </a>
    </div>
  </div>

  <!-- Customer Detail & Filters Card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row g-4 align-items-center">
        <!-- Customer Info -->
        <div class="col-md-6 border-end">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle">
              <i class="bi bi-person-fill fs-3"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-1"><%= report.client.name %></h5>
              <div class="text-muted small">
                <% if (report.client.gstin) { %>
                  <span class="me-2"><strong>GSTIN:</strong> <%= report.client.gstin %></span>
                <% } %>
                <% if (report.client.phone) { %>
                  <span class="me-2"><strong>Phone:</strong> <%= report.client.phone %></span>
                <% } %>
                <% if (report.client.email) { %>
                  <span><strong>Email:</strong> <%= report.client.email %></span>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Date Range Filter -->
        <div class="col-md-6">
          <form method="GET" action="/reports/customer-statement/<%= report.client.id %>" class="row g-2 align-items-end">
            <div class="col-sm-5">
              <label class="form-label small text-muted mb-1">From Date</label>
              <input type="date" name="fromDate" class="form-control form-control-sm" value="<%= filters.fromDate || '' %>">
            </div>
            <div class="col-sm-5">
              <label class="form-label small text-muted mb-1">To Date</label>
              <input type="date" name="toDate" class="form-control form-control-sm" value="<%= filters.toDate || '' %>">
            </div>
            <div class="col-sm-2">
              <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Statement Summary KPI Strip -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Opening Balance</div>
          <div class="fs-4 fw-bold mt-1">₹<%= parseFloat(report.statement.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Prior period balance</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Period Debits (Invoiced)</div>
          <div class="fs-4 fw-bold text-primary mt-1">₹<%= parseFloat(report.statement.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Invoices & debit notes</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Period Credits (Paid)</div>
          <div class="fs-4 fw-bold text-success mt-1">₹<%= parseFloat(report.statement.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Receipts & credit notes</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body p-3">
          <div class="text-muted small text-uppercase fw-bold">Closing Balance Due</div>
          <div class="fs-4 fw-bold text-dark mt-1">₹<%= parseFloat(report.statement.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></div>
          <div class="small text-muted">Effective receivable</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Customer Statement Transactions Table -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <h6 class="fw-bold mb-0">Customer Account Statement Transactions</h6>
      <span class="badge bg-light text-dark border"><%= report.transactions.length %> Transaction(s)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-3" style="width: 110px;">Date</th>
            <th style="width: 140px;">Journal #</th>
            <th style="width: 120px;">Source</th>
            <th>Particulars & Narration</th>
            <th class="text-end" style="width: 140px;">Debit (₹)</th>
            <th class="text-end" style="width: 140px;">Credit (₹)</th>
            <th class="text-end pe-3" style="width: 150px;">Running Balance (₹)</th>
          </tr>
        </thead>
        <tbody>
          <!-- Opening Balance Row -->
          <tr class="table-light">
            <td class="ps-3 text-muted fst-italic">—</td>
            <td colspan="3" class="fw-semibold text-muted fst-italic">Opening Balance</td>
            <td class="text-end">—</td>
            <td class="text-end">—</td>
            <td class="text-end pe-3 fw-bold">₹<%= parseFloat(report.statement.openingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
          </tr>
          <% if (report.transactions.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                No transactions recorded for this customer in the selected date range.
              </td>
            </tr>
          <% } else { %>
            <% report.transactions.forEach(t => { %>
              <tr>
                <td class="ps-3 text-nowrap"><%= new Date(t.entryDate).toLocaleDateString('en-IN') %></td>
                <td>
                  <a href="/reports/journals/<%= t.journalId %>" class="fw-bold text-decoration-none">
                    <%= t.entryNumber %>
                  </a>
                </td>
                <td>
                  <span class="badge bg-light text-dark border"><%= t.sourceType %> <%= t.sourceId ? '#' + t.sourceId : '' %></span>
                </td>
                <td>
                  <div class="fw-semibold"><%= t.narration %></div>
                  <% if (t.description) { %>
                    <div class="small text-muted"><%= t.description %></div>
                  <% } %>
                </td>
                <td class="text-end fw-bold text-primary">
                  <%= parseFloat(t.debit) > 0 ? '₹' + parseFloat(t.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end fw-bold text-success">
                  <%= parseFloat(t.credit) > 0 ? '₹' + parseFloat(t.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end pe-3 fw-bold">
                  ₹<%= parseFloat(t.runningBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
        <tfoot class="table-light border-top">
          <tr>
            <th colspan="4" class="text-end ps-3 py-3 fw-bold">Period Totals & Final Balance:</th>
            <th class="text-end py-3 text-primary fw-bold">
              ₹<%= parseFloat(report.statement.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
            </th>
            <th class="text-end py-3 text-success fw-bold">
              ₹<%= parseFloat(report.statement.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
            </th>
            <th class="text-end pe-3 py-3 fw-bold fs-6">
              ₹<%= parseFloat(report.statement.closingBalance).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
            </th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
