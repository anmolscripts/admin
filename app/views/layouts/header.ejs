<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= pageTitle || 'Spark Admin' %>
  </title>

  <meta name="description" content="Spark Admin - Premium Bootstrap 5 Admin Dashboard Template" />
  <meta name="author" content="Spark Admin Team" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.ico" />

  <!-- Bootstrap -->
  <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css" />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="/libs/bootstrap-icons/bootstrap-icons.css" />

  <!-- ApexCharts -->
  <link rel="stylesheet" href="/libs/apexcharts/apexcharts.css" />

  <!-- Flatpickr -->
  <link rel="stylesheet" href="/libs/flatpickr/flatpickr.min.css" />

  <!-- Spark Admin -->
  <link rel="stylesheet" href="/css/main.css" />
  <% if (locals.extraCss) { %>
    <%- locals.extraCss %>
  <% } %>
</head>

<%
  const currentNavPath = locals.currentPath || '';
  const currentNavTitle = (locals.pageTitle || '').toLowerCase();

  const isDashboard = currentNavPath === '/dashboard' || currentNavTitle.includes('dashboard');
  const isDocuments = (currentNavPath.startsWith('/documents') || currentNavPath === '/' || currentNavTitle.includes('quotation') || currentNavTitle.includes('invoice')) && !currentNavTitle.includes('client') && !currentNavTitle.includes('item') && !currentNavTitle.includes('unit') && !currentNavTitle.includes('team');
  const isClients = currentNavPath.startsWith('/clients') || currentNavTitle.includes('client');
  const isItems = currentNavPath.startsWith('/items') || currentNavTitle.includes('item');
  const isUnits = currentNavPath.startsWith('/units') || currentNavTitle.includes('unit');
  const isTeam = currentNavPath.startsWith('/team') || currentNavTitle.includes('team');
  const isSettings = currentNavPath.startsWith('/settings') || currentNavTitle.includes('setting') || currentNavTitle.includes('organization');

  // Permission resolution for dynamic navigation visibility
  const canViewTeam = typeof locals.hasPermission === 'function' ? locals.hasPermission('TEAM', 'VIEW') : (locals.user && (locals.user.role === 'ADMIN' || locals.user.role === 'OWNER'));
%>

<body>
  <div class="sidebar-wrapper" id="sidebar">
    <!-- Brand Logo / Identity -->
    <a href="/dashboard" class="sidebar-brand">
      <i class="bi bi-asterisk"></i>
      <span>Spark Admin</span>
    </a>

    <!-- Authoritative Navigation Menu -->
    <div class="flex-grow-1 overflow-y-auto">
      <div class="sidebar-menu-section">
        <div class="sidebar-menu-title">MENU</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item">
            <a href="/dashboard" class="sidebar-menu-link <%= isDashboard ? 'active' : '' %>" id="menu-dashboard" title="Dashboard">
              <i class="bi bi-grid-fill"></i>
              <span>Dashboard</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/documents" class="sidebar-menu-link <%= isDocuments ? 'active' : '' %>" id="menu-documents" title="Documents">
              <i class="bi bi-file-earmark-text-fill"></i>
              <span>Documents</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/clients" class="sidebar-menu-link <%= isClients ? 'active' : '' %>" id="menu-clients" title="Clients">
              <i class="bi bi-people-fill"></i>
              <span>Clients</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/items" class="sidebar-menu-link <%= isItems ? 'active' : '' %>" id="menu-items" title="Items">
              <i class="bi bi-box-seam-fill"></i>
              <span>Items</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/units" class="sidebar-menu-link <%= isUnits ? 'active' : '' %>" id="menu-units" title="Units">
              <i class="bi bi-rulers"></i>
              <span>Units</span>
            </a>
          </li>
          <% if (canViewTeam) { %>
          <li class="sidebar-menu-item">
            <a href="/team" class="sidebar-menu-link <%= isTeam ? 'active' : '' %>" id="menu-team" title="Team">
              <i class="bi bi-person-badge-fill"></i>
              <span>Team</span>
            </a>
          </li>
          <% } %>
          <li class="sidebar-menu-item">
            <a href="/settings" class="sidebar-menu-link <%= isSettings ? 'active' : '' %>" id="menu-settings" title="Settings">
              <i class="bi bi-gear-fill"></i>
              <span>Settings</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Sidebar Profile Card (Dynamic Footer) -->
    <div class="sidebar-profile">
      <img src="/images/avatar.png" alt="Administrator" class="sidebar-profile-img"
        onerror="this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=256&auto=format&fit=crop'">
      <div class="sidebar-profile-info">
        <div class="sidebar-profile-name"><%= locals.user ? locals.user.name : 'Administrator' %></div>
        <div class="sidebar-profile-email"><%= locals.user ? locals.user.email : 'admin@email.com' %></div>
      </div>
    </div>
  </div>


  <div class="main-wrapper">
    <!-- START: Top Navbar -->
    <header class="navbar-custom">
      <div class="navbar-left">
        <!-- Mobile sidebar toggle -->
        <button class="sidebar-toggle-btn me-2" id="sidebar-toggle" aria-label="Toggle Navigation">
          <i class="bi bi-list"></i>
        </button>

        <!-- Navigation Links -->
        <nav class="d-none d-md-flex align-items-center ms-3 gap-2">
          <a href="/dashboard" class="btn btn-sm <%= isDashboard ? 'btn-primary' : 'btn-light border' %>">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
          </a>
          <a href="/documents" class="btn btn-sm <%= isDocuments ? 'btn-primary' : 'btn-light border' %>">
            <i class="bi bi-file-earmark-text me-1"></i> Documents
          </a>
          <a href="/clients" class="btn btn-sm <%= isClients ? 'btn-primary' : 'btn-light border' %>">
            <i class="bi bi-people me-1"></i> Clients
          </a>
          <a href="/items" class="btn btn-sm <%= isItems ? 'btn-primary' : 'btn-light border' %>">
            <i class="bi bi-box-seam me-1"></i> Items
          </a>
          <a href="/units" class="btn btn-sm <%= isUnits ? 'btn-primary' : 'btn-light border' %>">
            <i class="bi bi-rulers me-1"></i> Units
          </a>
          <% if (canViewTeam) { %>
          <a href="/team" class="btn btn-sm <%= isTeam ? 'btn-primary' : 'btn-light border' %>" id="topnav-team">
            <i class="bi bi-person-badge me-1"></i> Team
          </a>
          <% } %>
          <a href="/settings" class="btn btn-sm <%= isSettings ? 'btn-primary' : 'btn-light border' %>">
            <i class="bi bi-gear me-1"></i> Settings
          </a>
        </nav>

        <!-- Create Dropdown -->
        <div class="dropdown ms-2">
          <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-plus-lg me-1"></i> New
          </button>
          <ul class="dropdown-menu dropdown-menu-quick-action shadow-sm">
            <li>
              <a class="dropdown-item" href="/documents/new?type=INVOICE">
                <i class="bi bi-receipt text-primary me-2"></i> New Invoice
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/documents/new?type=QUOTATION">
                <i class="bi bi-file-earmark-text text-info me-2"></i> New Quotation
              </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
              <a class="dropdown-item" href="/clients/new">
                <i class="bi bi-person-plus text-success me-2"></i> New Client
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/units">
                <i class="bi bi-rulers text-secondary me-2"></i> New Unit
              </a>
            </li>
            <% if (typeof locals.hasPermission === 'function' ? (locals.hasPermission('TEAM', 'CREATE') || locals.hasPermission('TEAM', 'MANAGE')) : (locals.user && (locals.user.role === 'ADMIN' || locals.user.role === 'OWNER'))) { %>
            <li>
              <a class="dropdown-item" href="/team?action=invite">
                <i class="bi bi-person-plus text-warning me-2"></i> New Team Member
              </a>
            </li>
            <% } %>
          </ul>
        </div>
      </div>

      <!-- Search -->
      <div class="navbar-search-wrapper">
        <input type="text" class="navbar-search-input" placeholder="Search anything in Spark..." id="main-search" />

        <button class="navbar-search-btn" aria-label="Search">
          <i class="bi bi-search"></i>
        </button>
      </div>

      <!-- Right actions -->
      <div class="navbar-actions">
        <!-- Fullscreen -->
        <button class="navbar-action-btn me-1" aria-label="Toggle Fullscreen" id="btn-fullscreen">
          <i class="bi bi-arrows-fullscreen"></i>
        </button>

        <!-- Notifications -->
        <div class="dropdown">
          <button class="navbar-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" id="btn-notifications">
            <i class="bi bi-bell"></i>

            <span class="navbar-action-badge"></span>
          </button>

          <div class="dropdown-menu dropdown-menu-end dropdown-menu-notification p-0">
            <div class="notification-header">
              <h6 class="notification-title">Notifications</h6>

              <button class="btn-clear-all" type="button">
                Mark all read
              </button>
            </div>

            <div class="notification-list">
              <a href="#" class="notification-item">
                <div class="notification-icon bg-success text-white">
                  <i class="bi bi-wallet2"></i>
                </div>

                <div class="notification-content">
                  <p class="notification-text">
                    New sale received:
                    <strong>$150.00</strong>
                  </p>

                  <span class="notification-time"> 2 mins ago </span>
                </div>

                <span class="notification-unread-dot"></span>
              </a>

              <a href="#" class="notification-item">
                <div class="notification-icon bg-primary text-white">
                  <i class="bi bi-person-plus-fill"></i>
                </div>

                <div class="notification-content">
                  <p class="notification-text">
                    New user registered:
                    <strong><span class="profile-name">
                        <%= user ? user.name : 'Guest' %>
                      </span></strong>
                  </p>

                  <span class="notification-time"> 1 hour ago </span>
                </div>

                <span class="notification-unread-dot"></span>
              </a>

              <a href="#" class="notification-item">
                <div class="notification-icon bg-warning text-dark">
                  <i class="bi bi-box-seam-fill"></i>
                </div>

                <div class="notification-content">
                  <p class="notification-text">
                    Stock running low:
                    <strong>Hoodie</strong>
                  </p>

                  <span class="notification-time"> 3 hours ago </span>
                </div>
              </a>
            </div>

            <a href="#" class="notification-footer">
              View All Notifications
            </a>
          </div>
        </div>

        <!-- Profile -->
        <div class="dropdown ms-2">
          <button class="navbar-profile-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" id="profile-dropdown">
            <img src="/images/avatar.png" alt="Profile Image" class="navbar-profile-img" />

            <span class="navbar-profile-name d-none d-md-inline">
              <span class="profile-name">
                <%= locals.user ? locals.user.name : 'Guest' %>
              </span>
            </span>

            <i class="bi bi-chevron-down navbar-profile-caret"></i>
          </button>

          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile">
            <li class="dropdown-header">Welcome !</li>

            <li>
              <a class="dropdown-item" href="#">
                <i class="bi bi-person"></i>
                <span class="profile-email">
                  <%= locals.user ? locals.user.email : '' %>
                </span>
              </a>
            </li>

            <li>
              <a class="dropdown-item" href="/settings">
                <i class="bi bi-gear"></i>
                Settings
              </a>
            </li>

            <li>
              <a class="dropdown-item" href="#">
                <i class="bi bi-lock"></i>
                Lock Screen
              </a>
            </li>

            <li>
              <hr class="dropdown-divider" />
            </li>

            <li>
              <form action="/logout" method="POST" class="m-0 p-0" id="logout-form">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <button type="submit" class="dropdown-item">
                  <i class="bi bi-box-arrow-right me-2"></i>
                  Logout
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </header>
    <!-- END: Top Navbar -->

    <!-- START: Page Header -->

    <div class="page-header">
      <div>
        <h1 class="page-title">
          <%= pageTitle || 'Dashboard' %>
        </h1>

        <p class="page-subtitle">
          <%= locals.pageSubtitle || 'An easy way to manage sales with care and precision.' %>
        </p>
      </div>

      <% if (locals.headerAction) { %>
        <%- locals.headerAction %>
      <% } else { %>
        <button class="btn-date-picker" type="button" id="date-picker-trigger">
          <i class="bi bi-calendar4-event"></i>

          <span id="selected-date-range">
            January 12, 2026 - January 23, 2026
          </span>

          <i class="bi bi-chevron-down ms-1"></i>
        </button>
      <% } %>
    </div>

    <!-- END: Page Header -->