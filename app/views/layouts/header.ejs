<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= pageTitle || 'Spark Admin' %> | <%= (locals.branding && locals.branding.workspaceName) || 'Spark Admin' %>
  </title>

  <script>
    (function () {
      try {
        var savedTheme = localStorage.getItem('spark-theme');
        var theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        var isMinimized = localStorage.getItem('spark-sidebar-minimized');
        if (isMinimized === 'true') {
          document.documentElement.classList.add('sidebar-minimized');
        } else if (isMinimized === 'false') {
          document.documentElement.classList.remove('sidebar-minimized');
        }
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <meta name="description" content="Spark Admin - Professional Accounting & Invoicing ERP" />
  <meta name="author" content="Spark Admin" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.ico" />

  <link rel="stylesheet" href="/libs/sweetalert2/sweetalert2.min.css" />
  <!-- Bootstrap -->
  <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css" />

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="/libs/bootstrap-icons/bootstrap-icons.css" />

  <!-- ApexCharts -->
  <link rel="stylesheet" href="/libs/apexcharts/apexcharts.css" />

  <!-- Flatpickr -->
  <link rel="stylesheet" href="/libs/flatpickr/flatpickr.min.css" />

  <!-- Tom Select -->
  <link rel="stylesheet" href="/libs/tom-select/css/tom-select.bootstrap5.min.css" />

  <!-- Spark Admin -->
  <link rel="stylesheet" href="/css/main.css" />
  <link rel="stylesheet" href="/css/spark-datatable.css" />
  <% if (locals.extraCss) { %>
    <%- locals.extraCss %>
  <% } %>
  <!-- Loaded last so semantic colors remain consistent across every screen. -->
  <link rel="stylesheet" href="/css/premium-refresh.css" />
  <link rel="stylesheet" href="/css/components.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
</head>

<%
  const currentNavPath = locals.currentPath || '';
  const currentNavTitle = (locals.pageTitle || '').toLowerCase();

  const isDashboard = currentNavPath === '/dashboard' || currentNavTitle.includes('dashboard');
  const isDocuments = (currentNavPath.startsWith('/documents') || currentNavPath === '/' || currentNavTitle.includes('quotation') || currentNavTitle.includes('invoice')) && !currentNavTitle.includes('client') && !currentNavTitle.includes('item') && !currentNavTitle.includes('unit') && !currentNavTitle.includes('team');
  const isClients = currentNavPath.startsWith('/clients') || currentNavTitle.includes('client');
  const isItems = currentNavPath.startsWith('/items') || currentNavTitle.includes('item');
  const isUnits = currentNavPath.startsWith('/units') || currentNavTitle.includes('unit');
  const isTeam = currentNavPath.startsWith('/team') || currentNavTitle.includes('team');
  const isReports = currentNavPath.startsWith('/reports') || Boolean(locals.isReports) || currentNavTitle.includes('report') || currentNavTitle.includes('ledger') || currentNavTitle.includes('trial balance') || currentNavTitle.includes('balance sheet') || currentNavTitle.includes('profit & loss') || currentNavTitle.includes('receivables') || currentNavTitle.includes('journal');
  const isSettings = currentNavPath
    ? /^\/settings(?:\/|$)/.test(currentNavPath)
    : currentNavTitle.includes('setting') || currentNavTitle.includes('organization');
  const isProjects = currentNavPath.startsWith('/projects') || currentNavTitle.includes('project');
  const isSuppliers = currentNavPath.startsWith('/suppliers') || currentNavTitle.includes('supplier');
  const isPurchases = Boolean(locals.isPurchaseNavigationActive);

  // Permission resolution for dynamic navigation visibility
  const canViewProjects = typeof locals.hasPermission === 'function' ? locals.hasPermission('PROJECTS', 'VIEW') : true;
  const canViewSuppliers = typeof locals.hasPermission === 'function' ? locals.hasPermission('CLIENTS', 'VIEW') : true;
  const canViewTeam = typeof locals.hasPermission === 'function' ? locals.hasPermission('TEAM', 'VIEW') : (locals.user && (locals.user.role === 'ADMIN' || locals.user.role === 'OWNER'));
  const canViewReports = typeof locals.hasPermission === 'function' ? (locals.hasPermission('REPORTS', 'VIEW') || locals.hasPermission('JOURNALS', 'VIEW') || locals.hasPermission('ACCOUNTS', 'VIEW')) : true;
  const canViewFinancialYears = typeof locals.hasPermission === 'function' ? locals.hasPermission('FINANCIAL_YEARS', 'VIEW') : true;
%>

<body>
  <div class="sidebar-wrapper" id="sidebar">
    <!-- Brand Logo / Identity -->
    <a href="/dashboard" class="sidebar-brand">
      <% if (locals.branding && locals.branding.logoUrl) { %>
        <img src="<%= locals.branding.logoUrl %>" alt="Logo" class="sidebar-brand-logo me-2" style="max-height: 28px;" />
      <% } else { %>
        <i class="bi bi-asterisk"></i>
      <% } %>
      <span class="sidebar-brand-text" title="<%= (locals.branding && locals.branding.workspaceName) || 'Spark Admin' %>"><%= (locals.branding && locals.branding.workspaceName) || 'Spark Admin' %></span>
    </a>

    <!-- Authoritative Navigation Menu -->
    <div class="sidebar-nav-container flex-grow-1">
      <div class="sidebar-menu-section">
        <div class="sidebar-menu-title">MENU</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item">
            <a href="/dashboard" class="sidebar-menu-link <%= isDashboard ? 'active' : '' %>" id="menu-dashboard" title="Dashboard">
              <i class="bi bi-grid-fill"></i>
              <span>Dashboard</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/documents" class="sidebar-menu-link <%= isDocuments ? 'active' : '' %>" id="menu-documents" title="Documents">
              <i class="bi bi-file-earmark-text-fill"></i>
              <span>Documents</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/credit-debit-notes" class="sidebar-menu-link <%= locals.isNotes ? 'active' : '' %>" id="menu-notes" title="Credit & Debit Notes">
              <i class="bi bi-receipt"></i>
              <span>Credit & Debit Notes</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/purchases/orders" class="sidebar-menu-link <%= isPurchases ? 'active' : '' %>" id="menu-purchases" title="Purchases & Vendor Bills">
              <i class="bi bi-cart-fill"></i>
              <span>Purchases</span>
            </a>
          </li>
          <% if (canViewSuppliers) { %><li class="sidebar-menu-item">
            <a href="/suppliers" class="sidebar-menu-link <%= isSuppliers ? 'active' : '' %>" id="menu-suppliers" title="Supplier Management">
              <i class="bi bi-truck"></i>
              <span>Suppliers</span>
            </a>
          </li>
          <% } %>
          <li class="sidebar-menu-item">
            <a href="/financials/expenses" class="sidebar-menu-link" id="menu-expenses" title="Operating Expenses & Other Income">
              <i class="bi bi-wallet2"></i>
              <span>Expenses</span>
            </a>
          </li>
          <% if (canViewProjects) { %>
          <li class="sidebar-menu-item">
            <a href="/projects" class="sidebar-menu-link <%= isProjects ? 'active' : '' %>" id="menu-projects" title="Projects & Costing">
              <i class="bi bi-kanban-fill"></i>
              <span>Projects</span>
            </a>
          </li>
          <% } %>
          <% if (canViewReports) { %>
          <li class="sidebar-menu-item">
            <a href="/reports" class="sidebar-menu-link <%= isReports && !currentNavPath.startsWith('/reports/workbench') ? 'active' : '' %>" id="menu-reports" title="Accounting & Reports">
              <i class="bi bi-bar-chart-line-fill"></i>
              <span>Reports & Accounting</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/reports/workbench" class="sidebar-menu-link <%= (currentNavPath.startsWith('/reports/workbench')) ? 'active' : '' %>" id="menu-workbench" title="Reporting & Analytics Workbench">
              <i class="bi bi-clipboard-data-fill"></i>
              <span>Analytics Workbench</span>
            </a>
          </li>
          <% } %>
          <% if (canViewFinancialYears) { %>
          <li class="sidebar-menu-item">
            <a href="/financial-years" class="sidebar-menu-link <%= locals.isFinancialYears ? 'active' : '' %>" id="menu-financial-years" title="Financial Years & Period Closing">
              <i class="bi bi-calendar2-range"></i>
              <span>Financial Years</span>
            </a>
          </li>
          <% } %>
          <li class="sidebar-menu-item">
            <a href="/clients" class="sidebar-menu-link <%= isClients ? 'active' : '' %>" id="menu-clients" title="Clients">
              <i class="bi bi-people-fill"></i>
              <span>Clients</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/items" class="sidebar-menu-link <%= isItems ? 'active' : '' %>" id="menu-items" title="Items">
              <i class="bi bi-box-seam-fill"></i>
              <span>Items</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/units" class="sidebar-menu-link <%= isUnits ? 'active' : '' %>" id="menu-units" title="Units">
              <i class="bi bi-rulers"></i>
              <span>Units</span>
            </a>
          </li>
          <% if (canViewTeam) { %>
          <li class="sidebar-menu-item">
            <a href="/team" class="sidebar-menu-link <%= isTeam ? 'active' : '' %>" id="menu-team" title="Team">
              <i class="bi bi-person-badge-fill"></i>
              <span>Team</span>
            </a>
          </li>
          <% } %>
          <li class="sidebar-menu-item">
            <a href="/settings" class="sidebar-menu-link <%= isSettings ? 'active' : '' %>" id="menu-settings" title="Settings">
              <i class="bi bi-gear-fill"></i>
              <span>Settings</span>
            </a>
          </li>
          <% if (locals.user && (locals.user.role === 'ADMIN' || locals.user.isPlatformAdmin === true)) { %>
          <li class="sidebar-menu-item">
            <a href="/admin/businesses" class="sidebar-menu-link <%= (currentNavPath.startsWith('/admin/businesses')) ? 'active' : '' %>" id="menu-admin-businesses" title="Organizations Management">
              <i class="bi bi-buildings-fill"></i>
              <span>Organizations</span>
            </a>
          </li>
          <li class="sidebar-menu-item">
            <a href="/admin/numbering" class="sidebar-menu-link <%= (currentNavPath.startsWith('/admin/numbering')) ? 'active' : '' %>" id="menu-admin-numbering" title="Document Numbering Configuration">
              <i class="bi bi-123"></i>
              <span>Numbering Series</span>
            </a>
          </li>
          <% } %>
        </ul>
      </div>
    </div>

    <!-- Sidebar Profile Card (Dynamic Footer) -->
    <a href="/profile" class="sidebar-profile text-decoration-none">
      <img src="<%= (locals.user && locals.user.avatarUrl) || '/images/default-avatar.png' %>" alt="<%= (locals.user && locals.user.name) || 'User' %>" class="sidebar-profile-img" />
      <div class="sidebar-profile-info text-truncate">
        <div class="sidebar-profile-name text-white fw-semibold"><%= locals.user ? locals.user.name : 'Administrator' %></div>
        <div class="sidebar-profile-email text-muted small"><%= locals.user ? locals.user.email : 'admin@email.com' %></div>
        <div class="sidebar-profile-role text-muted" style="font-size: 0.7rem;"><%= (locals.user && (locals.user.role === 'ADMIN' || locals.user.role === 'OWNER')) ? 'Administrator' : (locals.user ? locals.user.role : 'Guest') %></div>
      </div>
    </a>
  </div>


  <div class="main-wrapper">
    <!-- START: Top Navbar -->
    <header class="navbar-custom">
      <div class="navbar-left">
        <!-- Sidebar toggle (Desktop icon-rail collapse / Mobile drawer) -->
        <button class="sidebar-toggle-btn me-2" id="sidebar-toggle" aria-label="Toggle Navigation" aria-expanded="false" aria-controls="sidebar">
          <i class="bi bi-list"></i>
        </button>

        <!-- Workspace Context Switcher Dropdown -->
        <% if (locals.accessibleBusinesses && locals.accessibleBusinesses.length > 0) { %>
        <div class="dropdown ms-2">
          <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Active Organization Workspace">
            <i class="bi bi-buildings text-primary"></i>
            <span class="fw-semibold text-truncate d-none d-sm-inline" style="max-width: 150px;">
              <%= locals.activeBusiness ? locals.activeBusiness.name : 'Select Business' %>
            </span>
          </button>
          <ul class="dropdown-menu shadow-sm">
            <li class="dropdown-header small text-muted">ACTIVE WORKSPACE</li>
            <% locals.accessibleBusinesses.forEach(b => { %>
              <li>
                <form action="/switch-business" method="POST" class="m-0 p-0">
                  <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                  <input type="hidden" name="businessId" value="<%= b.id %>">
                  <button type="submit" class="dropdown-item py-2 d-flex justify-content-between align-items-center <%= (locals.activeBusiness && locals.activeBusiness.id === b.id) ? 'active' : '' %>">
                    <span><%= b.name %></span>
                    <% if (locals.activeBusiness && locals.activeBusiness.id === b.id) { %>
                      <i class="bi bi-check-lg text-primary ms-2"></i>
                    <% } %>
                  </button>
                </form>
              </li>
            <% }); %>
            <% if (locals.user && (locals.user.role === 'ADMIN' || locals.user.isPlatformAdmin === true)) { %>
              <li><hr class="dropdown-divider my-1" /></li>
              <li>
                <a class="dropdown-item text-primary py-2" href="/admin/businesses">
                  <i class="bi bi-gear-wide-connected me-1"></i> Manage Organizations
                </a>
              </li>
              <li>
                <a class="dropdown-item text-primary py-2" href="/admin/numbering">
                  <i class="bi bi-123 me-1"></i> Document Numbering
                </a>
              </li>
            <% } %>
          </ul>
        </div>
        <% } %>

        <!-- Create Dropdown -->
        <div class="dropdown ms-2">
          <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-plus-lg me-1"></i> New
          </button>
          <ul class="dropdown-menu dropdown-menu-quick-action shadow-sm">
            <li>
              <a class="dropdown-item" href="/documents/new?type=INVOICE">
                <i class="bi bi-receipt text-primary me-2"></i> New Invoice
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/documents/new?type=QUOTATION">
                <i class="bi bi-file-earmark-text text-info me-2"></i> New Quotation
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/purchases/orders/new">
                <i class="bi bi-cart-plus text-primary me-2"></i> New Purchase Order
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/purchases/bills/new">
                <i class="bi bi-receipt-cutoff text-danger me-2"></i> New Supplier Bill
              </a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
              <a class="dropdown-item" href="/clients/new">
                <i class="bi bi-person-plus text-success me-2"></i> New Client
              </a>
            </li>
            <li>
              <a class="dropdown-item" href="/units">
                <i class="bi bi-rulers text-secondary me-2"></i> New Unit
              </a>
            </li>
            <% if (typeof locals.hasPermission === 'function' ? (locals.hasPermission('TEAM', 'CREATE') || locals.hasPermission('TEAM', 'MANAGE')) : (locals.user && (locals.user.role === 'ADMIN' || locals.user.role === 'OWNER'))) { %>
            <li>
              <a class="dropdown-item" href="/team?action=invite">
                <i class="bi bi-person-plus text-warning me-2"></i> New Team Member
              </a>
            </li>
            <% } %>
          </ul>
        </div>
      </div>

      <!-- Search -->
      <div class="navbar-search-wrapper" id="global-search-container">
        <input
          type="text"
          class="navbar-search-input"
          placeholder="Search anything in Spark... (Ctrl+K)"
          id="main-search"
          autocomplete="off"
          spellcheck="false"
          role="combobox"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          aria-controls="global-search-dropdown"
        />

        <button class="navbar-search-btn" type="button" aria-label="Search" id="main-search-btn">
          <i class="bi bi-search" id="main-search-icon"></i>
          <span class="spinner-border spinner-border-sm text-primary d-none" id="main-search-spinner" role="status" aria-hidden="true" style="width: 1rem; height: 1rem; border-width: 2px;"></span>
        </button>

        <!-- Global Search Dropdown Panel -->
        <div class="global-search-dropdown d-none" id="global-search-dropdown" role="listbox" aria-label="Search results">
          <div class="global-search-body" id="global-search-body">
            <!-- Dynamic grouped results rendered here -->
          </div>
          <div class="global-search-footer" id="global-search-footer">
            <div class="d-flex align-items-center justify-content-between text-muted px-3 py-2" style="font-size: 0.75rem;">
              <span class="d-none d-sm-inline"><kbd class="search-kbd">↑</kbd> <kbd class="search-kbd">↓</kbd> Navigate</span>
              <span class="d-none d-sm-inline"><kbd class="search-kbd">↵</kbd> Open</span>
              <span><kbd class="search-kbd">ESC</kbd> Close</span>
              <span><kbd class="search-kbd">Ctrl+K</kbd> Focus</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right actions -->
      <div class="navbar-actions">
        <!-- Theme Switcher Toggle -->
        <button class="navbar-action-btn me-1" aria-label="Switch to dark mode" id="theme-toggle" title="Switch to dark mode" type="button">
          <i class="bi bi-moon-stars" id="theme-toggle-icon"></i>
        </button>

        <!-- Fullscreen -->
        <button class="navbar-action-btn me-1" aria-label="Toggle Fullscreen" id="btn-fullscreen">
          <i class="bi bi-arrows-fullscreen"></i>
        </button>

        <!-- Notifications -->
        <div class="dropdown">
          <button class="navbar-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" id="btn-notifications" aria-label="Notifications">
            <i class="bi bi-bell"></i>
          </button>

          <div class="dropdown-menu dropdown-menu-end dropdown-menu-notification p-0 shadow-sm" style="min-width: 280px;">
            <div class="notification-header p-3 border-bottom d-flex justify-content-between align-items-center">
              <h6 class="notification-title mb-0 fw-bold">Notifications</h6>
              <span class="badge bg-light text-muted fw-normal">0 unread</span>
            </div>

            <div class="notification-list p-4 text-center text-muted">
              <i class="bi bi-bell-slash fs-3 d-block mb-2 text-secondary opacity-50"></i>
              <p class="mb-0 small fw-medium">No new notifications</p>
              <small class="text-muted">You are all caught up.</small>
            </div>
          </div>
        </div>

        <!-- Profile -->
        <div class="dropdown ms-2">
          <button class="navbar-profile-btn dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown"
            aria-expanded="false" id="profile-dropdown">
            <img src="<%= (locals.user && locals.user.avatarUrl) || '/images/default-avatar.png' %>" alt="<%= (locals.user && locals.user.name) || 'User' %>" class="navbar-profile-img me-2" />

            <span class="navbar-profile-name d-none d-md-inline">
              <span class="profile-name">
                <%= locals.user ? locals.user.name : 'Guest' %>
              </span>
            </span>

            <i class="bi bi-chevron-down navbar-profile-caret ms-1"></i>
          </button>

          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-profile shadow-sm">
            <li class="dropdown-header border-bottom pb-2 mb-1">
              <div class="fw-bold text-dark"><%= locals.user ? locals.user.name : 'User' %></div>
              <div class="text-muted small text-truncate"><%= locals.user ? locals.user.email : '' %></div>
            </li>

            <li>
              <a class="dropdown-item py-2" href="/profile" id="user-profile-link">
                <i class="bi bi-person me-2 text-primary"></i>
                My Profile
              </a>
            </li>

            <li>
              <a class="dropdown-item py-2" href="/product-guide" id="user-product-guide-link">
                <i class="bi bi-journal-bookmark me-2 text-primary"></i>
                Product Guide
              </a>
            </li>

            <li>
              <a class="dropdown-item py-2" href="/settings" id="user-settings-link">
                <i class="bi bi-gear me-2 text-secondary"></i>
                Settings
              </a>
            </li>

            <li>
              <hr class="dropdown-divider my-1" />
            </li>

            <li>
              <form action="/logout" method="POST" class="m-0 p-0" id="logout-form">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
                <button type="submit" class="dropdown-item py-2 text-danger">
                  <i class="bi bi-box-arrow-right me-2"></i>
                  Logout
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </header>
    <!-- END: Top Navbar -->

    <!-- START: Page Header -->

    <% if (locals.showPageHeader !== false) { %>
    <div class="page-header">
      <div>
        <h1 class="page-title">
          <%= pageTitle || 'Dashboard' %>
        </h1>

        <p class="page-subtitle">
          <%= locals.pageSubtitle || 'An easy way to manage sales with care and precision.' %>
        </p>
      </div>

      <% if (locals.headerAction) { %>
        <%- locals.headerAction %>
      <% } %>
    </div>

    <!-- END: Page Header -->
    <% } %>

<% if (locals.reportingPeriod && (reportingPeriod.applies || ['/reports','/financial-years'].includes(locals.currentPath))) { %><%- include('../partials/reporting-period') %><% } %>
