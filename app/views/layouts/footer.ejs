<!-- START: Footer Component -->

<footer class="footer-custom">
    <div class="footer-left">
        <span class="footer-logo">
            <% if (locals.branding && locals.branding.logoUrl) { %>
                <img src="<%= locals.branding.logoUrl %>" alt="Logo" style="max-height: 20px;" class="me-1" />
            <% } else { %>
                <i class="bi bi-asterisk"></i>
            <% } %>
            <%= (locals.branding && locals.branding.workspaceName) || 'Spark Admin' %>
        </span>
        <span class="footer-separator">|</span>
        <span class="footer-copy">
            &copy; <%= new Date().getFullYear() %> <%= (locals.branding && (locals.branding.displayName || locals.branding.legalName)) || 'Spark Admin' %>. All rights reserved.
        </span>
    </div>

    <div class="footer-right">
        <ul class="footer-links">
            <li>
                <a href="/dashboard" class="footer-link">Dashboard</a>
            </li>
            <li>
                <a href="/documents" class="footer-link">Documents</a>
            </li>
            <li>
                <a href="/settings" class="footer-link">Settings</a>
            </li>
            <li>
                <a href="/profile" class="footer-link">Profile</a>
            </li>
        </ul>
    </div>
</footer>

<!-- END: Footer Component -->


</div>
<!-- END: Main Content Area -->


<script src="/libs/sweetalert2/sweetalert2.all.min.js"></script>
<script src="/js/spark-feedback.js"></script>
