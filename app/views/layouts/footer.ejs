<script src="/js/spark-modals.js"></script>

<!-- ApexCharts -->
<script src="/libs/apexcharts/apexcharts.min.js"></script>

<!-- Flatpickr -->
<script src="/libs/flatpickr/flatpickr.min.js"></script>
<script src="/js/spark-daterange.js"></script>
<script src="/js/reporting-period.js"></script>

<!-- Tom Select -->
<script src="/libs/tom-select/js/tom-select.complete.min.js"></script>
<script src="/js/spark-tom-select.js"></script>

<!-- Spark Admin -->
<script src="/js/dashboard.js"></script>
<script src="/js/report-drilldown.js"></script>
<script src="/js/record-desk.js"></script>
<script src="/js/spark-datatable.js"></script>
<script src="/js/global-search.js"></script>
<script src="/js/spark-ajax-loader.js"></script>

<% if (locals.extraJs) { %>
  <%- locals.extraJs %>
<% } %>

</body>

</html>