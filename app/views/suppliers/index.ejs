<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <a href="/suppliers/new" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Supplier</a>
  </div>

  <div class="card border-0 shadow-sm mb-4"><div class="card-body p-3">
    <form method="GET" action="/suppliers" class="row g-2">
      <div class="col-sm-8 col-md-6"><input class="form-control" name="q" value="<%= search || '' %>" placeholder="Search code, name, GSTIN, email or phone"></div>
      <div class="col-sm-4 col-md-2"><button class="btn btn-outline-primary w-100">Search</button></div>
    </form>
  </div></div>

  <div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light"><tr><th class="ps-3">Code</th><th>Supplier</th><th>GSTIN / State</th><th>Contact</th><th>Status</th><th class="text-end pe-3">Actions</th></tr></thead>
      <tbody>
      <% if (suppliers && suppliers.length) { suppliers.forEach(supplier => { %>
        <tr>
          <td class="ps-3 font-monospace"><%= supplier.supplierCode || '—' %></td>
          <td><strong><%= supplier.name %></strong><% if (supplier.address) { %><div class="small text-muted text-truncate" style="max-width: 320px"><%= supplier.address %></div><% } %></td>
          <td><%= supplier.gstin || '—' %><% if (supplier.stateCode) { %><div class="small text-muted"><%= supplier.stateCode %></div><% } %></td>
          <td><%= supplier.email || supplier.phone || '—' %><% if (supplier.email && supplier.phone) { %><div class="small text-muted"><%= supplier.phone %></div><% } %></td>
          <td><span class="badge <%= supplier.active ? 'bg-success' : 'bg-secondary' %>"><%= supplier.active ? 'Active' : 'Inactive' %></span></td>
          <td class="text-end pe-3">
            <a href="/suppliers/<%= supplier.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
            <form method="POST" action="/suppliers/<%= supplier.id %>/active" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="active" value="<%= supplier.active ? 'false' : 'true' %>">
              <button class="btn btn-sm btn-outline-<%= supplier.active ? 'warning' : 'success' %>" onclick="return confirm('<%= supplier.active ? 'Deactivate' : 'Reactivate' %> this supplier?')"><%= supplier.active ? 'Deactivate' : 'Reactivate' %></button>
            </form>
          </td>
        </tr>
      <% }); } else { %><tr><td colspan="6" class="text-center py-5 text-muted">No suppliers found. <a href="/suppliers/new">Add the first supplier</a>.</td></tr><% } %>
      </tbody>
    </table>
  </div></div>
</div>

<%- include('../layouts/footer') %>
