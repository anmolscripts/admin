<% 
  const headerActionHtml = `
    <div class="dropdown">
      <button class="btn-new-doc-toggle dropdown-toggle" type="button" id="dropdownNewDoc" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Create new document">
        <i class="bi bi-plus-lg"></i>
        <span>New Document</span>
      </button>
      <ul class="dropdown-menu dropdown-menu-end dropdown-menu-new-doc shadow-sm" aria-labelledby="dropdownNewDoc">
        <li>
          <a class="dropdown-item" href="/documents/new?type=QUOTATION" id="btn-new-quotation" role="button">
            <i class="bi bi-file-earmark-text text-info"></i>
            <span>New Quotation</span>
          </a>
        </li>
        <li>
          <a class="dropdown-item" href="/documents/new?type=INVOICE" id="btn-new-invoice" role="button">
            <i class="bi bi-receipt text-primary"></i>
            <span>New Invoice</span>
          </a>
        </li>
        <li><a class="dropdown-item" href="/documents/letters/new" id="btn-new-letter"><i class="bi bi-envelope-paper text-primary"></i><span>New Letter</span></a></li>
      </ul>
    </div>
  `;
%>

<%- include('../layouts/header', { 
    pageTitle: 'Quotations & Invoices', 
    pageSubtitle: 'Search, filter, inspect and manage quotations and invoices with precision.', 
    extraCss: '<link rel="stylesheet" href="/css/documents.css">', 
    headerAction: headerActionHtml 
}) %>

<nav class="nav nav-pills gap-2 mb-4" aria-label="Document categories"><a class="nav-link active" href="/documents" aria-current="page">Invoices &amp; Quotations</a><a class="nav-link" href="/documents/letters"><i class="bi bi-envelope-paper me-2"></i>Letters</a></nav>

<!-- START: KPI Summary Metric Cards -->
<section class="row g-3 mb-4" id="kpi-strip" aria-label="Key Performance Indicators">
  <div class="col-6 col-md-3">
    <div class="kpi-card">
      <div class="kpi-accent-bar accent-cyan"></div>
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="kpi-label">Active Quotations</span>
        <div class="kpi-icon-circle bg-info-subtle text-info"><i class="bi bi-file-earmark-text"></i></div>
      </div>
      <div class="kpi-value text-info" id="kpi-active-quotations">—</div>
      <div class="kpi-subtext">Issued & pending acceptance</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="kpi-card">
      <div class="kpi-accent-bar accent-green"></div>
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="kpi-label">Active Invoices</span>
        <div class="kpi-icon-circle bg-success-subtle text-success"><i class="bi bi-receipt"></i></div>
      </div>
      <div class="kpi-value text-success" id="kpi-active-invoices">—</div>
      <div class="kpi-subtext">Active billable receivables</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="kpi-card">
      <div class="kpi-accent-bar accent-amber"></div>
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="kpi-label">Total Outstanding</span>
        <div class="kpi-icon-circle bg-warning-subtle text-warning"><i class="bi bi-wallet2"></i></div>
      </div>
      <div class="kpi-value text-warning" id="kpi-total-outstanding">—</div>
      <div class="kpi-subtext">Awaiting client payment</div>
    </div>
  </div>
  <div class="col-6 col-md-3">
    <div class="kpi-card">
      <div class="kpi-accent-bar accent-red"></div>
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="kpi-label">Overdue Invoices</span>
        <div class="kpi-icon-circle bg-danger-subtle text-danger"><i class="bi bi-exclamation-octagon"></i></div>
      </div>
      <div class="kpi-value text-danger" id="kpi-overdue-invoices">—</div>
      <div class="kpi-subtext">Past settlement due date</div>
    </div>
  </div>
</section>
<!-- END: KPI Summary Metric Cards -->

<!-- START: Filter & Search Toolbar Card -->
<section class="documents-toolbar-card" aria-label="Document filters and search">
  <div class="row g-3 align-items-end toolbar-row">
    <!-- Search Query Input -->
    <div class="col-12 col-lg-4">
      <label for="search-input" class="toolbar-control-label">Search</label>
      <div class="toolbar-search-group">
        <i class="bi bi-search toolbar-search-icon" aria-hidden="true"></i>
        <input 
          type="search" 
          class="form-control toolbar-search-input" 
          id="search-input" 
          placeholder="Search document no or client..." 
          aria-label="Search by document number or client name" 
          autocomplete="off"
        />
      </div>
    </div>

    <!-- Document Type Filter -->
    <div class="col-6 col-sm-4 col-lg-2">
      <label for="filter-type" class="toolbar-control-label">Document Type</label>
      <select class="form-select toolbar-select" id="filter-type" aria-label="Filter by document type">
        <option value="">All Types</option>
        <option value="QUOTATION">Quotation</option>
        <option value="INVOICE">Invoice</option>
      </select>
    </div>

    <!-- Lifecycle Status Filter -->
    <div class="col-6 col-sm-4 col-lg-2">
      <label for="filter-status" class="toolbar-control-label">Status</label>
      <select class="form-select toolbar-select" id="filter-status" aria-label="Filter by document lifecycle status">
        <option value="">All Statuses</option>
        <option value="ACTIVE">Active</option>
        <option value="INACTIVE">Inactive</option>
        <option value="VOID">Void</option>
        <option value="DELETED">Deleted (Trash)</option>
      </select>
    </div>

    <!-- Payment Status Filter -->
    <div class="col-6 col-sm-4 col-lg-2">
      <label for="filter-payment-status" class="toolbar-control-label">Payment Status</label>
      <select class="form-select toolbar-select" id="filter-payment-status" aria-label="Filter by payment status">
        <option value="">All Payments</option>
        <option value="PAID">Paid</option>
        <option value="PARTIALLY_PAID">Partially Paid</option>
        <option value="UNPAID">Unpaid</option>
        <option value="OVERDUE">Overdue</option>
      </select>
    </div>

    <!-- Clear Filters Button -->
    <div class="col-6 col-sm-6 col-lg-2 d-flex align-items-end">
      <button 
        type="button" 
        class="btn-clear-filters w-100" 
        id="btn-clear-filters" 
        aria-label="Reset all search filters"
      >
        <i class="bi bi-x-circle" aria-hidden="true"></i>
        <span>Clear Filters</span>
      </button>
    </div>

    <!-- Unified Date Range Picker -->
    <div class="col-12 col-sm-12 col-lg-6">
      <label class="toolbar-control-label">Date Range</label>
      <div class="spark-daterange-picker w-100" data-from-name="dateFrom" data-to-name="dateTo">
        <div class="d-flex align-items-center gap-2">
          <button class="btn-date-picker flex-grow-1" type="button" id="toolbar-date-range-trigger" aria-label="Select date range filter">
            <span class="d-flex align-items-center gap-2 text-truncate">
              <i class="bi bi-calendar4-event text-primary"></i>
              <span class="spark-daterange-label text-truncate" id="toolbar-selected-date-range">All Dates</span>
            </span>
            <i class="bi bi-chevron-down text-muted ms-auto"></i>
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary btn-daterange-clear d-none" id="btn-clear-date-range" title="Clear date range" aria-label="Clear date range">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
        <input type="hidden" id="filter-date-from" name="dateFrom" />
        <input type="hidden" id="filter-date-to" name="dateTo" />
      </div>
    </div>

    <!-- Export Excel Button -->
    <div class="col-12 col-lg-6 d-flex align-items-end justify-content-lg-end">
      <button
        type="button"
        class="btn-custom btn-custom-outline-primary"
        id="btn-export-excel"
        aria-label="Export documents to Excel"
        title="Export filtered documents to Excel spreadsheet"
      >
        <i class="bi bi-file-earmark-spreadsheet me-1" aria-hidden="true"></i>
        <span>Export Excel</span>
      </button>
    </div>
  </div>
</section>
<!-- END: Filter & Search Toolbar Card -->

<!-- START: Main Documents Table Card -->
<section class="documents-table-card" id="documents-table-card" aria-label="Documents data table">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0 document-table" id="documents-table" aria-label="Quotations and Invoices list">
      <thead>
        <tr>
          <th scope="col" class="th-doc-no sortable" data-sort-key="documentNumber" tabindex="0" role="columnheader" title="Sort by Document Number">Document No</th>
          <th scope="col" class="th-type sortable" data-sort-key="type" tabindex="0" role="columnheader" title="Sort by Type">Type</th>
          <th scope="col" class="th-client sortable" data-sort-key="client" tabindex="0" role="columnheader" title="Sort by Client">Client</th>
          <th scope="col" class="th-date sortable" data-sort-key="date" tabindex="0" role="columnheader" title="Sort by Document Date">Document Date</th>
          <th scope="col" class="th-due sortable" data-sort-key="due" tabindex="0" role="columnheader" title="Sort by Due/Expiry Date">Due/Expiry Date</th>
          <th scope="col" class="th-amount text-end sortable" data-sort-key="amount" tabindex="0" role="columnheader" title="Sort by Amount">Amount</th>
          <th scope="col" class="th-status text-center sortable" data-sort-key="status" tabindex="0" role="columnheader" title="Sort by Status">Status</th>
          <th scope="col" class="th-actions text-end">Actions</th>
        </tr>
      </thead>
      <tbody id="documents-tbody" aria-live="polite">
        <!-- Rendered dynamically by documents.js with safe DOM elements -->
      </tbody>
    </table>
  </div>

  <!-- START: Pagination Bar -->
  <div class="documents-pagination-bar" id="documents-pagination-bar" aria-label="Table pagination navigation">
    <div class="pagination-info-text" id="pagination-info">
      Loading documents...
    </div>

    <div class="d-flex align-items-center gap-3">
      <div class="pagination-size-wrapper">
        <label for="page-size-select" class="visually-hidden">Documents per page</label>
        <span>Per page:</span>
        <select class="form-select form-select-sm pagination-size-select" id="page-size-select" aria-label="Select number of documents per page">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
      </div>

      <nav class="pagination-buttons-nav d-flex align-items-center gap-1" aria-label="Pagination page navigation">
        <button
          type="button"
          class="btn-page-nav"
          id="btn-first-page"
          disabled
          aria-label="Go to first page"
          title="First page"
        >
          <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
        </button>

        <button
          type="button"
          class="btn-page-nav"
          id="btn-prev-page"
          disabled
          aria-label="Go to previous page"
        >
          <i class="bi bi-chevron-left" aria-hidden="true"></i>
          <span>Previous</span>
        </button>

        <div class="d-inline-flex align-items-center gap-1" id="pagination-numbers-container">
          <span class="page-indicator-badge" id="page-indicator" aria-current="page">
            Page 1 of 1
          </span>
        </div>

        <button
          type="button"
          class="btn-page-nav"
          id="btn-next-page"
          disabled
          aria-label="Go to next page"
        >
          <span>Next</span>
          <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </button>

        <button
          type="button"
          class="btn-page-nav"
          id="btn-last-page"
          disabled
          aria-label="Go to last page"
          title="Last page"
        >
          <i class="bi bi-chevron-double-right" aria-hidden="true"></i>
        </button>
      </nav>
    </div>
  </div>
  <!-- END: Pagination Bar -->
</section>
<!-- END: Main Documents Table Card -->

<!-- START: Empty State Container (Hidden by default) -->
<section class="documents-table-card table-state-container d-none" id="empty-state" aria-label="No documents state">
  <div class="state-icon-wrapper state-icon-empty">
    <i class="bi bi-file-earmark-x" aria-hidden="true"></i>
  </div>
  <h2 class="state-title">No documents found</h2>
  <p class="state-desc">
    There are currently no quotations or invoices matching your criteria.
  </p>
  <button type="button" class="btn btn-outline-secondary d-none" id="btn-empty-clear">
    <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>
    Clear all filters
  </button>
</section>
<!-- END: Empty State Container -->

<!-- START: Error State Container (Hidden by default) -->
<section class="documents-table-card table-state-container d-none" id="error-state" role="alert" aria-label="Error loading documents">
  <div class="state-icon-wrapper state-icon-error">
    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
  </div>
  <h2 class="state-title">Unable to Load Documents</h2>
  <p class="state-desc" id="error-message">
    An error occurred while communicating with the server.
  </p>
  <button type="button" class="btn btn-primary" id="btn-retry">
    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>
    Retry
  </button>
</section>
<!-- END: Error State Container -->

<%- include('../layouts/footer', { 
    extraJs: '<script src="/js/documents.js"></script>' 
}) %>
