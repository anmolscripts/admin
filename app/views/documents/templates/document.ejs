<!--
  Unified Document Template (Print + PDF Shared Architecture)
  Single source of truth for Quotations and Invoices.
  Consumed identically by Browser Print view and PDF generation engine.
-->
<%
  const tpl = (typeof templateConfig !== 'undefined' && templateConfig) ? templateConfig : ((model && model.templateConfig) || {});
  const docAccent = tpl.accentColor || (model.isQuotation ? '#0070f3' : '#c8102e');
  const docAccentSubtle = tpl.accentSubtle || (docAccent + '15');
  const docFont = tpl.fontFamily || '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif';
  const themeClass = tpl.themeClass || (tpl.id ? 'theme-' + tpl.id : (model.isQuotation ? 'doc-theme-quotation' : 'doc-theme-invoice'));
  const showHsn = tpl.showHsn !== false;
  const showUpiQr = tpl.showUpiQr !== false;
  const customCss = tpl.customCss || '';
%>
<div class="spark-unified-document <%= model.isQuotation ? 'doc-theme-quotation' : 'doc-theme-invoice' %> <%= themeClass %>" id="unified-document-root" style="--doc-accent: <%= docAccent %>; --doc-accent-subtle: <%= docAccentSubtle %>; font-family: <%= docFont %>;">
  <style>
    :root {
      --doc-accent: <%= docAccent %>;
      --doc-accent-hover: <%= docAccent %>;
      --doc-accent-subtle: <%= docAccentSubtle %>;
      --doc-text-dark: #111827;
      --doc-text-body: #374151;
      --doc-text-muted: #6b7280;
      --doc-border: #e5e7eb;
      --doc-border-strong: #d1d5db;
      --doc-bg-subtle: #f9fafb;
      --doc-strip-bg: #e5e7eb;
      --doc-white: #ffffff;
    }

    /* THEME 1: Modern Minimalist */
    .theme-modern-minimal .doc-top-bar { height: 4px; background: var(--doc-accent); }
    .theme-modern-minimal .doc-hero-title { color: var(--doc-accent); font-size: 34px; }
    .theme-modern-minimal .doc-items-table thead tr { border-top: 1px solid var(--doc-border); border-bottom: 2px solid var(--doc-accent); background: #f8fafc; }
    .theme-modern-minimal .doc-items-table th { color: var(--doc-accent); font-size: 11px; }

    /* THEME 2: Classic Corporate */
    .theme-classic-corporate { border: 2px solid #1e3a8a; padding: 14px; }
    .theme-classic-corporate .doc-top-bar { height: 5px; background: #1e3a8a; }
    .theme-classic-corporate .doc-brand-name { color: #1e3a8a; letter-spacing: 1px; }
    .theme-classic-corporate .doc-header-grid { border: 1px solid #cbd5e1; padding: 12px; background: #f8fafc; border-radius: 4px; }
    .theme-classic-corporate .doc-items-table thead tr { background: #1e3a8a; border: 1px solid #1e3a8a; }
    .theme-classic-corporate .doc-items-table th { color: #ffffff !important; border-right: 1px solid rgba(255,255,255,0.2); }
    .theme-classic-corporate .doc-items-table td { border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; }
    .theme-classic-corporate .doc-footer-bar { background: #1e3a8a; }
    .theme-classic-corporate .doc-total-badge-row { background: #1e3a8a; }

    /* THEME 3: Industrial Bold */
    .theme-industrial-bold .doc-top-bar { height: 8px; background: #c8102e; }
    .theme-industrial-bold .doc-hero-title { font-size: 40px; font-weight: 900; }
    .theme-industrial-bold .doc-items-table thead tr { border-top: 2px solid #c8102e; border-bottom: 2px solid #c8102e; }
    .theme-industrial-bold .doc-items-table th { color: #c8102e; }

    /* THEME 4: Executive Emerald */
    .theme-executive-emerald .doc-top-bar { height: 4px; background: #0f766e; }
    .theme-executive-emerald .doc-hero-title { color: #0f766e; font-size: 34px; }
    .theme-executive-emerald .doc-brand-name { color: #0f766e; }
    .theme-executive-emerald .doc-items-table thead tr { border-top: 2px solid #0f766e; border-bottom: 2px solid #0f766e; }
    .theme-executive-emerald .doc-items-table th { color: #0f766e; }
    .theme-executive-emerald .doc-total-badge-row { background: #0f766e; }
    .theme-executive-emerald .doc-footer-bar { background: #0f766e; }

    <%- customCss %>

    .spark-unified-document {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: var(--doc-text-body);
      background: var(--doc-white);
      width: 100%;
      max-width: 820px;
      margin: 0 auto;
      padding: 0;
      box-sizing: border-box;
      position: relative;
      font-size: 12.5px;
      line-height: 1.5;
    }

    .spark-unified-document * {
      box-sizing: border-box;
    }

    /* Top Red Accent Line */
    .doc-top-bar {
      height: 7px;
      background-color: var(--doc-accent);
      width: 100%;
    }

    /* Content Area Padding */
    .doc-content-container {
      padding: 24px 36px;
    }

    /* Watermark for VOID and DELETED */
    .doc-watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-30deg);
      font-size: 76px;
      font-weight: 900;
      letter-spacing: 8px;
      opacity: 0.12;
      pointer-events: none;
      user-select: none;
      z-index: 10;
      text-transform: uppercase;
    }
    .watermark-void { color: #dc2626; }
    .watermark-deleted { color: #6b7280; }

    /* Centered Brand Header */
    .doc-brand-header {
      text-align: center;
      padding-top: 10px;
      padding-bottom: 24px;
    }
    .doc-brand-name {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--doc-text-dark);
      text-transform: uppercase;
      margin: 0;
      line-height: 1.2;
    }
    .doc-brand-logo {
      max-height: 55px;
      max-width: 240px;
      object-fit: contain;
    }

    /* Two-Column Client & Document Header */
    .doc-header-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 28px;
      align-items: start;
      margin-bottom: 24px;
    }

    .bill-to-section {
      text-align: left;
    }
    .bill-to-label {
      font-size: 15px;
      font-weight: 800;
      color: var(--doc-text-dark);
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin-bottom: 6px;
    }
    .bill-to-name {
      font-size: 14.5px;
      font-weight: 700;
      color: var(--doc-text-dark);
      margin-bottom: 8px;
    }
    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 12px;
      color: var(--doc-text-body);
      margin-bottom: 4px;
      line-height: 1.45;
    }
    .contact-icon {
      flex-shrink: 0;
      width: 14px;
      height: 14px;
      margin-top: 2px;
      color: var(--doc-text-muted);
    }

    /* Right Metadata & Hero Title */
    .doc-meta-section {
      text-align: right;
    }
    .meta-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
    }
    .meta-table td {
      padding: 2.5px 0;
      font-size: 12px;
    }
    .meta-table td.meta-key {
      color: var(--doc-text-muted);
      text-align: left;
      font-weight: 500;
    }
    .meta-table td.meta-val {
      color: var(--doc-text-dark);
      font-weight: 600;
      text-align: right;
    }

    .doc-hero-title {
      font-size: 40px;
      font-weight: 900;
      letter-spacing: 2px;
      color: var(--doc-text-dark);
      text-transform: uppercase;
      line-height: 1;
      margin-top: 10px;
      text-align: right;
    }

    /* Status Badge */
    .doc-status-badge {
      display: inline-block;
      padding: 2px 9px;
      border-radius: 9999px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-active { background: #dcfce7; color: #166534; }
    .badge-inactive { background: #fef3c7; color: #92400e; }
    .badge-void { background: #fee2e2; color: #991b1b; }
    .badge-deleted { background: #f3f4f6; color: #374151; }

    /* Red-Accented Items Table */
    .doc-items-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
      margin-bottom: 24px;
    }
    .doc-items-table thead tr {
      border-top: 2px solid var(--doc-accent);
      border-bottom: 2px solid var(--doc-accent);
    }
    .doc-items-table th {
      color: var(--doc-accent);
      font-weight: 700;
      font-size: 11.5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 10px;
      text-align: left;
      background: transparent;
    }
    .doc-items-table th.col-no { width: 38px; text-align: center; }
    .doc-items-table th.col-hsn { width: 75px; text-align: center; }
    .doc-items-table th.col-qty { width: 70px; text-align: right; }
    .doc-items-table th.col-rate { width: 100px; text-align: right; }
    .doc-items-table th.col-amt { width: 115px; text-align: right; }

    .doc-items-table tbody tr {
      border-bottom: 1px solid var(--doc-border);
      page-break-inside: avoid;
    }
    .doc-items-table tbody tr:nth-child(even) td {
      background: var(--doc-bg-subtle);
    }
    .doc-items-table td {
      padding: 9px 10px;
      font-size: 12px;
      color: var(--doc-text-body);
      vertical-align: top;
      word-break: break-word;
      overflow-wrap: break-word;
      white-space: normal;
      line-height: 1.5;
    }
    .col-no { text-align: center; color: var(--doc-text-muted); font-weight: 500; }
    .col-hsn { text-align: center; color: var(--doc-text-muted); font-size: 11px; }
    .col-qty { text-align: right; font-weight: 600; }
    .col-rate { text-align: right; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    .col-amt { text-align: right; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-weight: 600; color: var(--doc-text-dark); }

    .item-desc-cell strong {
      color: var(--doc-text-dark);
      display: block;
      margin-bottom: 2px;
    }

    /* Terms & Totals Section */
    .doc-terms-totals {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      margin-bottom: 22px;
      page-break-inside: avoid;
      align-items: start;
    }

    .terms-block-left {
      text-align: left;
    }
    .terms-heading-italic {
      font-style: italic;
      font-size: 15px;
      font-weight: 700;
      color: var(--doc-text-dark);
      margin-bottom: 8px;
    }
    .terms-text-content {
      font-size: 11.5px;
      color: var(--doc-text-body);
      line-height: 1.55;
    }
    .doc-remarks-content {
      margin-top: 10px;
      padding-top: 8px;
      border-top: 1px dotted var(--doc-border-strong);
      font-size: 11.5px;
      color: var(--doc-text-muted);
    }

    /* Totals Table Right */
    .totals-wrapper {
      text-align: right;
    }
    .totals-sub-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 4px;
    }
    .totals-sub-table td {
      padding: 4px 6px;
      font-size: 12px;
    }
    .totals-sub-table .t-label {
      text-align: left;
      color: var(--doc-text-muted);
    }
    .totals-sub-table .t-val {
      text-align: right;
      font-weight: 600;
      color: var(--doc-text-dark);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }

    /* Highlighted TOTAL Block */
    .doc-total-badge-row {
      background-color: var(--doc-accent);
      color: var(--doc-white);
      padding: 9px 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 0.5px;
      border-radius: 2px;
      margin-top: 6px;
    }
    .total-badge-label {
      text-transform: uppercase;
      font-weight: 800;
    }
    .total-badge-val {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 800;
      font-size: 16px;
    }
    .doc-total-underline {
      height: 2px;
      background-color: var(--doc-accent);
      width: 100%;
      margin-top: 3px;
      margin-bottom: 8px;
    }

    /* Payment & Bank Strip */
    .doc-payment-strip {
      background: var(--doc-strip-bg);
      border-radius: 4px;
      padding: 10px 16px;
      font-size: 11.5px;
      color: var(--doc-text-dark);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 22px;
      page-break-inside: avoid;
    }
    .strip-bank-info {
      flex: 1;
    }
    .strip-upi-info {
      text-align: right;
    }

    /* Thank-you Box */
    .doc-thank-you-box {
      border-top: 1px solid var(--doc-border);
      border-bottom: 1px solid var(--doc-border);
      padding: 14px 10px;
      margin-bottom: 20px;
      text-align: center;
      page-break-inside: avoid;
    }
    .doc-thank-you-text {
      font-family: Georgia, "Times New Roman", serif;
      font-style: italic;
      font-size: 24px;
      color: var(--doc-text-dark);
      letter-spacing: 0.5px;
    }

    /* Authorized Signatory */
    .doc-signatory-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 0 0 16px 0;
      page-break-inside: avoid;
    }
    .doc-auth-meta {
      font-size: 10px;
      color: var(--doc-text-muted);
    }
    .doc-signatory-box {
      text-align: right;
      min-width: 200px;
    }
    .doc-signatory-line {
      height: 36px;
      border-bottom: 1px solid var(--doc-border-strong);
      margin-bottom: 4px;
    }
    .doc-signatory-caption {
      font-size: 10.5px;
      font-weight: 600;
      color: var(--doc-text-body);
    }

    /* Full-Width Red Footer */
    .doc-footer-bar {
      background-color: var(--doc-accent);
      color: var(--doc-white);
      padding: 14px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      font-size: 11px;
      line-height: 1.4;
      page-break-inside: avoid;
    }
    .footer-address {
      flex: 1;
      max-width: 45%;
    }
    .footer-contact {
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }
    .footer-icon {
      width: 14px;
      height: 14px;
      fill: currentColor;
      flex-shrink: 0;
    }

    /* Multi-Page & Deterministic Print Rules */
    @media print {
      body {
        background: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .spark-unified-document {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-shadow: none !important;
      }
      .doc-top-bar,
      .doc-total-badge-row,
      .doc-total-underline,
      .doc-footer-bar {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      .doc-payment-strip {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      thead {
        display: table-header-group;
      }
      tfoot {
        display: table-footer-group;
      }
      tr {
        page-break-inside: avoid;
      }
      tbody tr {
        page-break-inside: avoid;
      }
      .doc-terms-totals,
      .doc-payment-strip,
      .doc-thank-you-box,
      .doc-signatory-row,
      .doc-footer-bar {
        page-break-inside: avoid;
      }
    }

    /* Responsive Viewports */
    @media (max-width: 720px) {
      .doc-content-container {
        padding: 16px 14px;
      }
      .doc-header-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
      .doc-meta-section {
        text-align: left;
      }
      .doc-hero-title {
        text-align: left;
        margin-top: 8px;
        font-size: 30px;
      }
      .doc-terms-totals {
        grid-template-columns: 1fr;
        gap: 20px;
      }
      .doc-payment-strip {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }
      .strip-upi-info {
        text-align: left;
      }
      .doc-footer-bar {
        flex-direction: column;
        align-items: flex-start;
        padding: 14px 16px;
        gap: 8px;
      }
      .footer-address {
        max-width: 100%;
      }
      .doc-signatory-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
      }
      .doc-signatory-box {
        text-align: left;
        width: 100%;
      }
    }
  </style>

  <!-- TOP ACCENT LINE -->
  <div class="doc-top-bar"></div>

  <% if (model.watermark) { %>
    <div class="print-watermark <%= model.watermark === 'VOID' ? 'watermark-void' : 'watermark-deleted' %> doc-watermark">
      <%= model.watermark %>
    </div>
  <% } %>

  <div class="doc-content-container">
    <!-- CENTERED BRAND LOGO / NAME -->
    <div class="doc-brand-header">
      <% if (model.seller && model.seller.logo) { %>
        <img src="<%= model.seller.logo %>" alt="<%= model.seller.name %>" class="doc-brand-logo" />
      <% } else { %>
        <h1 class="doc-brand-name"><%= model.seller.name %></h1>
      <% } %>
    </div>

    <!-- TWO-COLUMN CLIENT & DOCUMENT INFORMATION -->
    <div class="doc-header-grid">
      <!-- BILL TO (LEFT) -->
      <div class="bill-to-section">
        <div class="bill-to-label">BILL TO</div>
        <div class="bill-to-name"><%= model.client.name %></div>

        <% if (model.client.phone && model.client.phone !== '—') { %>
          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span><%= model.client.phone %></span>
          </div>
        <% } %>

        <% if (model.client.email && model.client.email !== '—') { %>
          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span><%= model.client.email %></span>
          </div>
        <% } %>

        <% if (model.client.billingAddress && model.client.billingAddress !== 'No billing address provided') { %>
          <div class="contact-item">
            <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <span><%= model.client.billingAddress %></span>
          </div>
        <% } %>

        <% if (model.client.gstin && model.client.gstin !== 'Unregistered') { %>
          <div class="contact-item" style="margin-top: 4px;">
            <span style="font-weight: 700; color: var(--doc-text-muted);">GSTIN:</span>
            <span style="font-weight: 600;"><%= model.client.gstin %></span>
          </div>
        <% } %>

        <% if (model.client.placeOfSupply) { %>
          <div class="contact-item">
            <span style="color: var(--doc-text-muted);">Place of Supply:</span>
            <span><%= model.client.placeOfSupply %></span>
          </div>
        <% } %>
      </div>

      <!-- DOCUMENT METADATA & TITLE (RIGHT) -->
      <div class="doc-meta-section">
        <table class="meta-table">
          <tr>
            <td class="meta-key"><%= model.typeLabel %>:</td>
            <td class="meta-val font-monospace">#<%= model.invoiceNumber %></td>
          </tr>
          <tr>
            <td class="meta-key"><%= model.isQuotation ? 'Quotation Date' : 'Invoice Date' %>:</td>
            <td class="meta-val"><%= model.dates.invoiceDate %></td>
          </tr>
          <tr>
            <td class="meta-key"><%= model.dates.dueOrExpiryLabel %>:</td>
            <td class="meta-val"><%= model.dates.dueOrExpiryDate %></td>
          </tr>
          <% if (model.reference && model.reference.sourceQuotation) { %>
            <tr>
              <td class="meta-key">Source Quotation:</td>
              <td class="meta-val" style="color: var(--doc-accent);"><%= model.reference.sourceQuotation.invoiceNumber %></td>
            </tr>
          <% } else if (model.reference && model.reference.convertedInvoice) { %>
            <tr>
              <td class="meta-key">Converted To:</td>
              <td class="meta-val" style="color: var(--doc-accent);"><%= model.reference.convertedInvoice.invoiceNumber %></td>
            </tr>
          <% } %>
          <tr>
            <td class="meta-key">Status:</td>
            <td class="meta-val">
              <span class="doc-status-badge <%= model.statusClass %>"><%= model.status %></span>
            </td>
          </tr>
        </table>

        <!-- LARGE HERO TITLE -->
        <div class="doc-hero-title"><%= model.isQuotation ? 'QUOTATION' : 'INVOICE' %></div>
        <div style="display: none;"><%= model.documentTitle %></div>
      </div>
    </div>

    <!-- CLEAN RED-ACCENTED ITEMS TABLE -->
    <table class="doc-items-table">
      <thead>
        <tr>
          <th class="col-no">NO</th>
          <th>Description</th>
          <th class="col-hsn">HSN/SAC</th>
          <th class="col-qty">QTY</th>
          <th class="col-rate">Unit Price</th>
          <th class="col-amt">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% if (model.items && model.items.length > 0) { %>
          <% model.items.forEach((item) => { %>
            <tr>
              <td class="col-no"><%= item.lineNumber %></td>
              <td class="item-desc-cell">
                <strong><%= item.name %></strong>
              </td>
              <td class="col-hsn"><%= item.hsnSac || '—' %></td>
              <td class="col-qty"><%= item.quantity %> <%= item.unit %></td>
              <td class="col-rate"><%= item.formattedRate %></td>
              <td class="col-amt"><%= item.formattedAmount %></td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 24px; color: var(--doc-text-muted);">No line items found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- TERMS & CONDITIONS (LEFT) + TOTALS (RIGHT) -->
    <div class="doc-terms-totals">
      <!-- TERMS & CONDITIONS (LEFT) -->
      <div class="terms-block-left">
        <% if (model.terms) { %>
          <div class="terms-heading-italic">Terms & Conditions</div>
          <div class="terms-text-content"><%= model.terms %></div>
        <% } %>

        <% if (model.notes) { %>
          <div class="doc-remarks-content">
            <strong>Remarks:</strong> <%= model.notes %>
          </div>
        <% } %>
      </div>

      <!-- TOTALS BREAKDOWN (RIGHT) -->
      <div class="totals-wrapper">
        <table class="totals-sub-table">
          <tr>
            <td class="t-label">Sub Total:</td>
            <td class="t-val"><%= model.financials.formattedSubtotal %></td>
          </tr>
          <% if (model.financials.gstEnabled) { %>
            <% if (model.financials.isInterState) { %>
              <tr>
                <td class="t-label">IGST (<%= model.financials.gstRate %>%):</td>
                <td class="t-val"><%= model.financials.formattedIgstAmount %></td>
              </tr>
            <% } else { %>
              <tr>
                <td class="t-label">CGST (<%= (Number(model.financials.gstRate) / 2).toFixed(2) %>%):</td>
                <td class="t-val"><%= model.financials.formattedCgstAmount %></td>
              </tr>
              <tr>
                <td class="t-label">SGST (<%= (Number(model.financials.gstRate) / 2).toFixed(2) %>%):</td>
                <td class="t-val"><%= model.financials.formattedSgstAmount %></td>
              </tr>
            <% } %>
          <% } %>
          <% if (Number(model.financials.roundOff) !== 0) { %>
            <tr>
              <td class="t-label">Round Off:</td>
              <td class="t-val"><%= model.financials.formattedRoundOff %></td>
            </tr>
          <% } %>
        </table>

        <!-- HIGHLIGHTED TOTAL BLOCK -->
        <div class="doc-total-badge-row">
          <span class="total-badge-label">TOTAL</span>
          <span class="total-badge-val"><%= model.financials.formattedGrandTotal %></span>
        </div>
        <div class="doc-total-underline"></div>

        <% if (!model.isQuotation) { %>
          <table class="totals-sub-table" style="margin-top: 6px;">
            <tr>
              <td class="t-label">Paid Amount:</td>
              <td class="t-val" style="color: #166534;"><%= model.financials.formattedPaidAmount %></td>
            </tr>
            <tr>
              <td class="t-label" style="font-weight: 700; color: #dc2626;">Outstanding Balance:</td>
              <td class="t-val" style="font-weight: 700; color: #dc2626;"><%= model.financials.formattedOutstandingAmount %></td>
            </tr>
          </table>
        <% } %>
      </div>
    </div>

    <!-- LIGHT-GREY PAYMENT / BANK INFORMATION STRIP -->
    <div class="doc-payment-strip">
      <% if (!model.isQuotation) { %>
        <div class="strip-bank-info">
          <strong>Bank Transfer :</strong>
          <% if (model.seller.hasBankDetails) { %>
            <%= model.seller.bankName %> (A/C: <%= model.seller.accountNumber %><% if (model.seller.ifscCode) { %>, IFSC: <%= model.seller.ifscCode %><% } %><% if (model.seller.branch) { %>, <%= model.seller.branch %><% } %>)
          <% } else { %>
            Pending settlement account configuration
          <% } %>
        </div>
        <% if (model.seller.upiId) { %>
          <div class="strip-upi-info">
            <strong>UPI / Remittance :</strong> <%= model.seller.upiId %>
          </div>
          <% if (showUpiQr) { %>
            <div class="doc-upi-qr-badge" style="display: inline-flex; align-items: center; gap: 8px; margin-left: 12px; padding: 2px 8px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 11px;">
              <span style="font-weight: 700; color: #15803d;"><i class="bi bi-qr-code"></i> UPI QR Ready</span>
              <span style="color: #64748b;">(GPay / PhonePe / Paytm / BHIM)</span>
            </div>
          <% } %>
        <% } %>
      <% } else { %>
        <div class="strip-bank-info">
          <strong>Quotation Validity :</strong>
          Valid until <%= model.dates.dueOrExpiryDate %>. Upon acceptance, will convert to Tax Invoice.
        </div>
      <% } %>
    </div>

    <!-- THANK-YOU SECTION -->
    <div class="doc-thank-you-box">
      <div class="doc-thank-you-text">Thanks for your Business!</div>
    </div>

    <!-- AUTHORIZED SIGNATORY -->
    <div class="doc-signatory-row">
      <div class="doc-auth-meta">
        <div>System-authenticated document</div>
        <div><%= model.invoiceNumber %></div>
      </div>
      <div class="doc-signatory-box">
        <div class="doc-signatory-line"></div>
        <div class="doc-signatory-caption">Authorized Signatory for <%= model.seller.name %></div>
      </div>
    </div>
  </div>

  <!-- FULL-WIDTH RED FOOTER -->
  <div class="doc-footer-bar">
    <div class="footer-address">
      <%= model.seller.address %>
    </div>
    <div class="footer-contact">
      <svg class="footer-icon" viewBox="0 0 24 24">
        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
      <span><%= model.seller.phone %></span>
    </div>
    <div class="footer-contact">
      <svg class="footer-icon" viewBox="0 0 24 24">
        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
      </svg>
      <span><%= model.seller.email %></span>
    </div>
  </div>
</div>
