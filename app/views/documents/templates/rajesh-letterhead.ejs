<% if (position === 'top') { %>
<style>
  .theme-rajesh-signature { min-height: 1122px; display: flex; flex-direction: column; isolation: isolate; color: #10264a; }
  .theme-rajesh-signature .doc-top-bar { display: none; }
  .ri-top-art { position: absolute; top: 0; left: 0; width: 100%; height: 132px; z-index: -1; pointer-events: none; }
  .ri-watermark { position: absolute; right: 0; bottom: 126px; width: 49%; height: 328px; opacity: .075; z-index: -1; pointer-events: none; }
  .theme-rajesh-signature .doc-content-container { padding: 78px 36px 12px; flex: 1; }
  .theme-rajesh-signature .doc-brand-header { display: flex; align-items: center; justify-content: space-between; gap: 30px; text-align: left; padding: 0 0 22px; }
  .ri-brand-logo { width: 345px; max-width: 64%; height: auto; }
  .ri-tagline { border-left: 2px solid #d59a28; padding-left: 28px; font-size: 11px; line-height: 1.8; letter-spacing: 4px; color: #091e49; }
  .ri-tagline span { display: block; width: 100px; height: 2px; background: linear-gradient(90deg,#091e49 63%,#d59a28 63%); margin-top: 15px; }
  .ri-seller-identity { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 10px; margin-bottom: 12px; border-bottom: 1px solid #dbb45a; color: #091e49; font-size: 11px; }
  .ri-seller-identity strong { font-size: 12px; }
  .ri-seller-identity span { white-space: nowrap; font-size: 10px; }
  .theme-rajesh-signature .doc-header-grid { gap: 24px; margin-bottom: 12px; }
  .theme-rajesh-signature .bill-to-label { color: #b07c20; font-size: 10px; letter-spacing: 2px; margin-bottom: 8px; }
  .theme-rajesh-signature .bill-to-name { color: #091e49; font-size: 14px; }
  .theme-rajesh-signature .contact-item { font-size: 10px; }
  .theme-rajesh-signature .doc-hero-title { font-size: 28px; letter-spacing: 3px; color: #091e49; }
  .theme-rajesh-signature .meta-table td { font-size: 10px; }
  .theme-rajesh-signature .doc-items-table { margin-bottom: 16px; table-layout: fixed; }
  .theme-rajesh-signature .doc-items-table thead tr { background: #091e49; border-top: 0; border-bottom: 3px solid #d9a43a; }
  .theme-rajesh-signature .doc-items-table th { color: #fff; font-size: 9px; letter-spacing: .5px; padding: 10px 7px; }
  .theme-rajesh-signature .doc-items-table td { font-size: 10.5px; padding: 8px 7px; background: transparent; border-bottom: 1px solid #e6dfcf; }
  .theme-rajesh-signature .doc-items-table tbody tr:nth-child(even) td { background: rgba(249,246,238,.65); }
  .theme-rajesh-signature .doc-items-table .col-no { width: 28px; }
  .theme-rajesh-signature .doc-items-table .col-hsn { width: 58px; }
  .theme-rajesh-signature .doc-items-table .col-qty { width: 63px; }
  .theme-rajesh-signature .doc-items-table .col-rate { width: 90px; }
  .theme-rajesh-signature .doc-items-table .col-amt { width: 98px; }
  .ri-item-description { color: #617086; font-size: 9.5px; margin-top: 4px; white-space: pre-line; }
  .theme-rajesh-signature .terms-heading-italic { color: #ab7925; font-style: normal; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; }
  .theme-rajesh-signature .terms-text-content, .theme-rajesh-signature .doc-remarks-content { font-size: 10px; }
  .theme-rajesh-signature .terms-text-content { white-space: pre-line; }
  .theme-rajesh-signature .doc-terms-totals { grid-template-columns: 1.1fr 1fr; gap: 25px; margin-bottom: 12px; }
  .theme-rajesh-signature .totals-sub-table td { font-size: 10.5px; }
  .theme-rajesh-signature .doc-total-badge-row { background: #091e49; border-left: 4px solid #daa83f; border-radius: 0; }
  .theme-rajesh-signature .doc-total-underline { background: #d8a03a; }
  .theme-rajesh-signature .doc-payment-strip { background: rgba(249,245,234,.8); border: 1px solid #ebddbd; border-radius: 0; font-size: 9px; margin-bottom: 10px; }
  .theme-rajesh-signature .doc-thank-you-box { padding: 8px 0; margin-bottom: 8px; }
  .theme-rajesh-signature .doc-thank-you-text { color: #091e49; font-size: 16px; }
  .theme-rajesh-signature .doc-signatory-row { margin-top: 8px; padding-bottom: 0; }
  .theme-rajesh-signature .doc-signatory-line { height: 24px; }
  .theme-rajesh-signature .doc-signatory-caption, .theme-rajesh-signature .doc-auth-meta { font-size: 9px; }
  .theme-rajesh-signature .doc-footer-bar { background: transparent; color: #091e49; gap: 12px; padding: 12px 35px 10px; font-size: 9px; align-items: center; }
  .theme-rajesh-signature .footer-address { display: flex; align-items: center; gap: 9px; flex: 1.2; max-width: none; font-size: 9px; }
  .theme-rajesh-signature .footer-contact { white-space: normal; overflow-wrap: anywhere; flex: 1; font-size: 9px; border-left: 1px solid #dba235; padding-left: 12px; }
  .theme-rajesh-signature .footer-contact:nth-child(3) { flex: 1.5; }
  .theme-rajesh-signature .footer-contact:nth-child(4) { flex: 1.4; }
  .theme-rajesh-signature .footer-icon, .ri-contact-icon { width: 25px; height: 25px; min-width: 25px; padding: 6px; border-radius: 50%; background: #091e49; color: #fff; fill: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; }
  .ri-bottom-art { width: 100%; height: 87px; display: block; flex-shrink: 0; break-inside: avoid; }
  @media print {
    @page { size: A4; margin: 0; }
    .theme-rajesh-signature { min-height: 296.5mm; width: 210mm; }
    .theme-rajesh-signature .doc-content-container { padding: 21mm 10mm 3mm; }
    .theme-rajesh-signature .doc-header-grid { grid-template-columns: 1.15fr .85fr; }
    .theme-rajesh-signature .doc-terms-totals { grid-template-columns: 1.1fr 1fr; }
    .theme-rajesh-signature .doc-footer-bar { flex-direction: row; align-items: center; padding: 3mm 10mm 2.5mm; }
    .theme-rajesh-signature .doc-brand-header { padding-bottom: 6mm; }
    .ri-top-art, .ri-bottom-art { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .theme-rajesh-signature .doc-meta-section, .theme-rajesh-signature .doc-hero-title { text-align: right; }
    .theme-rajesh-signature .doc-signatory-row { flex-direction: row; }
    .theme-rajesh-signature .doc-signatory-box { width: 240px; text-align: right; }
  }
  @media screen and (max-width: 600px) {
    .ri-tagline { padding-left: 12px; letter-spacing: 1.5px; font-size: 8px; }
    .ri-tagline span { width: 65px; }
    .theme-rajesh-signature .doc-content-container { padding: 74px 18px 12px; }
    .theme-rajesh-signature .doc-footer-bar { flex-wrap: wrap; padding: 15px 18px; }
    .theme-rajesh-signature .footer-address { max-width: none; width: 100%; }
    .theme-rajesh-signature .footer-contact { border: 0; padding: 0; }
    .ri-seller-identity { flex-wrap: wrap; gap: 5px; }
    .theme-rajesh-signature .doc-items-table .col-rate { width: 72px; }
    .theme-rajesh-signature .doc-items-table .col-amt { width: 76px; }
    .theme-rajesh-signature .doc-items-table .col-hsn { width: 44px; }
    .theme-rajesh-signature .doc-items-table .col-qty { width: 44px; }
    .theme-rajesh-signature .doc-items-table td { font-size: 9px; padding: 7px 4px; }
  }
</style>
<svg class="ri-top-art" viewBox="0 0 1055 175" preserveAspectRatio="none" aria-hidden="true">
  <defs><linearGradient id="ri-top-navy" x2="1" y2="1"><stop stop-color="#274366"/><stop offset=".6" stop-color="#071c41"/><stop offset="1" stop-color="#152c53"/></linearGradient><linearGradient id="ri-top-gold"><stop stop-color="#b3781d"/><stop offset=".25" stop-color="#ffe398"/><stop offset=".55" stop-color="#d4952f"/><stop offset="1" stop-color="#f2d29a"/></linearGradient></defs>
  <path d="M0 0H535C342 24 129 68 0 175Z" fill="url(#ri-top-gold)"/>
  <path d="M0 0H432C226 28 74 106 0 174Z" fill="url(#ri-top-navy)"/>
  <path d="M0 0H245C131 33 45 85 0 145Z" fill="#263d59" opacity=".75"/>
  <path d="M0 168Q84 61 245 0Q93 43 0 157Z" fill="url(#ri-top-gold)"/>
</svg>
<svg class="ri-watermark" viewBox="65 60 830 630" aria-hidden="true"><image href="<%= logo %>" width="2170" height="725"/></svg>
<% } else { %>
<svg class="ri-bottom-art" viewBox="0 0 1055 145" preserveAspectRatio="none" aria-hidden="true">
  <defs><linearGradient id="ri-bottom-navy" x2="1" y2=".4"><stop stop-color="#071b40"/><stop offset=".55" stop-color="#122f5b"/><stop offset="1" stop-color="#061637"/></linearGradient><linearGradient id="ri-bottom-gold"><stop stop-color="#f9dc80"/><stop offset=".25" stop-color="#ca8b26"/><stop offset=".5" stop-color="#ffe9ab"/><stop offset=".7" stop-color="#e0a132"/><stop offset="1" stop-color="#c58b2d"/></linearGradient></defs>
  <path d="M0 15C35 58 61 62 105 62H450C519 62 548 111 627 112C791 112 987 65 1055 0V145H0Z" fill="url(#ri-bottom-gold)"/>
  <path d="M0 27C35 66 61 69 105 69H450C519 69 548 138 627 138C791 138 1000 78 1055 20V145H0Z" fill="url(#ri-bottom-navy)"/>
  <path d="M700 145C862 124 975 75 1055 0V18C974 90 869 128 780 145Z" fill="url(#ri-bottom-gold)"/>
  <text x="57" y="115" fill="#fff" font-family="Arial, sans-serif" font-size="13" letter-spacing="3">PEOPLE<tspan fill="#dca83a">　|　</tspan>PARTNERSHIPS<tspan fill="#dca83a">　|　</tspan>PROGRESS</text>
</svg>
<% } %>
