<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <button class="btn btn-primary d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newExpenseModal">
      <i class="bi bi-plus-circle"></i>
      <span>Record Expense</span>
    </button>
  </div>

  <!-- Filters Card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/financials/expenses" class="row g-2 align-items-center">
        <div class="col-md-6">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Search description..." value="<%= search %>">
        </div>
        <div class="col-md-4">
          <input type="text" name="category" class="form-control form-control-sm" placeholder="Category (e.g. Office, Utilities)..." value="<%= category %>">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Expenses Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Date</th>
              <th>Category</th>
              <th>Description</th>
              <th class="text-end pe-3">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% if (records && records.length > 0) { %>
              <% records.forEach(exp => { %>
                <tr>
                  <td class="ps-3"><%= new Date(exp.expenseDate).toLocaleDateString() %></td>
                  <td><span class="badge bg-secondary"><%= exp.category || 'General' %></span></td>
                  <td><%= exp.description %></td>
                  <td class="text-end pe-3 fw-bold text-danger">-$<%= parseFloat(exp.amount).toFixed(2) %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center py-4 text-muted">No expenses recorded yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal for New Expense -->
<div class="modal fade" id="newExpenseModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="expenseForm">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Record Operating Expense</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Expense Date <span class="text-danger">*</span></label>
            <input type="date" name="expenseDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Category <span class="text-danger">*</span></label>
            <input type="text" name="category" class="form-control" placeholder="e.g. Office Supplies, Travel, Software" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Amount ($) <span class="text-danger">*</span></label>
            <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Payment Method</label>
            <select name="paymentMethod" class="form-select">
              <option value="BANK" selected>Bank Account</option>
              <option value="CASH">Cash on Hand</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Description / Purpose <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="2" placeholder="Details of expense..." required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Post Expense</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('expenseForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const payload = {
    expenseDate: formData.get('expenseDate'),
    category: formData.get('category'),
    amount: parseFloat(formData.get('amount')),
    paymentMethod: formData.get('paymentMethod'),
    description: formData.get('description')
  };

  try {
    const res = await fetch('/api/expenses', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      alert('Expense recorded and posted to ledger.');
      location.reload();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (err) {
    alert('Failed to save expense.');
  }
});
</script>

<%- include('../layouts/footer') %>
