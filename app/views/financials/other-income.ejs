<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <button class="btn btn-success d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newIncomeModal">
      <i class="bi bi-plus-circle"></i>
      <span>Record Other Income</span>
    </button>
  </div>

  <!-- Filters Card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/financials/other-income" class="row g-2 align-items-center">
        <div class="col-md-6">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Search description..." value="<%= search %>">
        </div>
        <div class="col-md-4">
          <input type="text" name="source" class="form-control form-control-sm" placeholder="Source (e.g. Interest, Scrap Sale)..." value="<%= source %>">
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Incomes Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Date</th>
              <th>Source</th>
              <th>Description</th>
              <th class="text-end pe-3">Amount</th>
            </tr>
          </thead>
          <tbody>
            <% if (records && records.length > 0) { %>
              <% records.forEach(inc => { %>
                <tr>
                  <td class="ps-3"><%= new Date(inc.incomeDate).toLocaleDateString() %></td>
                  <td><span class="badge bg-info text-dark"><%= inc.source || 'General' %></span></td>
                  <td><%= inc.description %></td>
                  <td class="text-end pe-3 fw-bold text-success">+$<%= parseFloat(inc.amount).toFixed(2) %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="text-center py-4 text-muted">No other income entries recorded yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal for New Income -->
<div class="modal fade" id="newIncomeModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="incomeForm">
        <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
        <div class="modal-header">
          <h5 class="modal-title fw-bold">Record Non-Invoice Other Income</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-bold">Income Date <span class="text-danger">*</span></label>
            <input type="date" name="incomeDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Source / Type <span class="text-danger">*</span></label>
            <input type="text" name="source" class="form-control" placeholder="e.g. Bank Interest, Equipment Rental, Rebate" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Amount (₹) <span class="text-danger">*</span></label>
            <input type="number" step="0.01" name="amount" class="form-control font-monospace" placeholder="0.00" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Receipt Method</label>
            <select name="receiptMethod" class="form-select">
              <option value="BANK" selected>Direct to Bank</option>
              <option value="CASH">Cash Received</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-bold">Description <span class="text-danger">*</span></label>
            <textarea name="description" class="form-control" rows="2" placeholder="Details of income received..." required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success">Post Income to Ledger</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.getElementById('incomeForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const csrfToken = formData.get('_csrf') || (document.querySelector('input[name="_csrf"]')?.value || '');
  const payload = {
    incomeDate: formData.get('incomeDate'),
    source: formData.get('source'),
    amount: parseFloat(formData.get('amount')),
    receiptMethod: formData.get('receiptMethod'),
    description: formData.get('description'),
    _csrf: csrfToken
  };

  try {
    const res = await fetch('/api/other-incomes', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      alert('Income recorded and posted to ledger.');
      location.reload();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (err) {
    alert('Failed to save income.');
  }
});
</script>

<%- include('../layouts/footer') %>
