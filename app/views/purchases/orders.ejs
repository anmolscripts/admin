<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <a href="/purchases/orders/new" class="btn btn-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i>
        <span>New Purchase Order</span>
      </a>
      <a href="/purchases/bills" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-receipt"></i>
        <span>Supplier Bills</span>
      </a>
    </div>
  </div>

  <!-- Filters Card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/purchases/orders" class="row g-2 align-items-center">
        <div class="col-md-5">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Search PO # or supplier..." value="<%= search %>">
        </div>
        <div class="col-md-3">
          <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            <option value="ACTIVE" <%= status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
            <option value="VOID" <%= status === 'VOID' ? 'selected' : '' %>>Void</option>
            <option value="DELETED" <%= status === 'DELETED' ? 'selected' : '' %>>Deleted</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">PO Number</th>
              <th>Supplier</th>
              <th>Order Date</th>
              <th>Due Date</th>
              <th>Items</th>
              <th>Status</th>
              <th class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (records && records.length > 0) { %>
              <% records.forEach(po => { %>
                <tr>
                  <td class="ps-3 fw-bold"><%= po.orderNumber %></td>
                  <td><%= po.supplierName %></td>
                  <td><%= new Date(po.orderDate).toLocaleDateString() %></td>
                  <td><%= po.dueDate ? new Date(po.dueDate).toLocaleDateString() : '—' %></td>
                  <td><%= po.items ? po.items.length : 0 %> items</td>
                  <td>
                    <span class="badge bg-<%= po.status === 'ACTIVE' ? 'success' : (po.status === 'VOID' ? 'danger' : 'secondary') %>">
                      <%= po.status %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <% if (po.status === 'ACTIVE') { %>
                      <button class="btn btn-sm btn-outline-danger" onclick="voidOrder(<%= po.id %>)">Void</button>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">No purchase orders found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
async function voidOrder(id) {
  const reason = prompt('Please enter reason for voiding this purchase order:');
  if (!reason) return;
  try {
    const res = await fetch(`/api/purchase-orders/${id}/void`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason })
    });
    const data = await res.json();
    if (data.success) {
      alert('Purchase Order voided.');
      location.reload();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (err) {
    alert('Failed to void purchase order.');
  }
}
</script>

<%- include('../layouts/footer') %>
