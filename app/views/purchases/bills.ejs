<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <a href="/purchases/bills/new" class="btn btn-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i>
        <span>Record Supplier Bill</span>
      </a>
      <a href="/purchases/orders" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-cart"></i>
        <span>Purchase Orders</span>
      </a>
    </div>
  </div>

  <!-- Filters Card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/purchases/bills" class="row g-2 align-items-center">
        <div class="col-md-5">
          <input type="text" name="search" class="form-control form-control-sm" placeholder="Search Bill # or supplier..." value="<%= search %>">
        </div>
        <div class="col-md-3">
          <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            <option value="ACTIVE" <%= status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
            <option value="VOID" <%= status === 'VOID' ? 'selected' : '' %>>Void</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-sm btn-dark w-100">Filter</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Bills Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Bill Number</th>
              <th>Supplier</th>
              <th>Bill Date</th>
              <th>Due Date</th>
              <th>Total Amount</th>
              <th>Status</th>
              <th class="text-end pe-3">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (records && records.length > 0) { %>
              <% records.forEach(bill => { %>
                <tr>
                  <td class="ps-3 fw-bold"><%= bill.billNumber %></td>
                  <td><%= bill.supplierName %></td>
                  <td><%= new Date(bill.billDate).toLocaleDateString() %></td>
                  <td><%= bill.dueDate ? new Date(bill.dueDate).toLocaleDateString() : '—' %></td>
                  <td class="fw-bold">$<%= parseFloat(bill.totalAmount).toFixed(2) %></td>
                  <td>
                    <span class="badge bg-<%= bill.status === 'ACTIVE' ? 'success' : 'danger' %>">
                      <%= bill.status %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <% if (bill.status === 'ACTIVE') { %>
                      <button class="btn btn-sm btn-outline-danger" onclick="voidBill(<%= bill.id %>)">Void</button>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">No supplier bills recorded yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
async function voidBill(id) {
  const reason = prompt('Please enter reason for voiding this supplier bill (this will reverse the accounting journal):');
  if (!reason) return;
  try {
    const res = await fetch(`/api/supplier-bills/${id}/void`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason })
    });
    const data = await res.json();
    if (data.success) {
      alert('Supplier Bill voided and accounting ledger reversed.');
      location.reload();
    } else {
      alert('Error: ' + data.error);
    }
  } catch (err) {
    alert('Failed to void supplier bill.');
  }
}
</script>

<%- include('../layouts/footer') %>
