<%- include('../layouts/header', { showPageHeader: false }) %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="page-title fw-bold text-dark mb-1">Goods Receipts (GRN)</h1>
      <p class="text-muted small mb-0">Track incoming warehouse stock, inspection status, and delivery challans.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <a href="/purchases/orders" class="btn btn-sm btn-outline-primary px-3">
        <i class="bi bi-cart me-1"></i> Purchase Orders
      </a>
    </div>
  </div>

  <!-- Search & Filter Card -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3">
      <form method="GET" action="/purchases/receipts" class="row g-2 align-items-center">
        <div class="col-md-5">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control border-start-0" placeholder="Search by GRN #, Supplier, Challan, or Store..." value="<%= search || '' %>" />
          </div>
        </div>
        <div class="col-md-3">
          <select name="status" class="form-select form-select-sm">
            <option value="">All Statuses</option>
            <option value="ACCEPTED" <%= status === 'ACCEPTED' ? 'selected' : '' %>>Accepted</option>
            <option value="DRAFT" <%= status === 'DRAFT' ? 'selected' : '' %>>Draft</option>
            <option value="CANCELLED" <%= status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
          </select>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-sm btn-primary w-100">Filter</button>
        </div>
        <% if (search || status) { %>
          <div class="col-md-2">
            <a href="/purchases/receipts" class="btn btn-sm btn-outline-secondary w-100">Clear</a>
          </div>
        <% } %>
      </form>
    </div>
  </div>

  <!-- Goods Receipts Table -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
      <table data-spark-datatable="true" data-server-paginated="true" class="table table-hover align-middle mb-0">
        <thead class="table-light small">
          <tr>
            <th class="ps-3">GRN #</th>
            <th>Receipt Date</th>
            <th>Supplier</th>
            <th>Purchase Order</th>
            <th>Project</th>
            <th>Store / Warehouse</th>
            <th>Challan #</th>
            <th class="text-center">Status</th>
            <th class="pe-3 text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (records && records.length > 0) { %>
            <% records.forEach(grn => { %>
              <tr data-record-type="goodsReceipt" data-record-id="<%= grn.id %>" tabindex="0" aria-label="Open record details">
                <td class="ps-3 fw-bold font-monospace text-primary">
                  <a href="/purchases/receipts/<%= grn.id %>" class="text-decoration-none">
                    <%= grn.receiptNumber %>
                  </a>
                </td>
                <td class="small text-muted"><%= new Date(grn.receiptDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
                <td>
                  <div class="fw-semibold text-dark"><%= grn.supplierName %></div>
                </td>
                <td>
                  <% if (grn.purchaseOrder) { %>
                    <a href="/purchases/orders/<%= grn.purchaseOrder.id %>" class="badge bg-light text-primary border text-decoration-none font-monospace">
                      <%= grn.purchaseOrder.orderNumber %>
                    </a>
                  <% } else { %>
                    <span class="text-muted small">Direct Delivery</span>
                  <% } %>
                </td>
                <td>
                  <% if (grn.project) { %>
                    <a href="/projects/<%= grn.project.id %>" class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill text-decoration-none">
                      <%= grn.project.code %>
                    </a>
                  <% } else { %>
                    <span class="text-muted small">General Inventory</span>
                  <% } %>
                </td>
                <td><span class="badge bg-light text-dark border"><%= grn.storeLocation %></span></td>
                <td class="small text-muted font-monospace"><%= grn.deliveryChallanNumber || '—' %></td>
                <td class="text-center">
                  <span class="badge <%= grn.status === 'ACCEPTED' ? 'bg-success' : (grn.status === 'CANCELLED' ? 'bg-danger' : 'bg-secondary') %> rounded-pill px-2">
                    <%= grn.status %>
                  </span>
                </td>
                <td class="pe-3 text-end">
                  <a href="/purchases/receipts/<%= grn.id %>" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-eye me-1"></i> Details
                  </a>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                <i class="bi bi-inbox display-6 d-block mb-2 text-secondary opacity-50"></i>
                No goods receipts registered yet.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
