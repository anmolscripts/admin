<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <a href="/purchases/orders" class="btn btn-outline-secondary">Back to Orders</a>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="poForm">
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label fw-bold">Supplier <span class="text-danger">*</span></label>
            <select name="supplierId" class="form-select" required>
              <option value="">Select Supplier...</option>
              <% suppliers.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.name %> <%= s.gstin ? '(' + s.gstin + ')' : '' %></option>
              <% }); %>
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Order Date <span class="text-danger">*</span></label>
            <input type="date" name="orderDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-bold">Expected Delivery / Due Date</label>
            <input type="date" name="dueDate" class="form-control">
          </div>
        </div>

        <h5 class="fw-bold mb-3">Order Line Items</h5>
        <div class="table-responsive mb-3">
          <table class="table table-bordered align-middle" id="itemsTable">
            <thead class="table-light">
              <tr>
                <th style="width: 40%;">Item Name / Description <span class="text-danger">*</span></th>
                <th style="width: 15%;">HSN/SAC</th>
                <th style="width: 15%;">Quantity <span class="text-danger">*</span></th>
                <th style="width: 15%;">Rate ($) <span class="text-danger">*</span></th>
                <th style="width: 15%;">Amount ($)</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="itemsBody">
              <tr>
                <td><input type="text" class="form-control form-control-sm item-name" required placeholder="Item description"></td>
                <td><input type="text" class="form-control form-control-sm item-hsn"></td>
                <td><input type="number" step="0.01" class="form-control form-control-sm item-qty" value="1" required oninput="calcTotals()"></td>
                <td><input type="number" step="0.01" class="form-control form-control-sm item-rate" value="0.00" required oninput="calcTotals()"></td>
                <td><input type="text" class="form-control form-control-sm item-amt" readonly value="0.00"></td>
                <td><button type="button" class="btn btn-sm btn-link text-danger" onclick="removeItem(this)">✕</button></td>
              </tr>
            </tbody>
          </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary mb-4" onclick="addItem()">+ Add Item</button>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label class="form-label fw-bold">Terms & Conditions</label>
            <textarea name="termsAndConditions" class="form-control" rows="3" placeholder="Standard procurement terms..."></textarea>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Remarks / Internal Notes</label>
            <textarea name="remarks" class="form-control" rows="3" placeholder="Notes for fulfillment..."></textarea>
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="/purchases/orders" class="btn btn-light">Cancel</a>
          <button type="submit" class="btn btn-primary px-4">Create Purchase Order</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function calcTotals() {
  document.querySelectorAll('#itemsBody tr').forEach(tr => {
    const qty = parseFloat(tr.querySelector('.item-qty').value) || 0;
    const rate = parseFloat(tr.querySelector('.item-rate').value) || 0;
    tr.querySelector('.item-amt').value = (qty * rate).toFixed(2);
  });
}

function addItem() {
  const tr = document.createElement('tr');
  tr.innerHTML = `
    <td><input type="text" class="form-control form-control-sm item-name" required placeholder="Item description"></td>
    <td><input type="text" class="form-control form-control-sm item-hsn"></td>
    <td><input type="number" step="0.01" class="form-control form-control-sm item-qty" value="1" required oninput="calcTotals()"></td>
    <td><input type="number" step="0.01" class="form-control form-control-sm item-rate" value="0.00" required oninput="calcTotals()"></td>
    <td><input type="text" class="form-control form-control-sm item-amt" readonly value="0.00"></td>
    <td><button type="button" class="btn btn-sm btn-link text-danger" onclick="removeItem(this)">✕</button></td>
  `;
  document.getElementById('itemsBody').appendChild(tr);
}

function removeItem(btn) {
  if (document.querySelectorAll('#itemsBody tr').length > 1) {
    btn.closest('tr').remove();
    calcTotals();
  }
}

document.getElementById('poForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const formData = new FormData(e.target);
  const items = [];
  document.querySelectorAll('#itemsBody tr').forEach(tr => {
    items.push({
      name: tr.querySelector('.item-name').value,
      hsnSac: tr.querySelector('.item-hsn').value,
      quantity: parseFloat(tr.querySelector('.item-qty').value) || 1,
      rate: parseFloat(tr.querySelector('.item-rate').value) || 0
    });
  });

  const payload = {
    supplierId: parseInt(formData.get('supplierId'), 10),
    orderDate: formData.get('orderDate'),
    dueDate: formData.get('dueDate') || null,
    termsAndConditions: formData.get('termsAndConditions') || null,
    remarks: formData.get('remarks') || null,
    items
  };

  try {
    const res = await fetch('/api/purchase-orders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();
    if (data.success) {
      alert('Purchase Order created successfully!');
      window.location.href = '/purchases/orders';
    } else {
      alert('Error: ' + data.error);
    }
  } catch (err) {
    alert('Failed to save purchase order.');
  }
});
</script>

<%- include('../layouts/footer') %>
