<%
  const headerActionHtml = `
    <div class="d-flex gap-2">
      <a href="/credit-debit-notes/new?type=CREDIT" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
        <i class="bi bi-dash-circle"></i>
        <span>New Credit Note</span>
      </a>
      <a href="/credit-debit-notes/new?type=DEBIT" class="btn btn-outline-info d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i>
        <span>New Debit Note</span>
      </a>
    </div>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: 'Credit & Debit Notes',
    pageSubtitle: 'Manage seller-issued credit and debit adjustments against sales invoices.',
    headerAction: headerActionHtml
}) %>

<div class="content-wrapper p-4">
  <!-- Filters & Search Toolbar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/credit-debit-notes" class="row g-2 align-items-center">
        <!-- Search -->
        <div class="col-md-5">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted">
              <i class="bi bi-search"></i>
            </span>
            <input type="text" name="search" class="form-control border-start-0"
                   placeholder="Search by Note #, Invoice #, Client, or Reason..."
                   value="<%= filters.search || '' %>">
          </div>
        </div>

        <!-- Note Type Filter -->
        <div class="col-md-3">
          <select name="noteType" class="form-select" onchange="this.form.submit()">
            <option value="">All Note Types</option>
            <option value="CREDIT" <%= filters.noteType === 'CREDIT' ? 'selected' : '' %>>Credit Notes (CN)</option>
            <option value="DEBIT" <%= filters.noteType === 'DEBIT' ? 'selected' : '' %>>Debit Notes (DN)</option>
          </select>
        </div>

        <!-- Status Filter -->
        <div class="col-md-2">
          <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">All Statuses</option>
            <option value="ISSUED" <%= filters.status === 'ISSUED' ? 'selected' : '' %>>Issued</option>
            <option value="VOID" <%= filters.status === 'VOID' ? 'selected' : '' %>>Void</option>
          </select>
        </div>

        <!-- Actions -->
        <div class="col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
          <% if (filters.search || filters.noteType || filters.status) { %>
            <a href="/credit-debit-notes" class="btn btn-outline-secondary d-inline-flex align-items-center justify-content-center" style="width: 38px; min-width: 38px;" title="Clear Filters">
              <i class="bi bi-x-lg"></i>
            </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Notes Table -->
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" id="notes-table">
        <thead class="table-light text-muted small text-uppercase">
          <tr>
            <th scope="col" style="width: 140px;">Note #</th>
            <th scope="col" style="width: 100px;">Type</th>
            <th scope="col" style="width: 110px;">Date</th>
            <th scope="col" style="width: 150px;">Invoice #</th>
            <th scope="col">Client</th>
            <th scope="col" class="text-end" style="width: 130px;">Grand Total</th>
            <th scope="col" class="text-center" style="width: 90px;">Status</th>
            <th scope="col" class="text-center" style="width: 150px;">Ledger Journal</th>
            <th scope="col" class="text-end" style="width: 120px;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (notes && notes.length > 0) { %>
            <% notes.forEach(n => { %>
              <tr>
                <td>
                  <a href="/credit-debit-notes/<%= n.id %>" class="fw-bold font-monospace text-decoration-none">
                    <%= n.noteNumber %>
                  </a>
                </td>
                <td>
                  <% if (n.noteType === 'CREDIT') { %>
                    <span class="badge bg-purple-subtle text-purple border" style="background-color: #faf5ff; color: #7c3aed; border-color: #e9d5ff !important;">
                      <i class="bi bi-dash me-1"></i>CREDIT
                    </span>
                  <% } else { %>
                    <span class="badge bg-info-subtle text-info border">
                      <i class="bi bi-plus me-1"></i>DEBIT
                    </span>
                  <% } %>
                </td>
                <td class="text-muted small">
                  <%= new Date(n.noteDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <a href="/documents/<%= n.invoiceId %>" class="font-monospace text-decoration-none small" title="View Original Invoice">
                    <%= n.originalInvoiceNumber %>
                  </a>
                </td>
                <td>
                  <div class="fw-medium text-truncate" style="max-width: 220px;" title="<%= n.clientName %>">
                    <%= n.clientName %>
                  </div>
                  <% if (n.reason) { %>
                    <div class="text-muted small text-truncate" style="max-width: 220px;" title="<%= n.reason %>">
                      <%= n.reason %>
                    </div>
                  <% } %>
                </td>
                <td class="text-end fw-semibold font-monospace">
                  ₹<%= Number(n.grandTotal).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </td>
                <td class="text-center">
                  <% if (n.status === 'ISSUED') { %>
                    <span class="badge bg-success-subtle text-success">ISSUED</span>
                  <% } else if (n.status === 'VOID') { %>
                    <span class="badge bg-secondary-subtle text-secondary">VOID</span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning">DRAFT</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <% if (n.accounting && n.accounting.isPosted && n.accounting.entryNumber) { %>
                    <% if (n.accounting.status === 'REVERSED') { %>
                      <a href="/accounting/journals/<%= n.accounting.journalId %>" class="badge bg-warning-subtle text-warning border text-decoration-none font-monospace" title="Journal Reversed">
                        <i class="bi bi-arrow-counterclockwise me-1"></i><%= n.accounting.entryNumber %>
                      </a>
                    <% } else { %>
                      <a href="/accounting/journals/<%= n.accounting.journalId %>" class="badge bg-primary-subtle text-primary border text-decoration-none font-monospace" title="View Double-Entry Journal">
                        <i class="bi bi-journal-text me-1"></i><%= n.accounting.entryNumber %>
                      </a>
                    <% } %>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary">Unposted</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/credit-debit-notes/<%= n.id %>" class="btn btn-outline-secondary" title="View Note">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/credit-debit-notes/<%= n.id %>/print" class="btn btn-outline-secondary" title="Print Note" target="_blank">
                      <i class="bi bi-printer"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-5 text-muted">
                <i class="bi bi-receipt fs-1 d-block mb-2 text-muted"></i>
                <div class="fw-semibold">No Credit or Debit Notes Found</div>
                <div class="small">Issue a note against an invoice to adjust accounts receivable and tax records.</div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <span class="text-muted small">
          Showing Page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.total %> total notes)
        </span>
        <ul class="pagination pagination-sm mb-0">
          <% if (pagination.page > 1) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= pagination.page - 1 %>&noteType=<%= filters.noteType || '' %>&status=<%= filters.status || '' %>&search=<%= filters.search || '' %>">Previous</a>
            </li>
          <% } %>
          <% for (let p = 1; p <= pagination.totalPages; p++) { %>
            <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= p %>&noteType=<%= filters.noteType || '' %>&status=<%= filters.status || '' %>&search=<%= filters.search || '' %>"><%= p %></a>
            </li>
          <% } %>
          <% if (pagination.page < pagination.totalPages) { %>
            <li class="page-item">
              <a class="page-link" href="?page=<%= pagination.page + 1 %>&noteType=<%= filters.noteType || '' %>&status=<%= filters.status || '' %>&search=<%= filters.search || '' %>">Next</a>
            </li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('../layouts/footer') %>
