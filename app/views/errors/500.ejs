<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= pageTitle %> - Spark Admin</title>

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/premium-refresh.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('spark-theme');
                var theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>

<body>

<div class="container py-5">
    <div class="text-center">

        <div class="mb-4">
            <i class="bi bi-x-circle display-1 text-danger"></i>
        </div>

        <h1 class="display-4 fw-bold"><%= locals.statusCode || 500 %></h1>

        <h3><%= locals.statusCode && locals.statusCode < 500 ? 'Request Could Not Be Completed' : 'Something Went Wrong' %></h3>

        <p class="text-muted">
            <%= locals.errorMessage || 'An unexpected error occurred while processing your request.' %>
        </p>

        <a href="/" class="btn btn-primary">
            <i class="bi bi-house me-1"></i>
            Back to Dashboard
        </a>

        <% if (error) { %>
            <div class="alert alert-danger text-start mt-4">
                <strong>Error:</strong>
                <%= error.message %>
            </div>
        <% } %>

    </div>
</div>

</body>
</html>
