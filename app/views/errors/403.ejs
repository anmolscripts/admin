<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= pageTitle || 'Access Denied' %> - Spark Admin</title>

    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body class="bg-light">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 text-center">

            <div class="mb-4">
                <i class="bi bi-shield-slash display-1 text-danger"></i>
            </div>

            <h1 class="display-5 fw-bold text-dark mb-2">403</h1>

            <h3 class="fw-semibold mb-3">Access Denied</h3>

            <p class="text-muted mb-4 lead fs-6">
                You do not have the required permissions to access this section or perform this operation.
                If you believe this is an error, please contact your organization administrator.
            </p>

            <div class="d-flex justify-content-center gap-3">
                <a href="javascript:history.back()" class="btn btn-spark btn-spark-outline">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </a>
                <a href="/dashboard" class="btn btn-spark btn-spark-primary">
                    <i class="bi bi-house me-1"></i> Dashboard
                </a>
            </div>

        </div>
    </div>
</div>

</body>
</html>
