<!doctype html><html lang="en" data-theme="light"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Training · <%= screen.title %></title><link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/libs/bootstrap-icons/bootstrap-icons.css"><link rel="stylesheet" href="/css/theme.css"><link rel="stylesheet" href="/css/premium-refresh.css"><link rel="stylesheet" href="/css/components.css"><style>
body{margin:0!important;padding:16px!important;background:#edf3ef!important;color:#193247!important;font-family:Montserrat,sans-serif}.training-frame{max-width:860px;margin:0 auto;background:#f7faf8;border:1px solid #d5e2da;border-radius:20px;overflow:hidden;box-shadow:0 12px 40px #173b2314}.training-top{display:flex;align-items:center;justify-content:space-between;padding:17px 22px;background:#113e2d;color:#fff}.training-top strong{font-size:15px}.training-top small{background:#d7f9a3;color:#153b25;border-radius:20px;padding:5px 10px;font-size:10px;font-weight:700}.training-body{padding:22px}.training-body h1{font-size:25px;font-weight:750;letter-spacing:-.6px;margin:0 0 8px}.training-body h2{font-size:16px;font-weight:700;margin:0 0 14px}.training-subtitle{color:#657b6c;font-size:12px;margin-bottom:20px}.training-card{background:#fff;border:1px solid #dce6df;border-radius:14px;padding:18px;margin-bottom:14px}.training-label{display:block;font-size:11px;font-weight:600;color:#597260;margin-bottom:7px}.training-value{padding:10px 12px;border:1px solid #d4dfd8;border-radius:8px;font-size:12px;background:#fff}.training-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.training-row{display:flex;align-items:center;justify-content:space-between;gap:12px}.training-marker{display:inline-grid;place-items:center;background:#c3ef8a;color:#153d27;width:23px;height:23px;border-radius:50%;font-size:12px;font-weight:750;margin-right:7px}.training-muted{color:#6a7f70;font-size:11px;line-height:1.65}.training-footer{border-top:1px solid #dde6df;padding:12px 22px;font-size:10px;color:#607667;background:#f1f6f2}.training-tabs{display:flex;gap:8px;margin-bottom:16px}.training-pill{padding:8px 12px;border:1px solid #d7e2da;border-radius:9px;font-size:11px;background:#fff}.training-pill.active{background:#153e2d;color:#fff}.training-action{display:inline-block;padding:10px 14px;border-radius:9px;background:#174f37;color:#fff;font-weight:700;font-size:12px}.training-secondary{background:#edf5ec;color:#1c5236;border:1px solid #cddfcd}.training-table{width:100%;border-collapse:collapse;font-size:12px}.training-table th{font-size:10px;text-transform:uppercase;letter-spacing:.4px;color:#607565;background:#f0f6f1;padding:12px;text-align:left}.training-table td{padding:14px 12px;border-bottom:1px solid #e6ece8}.training-badge{font-size:10px;border-radius:16px;padding:4px 8px;background:#e3f3e9;color:#236343}.training-note{padding:12px 14px;background:#edf5e5;border-radius:10px;font-size:12px;line-height:1.65}.training-swatch{width:34px;height:30px;border-radius:6px;background:#174f37;border:1px solid #b7cdbf}.training-avatar{width:80px;height:80px;display:grid;place-items:center;border-radius:20px;background:linear-gradient(140deg,#235d41,#bce981);color:#fff;font-size:35px}.training-check{width:30px;height:17px;border-radius:12px;background:#2b7350;display:inline-block;vertical-align:middle;margin-right:8px}.training-check:before{content:'';display:block;width:13px;height:13px;border-radius:50%;background:#fff;margin:2px 0 0 15px}.training-callout{display:flex;gap:10px;align-items:start;border-top:1px solid #e0e9e2;padding:14px 0;font-size:12px;line-height:1.7}.training-callout:first-child{border-top:0}.training-callout .training-marker{flex:none}.training-link{color:#1b6845;font-weight:600}.training-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.training-kpis strong{display:block;font-size:23px;margin-top:6px}.training-bar{height:13px;border-radius:6px;background:#236a4c;margin:10px 0}.training-warning{padding:10px 14px;border:1px dashed #afc5b5;border-radius:9px;font-size:11px;color:#55705e;margin-top:12px}@media(max-width:600px){.training-grid{grid-template-columns:1fr}.training-body{padding:16px}.training-kpis{gap:5px}.training-table{font-size:10px}.training-table td,.training-table th{padding:10px 6px}}
</style></head><body><main class="training-frame" id="training-frame"><header class="training-top"><strong>Demo workspace / Product Guide</strong><small>READ-ONLY TRAINING · SAMPLE DATA</small></header><div class="training-body"><h1><%= screen.title %></h1><p class="training-subtitle">An annotated example of the product workflow. No live business records are used.</p>
<% if(screen.kind==='workspace'){%>
 <div class="training-card training-row"><span><span class="training-marker">1</span><strong>Demo workspace</strong> ▾</span><div class="training-value" style="width:36%"><span class="training-marker">2</span>Search your work…</div><span><span class="training-marker">3</span>Account ▾</span></div><div class="training-grid"><div class="training-card"><h2>Your workspace</h2><div class="training-tabs"><span class="training-pill active">Home</span><span class="training-pill">Your records</span></div><p class="training-muted">Navigation and actions depend on the access assigned to your account.</p><div class="training-note">Check the business before opening or changing a record.</div></div><div class="training-card"><h2>Account menu</h2><div class="training-callout">My Profile <span class="training-muted">Personal details & photo</span></div><div class="training-callout training-link">Product Guide <span class="training-badge">You are here</span></div><div class="training-callout">Settings <span class="training-muted">When permitted</span></div></div></div><div class="training-card"><h2>A reliable way to work</h2><div class="training-row"><span class="training-pill">Find</span>→<span class="training-pill">Review</span>→<span class="training-pill">Save once</span>→<span class="training-pill">Verify</span></div></div>
<% } else if(screen.kind==='profile'){%>
 <div class="training-card"><h2>Personal Information</h2><div class="training-row" style="justify-content:flex-start;padding:15px;background:#f4f8f3;border:1px dashed #d1dfd4;border-radius:12px;gap:20px"><div class="training-avatar">A</div><div><strong>Profile photo</strong><p class="training-muted">sample-photo.png · Ready to save</p><span class="training-marker">1</span><span class="training-action training-secondary">Choose image</span> <span class="training-marker">2</span><span class="training-action training-secondary">Undo selection</span><p class="training-muted" style="margin:10px 0 0">PNG, JPEG or WebP · maximum 2 MB</p></div></div><div class="training-grid mt-3"><div><label class="training-label">Full Name</label><div class="training-value">Alex Example</div></div><div><label class="training-label">Email Address</label><div class="training-value">alex@example.test</div></div></div><p class="training-muted mt-3">Role permissions are managed by the authorised workspace administrator.</p><div class="text-end"><span class="training-marker">3</span><span class="training-action">Save Profile Details</span></div></div><div class="training-note">Choosing a file changes the preview. Your profile changes only after a successful save.</div>
<% } else if(screen.kind==='documents'||screen.kind==='clients'){%>
 <div class="training-card"><div class="training-row mb-3"><strong><span class="training-marker">1</span><%= screen.kind==='clients'?'Customer filters':'FY 2026–27 · 1 Apr 2026 – 31 Mar 2027' %></strong><span class="training-pill">All statuses ▾</span></div><div class="training-value">Search a name or reference…</div></div><div class="training-card" style="padding:0;overflow:hidden"><table class="training-table"><thead><tr><th>Reference</th><th><%= screen.kind==='clients'?'Customer name':'Customer / document' %></th><th>Status</th><th>Action</th></tr></thead><tbody><tr><td><span class="training-marker">2</span><%= screen.kind==='clients'?'CUST/EXAMPLE/001':'INV/EXAMPLE/001' %></td><td>Example Customer<% if(screen.kind!=='clients'){%><div class="training-muted">Invoice · 12,000.00</div><% }%></td><td><span class="training-badge">Active</span></td><td class="training-link">View</td></tr><tr><td><%= screen.kind==='clients'?'CUST/EXAMPLE/002':'QUOT/EXAMPLE/002' %></td><td>Sample Customer<% if(screen.kind!=='clients'){%><div class="training-muted">Quotation · 8,000.00</div><% }%></td><td><span class="training-badge">Active</span></td><td class="training-link">View</td></tr></tbody></table></div><div class="training-note"><span class="training-marker">3</span><%= screen.kind==='clients'?'Master details support future documents. Historical document snapshots remain independent.':'An active invoice and a paid invoice are different questions. Check lifecycle and settlement separately.' %></div>
<% } else if(screen.kind==='editor'){%>
 <div class="training-card"><h2><span class="training-marker">1</span>Document & buyer</h2><div class="training-grid"><div><span class="training-label">Type / date</span><div class="training-value">Invoice · 20 Oct 2026</div></div><div><span class="training-label">Customer</span><div class="training-value">Example Customer</div></div></div></div><div class="training-card"><h2><span class="training-marker">2</span>Line items</h2><table class="training-table"><thead><tr><th>Description</th><th>Qty</th><th>Unit</th><th>Rate</th><th>Discount</th></tr></thead><tbody><tr><td>Example service</td><td>2</td><td>HRS</td><td>1,000.00</td><td>10%</td></tr></tbody></table></div><div class="training-grid"><div class="training-note">Sample chosen tax rate: 18%.<br>Tax classification must be checked for the actual transaction.<br>No record is created by this example.</div><div class="training-card"><h2><span class="training-marker">3</span>Review totals</h2><div class="training-row mb-2"><span>Base / discount</span><strong>2,000 − 200</strong></div><div class="training-row mb-2"><span>Taxable / tax</span><strong>1,800 + 324</strong></div><div class="training-row border-top pt-3"><span>Sample total</span><strong>2,124.00</strong></div></div></div>
<% } else if(screen.kind==='history'){%>
 <div class="training-card"><h2><span class="training-marker">1</span>Sample record: Example Customer</h2><div class="training-tabs"><span class="training-pill">Details</span><span class="training-pill active"><span class="training-marker">2</span>Edit history</span></div><div class="training-note">Demo teammate · Example edit · UPDATED</div><table class="training-table mt-3"><thead><tr><th>Field</th><th>Before</th><th>After</th></tr></thead><tbody><tr><td>Billing address</td><td>10 Example Road</td><td>20 Example Road</td></tr><tr><td>Phone</td><td>Not supplied</td><td>Example phone</td></tr></tbody></table></div><div class="training-warning"><span class="training-marker">3</span>Earlier activity may have no field snapshots. History reflects the evidence captured by that workflow.</div>
<% } else if(screen.kind==='reports'){%>
 <div class="training-card"><div class="training-grid"><div><span class="training-label"><span class="training-marker">1</span>Dataset / scope</span><div class="training-value">Sales documents · Demo workspace</div></div><div><span class="training-label"><span class="training-marker">2</span>Financial years</span><div class="training-value">From FY 2024–25 → Through FY 2026–27</div></div></div><div class="training-note mt-3">1 Apr 2024 – 31 Mar 2027 · Three financial years</div></div><div class="training-kpis"><div class="training-card"><small class="training-muted">EXAMPLE RECORDS</small><strong>24</strong></div><div class="training-card"><small class="training-muted">TAXABLE VALUE</small><strong>72,000</strong></div><div class="training-card"><small class="training-muted">EXAMPLE TOTAL</small><strong>84,960</strong></div></div><div class="training-card"><h2><span class="training-marker">3</span>Read the period before the total</h2><div class="training-row"><span>FY 2024–25</span><div class="training-bar" style="width:35%"></div></div><div class="training-row"><span>FY 2025–26</span><div class="training-bar" style="width:55%;background:#5d925b"></div></div><div class="training-row"><span>FY 2026–27</span><div class="training-bar" style="width:43%;background:#8dae52"></div></div></div>
<% } else if(screen.kind==='templates'){%>
 <div class="training-card"><h2><span class="training-marker">1</span>Create Custom Template</h2><div class="training-grid"><div><span class="training-label">Template name</span><div class="training-value">Example Studio</div></div><div><span class="training-label">Base layout</span><div class="training-value">Modern Minimalist ▾</div></div></div><div class="training-grid mt-3"><div><span class="training-label"><span class="training-marker">2</span>Primary accent / typography</span><div class="training-row"><span class="training-swatch"></span><span class="training-value" style="flex:1">#174f37 · Inter / System UI</span></div></div><div><span class="training-label">Visible document features</span><div class="training-value"><span class="training-check"></span>HSN / SAC & units</div></div></div><div class="training-note mt-3">Create a custom copy. A design change does not change authoritative document totals.</div></div><div class="training-card training-row"><span><span class="training-marker">3</span>Preview the new output before applying a default.</span><span class="training-action">Save Custom Template</span></div>
<% } %>
<div class="training-warning">This is a read-only training view. Controls shown here are examples; use the real app screen for permitted business actions.</div></div><footer class="training-footer">Product Guide · Illustrative training screenshot · Fictional sample values · Interface details may vary with access and updates.</footer></main></body></html>
