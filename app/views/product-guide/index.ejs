<%- include('../layouts/header',{extraCss:'<link rel="stylesheet" href="/css/product-guide.css">'}) %>
<% const categories=[...new Set(chapters.map(c=>c.category))]; %>
<main class="guide" id="product-guide" data-progress-key="spark-guide-v1:<%= guideUserId %>:<%= guideBusinessId %>">
<div class="docs-toolbar"><a href="/product-guide" class="docs-brand">Product docs <span>Reference & guides</span></a><div class="d-flex align-items-center gap-2"><span class="docs-role"><i class="bi bi-shield-check me-1"></i><%= guideRole %></span><button type="button" class="btn btn-sm btn-outline-secondary" id="guide-print" aria-label="Print current article"><i class="bi bi-printer"></i></button></div></div>
<div class="docs-layout">
<aside class="guide-sidebar" aria-label="Documentation navigation">
<form method="GET" action="/product-guide" id="guide-search-form"><label class="visually-hidden" for="guide-search">Search documentation</label><div class="docs-search"><i class="bi bi-search"></i><input class="form-control" type="search" name="q" id="guide-search" placeholder="Search docs…" value="<%= guideQuery %>" autocomplete="off" aria-keyshortcuts="/"><kbd>/</kbd></div><button class="visually-hidden" type="submit">Search documentation</button></form>
<div class="docs-nav-tools"><button class="btn btn-sm btn-outline-secondary" type="button" id="guide-home">All topics</button><button class="btn btn-sm btn-outline-secondary" type="button" id="guide-bookmarks" aria-pressed="false"><i class="bi bi-bookmark me-1"></i>Saved</button></div><p id="guide-results" class="docs-count" aria-live="polite"><%= chapters.length %> articles</p>
<nav id="guide-chapter-nav"><% for(const category of categories){ %><section class="docs-nav-group"><h2><%= category %></h2><% for(const chapter of chapters.filter(c=>c.category===category)){ %><a class="guide-nav-link" href="/product-guide?lesson=<%= chapter.id %>" data-guide-open="<%= chapter.id %>" data-chapter-result="<%= chapter.id %>" <%- selected===chapter.id?'aria-current="page"':'' %>><%= chapter.title %></a><% } %></section><% } %></nav><p class="docs-access"><i class="bi bi-lock me-1"></i>Articles follow your current permissions. Reload after access changes.</p>
</aside>
<div class="guide-main">
<section id="guide-overview" <%= selected?'hidden':'' %>><header class="docs-article-header"><span class="docs-eyebrow">DOCUMENTATION</span><h2 tabindex="-1">Explore the product</h2><p>Find a task, understand a feature, or read the documentation in order. Only features available to your account appear here.</p></header><div class="docs-topic-index"><% for(const category of categories){ %><section data-topic-group><h3><%= category %></h3><% for(const c of chapters.filter(c=>c.category===category)){%><a href="/product-guide?lesson=<%= c.id %>" data-guide-open="<%= c.id %>" data-chapter-result="<%= c.id %>"><strong><%= c.title %><i class="bi bi-arrow-up-right"></i></strong><span><%= c.summary %></span></a><% }%></section><% }%></div></section>
<section id="guide-search-results" hidden aria-labelledby="docs-search-title"><header class="docs-article-header"><span class="docs-eyebrow">SEARCH</span><h2 id="docs-search-title">Search documentation</h2><p id="docs-search-summary" aria-live="polite"></p></header><div id="docs-search-matches"></div></section>
<div id="guide-no-results" hidden role="status"><h2>No matching articles</h2><p>Try a shorter phrase or clear the search. Only permitted features are included.</p><button type="button" class="btn btn-outline-primary" id="guide-clear-search">Clear filters</button></div>
<% for(const chapter of chapters){ %><article class="guide-lesson" id="lesson-<%= chapter.id %>" data-guide-lesson="<%= chapter.id %>" <%= selected===chapter.id?'':'hidden' %> aria-labelledby="title-<%= chapter.id %>">
<header class="docs-article-header"><div class="docs-breadcrumb">Documentation <i class="bi bi-chevron-right"></i> <%= chapter.category %></div><h2 id="title-<%= chapter.id %>" tabindex="-1"><%= chapter.title %></h2><p><%= chapter.summary %></p><div class="docs-article-tools"><span><%= chapter.minutes %> min read</span><button class="btn btn-sm btn-outline-secondary" type="button" data-guide-save="<%= chapter.id %>" aria-pressed="false">Save page</button><button class="btn btn-sm btn-outline-secondary" type="button" data-guide-copy="<%= chapter.id %>">Copy link</button></div></header>
<p class="docs-intro"><%= chapter.simple %></p><% if(chapter.outcome){%><div class="docs-note"><strong>Overview</strong><p><%= chapter.outcome %></p></div><% }%>
<% chapter.steps.forEach((step,index)=>{const anchor=step.anchor; %><section class="docs-section"><h3 id="<%= anchor %>" tabindex="-1"><%= step.title %><a class="docs-anchor" href="/product-guide?lesson=<%= chapter.id %>#<%= anchor %>" aria-label="Link to section: <%= step.title %>">#</a></h3><p><%= step.body %></p><div class="docs-behaviour"><strong>Expected result</strong><p><%= step.check %></p></div></section><% });%>
<% if(chapter.screen){const screen=chapter.screen;%><section class="docs-section"><h3 id="<%= chapter.id %>-example" tabindex="-1">Visual example</h3><p class="docs-muted">Annotated training example with fictional values. Click the image to zoom.</p><figure class="guide-figure"><% if(screen.available){%><button type="button" class="guide-image-button" data-guide-zoom="/product-guide/screens/<%= screen.id %>" data-caption="<%= screen.caption %>" aria-label="Zoom training screenshot: <%= screen.title %>"><img src="/product-guide/screens/<%= screen.id %>" alt="<%= screen.title %>. <%= screen.callouts.join(' ') %>" loading="lazy"><span><i class="bi bi-arrows-fullscreen me-2"></i>Expand image</span></button><% }else{%><a href="/product-guide/demo/<%= screen.id %>" target="_blank" rel="noopener">Open training example</a><% }%><figcaption><%= screen.caption %></figcaption><ol><% for(const text of screen.callouts){%><li><%= text %></li><% }%></ol></figure></section><% }%>
<% if(chapter.pitfalls?.length){%><section class="docs-section"><h3 id="<%= chapter.id %>-considerations" tabindex="-1">Important considerations</h3><ul><% for(const text of chapter.pitfalls){%><li><%= text %></li><% }%></ul></section><% }%>
<% if(chapter.glossary?.length){%><section class="docs-section"><h3 id="<%= chapter.id %>-terms" tabindex="-1">Terminology</h3><dl class="docs-glossary"><% for(const [term,meaning] of chapter.glossary){%><dt><%= term %></dt><dd><%= meaning %></dd><% }%></dl></section><% }%>
<% if(chapter.notes?.length){%><section class="docs-section"><h3 id="<%= chapter.id %>-reference" tabindex="-1">Additional reference</h3><% chapter.notes.forEach(([title,body],index)=>{%><h4 id="<%= chapter.id %>-reference-<%= index+1 %>" tabindex="-1"><%= title %></h4><p><%= body %></p><% });%></section><% }%>
<% if(chapter.links.length){%><section class="docs-section"><h3 id="<%= chapter.id %>-app-links" tabindex="-1">Related app pages</h3><p class="docs-muted">These links open real business screens. Changes there follow normal permissions and save rules.</p><div class="d-flex flex-wrap gap-2"><% for(const link of chapter.links){%><a class="btn btn-sm btn-outline-primary" href="<%= link.href %>"><%= link.label %><i class="bi bi-arrow-up-right ms-2"></i></a><% }%></div></section><% }%>
<nav class="docs-pagination" aria-label="Article navigation"><button type="button" data-guide-prev><small>Previous</small><span></span></button><button type="button" data-guide-next><small>Next</small><span></span></button></nav>
</article><% }%><p id="guide-status" role="status" aria-live="polite" class="docs-muted"></p></div>
<aside class="docs-toc" id="guide-toc" aria-label="On this page"><strong>On this page</strong><nav id="guide-toc-links"><% const current=chapters.find(c=>c.id===selected);if(current){current.steps.forEach((step,index)=>{%><a href="/product-guide?lesson=<%= current.id %>#<%= step.anchor %>"><%= step.title %></a><% });}%></nav><p>Browse topics to explore features, or press <kbd>/</kbd> to search.</p></aside>
</div>
<dialog id="guide-image-dialog" aria-labelledby="guide-image-title"><header><h2 id="guide-image-title">Training screenshot</h2><div class="d-flex gap-2"><button class="btn btn-sm btn-outline-secondary" type="button" id="guide-zoom-out" aria-label="Zoom out">−</button><output id="guide-zoom-level" aria-live="polite">100%</output><button class="btn btn-sm btn-outline-secondary" type="button" id="guide-zoom-in" aria-label="Zoom in">+</button><button class="btn btn-sm btn-danger" type="button" id="guide-zoom-close" aria-label="Close screenshot">Close</button></div></header><div class="guide-image-viewport"><img alt="Enlarged training screenshot" id="guide-zoom-image"></div><p id="guide-zoom-caption"></p><small>Use + / − to zoom. Scroll to inspect. Escape closes the image.</small></dialog>
</main>
<script type="application/json" id="guide-data"><%- JSON.stringify({chapters:chapters.map(c=>({id:c.id,title:c.title,category:c.category,search:c.search,sections:[...c.steps.map(s=>({title:s.title,body:s.body,anchor:s.anchor})),...(c.notes||[]).map(([title,body],i)=>({title,body,anchor:c.id+'-reference-'+(i+1)})),...(c.glossary?.length?[{title:'Terminology',body:c.glossary.flat().join(' '),anchor:c.id+'-terms'}]:[]),...(c.pitfalls?.length?[{title:'Important considerations',body:c.pitfalls.join(' '),anchor:c.id+'-considerations'}]:[])]})),selected,query:guideQuery}).replace(/</g,'\\u003c') %></script>
<noscript><p>All permitted articles and section links work without JavaScript. Enable JavaScript for live section search, bookmarks and screenshot zoom.</p></noscript>
<%- include('../layouts/footer',{extraJs:'<script src="/js/product-guide.js"></script>'}) %>
