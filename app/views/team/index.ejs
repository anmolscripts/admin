<%
  const canManage = typeof locals.hasPermission === 'function'
    ? (locals.hasPermission('TEAM', 'MANAGE') || locals.hasPermission('TEAM', 'CREATE'))
    : (locals.user && (locals.user.role === 'ADMIN' || locals.user.role === 'OWNER'));

  const canViewActivity = typeof locals.hasPermission === 'function'
    ? (locals.hasPermission('TEAM', 'ACTIVITY_VIEW') || locals.hasPermission('AUDIT_LOGS', 'VIEW'))
    : (locals.user && (locals.user.role === 'ADMIN' || locals.user.role === 'OWNER'));

  const headerActionHtml = canManage ? `
    <button type="button" class="btn btn-primary" id="btn-add-member" data-bs-toggle="modal" data-bs-target="#modal-add-member">
      <i class="bi bi-person-plus me-1"></i>
      <span>Add Team Member</span>
    </button>
  ` : '';
%>

<%- include('../layouts/header', {
    pageTitle: 'Team Management',
    pageSubtitle: 'Manage team members, roles and access permissions.',
    headerAction: headerActionHtml
}) %>

<!-- Sub-Navigation Tabs (Native Spark Admin Buttons) -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div class="d-flex gap-2">
    <a class="btn btn-sm btn-primary" href="/team">
      <i class="bi bi-people me-1"></i> Team Members
    </a>
    <% if (canViewActivity) { %>
    <a class="btn btn-sm btn-secondary" href="/team/activity">
      <i class="bi bi-clock-history me-1"></i> Activity Log
    </a>
    <a class="btn btn-sm btn-secondary" href="/team/analytics">
      <i class="bi bi-graph-up me-1"></i> Team Analytics
    </a>
    <% } %>
  </div>
</div>

<!-- KPI Strip (Spark Admin Card Language) -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <span class="small text-muted text-uppercase fw-bold">Total Members</span>
        <span class="badge bg-light text-dark border"><i class="bi bi-people fs-6"></i></span>
      </div>
      <div class="fs-4 fw-bold text-dark mt-1"><%= (analytics && analytics.team.totalUsers) || (users && users.length) || 0 %></div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <span class="small text-muted text-uppercase fw-bold">Active Accounts</span>
        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle fs-6"></i></span>
      </div>
      <div class="fs-4 fw-bold text-success mt-1"><%= (analytics && analytics.team.activeUsers) || 0 %></div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <span class="small text-muted text-uppercase fw-bold">Pending Invites</span>
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle"><i class="bi bi-envelope-open fs-6"></i></span>
      </div>
      <div class="fs-4 fw-bold text-warning mt-1"><%= (analytics && analytics.team.pendingInvitations) || 0 %></div>
    </div>
  </div>

  <div class="col-6 col-md-3">
    <div class="card border-0 shadow-sm rounded-3 p-3 bg-white h-100">
      <div class="d-flex align-items-center justify-content-between mb-1">
        <span class="small text-muted text-uppercase fw-bold">Never Logged In</span>
        <span class="badge bg-light text-secondary border"><i class="bi bi-person-x fs-6"></i></span>
      </div>
      <div class="fs-4 fw-bold text-secondary mt-1"><%= (analytics && analytics.team.neverLoggedIn) || 0 %></div>
    </div>
  </div>
</div>

<!-- Search and Filter Bar -->
<section class="card border-0 shadow-sm rounded-3 p-3 mb-4 bg-white" aria-label="Team Filters">
  <form method="GET" action="/team" class="row g-2 align-items-center">
    <div class="col-12 col-md-5">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input
          type="search"
          name="search"
          class="form-control bg-light border-start-0"
          placeholder="Search by member name or email..."
          value="<%= filters.search %>"
          aria-label="Search team"
        />
      </div>
    </div>

    <div class="col-6 col-md-3">
      <select name="status" class="form-select bg-light" aria-label="Filter by status">
        <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All Statuses</option>
        <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
        <option value="INVITED" <%= filters.status === 'INVITED' ? 'selected' : '' %>>Invited / Pending</option>
        <option value="INACTIVE" <%= filters.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <select name="roleId" class="form-select bg-light" aria-label="Filter by role">
        <option value="ALL" <%= filters.roleId === 'ALL' ? 'selected' : '' %>>All Roles</option>
        <% (roles || []).forEach(r => { %>
          <option value="<%= r.id %>" <%= filters.roleId == r.id ? 'selected' : '' %>><%= r.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="col-12 col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-secondary w-100">
        <i class="bi bi-funnel me-1"></i> Filter
      </button>
      <% if (filters.search || filters.status !== 'ALL' || filters.roleId !== 'ALL') { %>
        <a href="/team" class="btn btn-secondary" title="Clear Filters">
          <i class="bi bi-x-lg"></i>
        </a>
      <% } %>
    </div>
  </form>
</section>

<!-- Members Table Card -->
<section class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4" aria-label="Team Members Table">
  <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-person-badge text-dark fs-5"></i>
      <h5 class="card-title fw-bold mb-0 text-dark">Team Members</h5>
      <span class="badge bg-light text-muted border ms-2"><%= (users && users.length) || 0 %> Members</span>
    </div>
    <% if (canManage) { %>
    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modal-add-member">
      <i class="bi bi-plus-lg me-1"></i> Add Member
    </button>
    <% } %>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="team-table" data-spark-datatable="true" data-title="Team Members">
      <thead class="table-light">
        <tr>
          <th scope="col" style="width: 50px;" class="ps-4 text-center" data-sortable="false">#</th>
          <th scope="col">Member</th>
          <th scope="col">Role</th>
          <th scope="col">Status</th>
          <th scope="col">Last Login</th>
          <th scope="col">Last Activity</th>
          <th scope="col">Access Summary</th>
          <th scope="col" class="text-end pe-4" style="width: 200px;" data-sortable="false">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!users || users.length === 0) { %>
          <tr>
            <td colspan="8" class="text-center py-5">
              <div class="text-muted">
                <i class="bi bi-person-x display-6 mb-2 d-block text-secondary"></i>
                <h6 class="fw-semibold">No team members found</h6>
                <p class="small mb-3">Adjust your search or add a new team member to get started.</p>
                <% if (canManage) { %>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modal-add-member">
                  <i class="bi bi-plus-lg me-1"></i> Add Team Member
                </button>
                <% } %>
              </div>
            </td>
          </tr>
        <% } else { %>
          <% users.forEach((m, idx) => {
               const roleName = m.assignedRole ? m.assignedRole.name : (m.role || 'STAFF');
               const isOwner = roleName === 'OWNER';
               const isAdmin = roleName === 'ADMIN';
               let roleBadgeClass = 'bg-light text-dark border';
               if (isOwner) roleBadgeClass = 'bg-dark text-white';
               else if (isAdmin) roleBadgeClass = 'bg-secondary text-white';
               else if (roleName === 'STAFF') roleBadgeClass = 'bg-light text-dark border';
               else if (roleName === 'VIEWER') roleBadgeClass = 'bg-light text-muted border';

               let statusBadge = '<span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>';
               if (m.status === 'INVITED') {
                   statusBadge = '<span class="badge bg-warning-subtle text-warning border border-warning-subtle">Invited</span>';
               } else if (m.status === 'INACTIVE' || !m.active) {
                   statusBadge = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactive</span>';
               }
          %>
            <tr id="user-row-<%= m.id %>">
              <td class="ps-4 text-center text-muted small"><%= (pagination.page - 1) * pagination.limit + idx + 1 %></td>
              <td data-sort="<%= m.name %>">
                <div class="d-flex align-items-center">
                  <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center text-dark fw-bold me-2" style="width: 36px; height: 36px;">
                    <%= m.name ? m.name.charAt(0).toUpperCase() : 'U' %>
                  </div>
                  <div>
                    <a href="/team/<%= m.id %>" class="fw-semibold text-dark text-decoration-none member-name">
                      <%= m.name %>
                    </a>
                    <div class="text-muted small"><%= m.email %></div>
                  </div>
                </div>
              </td>
              <td data-sort="<%= roleName %>">
                <span class="badge <%= roleBadgeClass %> px-2 py-1"><%= roleName %></span>
              </td>
              <td data-sort="<%= m.status %>">
                <%- statusBadge %>
              </td>
              <td class="small text-muted" data-sort="<%= m.lastLoginAt ? new Date(m.lastLoginAt).toISOString() : '' %>">
                <%= m.lastLoginAt ? new Date(m.lastLoginAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Never' %>
              </td>
              <td class="small text-muted" data-sort="<%= m.lastActivityAt ? new Date(m.lastActivityAt).toISOString() : '' %>">
                <%= m.lastActivityAt ? new Date(m.lastActivityAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'None' %>
              </td>
              <td class="small" data-sort="<%= isOwner ? 'Full Access' : roleName %>">
                <% if (isOwner) { %>
                  <span class="text-dark fw-semibold"><i class="bi bi-shield-lock-fill me-1"></i> Full Access</span>
                <% } else if (m._count && m._count.userPermissions > 0) { %>
                  <span class="text-muted"><%= roleName %> + <%= m._count.userPermissions %> Custom</span>
                <% } else { %>
                  <span class="text-muted"><%= roleName %> Defaults</span>
                <% } %>
              </td>
              <td class="text-end pe-4">
                <div class="d-inline-flex gap-1">
                  <!-- View details button -->
                  <a href="/team/<%= m.id %>" class="btn btn-sm btn-outline-primary" title="View Member Profile">
                    <i class="bi bi-eye"></i> View
                  </a>

                  <% if (canManage) { %>
                    <!-- Edit Button -->
                    <button
                      type="button"
                      class="btn btn-sm btn-light border"
                      title="Edit Member"
                      onclick="openEditMemberModal(<%= m.id %>, '<%= m.name.replace(/'/g, "\\'") %>', '<%= m.roleId || '' %>', '<%= m.status %>')"
                    >
                      <i class="bi bi-pencil"></i>
                    </button>

                    <!-- Manage Access Button -->
                    <a href="/team/<%= m.id %>#access" class="btn btn-sm btn-light border" title="Manage Permissions">
                      <i class="bi bi-shield-check"></i>
                    </a>

                    <!-- More Actions Dropdown -->
                    <div class="dropdown">
                      <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-three-dots-vertical"></i>
                      </button>
                      <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <% if (m.status === 'INVITED') { %>
                          <li>
                            <button class="dropdown-item" onclick="resendInvitation(<%= m.id %>)">
                              <i class="bi bi-send text-primary me-2"></i> Resend Invitation
                            </button>
                          </li>
                          <li>
                            <button class="dropdown-item text-danger" onclick="revokeInvitation(<%= m.id %>)">
                              <i class="bi bi-x-circle text-danger me-2"></i> Revoke Invitation
                            </button>
                          </li>
                          <li><hr class="dropdown-divider"></li>
                        <% } %>

                        <% if (m.status === 'ACTIVE') { %>
                          <li>
                            <button class="dropdown-item text-warning" onclick="toggleStatus(<%= m.id %>, 'INACTIVE')">
                              <i class="bi bi-pause-circle text-warning me-2"></i> Deactivate User
                            </button>
                          </li>
                        <% } else if (m.status === 'INACTIVE') { %>
                          <li>
                            <button class="dropdown-item text-success" onclick="toggleStatus(<%= m.id %>, 'ACTIVE')">
                              <i class="bi bi-play-circle text-success me-2"></i> Activate User
                            </button>
                          </li>
                        <% } %>

                        <% if (!isOwner) { %>
                          <li>
                            <button class="dropdown-item text-danger" onclick="deleteUser(<%= m.id %>, '<%= m.name.replace(/'/g, "\\'") %>')">
                              <i class="bi bi-trash text-danger me-2"></i> Delete User
                            </button>
                          </li>
                        <% } %>
                      </ul>
                    </div>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination && pagination.pages > 1) { %>
    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
      <span class="small text-muted">
        Showing <%= (pagination.page - 1) * pagination.limit + 1 %> to <%= Math.min(pagination.total, pagination.page * pagination.limit) %> of <%= pagination.total %> members
      </span>
      <nav aria-label="Team page navigation">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/team?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&status=<%= filters.status %>&roleId=<%= filters.roleId %>">Previous</a>
          </li>
          <% for (let p = 1; p <= pagination.pages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/team?page=<%= p %>&search=<%= filters.search %>&status=<%= filters.status %>&roleId=<%= filters.roleId %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
            <a class="page-link" href="/team?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&status=<%= filters.status %>&roleId=<%= filters.roleId %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</section>

<!-- ========================================================================= -->
<!-- MODAL: ADD TEAM MEMBER -->
<!-- ========================================================================= -->
<% if (canManage) { %>
<div class="modal fade" id="modal-add-member" tabindex="-1" aria-labelledby="modalAddMemberTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom py-3 px-4">
        <h5 class="modal-title fw-bold text-dark" id="modalAddMemberTitle">
          <i class="bi bi-person-plus text-dark me-2"></i>Add Team Member
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <!-- Error Alert -->
        <div class="alert alert-danger d-none" id="add-member-error" role="alert"></div>

        <!-- Form: Member Details & Role / Permission Configuration -->
        <form id="form-add-member" onsubmit="submitAddMember(event)">
          <input type="hidden" name="_csrf" id="add-csrf" value="<%= locals.csrfToken || '' %>">

          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <label for="member-name" class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="member-name" name="name" placeholder="e.g. Rahul Sharma" required>
            </div>
            <div class="col-12 col-md-6">
              <label for="member-email" class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
              <input type="email" class="form-control" id="member-email" name="email" placeholder="e.g. rahul@example.com" required>
            </div>
          </div>

          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <label for="member-role" class="form-label fw-semibold small">Role <span class="text-danger">*</span></label>
              <select class="form-select" id="member-role" name="roleId" required onchange="onRoleChange()">
                <% (roles || []).forEach(r => { %>
                  <option value="<%= r.id %>" <%= r.name === 'STAFF' ? 'selected' : '' %> data-name="<%= r.name %>"><%= r.name %> - <%= r.description %></option>
                <% }); %>
              </select>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label fw-semibold small">Invitation Mode</label>
              <div class="form-control bg-light border text-muted small py-2">
                <i class="bi bi-shield-check text-success me-1"></i> Secure One-Time Setup Link (No plain passwords)
              </div>
            </div>
          </div>

          <!-- PERMISSION CONFIGURATION ACCORDION -->
          <div class="card border rounded-3 p-3 bg-light mb-4">
            <div class="d-flex align-items-center justify-content-between" role="button" data-bs-toggle="collapse" data-bs-target="#collapse-permissions" aria-expanded="false" aria-controls="collapse-permissions">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock text-dark"></i>
                <span class="fw-bold small text-dark">Configure Permissions</span>
                <span class="badge bg-light text-dark border small" id="preview-role-badge">STAFF</span>
              </div>
              <span class="small text-muted"><span id="toggle-perm-label">Customize</span> <i class="bi bi-chevron-down ms-1"></i></span>
            </div>

            <div class="collapse mt-3" id="collapse-permissions">
              <p class="small text-muted mb-2">Review or customize the specific permissions this member will inherit. Base role defaults are pre-selected.</p>
              <div class="row g-2 small" id="preview-matrix-container" style="max-height: 280px; overflow-y: auto;">
                <% if (locals.modules && locals.moduleActionMatrix && locals.allPermissions) { %>
                  <% modules.forEach(mod => {
                       const allowedActs = moduleActionMatrix[mod] || [];
                  %>
                    <div class="col-12 col-md-6">
                      <div class="p-2 border rounded bg-white h-100">
                        <strong class="d-block text-dark small mb-1"><%= mod %></strong>
                        <div class="d-flex flex-wrap gap-2">
                          <% allowedActs.forEach(act => {
                               const permObj = allPermissions.find(p => p.module === mod && p.action === act);
                               if (permObj) {
                          %>
                            <label class="form-check-label d-inline-flex align-items-center gap-1 small me-2 mb-1">
                              <input
                                type="checkbox"
                                class="form-check-input perm-checkbox"
                                name="permissionIds[]"
                                value="<%= permObj.id %>"
                                data-module="<%= mod %>"
                                data-action="<%= act %>"
                              >
                              <span><%= act %></span>
                            </label>
                          <% } }); %>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="text-center py-2 text-muted">Permissions loaded dynamically with role.</div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 pt-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary" id="btn-submit-add">
              <i class="bi bi-send me-1"></i> Create Member & Invite
            </button>
          </div>
        </form>

        <!-- Step 2: Invitation Created Success Box (Initially Hidden) -->
        <div id="add-member-success" class="d-none text-center py-3">
          <div class="rounded-circle bg-success-subtle text-success p-3 d-inline-flex mb-3">
            <i class="bi bi-check-lg display-6"></i>
          </div>
          <h5 class="fw-bold text-dark mb-1">Invitation Link Ready!</h5>
          <p class="text-muted small mb-3">The team member has been created in <strong>Invited</strong> status. Share this secure setup link with them to activate their account and set their password.</p>

          <div class="input-group mb-3">
            <input type="text" class="form-control bg-light font-monospace small" id="success-invite-url" readonly>
            <button class="btn btn-primary" type="button" id="btn-copy-invite" onclick="copyInviteUrl()">
              <i class="bi bi-clipboard me-1"></i> Copy Link
            </button>
          </div>

          <div class="alert alert-light border small text-muted text-start mb-4">
            <i class="bi bi-info-circle me-1 text-dark"></i>
            <strong>Note:</strong> Email delivery is not configured. Please copy the link above and provide it directly to the team member. The invitation expires in 7 days.
          </div>

          <div class="d-flex justify-content-center">
            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" onclick="location.reload()">
              Done
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: EDIT TEAM MEMBER -->
<!-- ========================================================================= -->
<div class="modal fade" id="modal-edit-member" tabindex="-1" aria-labelledby="modalEditMemberTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom py-3 px-4">
        <h5 class="modal-title fw-bold text-dark" id="modalEditMemberTitle">
          <i class="bi bi-pencil text-dark me-2"></i>Edit Team Member
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="form-edit-member" onsubmit="submitEditMember(event)">
        <div class="modal-body p-4">
          <div class="alert alert-danger d-none" id="edit-member-error" role="alert"></div>

          <input type="hidden" id="edit-user-id" name="id">

          <div class="mb-3">
            <label for="edit-member-name" class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="edit-member-name" name="name" required>
          </div>

          <div class="mb-3">
            <label for="edit-member-role" class="form-label fw-semibold small">Role <span class="text-danger">*</span></label>
            <select class="form-select" id="edit-member-role" name="roleId" required>
              <% (roles || []).forEach(r => { %>
                <option value="<%= r.id %>"><%= r.name %> - <%= r.description %></option>
              <% }); %>
            </select>
          </div>

          <div class="mb-3">
            <label for="edit-member-status" class="form-label fw-semibold small">Account Status</label>
            <select class="form-select" id="edit-member-status" name="status">
              <option value="ACTIVE">ACTIVE</option>
              <option value="INACTIVE">INACTIVE</option>
              <option value="INVITED">INVITED</option>
            </select>
          </div>
        </div>

        <div class="modal-footer border-top py-2 px-4">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<!-- Embedded Role & Permissions Metadata for Fast Client Sync -->
<script id="roles-data-json" type="application/json"><%- JSON.stringify(roles || []) %></script>

<!-- Frontend Interactions Script -->
<script>
  function getCsrfToken() {
    return (document.getElementById('add-csrf') && document.getElementById('add-csrf').value) ||
           (document.querySelector('input[name="_csrf"]') && document.querySelector('input[name="_csrf"]').value) || '';
  }

  const ROLES_METADATA = (() => {
    try {
      const el = document.getElementById('roles-data-json');
      return el ? JSON.parse(el.textContent) : [];
    } catch (_) {
      return [];
    }
  })();

  // Auto-open invite modal if query param is set
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('action') === 'invite') {
      const modalEl = document.getElementById('modal-add-member');
      if (modalEl && typeof bootstrap !== 'undefined') {
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
      }
    }
    const modalAddMember = document.getElementById('modal-add-member');
    if (modalAddMember) {
      modalAddMember.addEventListener('hidden.bs.modal', () => {
        const successBox = document.getElementById('add-member-success');
        if (successBox && !successBox.classList.contains('d-none')) {
          location.reload();
        }
      });
    }
    // Sync checkboxes for initial role
    onRoleChange();
  });

  function onRoleChange() {
    const roleSelect = document.getElementById('member-role');
    if (!roleSelect) return;
    const roleId = parseInt(roleSelect.value, 10);
    const selectedRole = ROLES_METADATA.find(r => r.id === roleId);

    const badge = document.getElementById('preview-role-badge');
    if (badge) badge.textContent = selectedRole ? selectedRole.name : 'STAFF';

    // If rolePermissions are available in role metadata, sync checkboxes
    if (selectedRole && selectedRole.rolePermissions) {
      const permIdSet = new Set(selectedRole.rolePermissions.map(rp => rp.permissionId));
      document.querySelectorAll('#preview-matrix-container .perm-checkbox').forEach(cb => {
        cb.checked = permIdSet.has(parseInt(cb.value, 10));
      });
    }
  }

  async function submitAddMember(e) {
    e.preventDefault();
    const btn = document.getElementById('btn-submit-add');
    const errBox = document.getElementById('add-member-error');
    errBox.classList.add('d-none');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Creating...';

    const name = document.getElementById('member-name').value.trim();
    const email = document.getElementById('member-email').value.trim();
    const roleId = document.getElementById('member-role').value;
    const csrfToken = getCsrfToken();

    // Collect custom checked permissions
    const permissionIds = [];
    document.querySelectorAll('#preview-matrix-container .perm-checkbox:checked').forEach(cb => {
      const val = parseInt(cb.value, 10);
      if (!isNaN(val)) permissionIds.push(val);
    });

    try {
      const res = await fetch('/api/team', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ name, email, roleId, permissionIds, _csrf: csrfToken })
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to create team member.');
      }

      // Show success screen with invitation URL
      document.getElementById('form-add-member').classList.add('d-none');
      document.getElementById('add-member-success').classList.remove('d-none');
      const url = data.inviteUrl || (data.data && data.data.inviteUrl) || '';
      document.getElementById('success-invite-url').value = url;
    } catch (err) {
      errBox.textContent = err.message;
      errBox.classList.remove('d-none');
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-send me-1"></i> Create Member & Invite';
    }
  }

  function copyInviteUrl() {
    const input = document.getElementById('success-invite-url');
    if (!input) return;
    input.select();
    input.setSelectionRange(0, 99999);

    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(input.value);
    } else {
      document.execCommand('copy');
    }

    const btn = document.getElementById('btn-copy-invite');
    if (btn) {
      const originalText = btn.innerHTML;
      btn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Copied!';
      btn.classList.remove('btn-primary');
      btn.classList.add('btn-success');
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.classList.remove('btn-success');
        btn.classList.add('btn-primary');
      }, 2500);
    }
  }

  function openEditMemberModal(id, name, roleId, status) {
    document.getElementById('edit-user-id').value = id;
    document.getElementById('edit-member-name').value = name;
    document.getElementById('edit-member-role').value = roleId;
    document.getElementById('edit-member-status').value = status;
    const modalEl = document.getElementById('modal-edit-member');
    if (modalEl && typeof bootstrap !== 'undefined') {
      const modal = new bootstrap.Modal(modalEl);
      modal.show();
    }
  }

  async function submitEditMember(e) {
    e.preventDefault();
    const id = document.getElementById('edit-user-id').value;
    const name = document.getElementById('edit-member-name').value;
    const roleId = document.getElementById('edit-member-role').value;
    const status = document.getElementById('edit-member-status').value;
    const errBox = document.getElementById('edit-member-error');
    errBox.classList.add('d-none');
    const csrfToken = getCsrfToken();

    try {
      const res = await fetch(`/api/team/${id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ name, roleId, status, _csrf: csrfToken })
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to update member.');

      location.reload();
    } catch (err) {
      errBox.textContent = err.message;
      errBox.classList.remove('d-none');
    }
  }

  async function toggleStatus(id, newStatus) {
    if (!confirm(`Are you sure you want to change this account status to ${newStatus}?`)) return;
    const csrfToken = getCsrfToken();

    try {
      const res = await fetch(`/api/team/${id}/status`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ status: newStatus, _csrf: csrfToken })
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to update status.');

      location.reload();
    } catch (err) {
      alert(err.message);
    }
  }

  async function resendInvitation(id) {
    const csrfToken = getCsrfToken();
    try {
      const res = await fetch(`/api/team/${id}/invite/resend`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ _csrf: csrfToken })
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to resend invitation.');

      const url = data.inviteUrl || (data.data && data.data.inviteUrl) || '';
      prompt('New invitation link generated! Copy and share it with the user:', url);
    } catch (err) {
      alert(err.message);
    }
  }

  async function revokeInvitation(id) {
    if (!confirm('Are you sure you want to revoke this invitation? The existing link will immediately become invalid.')) return;
    const csrfToken = getCsrfToken();

    try {
      const res = await fetch(`/api/team/${id}/invite/revoke`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ _csrf: csrfToken })
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to revoke invitation.');

      location.reload();
    } catch (err) {
      alert(err.message);
    }
  }

  async function deleteUser(id, name) {
    if (!confirm(`Are you sure you want to delete ${name}? This action cannot be undone.`)) return;
    const csrfToken = getCsrfToken();

    try {
      const res = await fetch(`/api/team/${id}`, {
        method: 'DELETE',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ _csrf: csrfToken })
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Failed to delete user.');

      alert(data.message);
      location.reload();
    } catch (err) {
      alert(err.message);
    }
  }
</script>

<%- include('../layouts/footer') %>
