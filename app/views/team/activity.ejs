<%- include('../layouts/header', {
    pageTitle: 'User Activity Log',
    pageSubtitle: 'Operational audit trail of user access, document lifecycle, prints, and exports.'
}) %>

<!-- Sub-Navigation Tabs -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <div class="btn-group" role="group" aria-label="Team Navigation">
    <a href="/team" class="btn btn-sm btn-secondary">
      <i class="bi bi-people me-1"></i> Team Members
    </a>
    <a href="/team/activity" class="btn btn-sm btn-primary">
      <i class="bi bi-clock-history me-1"></i> Activity Log
    </a>
    <a href="/team/analytics" class="btn btn-sm btn-secondary">
      <i class="bi bi-graph-up me-1"></i> Team Analytics
    </a>
  </div>
</div>

<%
  function getQueryUrl(paramsToMerge) {
    const q = {
      page: filters.page || 1,
      limit: filters.limit || 25,
      search: filters.search || '',
      actorUserId: filters.actorUserId || '',
      module: filters.module || '',
      action: filters.action || '',
      fromDate: filters.fromDate || '',
      toDate: filters.toDate || '',
      sortBy: filters.sortBy || 'createdAt',
      sortDirection: filters.sortDirection || 'desc',
      ...paramsToMerge
    };
    const sp = new URLSearchParams();
    for (const [k, v] of Object.entries(q)) {
      if (v !== '' && v !== null && v !== undefined) sp.set(k, String(v));
    }
    return '/team/activity?' + sp.toString();
  }

  function getSortUrl(colKey) {
    const isCurrent = filters.sortBy === colKey;
    const nextDir = (isCurrent && filters.sortDirection === 'asc') ? 'desc' : 'asc';
    return getQueryUrl({ sortBy: colKey, sortDirection: nextDir, page: 1 });
  }
%>

<!-- Filters Card -->
<section class="card border-0 shadow-sm rounded-3 p-3 mb-4 bg-white" aria-label="Activity Filters">
  <form method="GET" action="/team/activity" class="row g-2 align-items-center">
    <input type="hidden" name="sortBy" value="<%= filters.sortBy %>">
    <input type="hidden" name="sortDirection" value="<%= filters.sortDirection %>">
    <input type="hidden" name="limit" value="<%= filters.limit %>">

    <div class="col-12 col-md-3">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input
          type="search"
          name="search"
          class="form-control bg-light border-start-0"
          placeholder="Search by keyword, doc #, or user..."
          value="<%= filters.search %>"
        />
      </div>
    </div>

    <div class="col-6 col-md-2">
      <select name="actorUserId" class="form-select bg-light">
        <option value="">All Users</option>
        <% (teamMembers || []).forEach(m => { %>
          <option value="<%= m.id %>" <%= filters.actorUserId == m.id ? 'selected' : '' %>><%= m.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <select name="module" class="form-select bg-light">
        <option value="">All Modules</option>
        <% (modules || []).forEach(mod => { %>
          <option value="<%= mod %>" <%= filters.module === mod ? 'selected' : '' %>><%= mod %></option>
        <% }); %>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <input type="date" name="fromDate" class="form-control bg-light" value="<%= filters.fromDate %>" title="From Date">
    </div>

    <div class="col-6 col-md-2">
      <input type="date" name="toDate" class="form-control bg-light" value="<%= filters.toDate %>" title="To Date">
    </div>

    <div class="col-12 col-md-1 d-flex gap-1">
      <button type="submit" class="btn btn-primary w-100" title="Filter">
        <i class="bi bi-funnel"></i>
      </button>
      <% if (filters.search || filters.actorUserId || filters.module || filters.fromDate || filters.toDate) { %>
        <a href="/team/activity" class="btn btn-outline-secondary" title="Clear Filters">
          <i class="bi bi-x-lg"></i>
        </a>
      <% } %>
    </div>
  </form>
</section>

<!-- Activity Table Card -->
<section class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4" aria-label="Activity Table">
  <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-clock-history text-primary fs-5"></i>
      <h5 class="card-title fw-bold mb-0 text-dark">Audit Events</h5>
      <span class="badge bg-light text-muted border ms-2"><%= pagination.total %> Total Events</span>
    </div>

    <!-- Page Size Selector -->
    <div class="d-flex align-items-center gap-2">
      <span class="small text-muted">Show:</span>
      <select class="form-select form-select-sm" style="width: auto;" onchange="window.location.href=this.value" aria-label="Events per page">
        <% [10, 25, 50, 100].forEach(sz => { %>
          <option value="<%= getQueryUrl({ limit: sz, page: 1 }) %>" <%= pagination.limit === sz ? 'selected' : '' %>><%= sz %></option>
        <% }); %>
      </select>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="activity-table">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th scope="col" class="ps-4" style="width: 190px;">
            <a href="<%= getSortUrl('createdAt') %>" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1" title="Sort by Timestamp">
              <span>Timestamp</span>
              <% if (filters.sortBy === 'createdAt') { %>
                <i class="bi <%= filters.sortDirection === 'asc' ? 'bi-arrow-up' : 'bi-arrow-down' %> text-dark fw-bold"></i>
              <% } else { %>
                <i class="bi bi-arrow-down-up opacity-50"></i>
              <% } %>
            </a>
          </th>
          <th scope="col" style="width: 180px;">User</th>
          <th scope="col" style="width: 140px;">
            <a href="<%= getSortUrl('module') %>" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1" title="Sort by Module">
              <span>Module</span>
              <% if (filters.sortBy === 'module') { %>
                <i class="bi <%= filters.sortDirection === 'asc' ? 'bi-arrow-up' : 'bi-arrow-down' %> text-dark fw-bold"></i>
              <% } else { %>
                <i class="bi bi-arrow-down-up opacity-50"></i>
              <% } %>
            </a>
          </th>
          <th scope="col" style="width: 170px;">
            <a href="<%= getSortUrl('action') %>" class="text-decoration-none text-muted d-inline-flex align-items-center gap-1" title="Sort by Action">
              <span>Action</span>
              <% if (filters.sortBy === 'action') { %>
                <i class="bi <%= filters.sortDirection === 'asc' ? 'bi-arrow-up' : 'bi-arrow-down' %> text-dark fw-bold"></i>
              <% } else { %>
                <i class="bi bi-arrow-down-up opacity-50"></i>
              <% } %>
            </a>
          </th>
          <th scope="col">Description</th>
          <th scope="col" style="width: 150px;">Target Reference</th>
          <th scope="col" class="text-end pe-4" style="width: 130px;">IP Address</th>
        </tr>
      </thead>
      <tbody>
        <% if (!activities || activities.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center py-5">
              <div class="text-muted">
                <i class="bi bi-inbox display-6 mb-2 d-block text-secondary"></i>
                <h6 class="fw-semibold">No activity logs recorded</h6>
                <p class="small mb-0">Events are automatically logged as users navigate and operate Spark Admin.</p>
              </div>
            </td>
          </tr>
        <% } else { %>
          <% activities.forEach(act => {
               let actionBadge = 'bg-secondary';
               if (act.action.includes('CREATE')) actionBadge = 'bg-success';
               else if (act.action.includes('EDIT')) actionBadge = 'bg-warning text-dark';
               else if (act.action.includes('DELETE') || act.action.includes('VOID') || act.action.includes('DENIED')) actionBadge = 'bg-danger';
               else if (act.action.includes('PRINT') || act.action.includes('EXPORT')) actionBadge = 'bg-info text-dark';
               else if (act.action === 'LOGIN') actionBadge = 'bg-dark';
          %>
            <tr>
              <td class="ps-4 small text-muted font-monospace">
                <%= new Date(act.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
              </td>
              <td>
                <% if (act.actorUser) { %>
                  <a href="/team/<%= act.actorUser.id %>" class="fw-semibold text-dark text-decoration-none">
                    <%= act.actorUser.name %>
                  </a>
                  <div class="text-muted small"><%= act.actorUser.email %></div>
                <% } else { %>
                  <span class="text-muted fst-italic">System / Guest</span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-light text-dark border px-2 py-1"><%= act.module %></span>
              </td>
              <td>
                <span class="badge <%= actionBadge %> px-2 py-1"><%= act.action %></span>
              </td>
              <td class="small text-secondary">
                <%= act.description %>
              </td>
              <td class="small">
                <% if (act.targetReference) { %>
                  <span class="badge bg-secondary-subtle text-secondary font-monospace"><%= act.targetReference %></span>
                <% } else if (act.targetId) { %>
                  <span class="text-muted small">#<%= act.targetId %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="text-end pe-4 small text-muted font-monospace">
                <%= act.ipAddress || '—' %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination && pagination.pages > 1) {
       const totalP = pagination.pages;
       const curP = pagination.page;
       const winSize = 2;
       const startP = Math.max(1, curP - winSize);
       const endP = Math.min(totalP, curP + winSize);
  %>
    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <span class="small text-muted">
        Showing <%= (curP - 1) * pagination.limit + 1 %> to <%= Math.min(pagination.total, curP * pagination.limit) %> of <%= pagination.total %> events
      </span>
      <nav aria-label="Activity page navigation">
        <ul class="pagination pagination-sm mb-0 align-items-center gap-1">
          <!-- First -->
          <li class="page-item <%= curP <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= getQueryUrl({ page: 1 }) %>" title="First Page" aria-label="First page">
              <i class="bi bi-chevron-double-left"></i>
            </a>
          </li>
          <!-- Prev -->
          <li class="page-item <%= curP <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="<%= getQueryUrl({ page: curP - 1 }) %>" title="Previous Page" aria-label="Previous page">
              <i class="bi bi-chevron-left"></i>
            </a>
          </li>

          <!-- Windowed Numbers -->
          <% if (startP > 1) { %>
            <li class="page-item">
              <a class="page-link" href="<%= getQueryUrl({ page: 1 }) %>">1</a>
            </li>
            <% if (startP > 2) { %>
              <li class="page-item disabled"><span class="page-link">…</span></li>
            <% } %>
          <% } %>

          <% for (let p = startP; p <= endP; p++) { %>
            <li class="page-item <%= curP === p ? 'active' : '' %>">
              <a class="page-link" href="<%= getQueryUrl({ page: p }) %>"><%= p %></a>
            </li>
          <% } %>

          <% if (endP < totalP) { %>
            <% if (endP < totalP - 1) { %>
              <li class="page-item disabled"><span class="page-link">…</span></li>
            <% } %>
            <li class="page-item">
              <a class="page-link" href="<%= getQueryUrl({ page: totalP }) %>"><%= totalP %></a>
            </li>
          <% } %>

          <!-- Next -->
          <li class="page-item <%= curP >= totalP ? 'disabled' : '' %>">
            <a class="page-link" href="<%= getQueryUrl({ page: curP + 1 }) %>" title="Next Page" aria-label="Next page">
              <i class="bi bi-chevron-right"></i>
            </a>
          </li>
          <!-- Last -->
          <li class="page-item <%= curP >= totalP ? 'disabled' : '' %>">
            <a class="page-link" href="<%= getQueryUrl({ page: totalP }) %>" title="Last Page" aria-label="Last page">
              <i class="bi bi-chevron-double-right"></i>
            </a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</section>

<%- include('../layouts/footer') %>
