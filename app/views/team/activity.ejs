<%- include('../layouts/header', {
    pageTitle: 'User Activity Log',
    pageSubtitle: 'Operational audit trail of user access, document lifecycle, prints, and exports.'
}) %>

<!-- Sub-Navigation Tabs -->
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
  <ul class="nav nav-pills gap-2">
    <li class="nav-item">
      <a class="nav-link bg-white text-dark border fw-medium px-3 py-2 rounded-3" href="/team">
        <i class="bi bi-people me-1"></i> Team Members
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link active bg-primary text-white fw-medium px-3 py-2 rounded-3" href="/team/activity">
        <i class="bi bi-clock-history me-1"></i> Activity Log
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link bg-white text-dark border fw-medium px-3 py-2 rounded-3" href="/team/analytics">
        <i class="bi bi-graph-up me-1"></i> Team Analytics
      </a>
    </li>
  </ul>
</div>

<!-- Filters Card -->
<section class="card border-0 shadow-sm rounded-3 p-3 mb-4 bg-white" aria-label="Activity Filters">
  <form method="GET" action="/team/activity" class="row g-2 align-items-center">
    <div class="col-12 col-md-3">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input
          type="search"
          name="search"
          class="form-control bg-light border-start-0"
          placeholder="Search by keyword, doc #, or user..."
          value="<%= filters.search %>"
        />
      </div>
    </div>

    <div class="col-6 col-md-2">
      <select name="actorUserId" class="form-select bg-light">
        <option value="">All Users</option>
        <% (teamMembers || []).forEach(m => { %>
          <option value="<%= m.id %>" <%= filters.actorUserId == m.id ? 'selected' : '' %>><%= m.name %></option>
        <% }); %>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <select name="module" class="form-select bg-light">
        <option value="">All Modules</option>
        <% (modules || []).forEach(mod => { %>
          <option value="<%= mod %>" <%= filters.module === mod ? 'selected' : '' %>><%= mod %></option>
        <% }); %>
      </select>
    </div>

    <div class="col-6 col-md-2">
      <input type="date" name="fromDate" class="form-control bg-light" value="<%= filters.fromDate %>" title="From Date">
    </div>

    <div class="col-6 col-md-2">
      <input type="date" name="toDate" class="form-control bg-light" value="<%= filters.toDate %>" title="To Date">
    </div>

    <div class="col-12 col-md-1 d-flex gap-1">
      <button type="submit" class="btn btn-spark btn-spark-secondary w-100" title="Filter">
        <i class="bi bi-funnel"></i>
      </button>
      <% if (filters.search || filters.actorUserId || filters.module || filters.fromDate || filters.toDate) { %>
        <a href="/team/activity" class="btn btn-spark btn-spark-outline" title="Clear Filters">
          <i class="bi bi-x-lg"></i>
        </a>
      <% } %>
    </div>
  </form>
</section>

<!-- Activity Table Card -->
<section class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4" aria-label="Activity Table">
  <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-clock-history text-primary fs-5"></i>
      <h5 class="card-title fw-bold mb-0 text-dark">Audit Events</h5>
      <span class="badge bg-light text-muted border ms-2"><%= pagination.total %> Total Events</span>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="activity-table">
      <thead class="table-light text-muted small text-uppercase">
        <tr>
          <th scope="col" class="ps-4" style="width: 170px;">Timestamp</th>
          <th scope="col" style="width: 180px;">User</th>
          <th scope="col" style="width: 140px;">Module</th>
          <th scope="col" style="width: 170px;">Action</th>
          <th scope="col">Description</th>
          <th scope="col" style="width: 150px;">Target Reference</th>
          <th scope="col" class="text-end pe-4" style="width: 130px;">IP Address</th>
        </tr>
      </thead>
      <tbody>
        <% if (!activities || activities.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center py-5">
              <div class="text-muted">
                <i class="bi bi-inbox display-6 mb-2 d-block text-secondary"></i>
                <h6 class="fw-semibold">No activity logs recorded</h6>
                <p class="small mb-0">Events are automatically logged as users navigate and operate Spark Admin.</p>
              </div>
            </td>
          </tr>
        <% } else { %>
          <% activities.forEach(act => {
               let actionBadge = 'bg-secondary';
               if (act.action.includes('CREATE')) actionBadge = 'bg-success';
               else if (act.action.includes('EDIT')) actionBadge = 'bg-warning text-dark';
               else if (act.action.includes('DELETE') || act.action.includes('VOID') || act.action.includes('DENIED')) actionBadge = 'bg-danger';
               else if (act.action.includes('PRINT') || act.action.includes('EXPORT')) actionBadge = 'bg-info text-dark';
               else if (act.action === 'LOGIN') actionBadge = 'bg-primary';
          %>
            <tr>
              <td class="ps-4 small text-muted font-monospace">
                <%= new Date(act.createdAt).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
              </td>
              <td>
                <% if (act.actorUser) { %>
                  <a href="/team/<%= act.actorUser.id %>" class="fw-semibold text-dark text-decoration-none">
                    <%= act.actorUser.name %>
                  </a>
                  <div class="text-muted small"><%= act.actorUser.email %></div>
                <% } else { %>
                  <span class="text-muted fst-italic">System / Guest</span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-light text-dark border px-2 py-1"><%= act.module %></span>
              </td>
              <td>
                <span class="badge <%= actionBadge %> px-2 py-1"><%= act.action %></span>
              </td>
              <td class="small text-secondary">
                <%= act.description %>
              </td>
              <td class="small">
                <% if (act.targetReference) { %>
                  <span class="badge bg-secondary-subtle text-secondary font-monospace"><%= act.targetReference %></span>
                <% } else if (act.targetId) { %>
                  <span class="text-muted small">#<%= act.targetId %></span>
                <% } else { %>
                  <span class="text-muted">—</span>
                <% } %>
              </td>
              <td class="text-end pe-4 small text-muted font-monospace">
                <%= act.ipAddress || '—' %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (pagination && pagination.pages > 1) { %>
    <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
      <span class="small text-muted">
        Showing <%= (pagination.page - 1) * pagination.limit + 1 %> to <%= Math.min(pagination.total, pagination.page * pagination.limit) %> of <%= pagination.total %> events
      </span>
      <nav aria-label="Activity page navigation">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/team/activity?page=<%= pagination.page - 1 %>&search=<%= filters.search %>&actorUserId=<%= filters.actorUserId %>&module=<%= filters.module %>&fromDate=<%= filters.fromDate %>&toDate=<%= filters.toDate %>">Previous</a>
          </li>
          <% for (let p = 1; p <= pagination.pages; p++) { %>
            <li class="page-item <%= pagination.page === p ? 'active' : '' %>">
              <a class="page-link" href="/team/activity?page=<%= p %>&search=<%= filters.search %>&actorUserId=<%= filters.actorUserId %>&module=<%= filters.module %>&fromDate=<%= filters.fromDate %>&toDate=<%= filters.toDate %>"><%= p %></a>
            </li>
          <% } %>
          <li class="page-item <%= pagination.page >= pagination.pages ? 'disabled' : '' %>">
            <a class="page-link" href="/team/activity?page=<%= pagination.page + 1 %>&search=<%= filters.search %>&actorUserId=<%= filters.actorUserId %>&module=<%= filters.module %>&fromDate=<%= filters.fromDate %>&toDate=<%= filters.toDate %>">Next</a>
          </li>
        </ul>
      </nav>
    </div>
  <% } %>
</section>
