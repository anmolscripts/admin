<%- include('../layouts/header', {
    pageTitle: 'Organization Profile & Defaults',
    pageSubtitle: 'Manage business identity, GST registration, bank details, and invoice templates.'
}) %>

<div class="row justify-content-center">
  <div class="col-12 col-xl-11">
    <% if (locals.success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>Success:</strong> Organization settings and defaults have been saved successfully!
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <% if (locals.error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Error:</strong> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- SETTINGS NAVIGATION TABS -->
    <ul class="nav nav-pills mb-4 gap-2" id="settingsTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active px-4 py-2 fw-semibold rounded-pill d-flex align-items-center" id="tab-profile-btn" data-bs-toggle="pill" data-bs-target="#tab-profile" type="button" role="tab" aria-controls="tab-profile" aria-selected="true">
          <i class="bi bi-building me-2 fs-5"></i> Organization Profile & Defaults
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link px-4 py-2 fw-semibold rounded-pill d-flex align-items-center" id="tab-templates-btn" data-bs-toggle="pill" data-bs-target="#tab-templates" type="button" role="tab" aria-controls="tab-templates" aria-selected="false">
          <i class="bi bi-palette-fill me-2 fs-5"></i> Document & Invoice Templates
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-2 rounded-pill px-2">System</span>
        </button>
      </li>
    </ul>

    <div class="tab-content" id="settingsTabsContent">
      <!-- ========================================== -->
      <!-- TAB 1: ORGANIZATION PROFILE & DEFAULTS -->
      <!-- ========================================== -->
      <div class="tab-pane fade show active" id="tab-profile" role="tabpanel" aria-labelledby="tab-profile-btn">
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
          <div class="visually-hidden">Organization Profile & Defaults</div>
          <form method="POST" action="/settings" id="settings-form" enctype="multipart/form-data">
            <% if (locals.csrfToken) { %>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <% } %>

            <!-- SECTION 1: Organization Identity & Branding -->
            <div class="mb-4">
              <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                <i class="bi bi-building text-primary fs-4 me-2"></i>
                <div>
                  <h5 class="fw-bold mb-0 text-dark">Organization Identity & Branding</h5>
                  <small class="text-muted">Legal entity names and brand identity used in the application and documents.</small>
                </div>
              </div>

              <div class="row g-3">
                <!-- Legal Entity Name -->
                <div class="col-12 col-md-6">
                  <label for="profile-legalName" class="form-label fw-semibold">Legal Entity Name <span class="text-danger">*</span></label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-legalName"
                    name="legalName"
                    value="<%= (profile && profile.legalName) || '' %>"
                    placeholder="e.g. Acme Technologies Private Limited"
                    required
                  />
                  <div class="form-text">Used on official tax invoices, quotations, credit notes, and legal filings.</div>
                </div>

                <!-- Display / Trade Name -->
                <div class="col-12 col-md-6">
                  <label for="profile-displayName" class="form-label fw-semibold">Trade / Display Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-displayName"
                    name="displayName"
                    value="<%= (profile && profile.displayName) || '' %>"
                    placeholder="e.g. Acme Tech"
                  />
                  <div class="form-text">Customer-facing business name used across documents.</div>
                </div>

                <!-- Workspace Name -->
                <div class="col-12 col-md-6">
                  <label for="profile-workspaceName" class="form-label fw-semibold">Application / Workspace Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-workspaceName"
                    name="workspaceName"
                    value="<%= (profile && (profile.workspaceName || profile.displayName || profile.legalName)) || 'Spark Admin' %>"
                    placeholder="e.g. Acme ERP"
                  />
                  <div class="form-text">Displayed in sidebar, browser tabs, header, and system navigation.</div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="organization-logo" class="form-label fw-semibold">Organization Logo</label>
                  <input type="hidden" name="logoUrl" value="<%= (profile && profile.logoUrl) || '' %>">
                  <div class="avatar-upload organization-logo-upload">
                    <div class="avatar-upload-preview organization-logo-preview"><img id="organization-logo-preview" src="<%= (profile && profile.logoUrl) || '' %>" alt="Organization logo preview" <%= profile && profile.logoUrl?'':'hidden' %>><span id="organization-logo-placeholder" <%= profile && profile.logoUrl?'hidden':'' %> aria-label="No logo selected"><i class="bi bi-image"></i></span></div>
                    <div class="flex-grow-1"><div class="d-flex flex-wrap gap-2"><label for="organization-logo" class="btn btn-sm btn-outline-primary mb-0"><i class="bi bi-cloud-arrow-up me-2"></i>Choose image</label><input type="file" class="visually-hidden" id="organization-logo" name="logo" accept="image/png,image/jpeg,image/webp" aria-describedby="organization-logo-help organization-logo-caption"><button type="button" class="btn btn-sm btn-outline-secondary" id="organization-logo-reset" hidden>Undo selection</button></div><div id="organization-logo-help" class="form-text mt-2">PNG, JPEG or WebP · maximum 2 MB.</div><small id="organization-logo-caption" class="text-muted d-block mt-1" role="status">Preview first. Save changes to apply your logo.</small></div>
                  </div>
                  <div class="form-text">Used in your workspace, invoices and print headers. Your saved logo stays unchanged until a successful save.</div>
                </div>

                <!-- Billing Email -->
                <div class="col-12 col-md-4">
                  <label for="profile-email" class="form-label fw-semibold">Billing / Contact Email</label>
                  <input
                    type="email"
                    class="form-control"
                    id="profile-email"
                    name="email"
                    value="<%= (profile && profile.email) || '' %>"
                    placeholder="e.g. billing@acmetech.com"
                  />
                </div>

                <!-- Phone -->
                <div class="col-12 col-md-4">
                  <label for="profile-phone" class="form-label fw-semibold">Phone Number</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-phone"
                    name="phone"
                    value="<%= (profile && profile.phone) || '' %>"
                    placeholder="e.g. +91 22 2345 6789"
                  />
                </div>

                <!-- Website -->
                <div class="col-12 col-md-4">
                  <label for="profile-website" class="form-label fw-semibold">Website</label>
                  <input
                    type="url"
                    class="form-control"
                    id="profile-website"
                    name="website"
                    value="<%= (profile && profile.website) || '' %>"
                    placeholder="e.g. https://acmetech.com"
                  />
                </div>

                <!-- Address -->
                <div class="col-12">
                  <label for="profile-address" class="form-label fw-semibold">Registered Business Address</label>
                  <textarea
                    class="form-control"
                    id="profile-address"
                    name="address"
                    rows="2"
                    placeholder="Registered office address for tax invoices and document headers..."
                  ><%= (profile && profile.address) || '' %></textarea>
                </div>
              </div>
            </div>

            <!-- SECTION 2: GST Tax Registration -->
            <div class="mb-4">
              <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                <i class="bi bi-file-earmark-ruled text-success fs-4 me-2"></i>
                <div>
                  <h5 class="fw-bold mb-0 text-dark">GST Tax Registration</h5>
                  <small class="text-muted">Indian Goods and Services Tax configuration for tax calculation and invoices.</small>
                </div>
              </div>

              <div class="row g-3">
                <!-- GSTIN -->
                <div class="col-12 col-md-6">
                  <label for="profile-gstin" class="form-label fw-semibold">GSTIN (15 Characters)</label>
                  <input
                    type="text"
                    class="form-control text-uppercase font-monospace"
                    id="profile-gstin"
                    name="gstin"
                    value="<%= (profile && profile.gstin) || '' %>"
                    placeholder="27ABCDE1234F1Z5"
                    maxlength="15"
                  />
                  <div class="form-text">Your organization's registered 15-digit GST identification number.</div>
                </div>

                <!-- State Code -->
                <div class="col-12 col-md-6">
                  <label for="profile-stateCode" class="form-label fw-semibold">Home State Code (2 Digits)</label>
                  <input
                    type="text"
                    class="form-control font-monospace"
                    id="profile-stateCode"
                    name="stateCode"
                    value="<%= (profile && profile.stateCode) || '27' %>"
                    placeholder="e.g. 27"
                    maxlength="2"
                  />
                  <div class="form-text">Must match the first 2 digits of your GSTIN (e.g. 27 for Maharashtra). Governs CGST/SGST vs IGST rules.</div>
                </div>
              </div>
            </div>

            <!-- SECTION 3: Banking & Payment Information -->
            <div class="mb-4">
              <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                <i class="bi bi-bank text-info fs-4 me-2"></i>
                <div>
                  <h5 class="fw-bold mb-0 text-dark">Banking & Payment Information</h5>
                  <small class="text-muted">Settlement bank accounts and UPI coordinates printed on invoices for customer remittance.</small>
                </div>
              </div>

              <div class="row g-3">
                <!-- Bank Name -->
                <div class="col-12 col-md-6">
                  <label for="profile-bankName" class="form-label fw-semibold">Bank Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-bankName"
                    name="bankName"
                    value="<%= (profile && profile.bankName) || '' %>"
                    placeholder="e.g. HDFC Bank"
                  />
                </div>

                <!-- Account Holder -->
                <div class="col-12 col-md-6">
                  <label for="profile-accountHolder" class="form-label fw-semibold">Account Holder Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-accountHolder"
                    name="accountHolder"
                    value="<%= (profile && profile.accountHolder) || '' %>"
                    placeholder="e.g. Acme Technologies Pvt Ltd"
                  />
                </div>

                <!-- Account Number -->
                <div class="col-12 col-md-4">
                  <label for="profile-accountNumber" class="form-label fw-semibold">Account Number</label>
                  <input
                    type="text"
                    class="form-control font-monospace"
                    id="profile-accountNumber"
                    name="accountNumber"
                    value="<%= (profile && profile.accountNumber) || '' %>"
                    placeholder="e.g. 50200012345678"
                  />
                </div>

                <!-- IFSC -->
                <div class="col-12 col-md-4">
                  <label for="profile-ifsc" class="form-label fw-semibold">IFSC Code (11 Digits)</label>
                  <input
                    type="text"
                    class="form-control text-uppercase font-monospace"
                    id="profile-ifsc"
                    name="ifsc"
                    value="<%= (profile && profile.ifsc) || '' %>"
                    placeholder="e.g. HDFC0001234"
                    maxlength="11"
                  />
                </div>

                <!-- Branch -->
                <div class="col-12 col-md-4">
                  <label for="profile-branch" class="form-label fw-semibold">Branch Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-branch"
                    name="branch"
                    value="<%= (profile && profile.branch) || '' %>"
                    placeholder="e.g. BKC Branch, Mumbai"
                  />
                </div>

                <!-- UPI ID -->
                <div class="col-12 col-md-6">
                  <label for="profile-upiId" class="form-label fw-semibold">UPI ID / VPA</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-upiId"
                    name="upiId"
                    value="<%= (profile && profile.upiId) || '' %>"
                    placeholder="e.g. acmetech@hdfcbank"
                  />
                  <div class="form-text">Optional UPI handle for fast mobile payments.</div>
                </div>

                <!-- Payment Instructions -->
                <div class="col-12 col-md-6">
                  <label for="profile-paymentInstructions" class="form-label fw-semibold">Payment Instructions</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-paymentInstructions"
                    name="paymentInstructions"
                    value="<%= (profile && profile.paymentInstructions) || '' %>"
                    placeholder="e.g. Please quote invoice number during NEFT/RTGS transfer."
                  />
                </div>
              </div>
            </div>

            <!-- SECTION 4: Document Defaults & Localization -->
            <div class="mb-4">
              <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                <i class="bi bi-file-earmark-text text-warning fs-4 me-2"></i>
                <div>
                  <h5 class="fw-bold mb-0 text-dark">Document Defaults & Localization</h5>
                  <small class="text-muted">Default boilerplate terms and formatting applied to newly drafted documents.</small>
                </div>
              </div>

              <div class="row g-3">
                <!-- Currency -->
                <div class="col-12 col-md-6">
                  <label for="profile-currency" class="form-label fw-semibold">Base Currency</label>
                  <select class="form-select" id="profile-currency" name="currency">
                    <option value="INR" <%= (!profile || profile.currency === 'INR') ? 'selected' : '' %>>INR — Indian Rupee (₹)</option>
                    <option value="USD" <%= (profile && profile.currency === 'USD') ? 'selected' : '' %>>USD — US Dollar ($)</option>
                    <option value="EUR" <%= (profile && profile.currency === 'EUR') ? 'selected' : '' %>>EUR — Euro (€)</option>
                    <option value="GBP" <%= (profile && profile.currency === 'GBP') ? 'selected' : '' %>>GBP — British Pound (£)</option>
                    <option value="AED" <%= (profile && profile.currency === 'AED') ? 'selected' : '' %>>AED — UAE Dirham</option>
                  </select>
                </div>

                <!-- Timezone -->
                <div class="col-12 col-md-6">
                  <label for="profile-timeZone" class="form-label fw-semibold">Time Zone</label>
                  <select class="form-select" id="profile-timeZone" name="timeZone">
                    <option value="Asia/Kolkata" <%= (!profile || profile.timeZone === 'Asia/Kolkata') ? 'selected' : '' %>>Asia/Kolkata (IST +05:30)</option>
                    <option value="UTC" <%= (profile && profile.timeZone === 'UTC') ? 'selected' : '' %>>UTC (Coordinated Universal Time)</option>
                    <option value="Asia/Dubai" <%= (profile && profile.timeZone === 'Asia/Dubai') ? 'selected' : '' %>>Asia/Dubai (GST +04:00)</option>
                    <option value="Asia/Singapore" <%= (profile && profile.timeZone === 'Asia/Singapore') ? 'selected' : '' %>>Asia/Singapore (SGT +08:00)</option>
                    <option value="Europe/London" <%= (profile && profile.timeZone === 'Europe/London') ? 'selected' : '' %>>Europe/London (GMT/BST)</option>
                    <option value="America/New_York" <%= (profile && profile.timeZone === 'America/New_York') ? 'selected' : '' %>>America/New_York (EST/EDT)</option>
                  </select>
                </div>

                <!-- Default Terms -->
                <div class="col-12">
                  <label for="profile-defaultTerms" class="form-label fw-semibold">Default Terms & Conditions</label>
                  <textarea
                    class="form-control"
                    id="profile-defaultTerms"
                    name="defaultTerms"
                    rows="3"
                    placeholder="Standard payment terms, warranty, dispute jurisdiction..."
                  ><%= (profile && profile.defaultTerms) || '' %></textarea>
                </div>

                <!-- Default Remarks -->
                <div class="col-12">
                  <label for="profile-defaultRemarks" class="form-label fw-semibold">Default Remarks / Notes</label>
                  <textarea
                    class="form-control"
                    id="profile-defaultRemarks"
                    name="defaultRemarks"
                    rows="2"
                    placeholder="Thank you for your business notes..."
                  ><%= (profile && profile.defaultRemarks) || '' %></textarea>
                </div>

                <!-- Invoice Footer -->
                <div class="col-12">
                  <label for="profile-invoiceFooter" class="form-label fw-semibold">Invoice Footer Text</label>
                  <input
                    type="text"
                    class="form-control"
                    id="profile-invoiceFooter"
                    name="invoiceFooter"
                    value="<%= (profile && profile.invoiceFooter) || '' %>"
                    placeholder="e.g. This is a computer generated invoice and does not require a physical signature."
                  />
                </div>
              </div>
            </div>

            <div class="d-flex align-items-center justify-content-end pt-3 border-top">
              <button type="submit" class="btn btn-primary px-4 fw-semibold" id="btn-save-settings">
                <i class="bi bi-save me-1"></i> Save Organization Settings
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- TAB 2: DOCUMENT & INVOICE TEMPLATES -->
      <!-- ========================================== -->
      <div class="tab-pane fade" id="tab-templates" role="tabpanel" aria-labelledby="tab-templates-btn">
        <!-- Active Templates Quick Configuration Bar -->
        <div class="card border-0 shadow-sm rounded-3 p-4 bg-white mb-4">
          <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
              <h5 class="fw-bold mb-1 text-dark d-flex align-items-center">
                <i class="bi bi-sliders text-primary me-2"></i> Active Templates for Current Business
              </h5>
              <small class="text-muted">Select which layout is automatically used when generating PDF documents and print views.</small>
            </div>
            <div>
              <button type="button" class="btn btn-outline-primary fw-semibold" id="btn-open-create-template">
                <i class="bi bi-plus-circle me-1"></i> Create Custom Template
              </button>
            </div>
          </div>

          <div class="row g-3 align-items-end">
            <!-- Active Invoice Template Selector -->
            <div class="col-12 col-md-5">
              <label for="active-invoice-template-select" class="form-label fw-semibold text-dark">
                <i class="bi bi-receipt text-primary me-1"></i> Default Invoice Template
              </label>
              <select class="form-select form-select-lg" id="active-invoice-template-select">
                <% if (locals.templates && templates.length > 0) { %>
                  <% templates.forEach(function(tpl) { %>
                    <option value="<%= tpl.id %>" <%= (locals.activeTemplates && activeTemplates.invoiceTemplate === tpl.id) ? 'selected' : '' %>>
                      <%= tpl.name %> (<%= tpl.category %>)
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Active Quotation Template Selector -->
            <div class="col-12 col-md-5">
              <label for="active-quotation-template-select" class="form-label fw-semibold text-dark">
                <i class="bi bi-file-earmark-text text-teal me-1"></i> Default Quotation Template
              </label>
              <select class="form-select form-select-lg" id="active-quotation-template-select">
                <% if (locals.templates && templates.length > 0) { %>
                  <% templates.forEach(function(tpl) { %>
                    <option value="<%= tpl.id %>" <%= (locals.activeTemplates && activeTemplates.quotationTemplate === tpl.id) ? 'selected' : '' %>>
                      <%= tpl.name %> (<%= tpl.category %>)
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>

            <!-- Apply Button -->
            <div class="col-12 col-md-2">
              <button type="button" class="btn btn-primary btn-lg w-100 fw-semibold" id="btn-save-active-templates">
                <i class="bi bi-check2-circle me-1"></i> Apply
              </button>
            </div>
          </div>
        </div>

        <!-- Template Catalog Gallery -->
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <h5 class="fw-bold mb-0 text-dark">Template Gallery</h5>
            <small class="text-muted">Choose from enterprise built-ins or customize your own brand style.</small>
          </div>
          <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
            <%= (locals.templates ? templates.length : 0) %> Templates Available
          </span>
        </div>

        <div class="row g-4" id="templateGalleryContainer">
          <% if (locals.templates && templates.length > 0) { %>
            <% templates.forEach(function(tpl) { %>
              <%
                const isInvoiceActive = locals.activeTemplates && activeTemplates.invoiceTemplate === tpl.id;
                const isQuotationActive = locals.activeTemplates && activeTemplates.quotationTemplate === tpl.id;
              %>
              <div class="col-12 col-md-6 col-lg-6 col-xl-6 template-card-wrapper" data-template-id="<%= tpl.id %>">
                <div class="template-gallery-card h-100 d-flex flex-column hover-lift shadow-sm <%= isInvoiceActive ? 'is-active-invoice' : '' %> <%= isQuotationActive ? 'is-active-quotation' : '' %>">
                  <!-- Mock Visual Thumbnail Preview -->
                  <div class="template-thumb-preview" style="background: <%= tpl.accentSubtle || '#f8fafc' %>;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <span class="template-color-swatch" style="background-color: <%= tpl.accentColor %>;"></span>
                        <span class="fw-bold fs-6" style="color: <%= tpl.accentColor %>;"><%= tpl.name %></span>
                      </div>
                      <div class="d-flex gap-1 flex-wrap">
                        <% if (isInvoiceActive) { %>
                          <span class="badge bg-primary shadow-sm"><i class="bi bi-receipt me-1"></i>Active Invoice</span>
                        <% } %>
                        <% if (isQuotationActive) { %>
                          <span class="badge text-white shadow-sm" style="background-color: #0d9488;"><i class="bi bi-file-earmark-text me-1"></i>Active Quotation</span>
                        <% } %>
                      </div>
                    </div>

                    <!-- Mini Document Wireframe Representation -->
                    <div class="bg-white p-2 rounded shadow-xs flex-grow-1 border d-flex flex-column justify-content-between" style="border-left: 4px solid <%= tpl.accentColor %> !important; opacity: 0.95;">
                      <div class="d-flex justify-content-between border-bottom pb-1 mb-1">
                        <div style="font-size: 11px; font-weight: 700; color: <%= tpl.accentColor %>;">TAX INVOICE</div>
                        <div style="font-size: 10px; color: #64748b;">#INV-2026-0001</div>
                      </div>
                      <div class="row g-1 text-muted" style="font-size: 9px;">
                        <div class="col-7">Enterprise Cloud Platform</div>
                        <div class="col-2 text-center">1 Qty</div>
                        <div class="col-3 text-end fw-bold text-dark">₹ 1,18,000.00</div>
                      </div>
                      <div class="d-flex justify-content-between pt-1 border-top" style="font-size: 9px;">
                        <span class="text-muted"><%= tpl.showHsn ? 'HSN Included' : 'Standard' %></span>
                        <span class="fw-bold" style="color: <%= tpl.accentColor %>;">Total: ₹ 1,18,000</span>
                      </div>
                    </div>
                  </div>

                  <!-- Template Meta & Description -->
                  <div class="p-3 flex-grow-1 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <span class="badge bg-light text-dark border"><%= tpl.category || 'General' %></span>
                      <% if (tpl.isBuiltIn) { %>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Built-In Core</span>
                      <% } else { %>
                        <span class="badge bg-info-subtle text-info border border-info-subtle">Custom Template</span>
                      <% } %>
                    </div>

                    <p class="text-muted small mb-3 flex-grow-1">
                      <%= tpl.description || 'Custom business template layout.' %>
                    </p>

                    <!-- Features Checklist -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                      <span class="badge bg-light text-muted border" style="font-size: 11px;">
                        <i class="bi <%= tpl.showHsn ? 'bi-check-circle-fill text-success' : 'bi-x-circle text-muted' %> me-1"></i> HSN/SAC
                      </span>
                      <span class="badge bg-light text-muted border" style="font-size: 11px;">
                        <i class="bi <%= tpl.showUpiQr ? 'bi-check-circle-fill text-success' : 'bi-x-circle text-muted' %> me-1"></i> UPI QR
                      </span>
                      <span class="badge bg-light text-muted border" style="font-size: 11px;">
                        <i class="bi <%= tpl.showDiscount ? 'bi-check-circle-fill text-success' : 'bi-x-circle text-muted' %> me-1"></i> Discount
                      </span>
                      <span class="badge bg-light text-muted border" style="font-size: 11px;">
                        <i class="bi bi-fonts me-1"></i> Montserrat
                      </span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pt-2 border-top">
                      <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary btn-preview-template fw-semibold" data-template-id="<%= tpl.id %>" data-template-name="<%= tpl.name %>">
                          <i class="bi bi-eye me-1"></i> Preview
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-dark btn-edit-template fw-semibold" data-template='<%- JSON.stringify(tpl) %>'>
                          <i class="bi bi-pencil-square me-1"></i> <%= tpl.isBuiltIn ? 'Duplicate' : 'Edit' %>
                        </button>
                      </div>

                      <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm <%= isInvoiceActive ? 'btn-primary' : 'btn-outline-primary' %> btn-set-invoice" data-template-id="<%= tpl.id %>" title="Set as default template for Tax Invoices">
                          <i class="bi bi-receipt"></i> Invoice
                        </button>
                        <button type="button" class="btn btn-sm <%= isQuotationActive ? 'btn-teal text-white' : 'btn-outline-secondary' %> btn-set-quotation" style="<%= isQuotationActive ? 'background-color:#0d9488;' : '' %>" data-template-id="<%= tpl.id %>" title="Set as default template for Quotations">
                          <i class="bi bi-file-earmark-text"></i> Quotation
                        </button>
                        <% if (!tpl.isBuiltIn) { %>
                          <button type="button" class="btn btn-sm btn-outline-danger btn-delete-template" data-template-id="<%= tpl.id %>" title="Delete custom template">
                            <i class="bi bi-trash"></i>
                          </button>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: TEMPLATE LIVE PREVIEW (IFRAME) -->
<!-- ========================================== -->
<div class="modal fade" id="templatePreviewModal" tabindex="-1" aria-labelledby="templatePreviewModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered" style="max-width: 1100px;">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <div class="modal-header border-bottom py-3 px-4 bg-light">
        <div class="d-flex align-items-center gap-3">
          <i class="bi bi-eye-fill text-primary fs-4"></i>
          <div>
            <h5 class="modal-title fw-bold text-dark mb-0" id="templatePreviewModalTitle">Template Preview</h5>
            <small class="text-muted" id="previewModalSubtitle">Live preview rendered with actual business profile information</small>
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <!-- Toggle Sample Type -->
          <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-primary active" id="btn-preview-type-invoice">Tax Invoice</button>
            <button type="button" class="btn btn-outline-primary" id="btn-preview-type-quotation">Quotation</button>
          </div>

          <!-- Print Preview -->
          <button type="button" class="btn btn-sm btn-outline-secondary" id="btn-print-preview-frame">
            <i class="bi bi-printer me-1"></i> Print
          </button>

          <button type="button" class="btn-close ms-2" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>

      <div class="modal-body p-0 bg-secondary-subtle position-relative">
        <div id="previewLoader" class="position-absolute top-50 start-50 translate-middle text-center" style="display: none;">
          <div class="spinner-border text-primary" role="status"></div>
          <p class="mt-2 text-muted fw-semibold small">Rendering preview...</p>
        </div>
        <iframe id="templatePreviewIframe" src="" style="width: 100%; height: 720px; border: none; display: block; background: #fff;"></iframe>
      </div>

      <div class="modal-footer border-top py-2 px-4 bg-light d-flex justify-content-between">
        <span class="small text-muted"><i class="bi bi-info-circle me-1"></i> Preview reflects Indian GST compliance, HSN codes, and live business branding.</span>
        <button type="button" class="btn btn-secondary btn-sm px-3" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MODAL: TEMPLATE EDITOR / CUSTOMIZER -->
<!-- ========================================== -->
<div class="modal fade" id="templateEditorModal" tabindex="-1" aria-labelledby="templateEditorModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg rounded-3">
      <div class="modal-header border-bottom py-3 px-4">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-palette-fill text-primary fs-4"></i>
          <div>
            <h5 class="modal-title fw-bold text-dark mb-0" id="templateEditorModalTitle">Create Custom Template</h5>
            <small class="text-muted">Customize brand styling, color palettes, fonts, and document feature toggles.</small>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <form id="templateEditorForm">
          <input type="hidden" id="editor-template-id" value="" />

          <div class="row g-3 mb-3">
            <!-- Template Name -->
            <div class="col-12 col-md-8">
              <label for="editor-name" class="form-label fw-semibold">Template Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="editor-name" placeholder="e.g. Acme Tech Studio Blue" required />
            </div>

            <!-- Category -->
            <div class="col-12 col-md-4">
              <label for="editor-category" class="form-label fw-semibold">Category</label>
              <input type="text" class="form-control" id="editor-category" placeholder="e.g. Modern, CA, Tech" />
            </div>

            <!-- Description -->
            <div class="col-12">
              <label for="editor-description" class="form-label fw-semibold">Description</label>
              <input type="text" class="form-control" id="editor-description" placeholder="Brief summary of this template style..." />
            </div>

            <!-- Base Layout Engine -->
            <div class="col-12 col-md-6">
              <label for="editor-base-template" class="form-label fw-semibold">Base Layout Structure</label>
              <select class="form-select" id="editor-base-template">
                <option value="modern-minimal">Modern Minimalist (Clean & Airy)</option>
                <option value="classic-corporate">Classic Corporate (Auditor / CA Double Border)</option>
                <option value="industrial-bold">Industrial Bold (Manufacturing / High Contrast)</option>
                <option value="executive-emerald">Executive Emerald (Luxury / Studio)</option>
                <option value="rajesh-signature">Rajesh International (Navy & Gold)</option>
              </select>
            </div>

            <!-- Font Family -->
            <div class="col-12 col-md-6">
              <label for="editor-font-family" class="form-label fw-semibold">Typography / Font Family</label>
              <select class="form-select" id="editor-font-family">
                <option value="Montserrat, sans-serif">Montserrat</option>
              </select>
            </div>

            <!-- Accent Color -->
            <div class="col-12 col-md-6">
              <label for="editor-accent-color" class="form-label fw-semibold">Primary Accent Color</label>
              <div class="input-group">
                <input type="color" class="form-control form-control-color" id="editor-accent-picker" value="#2563eb" title="Choose color" />
                <input type="text" class="form-control font-monospace" id="editor-accent-color" value="#2563eb" placeholder="#2563eb" maxlength="7" />
              </div>
              <div class="form-text">Used for headings, document title, and primary table borders.</div>
            </div>

            <!-- Subtle Accent Color -->
            <div class="col-12 col-md-6">
              <label for="editor-subtle-color" class="form-label fw-semibold">Subtle Accent / Table Header Color</label>
              <div class="input-group">
                <input type="color" class="form-control form-control-color" id="editor-subtle-picker" value="#eff6ff" title="Choose color" />
                <input type="text" class="form-control font-monospace" id="editor-subtle-color" value="#eff6ff" placeholder="#eff6ff" maxlength="7" />
              </div>
              <div class="form-text">Used for table headers, total badge backgrounds, and highlights.</div>
            </div>
          </div>

          <!-- Feature Toggles -->
          <div class="mb-3 p-3 bg-light rounded-3 border">
            <h6 class="fw-bold mb-2 text-dark">Document Columns & Features</h6>
            <div class="row g-2">
              <div class="col-6 col-md-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="editor-show-hsn" checked />
                  <label class="form-check-label small fw-semibold" for="editor-show-hsn">HSN / SAC Column</label>
                </div>
              </div>
              <div class="col-6 col-md-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="editor-show-upi" checked />
                  <label class="form-check-label small fw-semibold" for="editor-show-upi">UPI QR Badge</label>
                </div>
              </div>
              <div class="col-6 col-md-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="editor-show-discount" checked />
                  <label class="form-check-label small fw-semibold" for="editor-show-discount">Discount Column</label>
                </div>
              </div>
              <div class="col-6 col-md-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="editor-show-unit" checked />
                  <label class="form-check-label small fw-semibold" for="editor-show-unit">Unit of Measure</label>
                </div>
              </div>
            </div>
          </div>

          <!-- Advanced Custom CSS -->
          <div class="mb-2">
            <label for="editor-custom-css" class="form-label fw-semibold d-flex justify-content-between align-items-center">
              <span>Advanced Custom CSS Rules</span>
              <span class="badge bg-secondary-subtle text-secondary">Optional Power Tool</span>
            </label>
            <textarea class="form-control font-monospace small" id="editor-custom-css" rows="3" placeholder="/* Custom CSS overrides e.g. .doc-items-table th { text-transform: uppercase; } */"></textarea>
            <div class="form-text">Injected into document print views and generated PDF documents.</div>
          </div>
        </form>
      </div>

      <div class="modal-footer border-top py-3 px-4 d-flex justify-content-between">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary px-4 fw-semibold" id="btn-save-custom-template">
          <i class="bi bi-save me-1"></i> Save Custom Template
        </button>
      </div>
    </div>
  </div>
</div>

<!-- CLIENT JAVASCRIPT: TEMPLATE SYSTEM INTERACTIVITY -->
<script>
(function() {
  'use strict';

  let currentPreviewTemplateId = 'modern-minimal';
  let currentPreviewDocType = 'INVOICE';

  async function templateRequest(url, options) {
    const token = document.querySelector('input[name="_csrf"]');
    if (!token || !token.value) throw new Error('Please refresh this page and try again.');
    const res = await fetch(url, {
      ...options,
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'x-csrf-token': token.value,
        ...(options.headers || {})
      }
    });
    if (res.redirected || !(res.headers.get('content-type') || '').includes('application/json')) {
      throw new Error('Your session may have expired. Refresh the page and sign in again.');
    }
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || data.message || 'Request failed (HTTP ' + res.status + ').');
    return data;
  }

  // 1. Sync color picker and text inputs
  function setupColorSync(pickerId, textId) {
    const picker = document.getElementById(pickerId);
    const text = document.getElementById(textId);
    if (!picker || !text) return;

    picker.addEventListener('input', function() {
      text.value = picker.value;
    });
    text.addEventListener('input', function() {
      if (/^#[0-9A-Fa-f]{6}$/.test(text.value)) {
        picker.value = text.value;
      }
    });
  }

  setupColorSync('editor-accent-picker', 'editor-accent-color');
  setupColorSync('editor-subtle-picker', 'editor-subtle-color');

  // 2. Preview Modal Logic
  function loadPreview(templateId, docType) {
    currentPreviewTemplateId = templateId || currentPreviewTemplateId;
    currentPreviewDocType = docType || currentPreviewDocType;

    const iframe = document.getElementById('templatePreviewIframe');
    const loader = document.getElementById('previewLoader');
    if (!iframe) return;

    if (loader) loader.style.display = 'block';
    iframe.src = '/settings/templates/preview/' + encodeURIComponent(currentPreviewTemplateId) + '?type=' + encodeURIComponent(currentPreviewDocType);

    iframe.onload = function() {
      if (loader) loader.style.display = 'none';
    };
  }

  document.querySelectorAll('.btn-preview-template').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const templateId = this.getAttribute('data-template-id');
      const templateName = this.getAttribute('data-template-name');
      const modalTitle = document.getElementById('templatePreviewModalTitle');
      if (modalTitle) modalTitle.textContent = 'Preview: ' + (templateName || templateId);

      loadPreview(templateId, currentPreviewDocType);

      if (window.openSparkModal) {
        window.openSparkModal('#templatePreviewModal');
      } else {
        const modalEl = document.getElementById('templatePreviewModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        modal.show();
      }
    });
  });

  const btnTypeInvoice = document.getElementById('btn-preview-type-invoice');
  const btnTypeQuotation = document.getElementById('btn-preview-type-quotation');

  if (btnTypeInvoice && btnTypeQuotation) {
    btnTypeInvoice.addEventListener('click', function() {
      btnTypeInvoice.classList.add('active');
      btnTypeQuotation.classList.remove('active');
      loadPreview(currentPreviewTemplateId, 'INVOICE');
    });

    btnTypeQuotation.addEventListener('click', function() {
      btnTypeQuotation.classList.add('active');
      btnTypeInvoice.classList.remove('active');
      loadPreview(currentPreviewTemplateId, 'QUOTATION');
    });
  }

  const btnPrintFrame = document.getElementById('btn-print-preview-frame');
  if (btnPrintFrame) {
    btnPrintFrame.addEventListener('click', function() {
      const iframe = document.getElementById('templatePreviewIframe');
      if (iframe && iframe.contentWindow) {
        iframe.contentWindow.focus();
        iframe.contentWindow.print();
      }
    });
  }

  // 3. Save Active Templates
  const btnSaveActive = document.getElementById('btn-save-active-templates');
  if (btnSaveActive) {
    btnSaveActive.addEventListener('click', async function() {
      const invoiceTemplate = document.getElementById('active-invoice-template-select').value;
      const quotationTemplate = document.getElementById('active-quotation-template-select').value;

      try {
        const data = await templateRequest('/api/settings/templates/active', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invoiceTemplate, quotationTemplate })
        });
        if (data.success) {
          if (window.SparkLoader && window.SparkLoader.toast) {
            window.SparkLoader.toast('Active invoice and quotation templates updated!', 'success');
          } else {
            alert('Active templates updated successfully!');
          }
          setTimeout(function() { window.location.reload(); }, 600);
        } else {
          alert('Failed to update templates: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Failed to update templates: ' + err.message);
      }
    });
  }

  // One-click quick set from template gallery
  document.querySelectorAll('.btn-set-invoice').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const templateId = this.getAttribute('data-template-id');
      const quotationTemplate = document.getElementById('active-quotation-template-select').value;
      try {
        const data = await templateRequest('/api/settings/templates/active', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invoiceTemplate: templateId, quotationTemplate })
        });
        if (data.success) {
          if (window.SparkLoader && window.SparkLoader.toast) {
            window.SparkLoader.toast('Default Invoice template set to ' + templateId, 'success');
          }
          setTimeout(function() { window.location.reload(); }, 600);
        }
      } catch (err) { alert('Failed to update templates: ' + err.message); }
    });
  });

  document.querySelectorAll('.btn-set-quotation').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const templateId = this.getAttribute('data-template-id');
      const invoiceTemplate = document.getElementById('active-invoice-template-select').value;
      try {
        const data = await templateRequest('/api/settings/templates/active', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ invoiceTemplate, quotationTemplate: templateId })
        });
        if (data.success) {
          if (window.SparkLoader && window.SparkLoader.toast) {
            window.SparkLoader.toast('Default Quotation template set to ' + templateId, 'success');
          }
          setTimeout(function() { window.location.reload(); }, 600);
        }
      } catch (err) { alert('Failed to update templates: ' + err.message); }
    });
  });

  // 4. Template Editor Modal
  const btnOpenCreate = document.getElementById('btn-open-create-template');
  if (btnOpenCreate) {
    btnOpenCreate.addEventListener('click', function() {
      document.getElementById('templateEditorModalTitle').textContent = 'Create Custom Template';
      document.getElementById('editor-base-template').value = 'modern-minimal';
      const fontSelect=document.getElementById('editor-font-family');
      fontSelect.value='Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      fontSelect.tomselect?.setValue(fontSelect.value);
      document.getElementById('editor-template-id').value = '';
      document.getElementById('editor-name').value = '';
      document.getElementById('editor-category').value = 'Custom';
      document.getElementById('editor-description').value = '';
      document.getElementById('editor-accent-color').value = '#2563eb';
      document.getElementById('editor-accent-picker').value = '#2563eb';
      document.getElementById('editor-subtle-color').value = '#eff6ff';
      document.getElementById('editor-subtle-picker').value = '#eff6ff';
      document.getElementById('editor-custom-css').value = '';
      document.getElementById('editor-show-hsn').checked = true;
      document.getElementById('editor-show-upi').checked = true;
      document.getElementById('editor-show-discount').checked = true;
      document.getElementById('editor-show-unit').checked = true;

      if (window.openSparkModal) {
        window.openSparkModal('#templateEditorModal');
      } else {
        bootstrap.Modal.getOrCreateInstance(document.getElementById('templateEditorModal')).show();
      }
    });
  }

  document.querySelectorAll('.btn-edit-template').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const raw = this.getAttribute('data-template');
      if (!raw) return;
      try {
        const tpl = JSON.parse(raw);
        const isBuiltIn = tpl.isBuiltIn;
        document.getElementById('templateEditorModalTitle').textContent = isBuiltIn ? ('Duplicate & Customize: ' + tpl.name) : ('Edit Template: ' + tpl.name);
        const layoutSelect=document.getElementById('editor-base-template');
        layoutSelect.value=tpl.baseLayout || tpl.id;
        if(!layoutSelect.value)layoutSelect.value='modern-minimal';
        layoutSelect.tomselect?.setValue(layoutSelect.value);
        document.getElementById('editor-font-family').value='Montserrat, sans-serif';
        document.getElementById('editor-template-id').value = isBuiltIn ? '' : tpl.id;
        document.getElementById('editor-name').value = isBuiltIn ? (tpl.name + ' (Custom)') : tpl.name;
        document.getElementById('editor-category').value = tpl.category || 'Custom';
        document.getElementById('editor-description').value = tpl.description || '';
        document.getElementById('editor-accent-color').value = tpl.accentColor || '#2563eb';
        document.getElementById('editor-accent-picker').value = tpl.accentColor || '#2563eb';
        document.getElementById('editor-subtle-color').value = tpl.accentSubtle || '#eff6ff';
        document.getElementById('editor-subtle-picker').value = tpl.accentSubtle || '#eff6ff';
        document.getElementById('editor-custom-css').value = tpl.customCss || '';
        document.getElementById('editor-show-hsn').checked = tpl.showHsn !== false;
        document.getElementById('editor-show-upi').checked = tpl.showUpiQr !== false;
        document.getElementById('editor-show-discount').checked = tpl.showDiscount !== false;
        document.getElementById('editor-show-unit').checked = tpl.showUnit !== false;

        if (window.openSparkModal) {
          window.openSparkModal('#templateEditorModal');
        } else {
          bootstrap.Modal.getOrCreateInstance(document.getElementById('templateEditorModal')).show();
        }
      } catch (e) {
        console.error('Failed to parse template JSON', e);
      }
    });
  });

  const btnSaveCustom = document.getElementById('btn-save-custom-template');
  if (btnSaveCustom) {
    btnSaveCustom.addEventListener('click', async function() {
      const id = document.getElementById('editor-template-id').value;
      const name = document.getElementById('editor-name').value.trim();
      if (!name) {
        alert('Please specify a template name.');
        return;
      }

      const payload = {
        id: id || undefined,
        name: name,
        category: document.getElementById('editor-category').value.trim() || 'Custom',
        description: document.getElementById('editor-description').value.trim(),
        baseLayout: document.getElementById('editor-base-template').value,
        fontFamily: document.getElementById('editor-font-family').value,
        accentColor: document.getElementById('editor-accent-color').value.trim() || '#2563eb',
        accentSubtle: document.getElementById('editor-subtle-color').value.trim() || '#eff6ff',
        showHsn: document.getElementById('editor-show-hsn').checked,
        showUpiQr: document.getElementById('editor-show-upi').checked,
        showDiscount: document.getElementById('editor-show-discount').checked,
        showUnit: document.getElementById('editor-show-unit').checked,
        customCss: document.getElementById('editor-custom-css').value
      };

      if(this.disabled)return;this.disabled=true;
      try {
        const data = await templateRequest('/api/settings/templates/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (data.success) {
          if (window.SparkLoader && window.SparkLoader.toast) {
            window.SparkLoader.toast('Custom template "' + data.template.name + '" saved!', 'success');
          }
          setTimeout(function() { window.location.reload(); }, 600);
        } else {
          alert('Failed to save template: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Failed to save template: ' + err.message);
      } finally {this.disabled=false;}
    });
  }

  // 5. Delete Custom Template
  document.querySelectorAll('.btn-delete-template').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      const templateId = this.getAttribute('data-template-id');
      if (!confirm('Are you sure you want to delete this custom template?')) return;

      try {
        const data = await templateRequest('/api/settings/templates/' + encodeURIComponent(templateId), {
          method: 'DELETE'
        });
        if (data.success) {
          if (window.SparkLoader && window.SparkLoader.toast) {
            window.SparkLoader.toast('Template deleted successfully.', 'success');
          }
          setTimeout(function() { window.location.reload(); }, 600);
        } else {
          alert('Delete failed: ' + (data.error || 'Unknown error'));
        }
      } catch (err) {
        alert('Failed to delete template: ' + err.message);
      }
    });
  });

})();
</script>

<%- include('../layouts/footer',{extraJs:'<script src="/js/organization-logo.js"></script>'}) %>
