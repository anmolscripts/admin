<%- include('../layouts/header', { showPageHeader: false }) %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <div class="d-flex align-items-center gap-2">
        <a href="/financial-years" class="btn btn-sm btn-light border" title="Back to Financial Years">
          <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="page-title fw-bold mb-0">Financial Year <%= fy.code %></h1>
        <% if (fy.status === 'OPEN') { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
            <i class="bi bi-unlock-fill me-1"></i> OPEN
          </span>
        <% } else { %>
          <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
            <i class="bi bi-lock-fill me-1"></i> CLOSED
          </span>
        <% } %>
      </div>
      <p class="text-muted small mt-1 mb-0">
        <%= new Date(fy.startDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }) %>
        &mdash;
        <%= new Date(fy.endDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'long', year: 'numeric' }) %>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if (fy.status === 'OPEN') { %>
        <a href="/financial-years/<%= fy.id %>/close-preview" class="btn btn-danger d-inline-flex align-items-center gap-2">
          <i class="bi bi-lock-fill"></i>
          <span>Close Financial Year</span>
        </a>
        <a href="/financial-years/<%= fy.id %>/opening-balances" class="btn btn-outline-primary d-inline-flex align-items-center gap-2">
          <i class="bi bi-arrow-right-circle"></i>
          <span>Initial Opening Balances</span>
        </a>
      <% } else { %>
        <button type="button" class="btn btn-warning d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#reopenModal">
          <i class="bi bi-unlock"></i>
          <span>Reopen Financial Year</span>
        </button>
      <% } %>
      <a href="/reports/general-ledger?financialYearId=<%= fy.id %>" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-book"></i>
        <span>General Ledger</span>
      </a>
    </div>
  </div>

  <!-- Metric Overview Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
      <div class="card border-0 shadow-sm p-3">
        <div class="text-muted small mb-1">Journal Entries</div>
        <div class="fs-4 fw-bold"><%= (fy._count ? fy._count.journalEntries : 0) %></div>
        <div class="text-muted small">Total ledger postings</div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card border-0 shadow-sm p-3">
        <div class="text-muted small mb-1">Sales Invoices</div>
        <div class="fs-4 fw-bold"><%= (fy._count ? fy._count.invoices : 0) %></div>
        <div class="text-muted small">Billing documents</div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card border-0 shadow-sm p-3">
        <div class="text-muted small mb-1">Payments Recorded</div>
        <div class="fs-4 fw-bold"><%= (fy._count ? fy._count.payments : 0) %></div>
        <div class="text-muted small">Collections</div>
      </div>
    </div>
    <div class="col-sm-6 col-md-3">
      <div class="card border-0 shadow-sm p-3">
        <div class="text-muted small mb-1">Credit / Debit Notes</div>
        <div class="fs-4 fw-bold"><%= (fy._count ? fy._count.creditDebitNotes : 0) %></div>
        <div class="text-muted small">Adjustments</div>
      </div>
    </div>
  </div>

  <!-- Closing Journal Details (if CLOSED) -->
  <% if (fy.status === 'CLOSED' && closingJournal) { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <div>
          <h5 class="card-title fw-bold mb-1">
            <i class="bi bi-journal-check text-primary me-2"></i>Year-End Closing Journal Entry
          </h5>
          <span class="text-muted small">Journal Number: <strong class="font-monospace"><%= closingJournal.entryNumber %></strong></span>
        </div>
        <span class="badge bg-secondary-subtle text-secondary border px-3 py-2">
          Posted on <%= new Date(closingJournal.postedAt).toLocaleString('en-IN') %>
        </span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="width: 50px;">#</th>
                <th>Account Code</th>
                <th>Account Name</th>
                <th>Type</th>
                <th class="text-end" style="width: 150px;">Debit (₹)</th>
                <th class="text-end" style="width: 150px;">Credit (₹)</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <% closingJournal.lines.forEach(line => { %>
                <tr>
                  <td class="text-muted small"><%= line.lineNumber %></td>
                  <td class="font-monospace fw-bold"><%= line.account.code %></td>
                  <td><%= line.account.name %></td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= line.account.type %></span>
                  </td>
                  <td class="text-end font-monospace <%= Number(line.debit) > 0 ? 'fw-bold' : 'text-muted' %>">
                    <%= Number(line.debit) > 0 ? Number(line.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="text-end font-monospace <%= Number(line.credit) > 0 ? 'fw-bold' : 'text-muted' %>">
                    <%= Number(line.credit) > 0 ? Number(line.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                  </td>
                  <td class="small text-muted"><%= line.description || '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Audit Activity History -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
      <h5 class="card-title fw-bold mb-0">
        <i class="bi bi-clock-history text-secondary me-2"></i>Audit & Activity History
      </h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Timestamp</th>
              <th>Action</th>
              <th>Actor</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% if (activities.length === 0) { %>
              <tr>
                <td colspan="4" class="text-center py-4 text-muted">
                  No lifecycle activity recorded for this period yet.
                </td>
              </tr>
            <% } else { %>
              <% activities.forEach(act => { %>
                <tr>
                  <td class="small text-muted">
                    <%= new Date(act.createdAt).toLocaleString('en-IN') %>
                  </td>
                  <td>
                    <span class="badge <%= act.action === 'CLOSE_FINANCIAL_YEAR' ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %>">
                      <%= act.action %>
                    </span>
                  </td>
                  <td class="small">
                    <%= act.actorUser ? act.actorUser.name : 'System' %>
                  </td>
                  <td class="small text-muted">
                    <% if (act.metadata) { %>
                      <code><%= JSON.stringify(act.metadata) %></code>
                    <% } else { %>
                      —
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal for Reopening Financial Year -->
<% if (fy.status === 'CLOSED') { %>
<div class="modal fade" id="reopenModal" tabindex="-1" aria-labelledby="reopenModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/financial-years/<%= fy.id %>/reopen" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header">
          <h5 class="modal-title text-warning" id="reopenModalLabel">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>Reopen Financial Year <%= fy.code %>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="text-dark small">
            Reopening this Financial Year will post an immutable <strong>Reversal Journal Entry</strong> cancelling the year-end closing journal, restore the nominal account balances, and transition the period status back to <strong>OPEN</strong>.
          </p>
          <div class="alert alert-warning py-2 small mb-3">
            <strong>Requirement:</strong> No subsequent Financial Year may be closed. If subsequent years are closed, they must be reopened first in reverse chronological order.
          </div>
          <div class="mb-3">
            <label for="reopenReason" class="form-label small fw-bold">Mandatory Reason for Reopening</label>
            <textarea class="form-control form-control-sm" id="reopenReason" name="reason" rows="3" placeholder="Provide an audit justification for reopening this closed year..." required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning">Confirm and Reopen Period</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('../layouts/footer') %>
