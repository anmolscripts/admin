<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= pageTitle %></h1>
      <p class="text-muted small mb-0"><%= pageSubtitle %></p>
    </div>
    <div class="d-flex gap-2">
      <a href="/reports" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
        <i class="bi bi-bar-chart-line"></i>
        <span>Financial Reports</span>
      </a>
    </div>
  </div>

  <!-- Information Alert -->
  <div class="card border-0 bg-primary bg-opacity-10 mb-4">
    <div class="card-body p-3 d-flex align-items-start gap-3">
      <i class="bi bi-info-circle-fill text-primary fs-4 mt-1"></i>
      <div>
        <h6 class="fw-bold text-primary mb-1">Financial Year Closing & Period Locking Rules</h6>
        <p class="text-dark small mb-0">
          Closing a Financial Year immutably zeroes nominal Income and Expense accounts for that period and transfers net operating profit or loss to Retained Earnings (Account 3120).
          Once a year is marked <strong>CLOSED</strong>, period locking strictly blocks new invoices, payments, credit/debit notes, and journal entries from entering the closed period.
        </p>
      </div>
    </div>
  </div>

  <!-- Financial Years Table -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="card-title fw-bold mb-0">Configured Financial Years</h5>
      <span class="badge bg-light text-muted border"><%= financialYears.length %> period(s)</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>FY Code</th>
            <th>Date Range</th>
            <th>Status</th>
            <th>Transactions</th>
            <th>Current Period</th>
            <th>Closed Details</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (financialYears.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                No Financial Years configured.
              </td>
            </tr>
          <% } else { %>
            <% financialYears.forEach(fy => { %>
              <tr>
                <td class="fw-bold font-monospace">
                  <a href="/financial-years/<%= fy.id %>" class="text-decoration-none">
                    <%= fy.code %>
                  </a>
                </td>
                <td class="small">
                  <%= new Date(fy.startDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                  <span class="text-muted mx-1">to</span>
                  <%= new Date(fy.endDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </td>
                <td>
                  <% if (fy.status === 'OPEN') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                      <i class="bi bi-unlock-fill me-1"></i> OPEN
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                      <i class="bi bi-lock-fill me-1"></i> CLOSED
                    </span>
                  <% } %>
                </td>
                <td class="small">
                  <span class="badge bg-light text-dark border">
                    <%= (fy._count ? fy._count.journalEntries : 0) %> journals
                  </span>
                </td>
                <td>
                  <% if (fy.isCurrent) { %>
                    <span class="badge bg-primary text-white">Current</span>
                  <% } else { %>
                    <span class="text-muted small">—</span>
                  <% } %>
                </td>
                <td class="small text-muted">
                  <% if (fy.status === 'CLOSED' && fy.closedAt) { %>
                    <div><%= new Date(fy.closedAt).toLocaleDateString('en-IN') %></div>
                    <div class="small"><%= fy.closedBy ? fy.closedBy.name : 'System' %></div>
                  <% } else { %>
                    <span>—</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="btn-group btn-group-sm">
                    <a href="/financial-years/<%= fy.id %>" class="btn btn-outline-secondary" title="View Period Details">
                      <i class="bi bi-eye"></i> View
                    </a>
                    <% if (fy.status === 'OPEN') { %>
                      <a href="/financial-years/<%= fy.id %>/close-preview" class="btn btn-outline-danger" title="Preview and Close Year">
                        <i class="bi bi-lock"></i> Close Year
                      </a>
                      <a href="/financial-years/<%= fy.id %>/opening-balances" class="btn btn-outline-primary" title="Opening Balances">
                        <i class="bi bi-arrow-right-circle"></i> Opening Balances
                      </a>
                    <% } else { %>
                      <a href="/financial-years/<%= fy.id %>" class="btn btn-outline-warning" title="Manage Closed Year">
                        <i class="bi bi-shield-lock"></i> Closed Record
                      </a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
