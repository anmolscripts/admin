<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <div class="d-flex align-items-center gap-2">
        <a href="/financial-years/<%= preview.financialYear.id %>" class="btn btn-sm btn-light border" title="Back">
          <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 fw-bold mb-0">Year-End Close Preview — FY <%= preview.financialYear.code %></h1>
      </div>
      <p class="text-muted small mt-1 mb-0">
        Review nominal account balances, calculated net profit/loss, and proposed closing journal before final execution.
      </p>
    </div>
    <div>
      <% if (preview.canClose) { %>
        <button type="button" class="btn btn-danger d-inline-flex align-items-center gap-2 px-3 py-2" data-bs-toggle="modal" data-bs-target="#confirmCloseModal">
          <i class="bi bi-lock-fill"></i>
          <span>Confirm & Execute Close</span>
        </button>
      <% } else { %>
        <button type="button" class="btn btn-secondary px-3 py-2" disabled>
          <i class="bi bi-slash-circle me-1"></i> Close Blocked
        </button>
      <% } %>
    </div>
  </div>

  <!-- Blockers & Warnings -->
  <% if (preview.blockers.length > 0) { %>
    <div class="alert alert-danger mb-4 shadow-sm">
      <div class="d-flex align-items-center gap-2 mb-2">
        <i class="bi bi-x-octagon-fill fs-5"></i>
        <h6 class="fw-bold mb-0">Closure Blockers Detected</h6>
      </div>
      <ul class="mb-0 ps-3 small">
        <% preview.blockers.forEach(b => { %>
          <li><%= b %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <% if (preview.warnings.length > 0) { %>
    <div class="alert alert-warning mb-4 shadow-sm">
      <div class="d-flex align-items-center gap-2 mb-1">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <h6 class="fw-bold mb-0">Warnings</h6>
      </div>
      <ul class="mb-0 ps-3 small">
        <% preview.warnings.forEach(w => { %>
          <li><%= w %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <!-- Financial Summary Banner -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row g-4 align-items-center">
        <div class="col-md-3 border-end">
          <div class="text-muted small mb-1">Total Operating Revenue</div>
          <div class="fs-4 fw-bold text-success font-monospace">
            ₹<%= Number(preview.totals.totalIncome).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </div>
          <div class="text-muted small">Nominal Income accounts</div>
        </div>
        <div class="col-md-3 border-end">
          <div class="text-muted small mb-1">Total Operating Expenses</div>
          <div class="fs-4 fw-bold text-danger font-monospace">
            ₹<%= Number(preview.totals.totalExpense).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </div>
          <div class="text-muted small">Nominal Expense accounts</div>
        </div>
        <div class="col-md-3 border-end">
          <div class="text-muted small mb-1">Net Operating Result</div>
          <div class="fs-4 fw-bold font-monospace <%= preview.totals.isProfit ? 'text-primary' : (preview.totals.isLoss ? 'text-danger' : 'text-muted') %>">
            ₹<%= Number(preview.totals.netProfitOrLoss).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
          </div>
          <div class="small fw-semibold">
            <% if (preview.totals.isProfit) { %>
              <span class="text-success"><i class="bi bi-arrow-up-circle me-1"></i> Net Profit</span>
            <% } else if (preview.totals.isLoss) { %>
              <span class="text-danger"><i class="bi bi-arrow-down-circle me-1"></i> Net Loss</span>
            <% } else { %>
              <span class="text-muted">Break Even (₹0.00)</span>
            <% } %>
          </div>
        </div>
        <div class="col-md-3">
          <div class="text-muted small mb-1">Retained Earnings Transfer</div>
          <div class="fs-5 fw-bold font-monospace">
            <%= preview.retainedEarningsAccount ? preview.retainedEarningsAccount.code : '3120' %>
          </div>
          <div class="small">
            Action: <strong><%= preview.retainedEarningsAccount ? preview.retainedEarningsAccount.action : 'NONE' %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Proposed Closing Journal Lines Table -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <div>
        <h5 class="card-title fw-bold mb-0">Proposed Closing Journal Entries</h5>
        <span class="text-muted small">Deterministic double-entry closing journal to zero nominal accounts</span>
      </div>
      <div>
        <% if (preview.closingJournal.isBalanced) { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 font-monospace">
            <i class="bi bi-check-circle me-1"></i> Balanced: Debit = Credit (₹<%= Number(preview.closingJournal.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>)
          </span>
        <% } else { %>
          <span class="badge bg-danger text-white px-3 py-2 font-monospace">
            <i class="bi bi-exclamation-triangle me-1"></i> Unbalanced Journal
          </span>
        <% } %>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 40px;">#</th>
            <th>Account Code</th>
            <th>Account Name</th>
            <th>Type</th>
            <th class="text-end" style="width: 160px;">Debit (₹)</th>
            <th class="text-end" style="width: 160px;">Credit (₹)</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <% if (preview.closingJournal.lines.length === 0) { %>
            <tr>
              <td colspan="7" class="text-center py-4 text-muted">
                No nominal movements recorded for this Financial Year. A zero-movement period can be closed directly.
              </td>
            </tr>
          <% } else { %>
            <% preview.closingJournal.lines.forEach((line, idx) => { %>
              <tr>
                <td class="text-muted small"><%= idx + 1 %></td>
                <td class="font-monospace fw-bold"><%= line.accountCode %></td>
                <td><%= line.accountName %></td>
                <td>
                  <span class="badge bg-light text-dark border"><%= line.accountType %></span>
                </td>
                <td class="text-end font-monospace <%= Number(line.debit) > 0 ? 'fw-bold' : 'text-muted' %>">
                  <%= Number(line.debit) > 0 ? Number(line.debit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="text-end font-monospace <%= Number(line.credit) > 0 ? 'fw-bold' : 'text-muted' %>">
                  <%= Number(line.credit) > 0 ? Number(line.credit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) : '—' %>
                </td>
                <td class="small text-muted"><%= line.description %></td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
        <tfoot class="table-light fw-bold font-monospace">
          <tr>
            <td colspan="4" class="text-end">Total:</td>
            <td class="text-end">₹<%= Number(preview.closingJournal.totalDebit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
            <td class="text-end">₹<%= Number(preview.closingJournal.totalCredit).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<!-- Modal: Confirm Year-End Closure -->
<% if (preview.canClose) { %>
<div class="modal fade" id="confirmCloseModal" tabindex="-1" aria-labelledby="confirmCloseModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/financial-years/<%= preview.financialYear.id %>/close" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title" id="confirmCloseModalLabel">
            <i class="bi bi-shield-lock me-2"></i>Confirm Year-End Closing for FY <%= preview.financialYear.code %>
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-warning py-2 small mb-3">
            <strong>Warning: Period Locking will take effect immediately.</strong>
            New invoices, payments, credit/debit notes, and journal entries with dates in FY <%= preview.financialYear.code %> will be strictly rejected.
          </div>
          <p class="text-dark small mb-2">
            The following actions will be executed atomically:
          </p>
          <ul class="small mb-3">
            <li>Generate an immutable <strong>Closing Journal Entry</strong> dated <%= new Date(preview.financialYear.endDate).toLocaleDateString('en-IN') %>.</li>
            <li>Zero out all nominal Income and Expense accounts for this Financial Year.</li>
            <li>Transfer net result of <strong>₹<%= Number(preview.totals.netProfitOrLoss).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></strong> to Retained Earnings (Account 3120).</li>
            <li>Mark Financial Year status as <strong>CLOSED</strong>.</li>
          </ul>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="confirmUnderstand" required>
            <label class="form-check-label small" for="confirmUnderstand">
              I understand that this action closes the accounting period and locks all posting paths into FY <%= preview.financialYear.code %>.
            </label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Confirm & Close Period</button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>

<%- include('../layouts/footer') %>
