<%- include('../layouts/header',{extraCss:'<link rel="stylesheet" href="/libs/quill/quill.snow.css"><link rel="stylesheet" href="/css/letters.css">'}) %>
<form id="letter-form" class="letter-compose" data-letter-id="<%= letter?.id||'' %>" data-version="<%= letter?.version||'' %>" data-editor-mode="<%= letter?.editorMode||'RICH' %>">
 <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4"><a class="btn btn-outline-secondary" href="<%= letter?.id?'/documents/letters/'+letter.id:'/documents/letters' %>">Back to Letters</a><div class="d-flex flex-wrap gap-2"><button type="button" id="letter-preview-btn" class="btn btn-outline-primary"><i class="bi bi-eye me-2"></i>Preview</button><button type="submit" class="btn btn-primary" id="letter-save"><i class="bi bi-check2-circle me-2"></i>Save Letter</button></div></div>
 <div class="card card-glass mb-4"><div class="card-body"><div class="row g-3">
  <div class="col-md-8"><label class="form-label" for="letter-subject">Subject <span class="text-danger">*</span></label><input id="letter-subject" class="form-control" name="subject" value="<%= letter?.subject||'' %>" maxlength="255" required></div>
  <div class="col-md-4"><label class="form-label" for="letter-date">Letter date <span class="text-danger">*</span></label><input id="letter-date" class="form-control" type="date" name="letterDate" value="<%= letter?.letterDate?letter.letterDate.toISOString().slice(0,10):new Date().toLocaleDateString('en-CA',{timeZone:'Asia/Kolkata'}) %>" required></div>
  <div class="col-md-6"><label class="form-label" for="letter-recipient">Recipient <span class="text-danger">*</span></label><input id="letter-recipient" class="form-control" name="recipientName" value="<%= letter?.recipientName||'' %>" maxlength="255" required></div>
  <div class="col-md-6"><label class="form-label" for="letter-template">Document template</label><select id="letter-template" class="form-select" name="templateId"><% for(const t of templates){ %><option value="<%= t.id %>" <%= (letter?.templateId||defaultTemplate)===t.id?'selected':'' %>><%= t.name %></option><% } %></select></div>
  <div class="col-12"><label class="form-label" for="letter-address">Recipient address <span class="text-muted">(optional)</span></label><textarea id="letter-address" class="form-control" name="recipientAddress" rows="2" maxlength="5000"><%= letter?.recipientAddress||'' %></textarea></div>
 </div></div></div>
 <div class="card card-glass letter-workspace" id="letter-workspace"><div class="card-body p-0">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 p-3 border-bottom"><div><strong>Letter content</strong><p class="small text-muted mb-0">Content flows onto additional A4 pages automatically. Preview to check page breaks.</p></div><div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-undo" aria-label="Undo">Undo</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-redo" aria-label="Redo">Redo</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-page-break">Insert page break</button></div></div>
  <div class="d-flex flex-wrap justify-content-between gap-2 px-3 py-2 border-bottom"><div class="nav nav-pills gap-2" role="tablist" aria-label="Editing mode"><button type="button" class="nav-link active" id="letter-rich-tab" role="tab" aria-selected="true" aria-controls="letter-rich-panel"><i class="bi bi-fonts me-1"></i>Rich Text</button><button type="button" class="nav-link" id="letter-code-tab" role="tab" aria-selected="false" aria-controls="letter-code-panel"><i class="bi bi-code-slash me-1"></i>HTML &amp; CSS</button></div><div class="d-flex gap-2"><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-find">Find / Replace</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-fullscreen">Fullscreen</button></div></div>
  <div id="letter-rich-panel" role="tabpanel" aria-labelledby="letter-rich-tab">
  <div id="letter-toolbar" aria-label="Letter formatting">
   <span class="ql-formats"><select class="ql-header" data-no-tomselect="true" aria-label="Heading"><option selected></option><% for(let n=1;n<=6;n++){ %><option value="<%= n %>">Heading <%= n %></option><% } %></select><select class="ql-font" data-no-tomselect="true" aria-label="Font"><option selected>Sans Serif</option><option value="serif">Serif</option><option value="monospace">Monospace</option></select><select class="ql-size" data-no-tomselect="true" aria-label="Text size"><% for(const size of ['10px','12px','14px','16px','18px','20px','24px','28px','32px','40px','48px']){ %><option value="<%= size %>" <%= size==='16px'?'selected':'' %>><%= size %></option><% } %></select></span>
   <span class="ql-formats"><button type="button" class="ql-bold" aria-label="Bold"></button><button type="button" class="ql-italic" aria-label="Italic"></button><button type="button" class="ql-underline" aria-label="Underline"></button><button type="button" class="ql-strike" aria-label="Strikethrough"></button></span>
   <span class="ql-formats"><select class="ql-color" data-no-tomselect="true" aria-label="Text color"></select><select class="ql-background" data-no-tomselect="true" aria-label="Highlight color"></select><select class="ql-align" data-no-tomselect="true" aria-label="Alignment"></select><button type="button" class="ql-list" value="ordered" aria-label="Numbered list"></button><button type="button" class="ql-list" value="bullet" aria-label="Bullet list"></button><button type="button" class="ql-list" value="check" aria-label="Checklist"></button><button type="button" class="ql-indent" value="-1" aria-label="Decrease indent"></button><button type="button" class="ql-indent" value="+1" aria-label="Increase indent"></button></span>
   <span class="ql-formats"><button type="button" class="ql-script" value="sub" aria-label="Subscript"></button><button type="button" class="ql-script" value="super" aria-label="Superscript"></button><button type="button" class="ql-blockquote" aria-label="Quote"></button><button type="button" class="ql-code" aria-label="Inline code"></button><button type="button" class="ql-code-block" aria-label="Code block"></button><button type="button" class="ql-link" aria-label="Link"></button><button type="button" class="ql-clean" aria-label="Clear formatting"></button></span>
  </div>
  <div class="d-flex flex-wrap gap-2 px-3 py-2 border-bottom" aria-label="Table tools"><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-insert-table">Insert Table</button><button type="button" class="btn btn-sm btn-outline-secondary" data-table-action="insertRowBelow">Add Row</button><button type="button" class="btn btn-sm btn-outline-secondary" data-table-action="insertColumnRight">Add Column</button><button type="button" class="btn btn-sm btn-outline-danger" data-table-action="deleteRow">Remove Row</button><button type="button" class="btn btn-sm btn-outline-danger" data-table-action="deleteColumn">Remove Column</button><button type="button" class="btn btn-sm btn-outline-danger" data-table-action="deleteTable">Remove Table</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-horizontal-rule">Horizontal Rule</button></div>
  <div id="letter-editor" aria-label="Letter content"></div><textarea id="letter-initial" hidden><%= letter?.bodyHtml||'<p>Dear Sir / Madam,</p><p><br></p><p>Yours sincerely,</p>' %></textarea>
  </div>
  <div id="letter-code-panel" role="tabpanel" aria-labelledby="letter-code-tab" hidden>
   <div class="alert alert-info m-3 mb-2 small">Write HTML and CSS for the <strong>letter content only</strong>. CSS cannot change the application, letterhead or footer. Scripts, remote resources, global CSS rules and fixed/sticky positioning are blocked.</div>
   <div class="d-flex flex-wrap align-items-center gap-2 px-3 py-2"><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-format-code">Format Code</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-rename-tag">Rename Tag (F2)</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-select-tags">Select Tag Pair</button><button type="button" class="btn btn-sm btn-outline-danger" id="letter-remove-tag">Remove Tag Pair</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-command-palette">Commands (F1)</button><button type="button" class="btn btn-sm btn-outline-secondary" id="letter-wrap-code" aria-pressed="true">Word Wrap</button><span class="small text-muted" id="letter-code-status" aria-live="polite">Loading code tools when opened…</span></div>
   <div class="row g-3 px-3 pb-3"><section class="col-lg-6"><h3 class="fs-6">HTML</h3><div id="letter-html-code" class="letter-code-editor" aria-label="HTML code editor"></div><textarea class="form-control letter-code-fallback" id="letter-html-source" aria-label="HTML source"><%= letter?.bodyHtml||'<p>Dear Sir / Madam,</p><p><br></p><p>Yours sincerely,</p>' %></textarea></section><section class="col-lg-6"><h3 class="fs-6">CSS <span class="small text-muted">(scoped to content)</span></h3><div id="letter-css-code" class="letter-code-editor" aria-label="CSS code editor"></div><textarea class="form-control letter-code-fallback" id="letter-css-source" aria-label="CSS source" placeholder="p { line-height: 1.8; }"><%= letter?.bodyCss||'' %></textarea></section></div>
   <div class="d-flex justify-content-between align-items-center gap-2 border-top px-3 py-2"><strong>Content Preview</strong><span id="letter-live-status" class="small text-muted" role="status">Preview updates as you type. Nothing is saved.</span><button type="button" class="btn btn-sm btn-outline-primary" id="letter-refresh-code-preview">Refresh</button></div><div class="px-3 pb-3"><iframe id="letter-code-preview" class="letter-content-preview" sandbox="allow-same-origin" title="Isolated HTML and CSS content preview"></iframe></div>
   <p class="small text-muted px-3">Ctrl+Space: suggestions · Shift+Alt+F: format · Ctrl+F / Ctrl+H: find / replace · Ctrl+/: comment · Alt+Click: multiple cursors. Tag names update together; deleting a complete tag removes its matching partner.</p>
  </div>
  <div class="small text-muted p-3 border-top" id="letter-word-count" aria-live="polite">Write your letter above.</div>
 </div></div>
</form>
<div class="modal fade" id="letter-preview-modal" tabindex="-1" aria-labelledby="letter-preview-title"><div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="letter-preview-title">Letter Preview</h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body p-0"><iframe id="letter-preview-frame" title="Unsaved letter preview" sandbox="allow-same-origin" class="letter-preview-frame"></iframe></div><div class="modal-footer"><span class="small text-muted me-auto">Unsaved preview. Use Print or PDF after saving to see final pagination.</span><button class="btn btn-outline-secondary" data-bs-dismiss="modal" type="button">Close</button></div></div></div></div>
<%- include('../layouts/footer',{extraJs:'<script src="/libs/quill/quill.js"></script><script src="/js/letter-code-tools.js"></script><script src="/libs/monaco/vs/loader.js"></script><script src="/js/letter-source-editor.js"></script><script src="/js/letters.js"></script>'}) %>
