<%- include('../layouts/header') %>

<div class="content-wrapper p-4">
  <!-- Page Header -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h1 class="h3 fw-bold mb-1">Multi-Business Organizations</h1>
      <p class="text-muted small mb-0">Platform Administration: Manage legal entities, workspaces, and team memberships.</p>
    </div>
    <div>
      <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createBusinessModal">
        <i class="bi bi-plus-lg"></i>
        <span>Create New Organization</span>
      </button>
    </div>
  </div>

  <% if (locals.success) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="bi bi-check-circle me-1"></i> <%= locals.success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <!-- Businesses Table -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="fw-bold mb-0">Registered Business Workspaces (<%= businesses.length %>)</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Display Name</th>
            <th>Legal Name</th>
            <th>GSTIN</th>
            <th>Currency</th>
            <th>Status</th>
            <th>Members</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% businesses.forEach(b => { %>
            <tr>
              <td class="text-muted small">#<%= b.id %></td>
              <td>
                <div class="fw-bold text-dark"><%= b.name %></div>
                <small class="text-muted">Slug: <%= b.slug %></small>
              </td>
              <td><%= b.legalName || '-' %></td>
              <td><code><%= b.gstin || '-' %></code></td>
              <td><span class="badge bg-light text-dark border"><%= b.currency || 'INR' %></span></td>
              <td>
                <% if (b.status === 'ACTIVE') { %>
                  <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                <% } else if (b.status === 'SUSPENDED') { %>
                  <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Suspended</span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary border"><%= b.status %></span>
                <% } %>
              </td>
              <td>
                <span class="badge bg-info-subtle text-info border border-info-subtle">
                  <%= b._count ? b._count.memberships : (b.memberships ? b.memberships.length : 0) %> members
                </span>
              </td>
              <td class="text-end">
                <form action="/switch-business" method="POST" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="businessId" value="<%= b.id %>">
                  <button type="submit" class="btn btn-sm btn-outline-primary" title="Switch into this workspace">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Switch
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Create Business Modal -->
<div class="modal fade" id="createBusinessModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold">Create New Business Workspace</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/api/businesses/create" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Workspace Display Name *</label>
            <input type="text" name="name" class="form-control" placeholder="e.g. Acme Retailers" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Legal / Registered Name</label>
            <input type="text" name="legalName" class="form-control" placeholder="e.g. Acme Retailers Private Limited">
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label small fw-semibold">Currency Code</label>
              <input type="text" name="currency" class="form-control" value="INR" maxlength="3">
            </div>
            <div class="col-6">
              <label class="form-label small fw-semibold">Timezone</label>
              <input type="text" name="timezone" class="form-control" value="Asia/Kolkata">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">GSTIN (Optional)</label>
            <input type="text" name="gstin" class="form-control" placeholder="15-character GSTIN" maxlength="15">
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Workspace</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
