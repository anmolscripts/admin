<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set Password - Spark Admin</title>

    <meta name="description" content="Set up your account password to access Spark Admin">
    <link rel="icon" type="image/png" href="/images/favicon.ico">

    <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/main.css">
</head>

<body>

    <div class="login-wrapper">
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>

        <div class="login-card" style="max-width: 480px;">

            <a href="/" class="login-brand text-decoration-none">
                <i class="bi bi-asterisk"></i>
                <span>Spark Admin</span>
            </a>

            <h4 class="fw-bold text-center mt-2 mb-1">Welcome, <%= locals.user ? locals.user.name : 'Team Member' %></h4>
            <p class="login-subtitle mb-4">Set a secure password to activate your account</p>

            <% if (locals.error) { %>
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-circle me-1"></i> <%= error %>
                </div>
            <% } %>

            <form action="/invite/<%= locals.token %>" method="POST" id="setupPasswordForm" class="needs-validation" novalidate>
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">

                <div class="login-form-group mb-3">
                    <label class="login-form-label">Email Address</label>
                    <div class="login-input-group">
                        <i class="bi bi-envelope input-icon"></i>
                        <input type="email" class="login-input" value="<%= locals.user ? locals.user.email : '' %>" readonly disabled style="background-color: #f8fafc; color: #64748b;">
                    </div>
                </div>

                <div class="login-form-group mb-3">
                    <label for="password" class="login-form-label">New Password</label>
                    <div class="login-input-group">
                        <i class="bi bi-lock input-icon"></i>
                        <input type="password" name="password" id="password" class="login-input" placeholder="Create a strong password" required minlength="8" autocomplete="new-password">
                        <button type="button" class="btn-toggle-password" id="togglePasswordBtn" aria-label="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="login-form-group mb-3">
                    <label for="confirmPassword" class="login-form-label">Confirm Password</label>
                    <div class="login-input-group">
                        <i class="bi bi-shield-check input-icon"></i>
                        <input type="password" name="confirmPassword" id="confirmPassword" class="login-input" placeholder="Repeat your password" required autocomplete="new-password">
                    </div>
                </div>

                <!-- Password Rules Checklist -->
                <div class="card bg-light border-0 p-3 mb-4 rounded-3 text-start">
                    <div class="fw-semibold small text-muted mb-2">Password Requirements:</div>
                    <ul class="list-unstyled mb-0 small text-secondary">
                        <li id="req-length" class="mb-1"><i class="bi bi-dash-circle me-1 text-muted"></i> At least 8 characters</li>
                        <li id="req-upper" class="mb-1"><i class="bi bi-dash-circle me-1 text-muted"></i> At least one uppercase letter (A-Z)</li>
                        <li id="req-lower" class="mb-1"><i class="bi bi-dash-circle me-1 text-muted"></i> At least one lowercase letter (a-z)</li>
                        <li id="req-number" class="mb-1"><i class="bi bi-dash-circle me-1 text-muted"></i> At least one number (0-9)</li>
                        <li id="req-match"><i class="bi bi-dash-circle me-1 text-muted"></i> Passwords must match</li>
                    </ul>
                </div>

                <button type="submit" class="btn-login w-100" id="btnSubmit">
                    <i class="bi bi-check-circle me-1"></i> Activate Account & Sign In
                </button>
            </form>

        </div>
    </div>

    <script>
        const pwdInput = document.getElementById('password');
        const confirmInput = document.getElementById('confirmPassword');
        const toggleBtn = document.getElementById('togglePasswordBtn');

        toggleBtn.addEventListener('click', () => {
            const isPassword = pwdInput.type === 'password';
            pwdInput.type = isPassword ? 'text' : 'password';
            toggleBtn.querySelector('i').className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
        });

        function updateCheck(elId, valid) {
            const el = document.getElementById(elId);
            if (!el) return;
            const icon = el.querySelector('i');
            if (valid) {
                icon.className = 'bi bi-check-circle-fill me-1 text-success';
                el.classList.add('text-success');
                el.classList.remove('text-secondary');
            } else {
                icon.className = 'bi bi-dash-circle me-1 text-muted';
                el.classList.remove('text-success');
                el.classList.add('text-secondary');
            }
        }

        function validateLive() {
            const p = pwdInput.value || '';
            const c = confirmInput.value || '';

            updateCheck('req-length', p.length >= 8);
            updateCheck('req-upper', /[A-Z]/.test(p));
            updateCheck('req-lower', /[a-z]/.test(p));
            updateCheck('req-number', /[0-9]/.test(p));
            updateCheck('req-match', p.length >= 8 && p === c);
        }

        pwdInput.addEventListener('input', validateLive);
        confirmInput.addEventListener('input', validateLive);
    </script>
</body>
</html>
