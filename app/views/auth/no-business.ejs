<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>No Workspace Access - Spark Admin ERP</title>
    <link rel="icon" type="image/png" href="/images/favicon.ico">
    <link rel="stylesheet" href="/libs/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/libs/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/theme.css">
    <link rel="stylesheet" href="/css/premium-refresh.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('spark-theme');
                var theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>
</head>
<body>
    <div class="login-wrapper">
        <div class="login-bg-shape login-bg-shape-1"></div>
        <div class="login-bg-shape login-bg-shape-2"></div>

        <div class="login-card text-center" style="max-width: 480px;">
            <div class="login-brand text-decoration-none justify-content-center mb-3">
                <i class="bi bi-shield-lock text-warning fs-1"></i>
            </div>

            <h4 class="fw-bold mb-2">No Active Business Access</h4>
            <p class="text-muted mb-4">
                Your account does not currently have an active membership assigned to any organization. Please contact your system administrator to be invited or assigned to a business workspace.
            </p>

            <div class="d-grid gap-2">
                <a href="/login" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-clockwise me-1"></i> Check Again
                </a>
                <a href="/logout" class="btn btn-secondary">
                    Sign Out
                </a>
            </div>
        </div>
    </div>
</body>
</html>
