<%
  const headerActionHtml = `
    <button type="button" class="btn btn-primary" id="btn-new-item" data-bs-toggle="modal" data-bs-target="#modal-item-form" onclick="openCreateItemModal()">
      <i class="bi bi-plus-lg me-1"></i>
      <span>New Item</span>
    </button>
  `;
%>

<%- include('../layouts/header', {
    pageTitle: 'Item Master',
    pageSubtitle: 'Manage standard product catalog, services, default units, and baseline rates.',
    headerAction: headerActionHtml
}) %>

<!-- Search and Filter Bar -->
<section class="card border-0 shadow-sm rounded-3 p-3 mb-4 bg-white" aria-label="Item Filters">
  <form method="GET" action="/items" class="row g-2 align-items-center">
    <div class="col-12 col-md-6 col-lg-5">
      <div class="input-group">
        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input
          type="search"
          name="search"
          class="form-control bg-light border-start-0"
          placeholder="Search by item name, description, or HSN/SAC..."
          value="<%= locals.search || '' %>"
          aria-label="Search items"
        />
      </div>
    </div>
    <div class="col-6 col-md-3 col-lg-3">
      <select name="active" class="form-select" aria-label="Filter by status">
        <option value="" <%= locals.active === undefined || locals.active === '' ? 'selected' : '' %>>All Statuses</option>
        <option value="true" <%= locals.active === 'true' ? 'selected' : '' %>>Active Only</option>
        <option value="false" <%= locals.active === 'false' ? 'selected' : '' %>>Inactive Only</option>
      </select>
    </div>
    <div class="col-6 col-md-3 col-lg-2">
      <button type="submit" class="btn btn-secondary w-100">
        <i class="bi bi-funnel me-1"></i> Filter
      </button>
    </div>
    <% if (locals.search || (locals.active !== undefined && locals.active !== '')) { %>
      <div class="col-12 col-lg-2">
        <a href="/items" class="btn btn-link text-decoration-none text-muted p-0">Clear Filters</a>
      </div>
    <% } %>
  </form>
</section>

<!-- Items Table -->
<section class="card border-0 shadow-sm rounded-3 overflow-hidden bg-white mb-4" aria-label="Items Table">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="item-master-table">
      <thead class="table-light">
        <tr>
          <th scope="col" class="ps-4">Item Name</th>
          <th scope="col">HSN/SAC</th>
          <th scope="col">Unit</th>
          <th scope="col" class="text-end">Default Rate</th>
          <th scope="col" class="text-center">Status</th>
          <th scope="col" class="text-end pe-4">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!items || items.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-muted">
              <i class="bi bi-box-seam fs-1 text-muted d-block mb-2"></i>
              <p class="mb-0">No items found matching criteria.</p>
            </td>
          </tr>
        <% } else { %>
          <% items.forEach(function(item) { %>
            <tr>
              <td class="ps-4">
                <div class="fw-bold text-dark"><%= item.name %></div>
                <% if (item.description) { %>
                  <div class="text-muted small text-truncate" style="max-width: 320px;"><%= item.description %></div>
                <% } %>
              </td>
              <td>
                <%= item.hsnSac ? item.hsnSac : '—' %>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= item.unit || 'PCS' %></span>
              </td>
              <td class="text-end font-monospace fw-semibold">
                ₹ <%= Number(item.rate).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
              </td>
              <td class="text-center">
                <% if (item.active) { %>
                  <span class="badge bg-success-subtle text-success">Active</span>
                <% } else { %>
                  <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                <% } %>
              </td>
              <td class="text-end pe-4">
                <button
                  type="button"
                  class="btn btn-sm btn-outline-secondary"
                  onclick="openEditItemModal(<%= JSON.stringify(item) %>)"
                  title="Edit Item"
                >
                  <i class="bi bi-pencil"></i>
                </button>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<!-- Item Create/Edit Modal -->
<div class="modal fade" id="modal-item-form" tabindex="-1" aria-labelledby="itemFormModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form id="item-master-form" onsubmit="saveItem(event)">
        <div class="modal-header">
          <h5 class="modal-title fw-bold" id="itemFormModalTitle">New Item</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <input type="hidden" id="modal-item-id" value="">
          <div id="modal-item-alert" class="alert alert-danger d-none py-2 mb-3"></div>

          <div class="mb-3">
            <label for="modal-item-name" class="form-label fw-semibold">Item Name *</label>
            <input type="text" class="form-control" id="modal-item-name" required maxlength="255" placeholder="e.g. Cloud Hosting Services, Widget Pro">
          </div>

          <div class="mb-3">
            <label for="modal-item-desc" class="form-label fw-semibold">Description</label>
            <textarea class="form-control" id="modal-item-desc" rows="2" placeholder="Optional details, specifications or service terms..."></textarea>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="modal-item-unit" class="form-label fw-semibold">Unit</label>
              <select class="form-select" id="modal-item-unit">
                <option value="PCS">PCS</option>
                <option value="Hours">Hours</option>
                <option value="Project">Project</option>
                <option value="Months">Months</option>
                <option value="Units">Units</option>
                <option value="License">License</option>
                <option value="Year">Year</option>
                <option value="Package">Package</option>
                <option value="Set">Set</option>
                <option value="KG">KG</option>
                <option value="Service">Service</option>
              </select>
            </div>
            <div class="col-6">
              <label for="modal-item-hsn" class="form-label fw-semibold">HSN/SAC</label>
              <input type="text" class="form-control font-monospace" id="modal-item-hsn" maxlength="20" placeholder="e.g. 998313">
            </div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-6">
              <label for="modal-item-rate" class="form-label fw-semibold">Default Rate (₹) *</label>
              <input type="number" step="0.01" min="0" class="form-control font-monospace text-end" id="modal-item-rate" required placeholder="0.00">
            </div>
            <div class="col-6">
              <label for="modal-item-gst" class="form-label fw-semibold">GST Rate (%)</label>
              <select class="form-select" id="modal-item-gst">
                <option value="0">0% (Nil / Exempt)</option>
                <option value="5">5%</option>
                <option value="12">12%</option>
                <option value="18" selected>18% (Standard)</option>
                <option value="28">28%</option>
              </select>
            </div>
          </div>

          <div class="form-check form-switch mt-2">
            <input class="form-check-input" type="checkbox" id="modal-item-active" checked>
            <label class="form-check-label fw-semibold" for="modal-item-active">Active in Catalog</label>
          </div>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary" id="btn-save-item-submit">
            <span class="spinner-border spinner-border-sm d-none me-1" id="item-submit-spinner"></span>
            Save Item
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  let modalInstance = null;

  document.addEventListener('DOMContentLoaded', () => {
    const el = document.getElementById('modal-item-form');
    if (el && window.bootstrap) {
      modalInstance = new bootstrap.Modal(el);
    }
  });

  function openCreateItemModal() {
    document.getElementById('itemFormModalTitle').textContent = 'New Item';
    document.getElementById('modal-item-id').value = '';
    document.getElementById('modal-item-name').value = '';
    document.getElementById('modal-item-desc').value = '';
    document.getElementById('modal-item-unit').value = 'PCS';
    document.getElementById('modal-item-hsn').value = '';
    document.getElementById('modal-item-rate').value = '';
    document.getElementById('modal-item-gst').value = '18';
    document.getElementById('modal-item-active').checked = true;
    document.getElementById('modal-item-alert').classList.add('d-none');
    if (modalInstance) modalInstance.show();
  }

  function openEditItemModal(item) {
    document.getElementById('itemFormModalTitle').textContent = 'Edit Item';
    document.getElementById('modal-item-id').value = item.id;
    document.getElementById('modal-item-name').value = item.name || '';
    document.getElementById('modal-item-desc').value = item.description || '';
    document.getElementById('modal-item-unit').value = item.unit || 'PCS';
    document.getElementById('modal-item-hsn').value = item.hsnSac || '';
    document.getElementById('modal-item-rate').value = Number(item.rate).toFixed(2);
    document.getElementById('modal-item-gst').value = String(Number(item.gstRate) || 0);
    document.getElementById('modal-item-active').checked = item.active !== false;
    document.getElementById('modal-item-alert').classList.add('d-none');
    if (modalInstance) modalInstance.show();
  }

  async function saveItem(e) {
    e.preventDefault();
    const alertBox = document.getElementById('modal-item-alert');
    const spinner = document.getElementById('item-submit-spinner');
    const btnSubmit = document.getElementById('btn-save-item-submit');
    alertBox.classList.add('d-none');

    const id = document.getElementById('modal-item-id').value;
    const isEdit = Boolean(id);

    const payload = {
      name: document.getElementById('modal-item-name').value.trim(),
      description: document.getElementById('modal-item-desc').value.trim() || null,
      unit: document.getElementById('modal-item-unit').value,
      hsnSac: document.getElementById('modal-item-hsn').value.trim() || null,
      rate: parseFloat(document.getElementById('modal-item-rate').value) || 0,
      gstRate: parseFloat(document.getElementById('modal-item-gst').value) || 0,
      active: document.getElementById('modal-item-active').checked
    };

    const csrfToken = '<%= locals.csrfToken || "" %>';

    try {
      spinner.classList.remove('d-none');
      btnSubmit.disabled = true;

      const url = isEdit ? `/api/items/${id}` : '/api/items';
      const method = isEdit ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.error || 'Failed to save item.');
      }

      window.location.reload();
    } catch (err) {
      alertBox.textContent = err.message;
      alertBox.classList.remove('d-none');
    } finally {
      spinner.classList.add('d-none');
      btnSubmit.disabled = false;
    }
  }
</script>

<%- include('../layouts/footer') %>
