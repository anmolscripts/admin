# ==============================================================================
# SPARK ADMIN - LOCAL DEVELOPMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT SENSITIVE PRODUCTION CREDENTIALS TO THIS FILE.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
REQUEST_BODY_LIMIT=2mb

# Session Configuration
# For development only. In production, use a 32+ character random secret.
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars
SESSION_COOKIE_NAME=spark.sid
SESSION_MAX_AGE_HOURS=8

# Password Hashing Cost (10-12 recommended)
BCRYPT_SALT_ROUNDS=12

# Database Connection (MySQL 8 / MariaDB)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=admin
DATABASE_URL="mysql://your_database_user:your_database_password@localhost:3306/admin"

# Initial Seed Credentials (Used by prisma/seed.js for local development setup)
SEED_ADMIN_PASSWORD=your_local_seed_password
