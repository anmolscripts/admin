# ==========================================
# Application Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=3000

# Session Configuration
# In production, use a strong 32+ character random secret
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=spark.sid
SESSION_MAX_AGE_HOURS=8

# Password Hashing Cost
BCRYPT_SALT_ROUNDS=12

# Database Connection (MySQL / MariaDB)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=admin
DATABASE_URL="mysql://your_database_user:your_database_password@localhost:3306/admin"

# Seed Admin Credentials
SEED_ADMIN_PASSWORD=your_local_seed_password
