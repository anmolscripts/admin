// This is your Prisma schema file,
// learn more about the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum DocumentType {
  QUOTATION
  INVOICE
}

enum InvoiceStatus {
  ACTIVE
  INACTIVE
  VOID
  DELETED
}

model User {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  email            String            @unique @db.VarChar(150)
  password         String            @db.VarChar(255)
  role             String            @default("ADMIN") @db.VarChar(30)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  invoicesCreated  Invoice[]         @relation("InvoiceCreatedBy")
  invoicesUpdated  Invoice[]         @relation("InvoiceUpdatedBy")
  invoicesDeleted  Invoice[]         @relation("InvoiceDeletedBy")
  revisionsCreated InvoiceRevision[] @relation("RevisionChangedBy")
  clientsCreated   Client[]          @relation("ClientCreatedBy")
  paymentsCreated  Payment[]         @relation("PaymentCreatedBy")
  itemsCreated     Item[]            @relation("ItemCreatedBy")
  unitsCreated     Unit[]            @relation("UnitCreatedBy")

  @@map("users")
}

model Client {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(191)
  email           String?   @db.VarChar(191)
  phone           String?   @db.VarChar(50)
  gstin           String?   @db.VarChar(20)
  stateCode       String?   @db.VarChar(5)
  billingAddress  String?   @db.Text
  shippingAddress String?   @db.Text
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     Int?
  createdBy       User?     @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  invoices        Invoice[]

  @@index([name])
  @@index([email])
  @@index([active])
  @@index([createdById])
  @@map("clients")
}

model BusinessProfile {
  id             Int      @id @default(autoincrement())
  legalName      String   @db.VarChar(191)
  displayName    String?  @db.VarChar(191)
  gstin          String?  @db.VarChar(20)
  stateCode      String?  @db.VarChar(5)
  email          String?  @db.VarChar(191)
  phone          String?  @db.VarChar(50)
  address        String?  @db.Text
  defaultTerms   String?  @db.Text
  defaultRemarks String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("business_profiles")
}

model Invoice {
  id                         Int               @id @default(autoincrement())
  documentType               DocumentType      @default(INVOICE)
  invoiceNumber              String            @unique @db.VarChar(50)
  clientId                   Int?
  client                     Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName                 String            @db.VarChar(255)
  clientEmail                String?           @db.VarChar(255)
  clientPhone                String?           @db.VarChar(50)
  clientGSTIN                String?           @db.VarChar(20)
  placeOfSupplyStateCode     String?           @db.VarChar(5)
  sellerName                 String?           @db.VarChar(191)
  sellerGSTIN                String?           @db.VarChar(20)
  sellerStateCode            String?           @db.VarChar(5)
  sellerEmail                String?           @db.VarChar(191)
  sellerPhone                String?           @db.VarChar(50)
  sellerAddress              String?           @db.Text
  billingAddress             String?           @db.Text
  shippingAddress            String?           @db.Text
  termsAndConditions         String?           @db.Text
  remarks                    String?           @db.Text
  invoiceDate                DateTime          @db.Date
  dueDate                    DateTime?         @db.Date
  validUntil                 DateTime?         @db.Date
  gstEnabled                 Boolean           @default(false)
  gstRate                    Decimal           @default(0.00) @db.Decimal(5, 2)
  subtotal                   Decimal           @db.Decimal(12, 2)
  gstAmount                  Decimal           @db.Decimal(12, 2)
  cgstAmount                 Decimal           @default(0.00) @db.Decimal(12, 2)
  sgstAmount                 Decimal           @default(0.00) @db.Decimal(12, 2)
  igstAmount                 Decimal           @default(0.00) @db.Decimal(12, 2)
  roundOff                   Decimal           @db.Decimal(12, 2)
  grandTotal                 Decimal           @db.Decimal(12, 2)
  paidAmount                 Decimal           @default(0.00) @db.Decimal(12, 2)
  outstandingAmount          Decimal           @default(0.00) @db.Decimal(12, 2)
  status                     InvoiceStatus     @default(ACTIVE)
  previousStatusBeforeDelete InvoiceStatus?
  deletedAt                  DateTime?
  deletedById                Int?
  deleteReason               String?           @db.Text
  version                    Int               @default(1)
  sourceQuotationId          Int?              @unique
  createdById                Int
  updatedById                Int
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  createdBy                  User              @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy                  User              @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  deletedBy                  User?             @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])
  sourceQuotation            Invoice?          @relation("QuotationToInvoice", fields: [sourceQuotationId], references: [id], onDelete: Restrict)
  convertedInvoice           Invoice?          @relation("QuotationToInvoice")
  items                      InvoiceItem[]
  revisions                  InvoiceRevision[]
  payments                   Payment[]

  @@index([documentType])
  @@index([clientId])
  @@index([clientName])
  @@index([status])
  @@index([invoiceDate])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("invoices")
}

model InvoiceItem {
  id         Int      @id @default(autoincrement())
  invoiceId  Int
  lineNumber Int
  name       String   @db.VarChar(255)
  hsnSac     String?  @db.VarChar(20)
  quantity   Decimal  @db.Decimal(10, 2)
  unit       String   @default("PCS") @db.VarChar(30)
  rate       Decimal  @db.Decimal(12, 2)
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(255)
  description String?  @db.Text
  unit        String   @default("PCS") @db.VarChar(30)
  rate        Decimal  @default(0.00) @db.Decimal(12, 2)
  hsnSac      String?  @db.VarChar(20)
  gstRate     Decimal  @default(0.00) @db.Decimal(5, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?
  createdBy   User?    @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([createdById])
  @@map("items")
}

model Unit {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  symbol      String   @unique @db.VarChar(30)
  description String?  @db.Text
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById Int?
  createdBy   User?    @relation("UnitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([active])
  @@index([createdById])
  @@map("units")
}

model InvoiceRevision {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  revisionNo  Int
  action      String   @db.VarChar(50)
  changedById Int
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  changedAt   DateTime @default(now())
  changes     Json
  snapshot    Json
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy   User     @relation("RevisionChangedBy", fields: [changedById], references: [id])

  @@unique([invoiceId, revisionNo])
  @@index([invoiceId])
  @@index([changedById])
  @@map("invoice_revisions")
}

model Payment {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  paymentDate DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @default("BANK_TRANSFER") @db.VarChar(50)
  reference   String?  @db.VarChar(191)
  notes       String?  @db.Text
  status      String   @default("POSTED") @db.VarChar(20)
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy   User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([status])
  @@index([paymentDate])
  @@index([createdById])
  @@map("payments")
}

model InvoiceNumberSequence {
  id            Int          @id @default(autoincrement())
  documentType  DocumentType @default(INVOICE)
  year          Int
  currentNumber Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([documentType, year])
  @@map("invoice_number_sequences")
}
