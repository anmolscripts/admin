model StockMovement {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id             Int       @id @default(autoincrement())
  movementNumber String    @db.VarChar(50)
  requestKey     String?   @db.VarChar(100)
  requestHash    String?   @db.VarChar(64)
  businessId     Int?
  business       Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemId         Int
  movementType   String    @db.VarChar(30)
  quantity       Decimal   @db.Decimal(10, 2)
  unitCost       Decimal   @default(0.00) @db.Decimal(12, 2)
  totalCost      Decimal   @default(0.00) @db.Decimal(12, 2)
  referenceType  String?   @db.VarChar(50)
  referenceId       Int?
  movementDate      DateTime           @db.Date
  notes             String?            @db.Text
  projectId         Int?
  storeLocation     String?            @db.VarChar(100)
  project           Project?           @relation(fields: [projectId], references: [id])
  createdById       Int
  createdAt         DateTime           @default(now())
  createdBy         User               @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]

  @@unique([businessId, movementNumber])
  @@unique([businessId, requestKey])
  @@index([businessId])
  @@index([itemId])
  @@index([movementDate])
  @@index([movementType])
  @@index([projectId])
  @@index([storeLocation])
  @@map("stock_movements")
}

model Employee {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                Int                     @id @default(autoincrement())
  employeeCode      String                  @db.VarChar(50)
  businessId        Int?
  business          Business?               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstName         String                  @db.VarChar(100)
  lastName          String                  @db.VarChar(100)
  email             String                  @unique @db.VarChar(150)
  phone             String?                 @db.VarChar(50)
  department        String?                 @db.VarChar(100)
  designation       String?                 @db.VarChar(100)
  dateOfJoining     DateTime                @db.Date
  dateOfLeaving     DateTime?               @db.Date
  panNumber         String?                 @db.VarChar(20)
  uanNumber         String?                 @db.VarChar(30)
  bankAccountNumber String?                 @db.VarChar(50)
  bankIfsc          String?                 @db.VarChar(20)
  bankName          String?                 @db.VarChar(100)
  status            String                  @default("ACTIVE") @db.VarChar(20)
  createdById       Int
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  createdBy         User                    @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  salaryStructures  SalaryStructure[]
  payrollEntries    PayrollEntry[]
  reimbursements    EmployeeReimbursement[]

  @@unique([businessId, employeeCode])
  @@index([businessId])
  @@index([status])
  @@index([department])
  @@map("employees")
}

model SalaryStructure {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int       @id @default(autoincrement())
  employeeId       Int
  effectiveFrom    DateTime  @db.Date
  basicSalary      Decimal   @db.Decimal(12, 2)
  hra              Decimal   @default(0.00) @db.Decimal(12, 2)
  conveyance       Decimal   @default(0.00) @db.Decimal(12, 2)
  specialAllowance Decimal   @default(0.00) @db.Decimal(12, 2)
  epfApplicable    Boolean   @default(true)
  esiApplicable    Boolean   @default(false)
  ptApplicable     Boolean   @default(true)
  tdsMonthly       Decimal   @default(0.00) @db.Decimal(12, 2)
  createdById      Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  businessId       Int?
  business         Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy        User      @relation("SalaryStructureCreatedBy", fields: [createdById], references: [id])
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([employeeId])
  @@index([effectiveFrom])
  @@map("salary_structures")
}

model PayrollPeriod {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id              Int            @id @default(autoincrement())
  financialYearId Int
  periodCode      String         @db.VarChar(20)
  month           Int
  year            Int
  startDate       DateTime       @db.Date
  endDate         DateTime       @db.Date
  status          String         @default("DRAFT") @db.VarChar(20)
  approvedById    Int?
  approvedAt      DateTime?
  journalEntryId  Int?
  createdById     Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  businessId      Int
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  approvedBy      User?          @relation("PayrollPeriodApprovedBy", fields: [approvedById], references: [id])
  createdBy       User           @relation("PayrollPeriodCreatedBy", fields: [createdById], references: [id])
  financialYear   FinancialYear  @relation(fields: [financialYearId], references: [id])
  journalEntry    JournalEntry?  @relation(fields: [journalEntryId], references: [id])
  entries         PayrollEntry[]

  @@unique([businessId, periodCode])
  @@index([businessId])
  @@index([periodCode])
  @@index([financialYearId])
  @@index([status])
  @@map("payroll_periods")
}

model PayrollEntry {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int           @id @default(autoincrement())
  payrollPeriodId  Int
  employeeId       Int
  basicSalary      Decimal       @db.Decimal(12, 2)
  hra              Decimal       @default(0.00) @db.Decimal(12, 2)
  allowances       Decimal       @default(0.00) @db.Decimal(12, 2)
  grossEarnings    Decimal       @db.Decimal(12, 2)
  employeeEpf      Decimal       @default(0.00) @db.Decimal(12, 2)
  employerEpf      Decimal       @default(0.00) @db.Decimal(12, 2)
  employeeEsi      Decimal       @default(0.00) @db.Decimal(12, 2)
  employerEsi      Decimal       @default(0.00) @db.Decimal(12, 2)
  professionalTax  Decimal       @default(0.00) @db.Decimal(12, 2)
  tds              Decimal       @default(0.00) @db.Decimal(12, 2)
  totalDeductions  Decimal       @db.Decimal(12, 2)
  netPay           Decimal       @db.Decimal(12, 2)
  status           String        @default("DRAFT") @db.VarChar(20)
  paymentMethod    String?       @default("BANK_TRANSFER") @db.VarChar(50)
  paymentDate      DateTime?     @db.Date
  paymentReference String?       @db.VarChar(100)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  employee         Employee      @relation(fields: [employeeId], references: [id])
  payrollPeriod    PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@unique([payrollPeriodId, employeeId])
  @@index([payrollPeriodId])
  @@index([employeeId])
  @@map("payroll_entries")
}

model EmployeeReimbursement {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id              Int            @id @default(autoincrement())
  employeeId      Int
  expenseDate     DateTime       @db.Date
  amount          Decimal        @db.Decimal(12, 2)
  category        String         @db.VarChar(100)
  description     String?        @db.Text
  claimNumber     String?        @db.VarChar(50)
  businessId      Int?
  business        Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  receiptUrl      String?        @db.VarChar(255)
  status          String         @default("PENDING") @db.VarChar(20)
  approvedById    Int?
  financialYearId Int?
  projectId       Int?
  project         Project?       @relation(fields: [projectId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  approvedBy      User?          @relation("ReimbursementApprovedBy", fields: [approvedById], references: [id])
  employee        Employee       @relation(fields: [employeeId], references: [id])
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([projectId])
  @@map("employee_reimbursements")
}

model Project {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                       Int                          @id @default(autoincrement())
  code                     String                       @db.VarChar(50)
  businessId               Int
  business                 Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                     String                       @db.VarChar(255)
  description              String?                      @db.Text
  clientId                 Int?
  siteLocation             String?                      @db.VarChar(255)
  managerId                Int?
  status                   String                       @default("ACTIVE") @db.VarChar(20)
  startDate                DateTime                     @db.Date
  endDate                  DateTime?                    @db.Date
  contractValue            Decimal                      @default(0.00) @db.Decimal(14, 2)
  budgetAmount             Decimal                      @default(0.00) @db.Decimal(14, 2)
  budgetMaterials          Decimal                      @default(0.00) @db.Decimal(14, 2)
  budgetLabour             Decimal                      @default(0.00) @db.Decimal(14, 2)
  budgetSubcontractor      Decimal                      @default(0.00) @db.Decimal(14, 2)
  budgetExpenses           Decimal                      @default(0.00) @db.Decimal(14, 2)
  hourlyRate               Decimal                      @default(0.00) @db.Decimal(10, 2)
  costRate                 Decimal                      @default(0.00) @db.Decimal(10, 2)
  billingType              String                       @default("TIME_AND_MATERIALS") @db.VarChar(30)
  revenueRecognitionMethod String                       @default("COMPLETED_CONTRACT") @db.VarChar(50)
  createdById              Int
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  client                   Client?                      @relation(fields: [clientId], references: [id])
  createdBy                User                         @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  manager                  User?                        @relation("ProjectManager", fields: [managerId], references: [id])
  costs                    ProjectCost[]
  tasks                    ProjectTask[]
  timesheetEntries         TimesheetEntry[]
  supplierBills            SupplierBill[]
  supplierBillItems        SupplierBillItem[]
  invoices                 Invoice[]
  invoiceItems             InvoiceItem[]
  creditDebitNotes         CreditDebitNote[]
  stockMovements           StockMovement[]
  expenses                 Expense[]
  employeeReimbursements   EmployeeReimbursement[]
  purchaseOrders           PurchaseOrder[]
  attachments              ProjectAttachment[]
  dailyLabour              ProjectDailyLabour[]
  contractorWorkOrders     ProjectContractorWorkOrder[]
  goodsReceipts            GoodsReceipt[]
  purchaseOrderItems       PurchaseOrderItem[]
  sourceQuotationId        Int?                         @unique
  sourceQuotationNumber    String?                      @db.VarChar(50)
  sourceQuotationSnapshot  Json?
  sourceQuotation          Invoice?                     @relation("QuotationToProject", fields: [sourceQuotationId], references: [id])
  closedAt                 DateTime?
  closedById               Int?
  closureOverrideReason    String?                      @db.Text
  closedBy                 User?                        @relation("ProjectClosedBy", fields: [closedById], references: [id])

  @@unique([businessId, code])
  @@index([businessId])
  @@index([clientId])
  @@index([managerId])
  @@index([status])
  @@index([sourceQuotationId])
  @@index([closedById])
  @@map("projects")
}

model ProjectTask {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int              @id @default(autoincrement())
  projectId        Int
  title            String           @db.VarChar(255)
  description      String?          @db.Text
  status           String           @default("TODO") @db.VarChar(20)
  estimatedHours   Decimal          @default(0.00) @db.Decimal(8, 2)
  actualHours      Decimal          @default(0.00) @db.Decimal(8, 2)
  assignedToUserId Int?
  dueDate          DateTime?        @db.Date
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignedTo       User?            @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timesheetEntries TimesheetEntry[]

  @@index([projectId])
  @@index([status])
  @@map("project_tasks")
}

model TimesheetEntry {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id           Int          @id @default(autoincrement())
  projectId    Int
  taskId       Int?
  userId       Int
  entryDate    DateTime     @db.Date
  hours        Decimal      @db.Decimal(6, 2)
  hourlyRate   Decimal      @db.Decimal(10, 2)
  costAmount   Decimal      @db.Decimal(12, 2)
  isBillable   Boolean      @default(true)
  status       String       @default("DRAFT") @db.VarChar(20)
  approvedById Int?
  approvedAt   DateTime?
  notes        String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  approvedBy   User?        @relation("TimesheetApprovedBy", fields: [approvedById], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])
  task         ProjectTask? @relation(fields: [taskId], references: [id])
  user         User         @relation("TimesheetUser", fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([entryDate])
  @@index([status])
  @@map("timesheet_entries")
}

model ProjectCost {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int           @id @default(autoincrement())
  businessId       Int
  projectId        Int
  costType         String        @db.VarChar(30)
  category         String        @default("OTHER") @db.VarChar(50)
  sourceType       String?       @db.VarChar(50)
  sourceId         Int?
  sourceLineId     Int           @default(0)
  sourceReference  String?       @db.VarChar(100)
  amount           Decimal       @db.Decimal(12, 2)
  quantity         Decimal?      @db.Decimal(12, 4)
  unit             String?       @db.VarChar(20)
  unitCost         Decimal?      @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0.00) @db.Decimal(14, 2)
  isTaxRecoverable Boolean       @default(true)
  status           String        @default("POSTED") @db.VarChar(30)
  costDate         DateTime      @db.Date
  description      String?       @db.Text
  journalEntryId   Int?
  createdById      Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@unique([businessId, sourceType, sourceId, sourceLineId])
  @@index([businessId])
  @@index([projectId])
  @@index([category])
  @@index([status])
  @@index([costDate])
  @@map("project_costs")
}

model ProjectAttachment {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int      @id @default(autoincrement())
  businessId       Int
  projectId        Int?
  entityType       String   @db.VarChar(50)
  entityId         Int?
  title            String?  @db.VarChar(255)
  category         String   @default("OTHER") @db.VarChar(50)
  description      String?  @db.Text
  referenceNumber  String?  @db.VarChar(100)
  issueDate        DateTime? @db.Date
  expiryDate       DateTime? @db.Date
  originalFilename String   @db.VarChar(255)
  storedFilename   String   @unique @db.VarChar(255)
  filePath         String   @db.VarChar(500)
  fileSize         Int
  mimeType         String   @db.VarChar(100)
  sha256Hash       String?  @db.VarChar(64)
  uploadedById     Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project          Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy       User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([businessId, projectId])
  @@index([entityType, entityId])
  @@index([category])
  @@map("project_attachments")
}

model DailyWorker {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id              Int                  @id @default(autoincrement())
  businessId      Int
  workerCode      String               @db.VarChar(50)
  name            String               @db.VarChar(150)
  trade           String?              @db.VarChar(100)
  phone           String?              @db.VarChar(50)
  aadhaarNumber   String?              @db.VarChar(20)
  defaultWageRate Decimal              @default(0.00) @db.Decimal(10, 2)
  wageBasis       String               @default("DAILY") @db.VarChar(20)
  status          String               @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  labourEntries   ProjectDailyLabour[]

  @@unique([businessId, workerCode])
  @@index([businessId, status])
  @@map("daily_workers")
}

model ProjectDailyLabour {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int           @id @default(autoincrement())
  businessId       Int
  projectId        Int
  workerId         Int
  workDate         DateTime      @db.Date
  trade            String?       @db.VarChar(100)
  hours            Decimal       @default(8.00) @db.Decimal(6, 2)
  wageRate         Decimal       @db.Decimal(10, 2)
  wageBasis        String        @default("DAILY") @db.VarChar(20)
  grossPayable     Decimal       @db.Decimal(12, 2)
  advancesDeducted Decimal       @default(0.00) @db.Decimal(12, 2)
  netPayable       Decimal       @db.Decimal(12, 2)
  paymentMethod    String        @default("CASH") @db.VarChar(30)
  paymentStatus    String        @default("UNPAID") @db.VarChar(20)
  paidAt           DateTime?
  status           String        @default("APPROVED") @db.VarChar(20)
  supervisorId     Int?
  journalEntryId   Int?
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  worker           DailyWorker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  supervisor       User?         @relation("DailyLabourSupervisor", fields: [supervisorId], references: [id])
  journalEntry     JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([projectId, workDate])
  @@index([businessId])
  @@index([workerId])
  @@index([status])
  @@map("project_daily_labour")
}

model ProjectContractorWorkOrder {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                 Int       @id @default(autoincrement())
  businessId         Int
  projectId          Int
  supplierId         Int
  orderNumber        String    @db.VarChar(50)
  contractTitle      String    @db.VarChar(255)
  contractValue      Decimal   @db.Decimal(14, 2)
  withholdingTaxRate Decimal   @default(0.00) @db.Decimal(5, 2)
  status             String    @default("ACTIVE") @db.VarChar(20)
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  terms              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier           Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([businessId, orderNumber])
  @@index([projectId])
  @@index([supplierId])
  @@index([status])
  @@map("project_contractor_work_orders")
}

model GoodsReceipt {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                    Int                @id @default(autoincrement())
  requestKey            String?            @db.VarChar(100)
  requestHash           String?            @db.Char(64)
  receiptNumber         String             @db.VarChar(50)
  businessId            Int
  business              Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrderId       Int?
  purchaseOrder         PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId            Int?
  supplier              Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName          String             @db.VarChar(255)
  deliveryChallanNumber String?            @db.VarChar(100)
  receiptDate           DateTime           @db.Date
  storeLocation         String             @default("Main Warehouse") @db.VarChar(100)
  status                String             @default("ACCEPTED") @db.VarChar(20)
  notes                 String?            @db.Text
  projectId             Int?
  project               Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  receivedById          Int
  receivedBy            User               @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  items                 GoodsReceiptItem[]

  @@unique([businessId, receiptNumber])
  @@unique([businessId, requestKey])
  @@index([businessId])
  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([projectId])
  @@index([receiptDate])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                  Int                @id @default(autoincrement())
  goodsReceiptId      Int
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId Int?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  itemId              Int?
  item                Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name                String             @db.VarChar(500)
  unit                String             @default("PCS") @db.VarChar(30)
  orderedQuantity     Decimal            @default(0.00) @db.Decimal(10, 2)
  receivedQuantity    Decimal            @db.Decimal(10, 2)
  acceptedQuantity    Decimal            @db.Decimal(10, 2)
  rejectedQuantity    Decimal            @default(0.00) @db.Decimal(10, 2)
  unitCost            Decimal            @default(0.00) @db.Decimal(12, 2)
  totalCost           Decimal            @default(0.00) @db.Decimal(12, 2)
  stockMovementId     Int?
  stockMovement       StockMovement?     @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([itemId])
  @@index([stockMovementId])
  @@map("goods_receipt_items")
}

model Session {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id        Int      @id @default(autoincrement())
  legacyId  String?  @unique @db.VarChar(128)
  sid       String   @unique @db.VarChar(128)
  data      String   @db.MediumText
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("sessions")
}
