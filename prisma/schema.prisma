generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                      Int                     @id @default(autoincrement())
  name                    String                  @db.VarChar(100)
  email                   String                  @unique @db.VarChar(150)
  password                String                  @db.VarChar(255)
  role                    String                  @default("ADMIN") @db.VarChar(30)
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  lastActivityAt          DateTime?
  lastLoginAt             DateTime?
  roleId                  Int?
  status                  String                  @default("ACTIVE") @db.VarChar(20)
  avatarUrl               String?                 @db.VarChar(255)
  phone                   String?                 @db.VarChar(50)
  accountsCreated         ChartOfAccount[]        @relation("AccountCreatedBy")
  clientsCreated          Client[]                @relation("ClientCreatedBy")
  notesCreated            CreditDebitNote[]       @relation("NoteCreatedBy")
  notesUpdated            CreditDebitNote[]       @relation("NoteUpdatedBy")
  notesVoided             CreditDebitNote[]       @relation("NoteVoidedBy")
  financialYearsClosed    FinancialYear[]         @relation("FinancialYearClosedBy")
  invitationsSent         Invitation[]            @relation("InvitationCreatedBy")
  invitation              Invitation?             @relation("UserInvitation")
  revisionsCreated        InvoiceRevision[]       @relation("RevisionChangedBy")
  invoicesCreated         Invoice[]               @relation("InvoiceCreatedBy")
  invoicesDeleted         Invoice[]               @relation("InvoiceDeletedBy")
  invoicesUpdated         Invoice[]               @relation("InvoiceUpdatedBy")
  quotationsAccepted     Invoice[]               @relation("QuotationAcceptedBy")
  itemsCreated            Item[]                  @relation("ItemCreatedBy")
  journalsPosted          JournalEntry[]          @relation("JournalPostedBy")
  paymentsCreated         Payment[]               @relation("PaymentCreatedBy")
  purchaseOrdersCreated   PurchaseOrder[]         @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated   PurchaseOrder[]         @relation("PurchaseOrderUpdatedBy")
  suppliersCreated        Supplier[]              @relation("SupplierCreatedBy")
  unitsCreated            Unit[]                  @relation("UnitCreatedBy")
  activities              UserActivityLog[]       @relation("UserActivities")
  supplierBillsCreated    SupplierBill[]          @relation("SupplierBillCreatedBy")
  supplierBillsUpdated    SupplierBill[]          @relation("SupplierBillUpdatedBy")
  expensesCreated         Expense[]               @relation("ExpenseCreatedBy")
  expensesUpdated         Expense[]               @relation("ExpenseUpdatedBy")
  otherIncomesCreated     OtherIncome[]           @relation("OtherIncomeCreatedBy")
  otherIncomesUpdated     OtherIncome[]           @relation("OtherIncomeUpdatedBy")
  supplierPaymentsCreated SupplierPayment[]       @relation("SupplierPaymentCreatedBy")
  stockMovementsCreated   StockMovement[]         @relation("StockMovementCreatedBy")
  employeesCreated        Employee[]              @relation("EmployeeCreatedBy")
  salaryStructuresCreated SalaryStructure[]       @relation("SalaryStructureCreatedBy")
  payrollPeriodsCreated   PayrollPeriod[]         @relation("PayrollPeriodCreatedBy")
  payrollPeriodsApproved  PayrollPeriod[]         @relation("PayrollPeriodApprovedBy")
  reimbursementsApproved  EmployeeReimbursement[] @relation("ReimbursementApprovedBy")
  projectsCreated         Project[]               @relation("ProjectCreatedBy")
  projectsManaged         Project[]               @relation("ProjectManager")
  projectsClosed          Project[]               @relation("ProjectClosedBy")
  attachmentsUploaded     ProjectAttachment[]     @relation("AttachmentUploadedBy")
  dailyLabourSupervised   ProjectDailyLabour[]    @relation("DailyLabourSupervisor")
  tasksAssigned           ProjectTask[]           @relation("TaskAssignedTo")
  timesheetEntries        TimesheetEntry[]        @relation("TimesheetUser")
  timesheetsApproved      TimesheetEntry[]        @relation("TimesheetApprovedBy")
  goodsReceiptsReceived   GoodsReceipt[]          @relation("GoodsReceiptReceivedBy")
  userPermissions         UserPermission[]
  assignedRole            Role?                   @relation(fields: [roleId], references: [id])
  businessMemberships     BusinessMembership[]

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model Business {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  letters Letter[]
  id               Int                     @id @default(autoincrement())
  code             String                  @unique @db.VarChar(50)
  name             String                  @db.VarChar(255)
  legalName        String?                 @db.VarChar(255)
  gstin            String?                 @db.VarChar(20)
  stateCode        String?                 @db.VarChar(5)
  currency         String                  @default("INR") @db.VarChar(10)
  timeZone         String                  @default("Asia/Kolkata") @db.VarChar(50)
  status           String                  @default("ACTIVE") @db.VarChar(20)
  email            String?
  phone            String?                 @db.VarChar(50)
  address          String?                 @db.Text
  website          String?
  logoUrl          String?                 @db.VarChar(255)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  memberships      BusinessMembership[]
  profiles         BusinessProfile[]
  clients          Client[]
  suppliers        Supplier[]
  purchaseOrders   PurchaseOrder[]
  supplierBills    SupplierBill[]
  expenses         Expense[]
  otherIncomes     OtherIncome[]
  invoices         Invoice[]
  items            Item[]
  units            Unit[]
  payments         Payment[]
  financialYears   FinancialYear[]
  accounts         ChartOfAccount[]
  journalEntries   JournalEntry[]
  creditDebitNotes CreditDebitNote[]
  supplierPayments SupplierPayment[]
  stockMovements   StockMovement[]
  employees        Employee[]
  salaryStructures SalaryStructure[]
  payrollPeriods   PayrollPeriod[]
  reimbursements   EmployeeReimbursement[]
  projects             Project[]
  projectCosts         ProjectCost[]
  projectAttachments   ProjectAttachment[]
  dailyWorkers         DailyWorker[]
  projectDailyLabour   ProjectDailyLabour[]
  contractorWorkOrders ProjectContractorWorkOrder[]
  goodsReceipts        GoodsReceipt[]
  sequences            NumberingSequence[]
  prefixConfigs    BusinessPrefixConfig[]
  activityLogs     UserActivityLog[]

  @@index([status])
  @@map("businesses")
}

model Letter {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id            Int @id @default(autoincrement())
  businessId    Int
  business      Business @relation(fields: [businessId], references: [id])
  letterNumber  String @db.VarChar(80)
  subject       String @db.VarChar(255)
  recipientName String @db.VarChar(255)
  recipientAddress String? @db.Text
  letterDate    DateTime @db.Date
  bodyHtml      String @db.LongText
  bodyCss       String? @db.Text
  editorMode    String @default("RICH") @db.VarChar(10)
  templateId    String @db.VarChar(100)
  status        InvoiceStatus @default(ACTIVE)
  version       Int @default(1)
  createdById   Int
  updatedById   Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  revisions     LetterRevision[]

  @@unique([businessId, letterNumber])
  @@index([businessId, letterDate])
  @@map("letters")
}

model LetterRevision {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id          Int @id @default(autoincrement())
  letterId    Int
  letter      Letter @relation(fields: [letterId], references: [id])
  version     Int
  action      String @db.VarChar(30)
  reason      String? @db.Text
  changedById Int
  changedAt   DateTime @default(now())
  snapshot    Json

  @@unique([letterId, version])
  @@map("letter_revisions")
}

model BusinessMembership {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id         Int      @id @default(autoincrement())
  userId     Int
  businessId Int
  role       String   @default("MEMBER") @db.VarChar(30)
  status     String   @default("ACTIVE") @db.VarChar(20)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@map("business_memberships")
}

model NumberingSequence {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id            Int      @id @default(autoincrement())
  businessId    Int
  entityType    String   @db.VarChar(50)
  year          Int
  month         Int
  currentNumber BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, entityType, year, month])
  @@index([businessId, entityType])
  @@map("numbering_sequences")
}

model BusinessPrefixConfig {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id         Int      @id @default(autoincrement())
  businessId Int
  entityType String   @db.VarChar(50)
  prefix     String   @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, entityType])
  @@index([businessId])
  @@map("business_prefix_configs")
}

model Client {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int                @id @default(autoincrement())
  clientCode       String?            @db.VarChar(50)
  name             String
  email            String?
  phone            String?            @db.VarChar(50)
  gstin            String?            @db.VarChar(20)
  stateCode        String?            @db.VarChar(5)
  billingAddress   String?            @db.Text
  shippingAddress  String?            @db.Text
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdById      Int?
  createdBy        User?              @relation("ClientCreatedBy", fields: [createdById], references: [id])
  creditDebitNotes CreditDebitNote[]
  invoices         Invoice[]
  journalLines     JournalEntryLine[]
  projects         Project[]
  businessId       Int?
  business         Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, clientCode])
  @@index([businessId])
  @@index([clientCode])
  @@index([name])
  @@index([email])
  @@index([active])
  @@index([createdById])
  @@map("clients")
}

model Supplier {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id               Int               @id @default(autoincrement())
  supplierCode     String?           @db.VarChar(50)
  name             String
  email            String?
  phone            String?           @db.VarChar(50)
  gstin            String?           @db.VarChar(20)
  stateCode        String?           @db.VarChar(5)
  address          String?           @db.Text
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      Int?
  businessId       Int?
  business         Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrders   PurchaseOrder[]
  createdBy        User?             @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  supplierBills        SupplierBill[]
  supplierPayments     SupplierPayment[]
  contractorWorkOrders ProjectContractorWorkOrder[]
  goodsReceipts        GoodsReceipt[]

  @@unique([businessId, supplierCode])
  @@index([businessId])
  @@index([supplierCode])
  @@index([name])
  @@index([email])
  @@index([active])
  @@index([createdById])
  @@map("suppliers")
}

model PurchaseOrder {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                     Int                 @id @default(autoincrement())
  orderNumber            String              @db.VarChar(50)
  businessId             Int?
  business               Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId             Int?
  supplierName           String              @db.VarChar(255)
  supplierGSTIN          String?             @db.VarChar(20)
  placeOfSupplyStateCode String?             @db.VarChar(5)
  taxableSubtotal        Decimal             @default(0.00) @db.Decimal(14, 2)
  cgstAmount             Decimal             @default(0.00) @db.Decimal(14, 2)
  sgstAmount             Decimal             @default(0.00) @db.Decimal(14, 2)
  igstAmount             Decimal             @default(0.00) @db.Decimal(14, 2)
  totalTaxAmount         Decimal             @default(0.00) @db.Decimal(14, 2)
  totalAmount            Decimal             @default(0.00) @db.Decimal(14, 2)
  termsAndConditions     String?             @db.Text
  remarks                String?             @db.Text
  orderDate              DateTime            @db.Date
  dueDate                DateTime?           @db.Date
  status                 String              @default("ACTIVE") @db.VarChar(20)
  projectId              Int?
  financialYearId        Int?
  createdById            Int
  updatedById            Int
  version                Int                 @default(1)
  items                  PurchaseOrderItem[]
  createdBy              User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  financialYear          FinancialYear?      @relation(fields: [financialYearId], references: [id])
  supplier               Supplier?           @relation(fields: [supplierId], references: [id])
  updatedBy              User                @relation("PurchaseOrderUpdatedBy", fields: [updatedById], references: [id])
  project                Project?            @relation(fields: [projectId], references: [id])
  goodsReceipts          GoodsReceipt[]

  @@unique([businessId, orderNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([projectId])
  @@index([orderDate])
  @@index([status])
  @@index([createdById], map: "purchase_orders_createdById_fkey")
  @@index([financialYearId], map: "purchase_orders_financialYearId_fkey")
  @@index([updatedById], map: "purchase_orders_updatedById_fkey")
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                Int                @id @default(autoincrement())
  purchaseOrderId   Int
  lineNumber        Int
  name              String             @db.VarChar(500)
  hsnSac            String?            @db.VarChar(20)
  quantity          Decimal            @db.Decimal(10, 2)
  unit              String             @default("PCS") @db.VarChar(30)
  rate              Decimal            @db.Decimal(12, 2)
  amount            Decimal            @db.Decimal(12, 2)
  discountAmount    Decimal            @default(0.00) @db.Decimal(12, 2)
  taxableAmount     Decimal            @default(0.00) @db.Decimal(12, 2)
  gstRate           Decimal            @default(0.00) @db.Decimal(5, 2)
  cgstAmount        Decimal            @default(0.00) @db.Decimal(12, 2)
  sgstAmount        Decimal            @default(0.00) @db.Decimal(12, 2)
  igstAmount        Decimal            @default(0.00) @db.Decimal(12, 2)
  totalAmount       Decimal            @default(0.00) @db.Decimal(12, 2)
  projectId         Int?
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  project           Project?           @relation(fields: [projectId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([projectId])
  @@map("purchase_order_items")
}

model PurchaseOrderNumberSequence {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id            Int      @id @default(autoincrement())
  year          Int      @unique
  currentNumber Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("purchase_order_number_sequences")
}

model SupplierBill {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                   Int                @id @default(autoincrement())
  billNumber           String             @db.VarChar(50)
  internalNumber       String?            @db.VarChar(50)
  businessId           Int?
  business             Business?          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplierId           Int?
  supplierName         String             @db.VarChar(255)
  supplierGSTIN        String?            @db.VarChar(20)
  billDate             DateTime           @db.Date
  dueDate              DateTime?          @db.Date
  status               String             @default("ACTIVE") @db.VarChar(20)
  totalAmount          Decimal            @db.Decimal(12, 2)
  financialYearId      Int?
  createdById          Int
  updatedById          Int
  version              Int                @default(1)
  projectId            Int?
  externalInvoiceNumber String?           @db.VarChar(100)
  placeOfSupply        String?            @db.VarChar(10)
  stateCode            String?            @db.VarChar(5)
  billToName           String?            @db.VarChar(255)
  billToAddress        String?            @db.Text
  shipToName           String?            @db.VarChar(255)
  shipToAddress        String?            @db.Text
  orderReference       String?            @db.VarChar(100)
  deliveryReference    String?            @db.VarChar(100)
  irn                  String?            @db.VarChar(100)
  ackNumber            String?            @db.VarChar(100)
  ackDate              DateTime?
  taxableAmount        Decimal            @default(0.00) @db.Decimal(14, 2)
  cgstAmount           Decimal            @default(0.00) @db.Decimal(12, 2)
  sgstAmount           Decimal            @default(0.00) @db.Decimal(12, 2)
  igstAmount           Decimal            @default(0.00) @db.Decimal(12, 2)
  cessAmount           Decimal            @default(0.00) @db.Decimal(12, 2)
  chargesAmount        Decimal            @default(0.00) @db.Decimal(12, 2)
  roundOff             Decimal            @default(0.00) @db.Decimal(8, 2)
  itcEligibility       String             @default("INPUT_GOODS_SERVICES") @db.VarChar(50)
  verificationStatus   String             @default("VERIFIED") @db.VarChar(30)
  items                SupplierBillItem[]
  createdBy            User               @relation("SupplierBillCreatedBy", fields: [createdById], references: [id])
  updatedBy            User               @relation("SupplierBillUpdatedBy", fields: [updatedById], references: [id])
  financialYear        FinancialYear?     @relation(fields: [financialYearId], references: [id])
  supplier             Supplier?          @relation(fields: [supplierId], references: [id])
  project              Project?           @relation(fields: [projectId], references: [id])
  supplierPayments     SupplierPayment[]

  @@unique([businessId, billNumber])
  @@unique([businessId, internalNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([billDate])
  @@index([status])
  @@index([projectId])
  @@map("supplier_bills")
}

model SupplierBillItem {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id             Int          @id @default(autoincrement())
  supplierBillId Int
  lineNumber     Int
  name           String       @db.VarChar(500)
  hsnSac         String?      @db.VarChar(20)
  quantity       Decimal      @db.Decimal(10, 2)
  unit           String       @default("PCS") @db.VarChar(30)
  rate           Decimal      @db.Decimal(12, 2)
  amount         Decimal      @db.Decimal(12, 2)
  projectId      Int?
  costCode       String?      @db.VarChar(50)
  discountAmount Decimal      @default(0.00) @db.Decimal(12, 2)
  taxableAmount  Decimal      @default(0.00) @db.Decimal(12, 2)
  gstRate        Decimal      @default(0.00) @db.Decimal(5, 2)
  cgstAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  sgstAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  igstAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  cessRate       Decimal      @default(0.00) @db.Decimal(5, 2)
  cessAmount     Decimal      @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  supplierBill   SupplierBill @relation(fields: [supplierBillId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id])

  @@index([supplierBillId])
  @@index([projectId])
  @@map("supplier_bill_items")
}

model Expense {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id              Int            @id @default(autoincrement())
  expenseDate     DateTime       @db.Date
  amount          Decimal        @db.Decimal(12, 2)
  description     String?        @db.Text
  category        String?        @db.VarChar(100)
  expenseNumber   String?        @db.VarChar(50)
  businessId      Int?
  business        Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financialYearId Int?
  projectId       Int?
  project         Project?       @relation(fields: [projectId], references: [id])
  createdById     Int
  updatedById     Int
  version         Int            @default(1)
  createdBy       User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy       User           @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id])

  @@index([businessId])
  @@index([projectId])
  @@index([expenseDate])
  @@map("expenses")
}

model OtherIncome {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id              Int            @id @default(autoincrement())
  incomeDate      DateTime       @db.Date
  amount          Decimal        @db.Decimal(12, 2)
  description     String?        @db.Text
  source          String?        @db.VarChar(100)
  incomeNumber    String?        @db.VarChar(50)
  businessId      Int?
  business        Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  financialYearId Int?
  createdById     Int
  updatedById     Int
  version         Int            @default(1)
  createdBy       User           @relation("OtherIncomeCreatedBy", fields: [createdById], references: [id])
  updatedBy       User           @relation("OtherIncomeUpdatedBy", fields: [updatedById], references: [id])
  financialYear   FinancialYear? @relation(fields: [financialYearId], references: [id])

  @@index([businessId])
  @@index([incomeDate])
  @@map("other_incomes")
}

model BusinessProfile {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                  Int       @id @default(autoincrement())
  legalName           String
  displayName         String?
  gstin               String?   @db.VarChar(20)
  stateCode           String?   @db.VarChar(5)
  email               String?
  phone               String?   @db.VarChar(50)
  address             String?   @db.Text
  defaultTerms        String?   @db.Text
  defaultRemarks      String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  accountHolder       String?
  accountNumber       String?   @db.VarChar(50)
  bankName            String?
  branch              String?
  currency            String?   @default("INR") @db.VarChar(10)
  ifsc                String?   @db.VarChar(20)
  invoiceFooter       String?   @db.Text
  logoUrl             String?   @db.VarChar(255)
  paymentInstructions String?   @db.Text
  timeZone            String?   @default("Asia/Kolkata") @db.VarChar(50)
  upiId               String?   @db.VarChar(100)
  website             String?
  workspaceName       String?
  businessId          Int?
  business            Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_profiles")
}

model Invoice {
  CREATED_BY Int?
  CREATED_AT DateTime? @default(now())
  IP_ADDRESS String? @db.VarChar(45)
  id                         Int               @id @default(autoincrement())
  invoiceNumber              String            @db.VarChar(50)
  businessId                 Int?
  business                   Business?         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientName                 String            @db.VarChar(255)
  invoiceDate                DateTime          @db.Date
  gstEnabled                 Boolean           @default(false)
  gstRate                    Decimal           @default(0.00) @db.Decimal(5, 2)
  subtotal                   Decimal           @db.Decimal(12, 2)
  gstAmount                  Decimal           @db.Decimal(12, 2)
  roundOff                   Decimal           @db.Decimal(12, 2)
  grandTotal                 Decimal           @db.Decimal(12, 2)
  status                     InvoiceStatus     @default(ACTIVE)
  version                    Int               @default(1)
  createdById                Int
  updatedById                Int
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  deleteReason               String?           @db.Text
  deletedAt                  DateTime?
  deletedById                Int?
  documentType               DocumentType      @default(INVOICE)
  previousStatusBeforeDelete InvoiceStatus?
  sourceQuotationId          Int?              @unique
  billingAddress             String?           @db.Text
  clientEmail                String?           @db.VarChar(255)
  clientPhone                String?           @db.VarChar(50)
  remarks                    String?           @db.Text
  shippingAddress            String?           @db.Text
  termsAndConditions         String?           @db.Text
