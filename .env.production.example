# ==============================================================================
# SPARK ADMIN - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# Instructions for production deployment:
# 1. Copy this template to .env on the production server:
#      cp .env.production.example .env
# 2. Generate a secure 64-character random session secret:
#      openssl rand -hex 32
# 3. Restrict file permissions so only the application user can read it:
#      chmod 600 .env
#
# NEVER COMMIT THE ACTUAL .env FILE OR REAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# TRUST_PROXY must be 'true' when deployed behind Nginx or an SSL-terminating reverse proxy
TRUST_PROXY=true
REQUEST_BODY_LIMIT=2mb

# Session Security
# Required: Must be at least 32 characters long.
SESSION_SECRET=GENERATE_STRONG_RANDOM_SECRET_MIN_32_CHARS_VIA_OPENSSL
SESSION_COOKIE_NAME=spark.sid
SESSION_MAX_AGE_HOURS=8

# Password Hashing Cost (12 recommended for production security)
BCRYPT_SALT_ROUNDS=12

# Database Connection (MySQL 8 / MariaDB)
# Production MUST use a dedicated least-privilege application database user (NOT root).
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=spark_app_user
DATABASE_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD
DATABASE_NAME=spark_admin_prod
DATABASE_URL="mysql://spark_app_user:YOUR_STRONG_DATABASE_PASSWORD@localhost:3306/spark_admin_prod"

# Initial Setup / Seed Credentials
# Only required if initializing the database with an admin account:
#   SEED_ADMIN_PASSWORD=YOUR_INITIAL_SECURE_ADMIN_PASSWORD
# Once the database is seeded and verified, remove or unset this variable.
SEED_ADMIN_PASSWORD=
